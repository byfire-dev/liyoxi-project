{
  "name": "@liyoxi/admin",
  "version": "0.1.0",
  "private": true,
  "description": "运营管理后台（React 19 · Vite 8；骨架由 W0-28 接）",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && node scripts/check-build.mjs dist/app --app admin",
    "dev": "vite",
    "build:e2e": "vite build --mode e2e",
    "e2e": "pnpm build:e2e && playwright test && pnpm e2e:cover",
    "e2e:cover": "playwright test --config test/cover-upload.config.ts",
    "e2e:live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@liyoxi/contract": "workspace:*",
    "@liyoxi/shared": "workspace:*",
    "@tanstack/react-query": "5.103.3",
    "@tanstack/react-router": "1.170.39",
    "antd": "6.6.5",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  }
}
