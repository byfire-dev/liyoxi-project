{
  "name": "@liyoxi/worker",
  "version": "0.1.0",
  "private": true,
  "description": "任务进程入口：数据库租约、出站中继与派发、定时器扫描、周期补登记、队列消费（W0-23）",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "redis:compat": "node scripts/build.mjs && node dist/redis-compat.js",
    "staff:bootstrap": "node scripts/build.mjs && node dist/staff-bootstrap.js",
    "staff:reissue-activation": "node scripts/build.mjs && node dist/staff-reissue-activation.js"
  },
  "dependencies": {
    "@liyoxi/contract": "workspace:*",
    "@liyoxi/services": "workspace:*",
    "@liyoxi/shared": "workspace:*",
    "@napi-rs/canvas": "1.0.9",
    "@react-pdf/renderer": "4.9.0",
    "@signpdf/placeholder-pdf-lib": "3.4.0",
    "@signpdf/signer-p12": "3.4.0",
    "@signpdf/signpdf": "3.4.0",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "node-forge": "1.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "sanitize-html": "2.17.7",
    "tencentcloud-sdk-nodejs-common": "4.1.220",
    "tencentcloud-sdk-nodejs-ocr": "4.1.322"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
