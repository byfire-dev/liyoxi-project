{
  "name": "liyoxi",
  "version": "0.1.0",
  "private": true,
  "description": "狸有戏：面向本地生活商家的短剧营销工具",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "prepare": "husky",
    "infra:up": "docker compose -f infra/compose/local.yml up -d --wait",
    "infra:down": "docker compose -f infra/compose/local.yml down",
    "gates:selftest": "node infra/ci/selftest/run.mjs",
    "status:summary": "node infra/ci/status-summary.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p infra && tsc --noEmit -p infra/ci/fixtures/base && tsc --noEmit -p infra/ci/fixtures/node-lib && tsc --noEmit -p infra/ci/fixtures/node-app && tsc --noEmit -p infra/ci/fixtures/web-react19 && tsc --noEmit -p infra/ci/fixtures/taro-react18 && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "contract:generate": "pnpm --filter @liyoxi/contract generate",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- packages/contract/generated",
    "depcheck": "node infra/ci/check-layers.mjs && depcruise apps packages infra --config .dependency-cruiser.cjs",
    "check:rename": "node infra/ci/check-rename.mjs",
    "design:generate": "pnpm --filter @liyoxi/shared run design:generate",
    "design:check": "pnpm design:generate && git diff --exit-code -- packages/shared/src/design/generated && node infra/ci/check-untracked.mjs packages/shared/src/design/generated",
    "lint:colors": "node infra/ci/check-colors.mjs",
    "mediatool:verify": "node infra/docker/mediatool/verify/run.mjs verify",
    "mediatool:bench": "node infra/docker/mediatool/verify/run.mjs bench",
    "wxpay:vectors": "vitest run --config packages/services/src/providers/wechat-pay/__fixtures__/vectors.vitest.config.ts",
    "db:generate": "pnpm --filter @liyoxi/db generate",
    "db:validate": "pnpm --filter @liyoxi/db validate",
    "db:deploy": "pnpm --filter @liyoxi/db migrate:deploy",
    "db:catalog-diff": "node infra/ci/db-catalog-diff.mjs",
    "db:verify-managed": "node infra/ci/db-verify-managed.mjs",
    "admin:build": "pnpm --filter @liyoxi/admin build",
    "portal:build": "pnpm --filter @liyoxi/portal build",
    "admin:e2e": "pnpm --filter @liyoxi/admin e2e",
    "registry:generate": "pnpm --filter @liyoxi/contract registry:generate",
    "registry:check": "pnpm registry:generate && git diff --exit-code -- docs/plan/x01-map.md && node infra/ci/check-untracked.mjs docs/plan/x01-map.md && pnpm --filter @liyoxi/contract registry:check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
