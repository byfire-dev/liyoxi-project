{
  "说明": [
    "预发节点的密钥文件清单（ADR-041 第 4.6 节；W2-25 任务书 第 10 节第 3 项）。这里只有文件名与去向，没有任何值。",
    "文件都放在节点的密钥目录里（缺省 /opt/liyoxi/secrets，只有 root 能进），逐项一个文件、权限 0400，只读挂到容器的 /run/secrets/<文件名>。",
    "file 文件名；uid 属主（读它的容器的运行用户：server 镜像 1000，PostgreSQL 与 Redis 的官方镜像 999）；required 现在就要不要；",
    "services 挂给基础 node.yml 或选中 Provider overlay 里的哪些服务（空格分隔，空串是现在谁都不挂）；env 容器里指向它的环境变量（空串是不经环境变量）；what 是什么。",
    "读它的有三处：infra/deploy/check-secrets.sh（齐备检查）、infra/bootstrap/gen-secrets.sh（生成）、infra/ci/test/stg-node.test.ts（核对 node.yml 的挂载与这里逐项一致）。",
    "加一项密钥：这里加一条，node.yml 或固定 Provider overlay 给用它的服务加上挂载与 *_FILE 变量（用例核对一致）；可选项被选择器选中后必须齐备，第三方密钥由业主写入。",
    "写法上的约束（bash 那一侧按行读，用例会核对）：每项只有上面六个键，值是字符串、数字或布尔；字符串里不出现反斜杠与花括号。"
  ],
  "secrets": [
    {
      "file": "postgres-password",
      "uid": 999,
      "required": true,
      "services": "postgres",
      "env": "POSTGRES_PASSWORD_FILE",
      "what": "PostgreSQL 超级用户的口令：只在第一次建数据目录时用到，之后留作应急"
    },
    {
      "file": "migrator-database-url",
      "uid": 1000,
      "required": true,
      "services": "migrate verify-db",
      "env": "",
      "what": "迁移账号 lyx_migrator（表的属主）的连接串：只挂给迁移与库核对两个一次性容器，常驻的容器都没有"
    },
    {
      "file": "database-url",
      "uid": 1000,
      "required": true,
      "services": "api worker seed check-env verify-db",
      "env": "DATABASE_URL_FILE",
      "what": "应用登录账号的连接串：该账号只是 lyx_app 的成员，不是属主"
    },
    {
      "file": "backup-database-url",
      "uid": 1000,
      "required": true,
      "services": "",
      "env": "",
      "what": "备份登录账号的连接串：该账号只是 lyx_readonly 的成员。账号现在就建，文件等每日备份的包接进来再挂给 worker"
    },
    {
      "file": "redis-auth.conf",
      "uid": 999,
      "required": true,
      "services": "redis",
      "env": "",
      "what": "Redis 的口令，一行 requirepass：与 redis-url 里的是同一个"
    },
    {
      "file": "redis-url",
      "uid": 1000,
      "required": true,
      "services": "api worker seed check-env",
      "env": "REDIS_URL_FILE",
      "what": "Redis 的连接串，带口令"
    },
    {
      "file": "data-keys.json",
      "uid": 1000,
      "required": true,
      "services": "api worker check-env",
      "env": "DATA_KEYS_FILE",
      "what": "字段加密的密钥：丢了已加密的数据就解不开，离线另存一份"
    },
    {
      "file": "bidx-keys.json",
      "uid": 1000,
      "required": true,
      "services": "api worker check-env",
      "env": "BIDX_KEYS_FILE",
      "what": "盲索引的密钥：换了旧数据就查不到，离线另存一份"
    },
    {
      "file": "auth-keys.json",
      "uid": 1000,
      "required": true,
      "services": "api check-env",
      "env": "AUTH_KEYS_FILE",
      "what": "后台登录的三把密钥：票据签名、设备 Cookie 签名、动态口令密钥的加密"
    },
    {
      "file": "cos-signer-keys.json",
      "uid": 1000,
      "required": false,
      "services": "api check-env",
      "env": "COS_SIGNER_KEYS_FILE",
      "what": "可选 COS 签名角色：仅 API 签发受授权的上传与下载地址"
    },
    {
      "file": "cos-sts-issuer-keys.json",
      "uid": 1000,
      "required": false,
      "services": "api check-env",
      "env": "COS_STS_ISSUER_KEYS_FILE",
      "what": "可选 COS STS 签发角色：仅 API 签发窄临时上传策略"
    },
    {
      "file": "cos-worker-keys.json",
      "uid": 1000,
      "required": false,
      "services": "worker check-env",
      "env": "COS_WORKER_KEYS_FILE",
      "what": "可选 COS worker 独立角色：对象读取、入库与留存任务"
    },
    {
      "file": "ci-worker-keys.json",
      "uid": 1000,
      "required": false,
      "services": "worker check-env",
      "env": "CI_WORKER_KEYS_FILE",
      "what": "可选数据万象 worker 独立角色：媒体任务提交与回查"
    },
    {
      "file": "ci-callback-key",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "CI_CALLBACK_KEY_FILE",
      "what": "可选数据万象回调密钥：发送与接收端共用固定任务签名"
    },
    {
      "file": "asr-tencent.json",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "ASR_TENCENT_FILE",
      "what": "可选腾讯录音识别配置：不代表已授权付费或通过预算准入"
    },
    {
      "file": "asr-callback-key",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "ASR_CALLBACK_KEY_FILE",
      "what": "可选录音识别回调密钥：保留原始 UTF8 字节并须同时选择 ASR"
    },
    {
      "file": "ocr-tencent.json",
      "uid": 1000,
      "required": false,
      "services": "api check-env",
      "env": "OCR_TENCENT_FILE",
      "what": "可选腾讯营业执照识别配置：仅同步 API 使用，不交 worker"
    },
    {
      "file": "llm-domestic.json",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "LLM_DOMESTIC_FILE",
      "what": "可选境内模型主备配置：文字与视觉均须完整，预算默认关闭"
    },
    {
      "file": "media-production.json",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "MEDIA_PRODUCTION_FILE",
      "what": "可选制作配置：共享工作卷与套接字、法务主体字段及六个真实模板 ID"
    },
    {
      "file": "client-error-projects.json",
      "uid": 1000,
      "required": false,
      "services": "api check-env",
      "env": "CLIENT_ERROR_PROJECTS_FILE",
      "what": "可选客户端错误项目白名单与固定 HTTPS 上游：仅 API 转发、check-env 格式校验"
    },
    {
      "file": "server-errors.json",
      "uid": 1000,
      "required": false,
      "services": "api worker check-env",
      "env": "SERVER_ERRORS_FILE",
      "what": "可选服务端自身错误上游：API/worker仅消费本组件DSN，check-env离线校验"
    },
    {
      "file": "alerts.json",
      "uid": 1000,
      "required": false,
      "services": "worker check-env",
      "env": "ALERTS_FILE",
      "what": "可选运维告警：机器人原始 key、值班人及 P2 即时规则；仅 worker 发送"
    }
  ]
}
