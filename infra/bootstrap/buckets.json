        },
        {
          "ID": "lyx-export",
          "Status": "Enabled",
          "Filter": { "Prefix": "export/" },
          "Expiration": { "Days": 2 }
        },
        {
          "ID": "lyx-ci",
          "Status": "Enabled",
          "Filter": { "Prefix": "ci/" },
          "Expiration": { "Days": 7 }
        }
      ]
    },
