# 狸有戏 · 预发节点的非敏感配置（D7 第 7.5 节；ADR-041；W2-25）。
# 只给 docker compose 做变量替换（--env-file），不是容器的 env_file；改了随发布生效。
# 这里不放任何密钥、口令、连接串：那些逐项一个文件，清单在 infra/deploy/secrets.manifest.json。
# 一行一个 键=值，值不加引号（节点脚本也按行读它）。

# 三个预发域名（业主 2026-10-04 定）。gateway 按它们隔离接口面，宿主机 nginx 的三个站点也从这里取
LYX_API_HOST=api.stg.liyoxi.timavia.com
LYX_ADMIN_HOST=admin.stg.liyoxi.timavia.com
LYX_PORTAL_HOST=portal.stg.liyoxi.timavia.com

# Compose 网络的固定网段；与节点上已有的网络相撞时换一个（节点初始化会查）
LYX_NODE_SUBNET=172.30.41.0/24
# gateway 只信这些来源带来的 X-Forwarded-For：宿主机 nginx 经回环端口进容器时，来源是这个网络的网桥地址。
# 起始值按上面的网段写；首次起环境后照 infra/bootstrap/README.md 第 6 节实测，对不上就改这里（V6 的预发部分）
LYX_TRUSTED_PROXY_CIDRS=172.30.41.1/32
# gateway 发布到宿主机回环地址的端口
LYX_GATEWAY_PORT=8080

# 写进静态页 CSP 的对象存储与 CDN 的源（空格分隔）。内容域还没定，真实存储接通时填（G3-A）
LYX_MEDIA_ORIGINS=

LYX_LOG_LEVEL=info
LYX_DB_NAME=liyoxi

# 默认关闭。节点 node.env 可按需启用固定能力名（空格分隔、不加引号）：
# cos ci asr asr-callback ocr llm media-production。asr-callback 必须同时启用 asr。
# 选中后对应的 FILE 必须齐备；挂载与非敏感配置见 infra/compose/providers/README.md。
LYX_NODE_PROVIDERS=
# 仅明确演练时临时开启；发布流程从不调用清空。冻结配置必须显式为 false 才允许。
LYX_REDIS_FLUSH_ENABLED=false

# 库与 Redis 的镜像：与 infra/compose/local.yml 同一个。转存到镜像仓库之后改成仓库里按摘要固定的地址
LYX_PG_IMAGE=postgres:17-trixie@sha256:ae69c452f483507a6b99fb654cf93aad7fe156ffd2c56247707eef4e36d3c12b
LYX_REDIS_IMAGE=redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
