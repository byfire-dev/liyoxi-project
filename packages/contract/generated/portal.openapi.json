          "storeName",
          "isStoreArchived",
          "entityId",
          "entityName",
          "authorizerPhoneMask",
          "grantScope",
          "capabilities",
          "authorizedAt",
          "expiresAt",
          "serverTime"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "PortalTicketCreated": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "pairDigits": {
            "pattern": "^\\d{2}$",
            "type": "string"
          },
          "pollIntervalMs": {
            "enum": [
              2000
            ],
            "type": "number"
          },
          "pollSecret": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
