            "format": "date-time",
            "type": "string"
          },
          "portalTicketId": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired",
              "consumed"
            ],
            "type": "string"
          }
        },
        "required": [
          "portalTicketId",
          "status",
          "expiresAt"
        ],
        "type": "object"
      },
      "SentryEnvelope": {
        "description": "Sentry envelope 原文，≤200KB",
        "maxLength": 204800,
        "minLength": 1,
        "type": "string"
      }
