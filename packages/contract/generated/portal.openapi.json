            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "qrUrl": {
            "format": "uri",
            "type": "string"
          },
          "shortCode": {
            "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$",
            "type": "string"
          }
        },
        "required": [
          "portalTicketId",
          "qrUrl",
          "shortCode",
          "pairDigits",
          "pollSecret",
          "expiresAt",
          "pollIntervalMs"
