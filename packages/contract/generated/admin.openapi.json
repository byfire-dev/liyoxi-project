          "wecomBindStatus": {
            "enum": [
              "none",
              "invited",
              "bound",
              "unbound"
            ],
            "type": "string",
            "x-open-enum": true
          }
        },
        "required": [
          "staff",
          "displayName",
          "phoneMask",
          "roleName",
          "staffGroup",
          "moduleLevels",
          "permissions",
          "dataScope",
          "wecomBindStatus",
          "mustChangePassword",
          "recoveryCodesLeft",
          "session",
          "flags",
          "serverTime"
        ],
        "type": "object"
      },
      "StepUpBody": {
        "properties": {
          "code": {
            "pattern": "^(?:\\d{6}|[A-Za-z0-9]{5}-?[A-Za-z0-9]{5})$",
            "type": "string"
          },
          "method": {
            "enum": [
              "totp",
              "recovery"
            ],
            "type": "string"
          }
        },
        "required": [
          "method",
          "code"
