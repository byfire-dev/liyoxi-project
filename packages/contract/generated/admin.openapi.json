    "/api/v1/admin/auth/me": {
      "get": {
        "operationId": "admin.auth.me.get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "enum": [
                        0
                      ],
                      "type": "number"
