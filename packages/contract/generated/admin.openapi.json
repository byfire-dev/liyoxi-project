            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "ticket": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "ticketExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "otpauthUri",
          "secret",
          "ticket",
          "ticketExpiresAt"
        ],
        "type": "object"
      },
      "VerifyMfaBody": {
        "properties": {
          "code": {
            "pattern": "^(?:\\d{6}|[A-Za-z0-9]{5}-?[A-Za-z0-9]{5})$",
            "type": "string"
          },
          "method": {
            "enum": [
              "totp",
              "recovery"
            ],
            "type": "string"
          },
          "ticket": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "method",
          "code"
        ],
        "type": "object"
      }
    }
