  "info": {
    "title": "狸有戏 · 后台接口",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/auth/activate": {
      "post": {
        "operationId": "admin.auth.activate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "enum": [
                        0
                      ],
                      "type": "number"
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuthNext"
                    },
                    "message": {
                      "enum": [
                        "ok"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "入参不合约定，或业务规则拒绝了输入本身"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未登录或会话失效"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "已登录但无权"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "限流"
          }
        },
        "summary": "新员工或被重置的员工凭短信激活码换取设置密码票据",
        "x-auth": "public",
        "x-idempotent": "none",
        "x-idempotent-reason": "登录前的激活与首次绑定，此时没有会话（C47 本稿归入登录与换会话）",
        "x-rate-limit": "admin.login"
      }
    },
