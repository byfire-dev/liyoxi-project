{
  "components": {
    "parameters": {},
    "schemas": {
      "ActivateBody": {
        "properties": {
          "activationCode": {
            "pattern": "^[A-Za-z0-9]{8}$",
            "type": "string"
          },
          "phone": {
            "pattern": "^1\\d{10}$",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "activationCode"
        ],
        "type": "object"
      },
      "AuthNext": {
        "properties": {
          "methods": {
            "items": {
              "enum": [
                "totp",
                "recovery"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "next": {
            "enum": [
              "mfa",
              "set_password",
              "enroll_totp",
              "login"
            ],
            "type": "string"
          },
          "ticket": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ticketExpiresAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "next",
          "ticket",
          "ticketExpiresAt",
          "methods"
        ],
        "type": "object"
      },
      "ConfirmTotpBody": {
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "ticket": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "code"
        ],
        "type": "object"
      },
      "DictRef": {
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "type": "object"
      },
      "EnrollTotpBody": {
        "properties": {
          "ticket": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticket"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "integer"
          },
          "details": {},
          "error": {
            "type": "string"
          },
          "fieldErrors": {
            "items": {
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "error",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "LoginBody": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "pattern": "^1\\d{10}$",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password"
        ],
        "type": "object"
      },
      "SentryEnvelope": {
        "description": "Sentry envelope 原文，≤200KB",
        "maxLength": 204800,
        "minLength": 1,
        "type": "string"
      },
      "SetPasswordBody": {
        "properties": {
          "newPassword": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "ticket": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "newPassword"
        ],
        "type": "object"
      },
      "StaffBrief": {
        "properties": {
          "isLead": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "roleKey": {
            "enum": [
              "super_admin",
              "cs",
              "delivery_manager",
              "editor",
              "publisher",
              "content_ops",
              "channel_ops",
              "finance"
            ],
            "type": "string",
            "x-open-enum": true
          },
          "staffId": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "staffNo": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "disabled"
            ],
            "type": "string",
            "x-open-enum": true
          }
        },
        "required": [
          "staffId",
          "staffNo",
          "name",
          "roleKey",
          "isLead",
          "status"
        ],
        "type": "object"
      },
      "StaffMe": {
        "properties": {
          "dataScope": {
            "enum": [
              "own",
              "group",
              "all"
            ],
            "type": "string",
            "x-open-enum": true
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "flags": {
            "additionalProperties": {},
            "type": "object"
          },
          "moduleLevels": {
            "properties": {
              "billing": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "channel": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "delivery": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "drama": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "finance": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "merchant": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "ops": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "order": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "publish": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "report": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "service": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "system": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              },
              "workbench": {
                "enum": [
                  "n",
                  "v",
                  "o",
                  "e"
                ],
                "type": "string"
              }
            },
            "required": [
              "workbench",
              "drama",
              "billing",
              "merchant",
              "order",
              "delivery",
              "publish",
              "service",
              "finance",
              "report",
              "ops",
              "system",
              "channel"
            ],
            "type": "object"
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "phoneMask": {
            "type": "string"
          },
          "recoveryCodesLeft": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "roleName": {
            "type": "string"
          },
          "serverTime": {
            "format": "date-time",
            "type": "string"
          },
          "session": {
            "properties": {
              "absoluteExpiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "authMethod": {
                "enum": [
                  "password+totp",
                  "password+recovery"
                ],
                "type": "string",
                "x-open-enum": true
              },
              "idleExpiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "staffSessionId": {
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "stepUpValidUntil": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "staffSessionId",
              "authMethod",
              "idleExpiresAt",
              "absoluteExpiresAt",
              "stepUpValidUntil"
            ],
            "type": "object"
          },
          "staff": {
            "$ref": "#/components/schemas/StaffBrief"
          },
          "staffGroup": {
            "anyOf": [
