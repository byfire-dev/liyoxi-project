{
  "name": "@liyoxi/contract",
  "version": "0.1.0",
  "private": true,
  "description": "接口契约唯一手写源：Zod schema、路由元数据、错误码与各登记表",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "default": "./src/enums/index.ts"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "default": "./src/registry/index.ts"
    },
    "./config/flags": {
      "types": "./src/config/flags.ts",
      "default": "./src/config/flags.ts"
    },
    "./config/params": {
      "types": "./src/config/params.ts",
      "default": "./src/config/params.ts"
    },
    "./types/merchant": {
      "types": "./generated/merchant.d.ts"
    },
    "./types/admin": {
      "types": "./generated/admin.d.ts"
    },
    "./types/portal": {
      "types": "./generated/portal.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo '源码包：exports 直接指向 src，没有构建'",
    "generate": "tsx scripts/generate.ts",
    "check": "pnpm generate && git diff --exit-code -- generated",
    "registry:generate": "tsx scripts/registry-map.ts",
    "registry:check": "tsx scripts/registry-check.ts",
    "enums:check": "tsx scripts/enums-check.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15"
  }
}
