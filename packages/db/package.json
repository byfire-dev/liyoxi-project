{
  "name": "@liyoxi/db",
  "version": "0.1.0",
  "private": true,
  "description": "唯一数据访问层：Prisma schema、迁移、客户端工厂（首版迁移由 W0-05 接）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/global-setup": {
      "types": "./src/testing/global-setup.ts",
      "default": "./src/testing/global-setup.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migration:build": "node scripts/build-init-migration.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo '源码包：exports 直接指向 src，没有构建'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.9.1"
  }
}
