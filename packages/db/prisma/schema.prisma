/// 样片版本：每个版本一行，流程视角（质检、推送、查看方式、商家决定与修改意见）；状态机 machine = sample，state_field = status
model Sample {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_sample") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId             String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId              String    @map("store_id") @db.Uuid
  /// 所属工单
  deliveryTicketId     String    @map("delivery_ticket_id") @db.Uuid
  /// 版本号，同一工单内从 1 递增
  versionNo            Int       @map("version_no") @db.SmallInt
  /// 样片原版文件（类别 sample_video），经 file_ref 登记
  fileId               String    @map("file_id") @db.Uuid
  /// 时长（毫秒）；体检通过（media.production.checked，gate = pass）时从探测结果回写，此前为空
  durationMs           Int?      @map("duration_ms")
  /// 广告位标记：[{ slot, startMs, endMs, label }]
  adSlots              Json      @map("ad_slots")
  /// 本版所用的广告版本：[{ slot, adId, versionNo }]
  adVersionsUsed       Json      @map("ad_versions_used")
  /// 状态：uploaded / check_rejected / qc_rejected / qc_passed / pushed / confirmed / change_requested / superseded；只经 flow.transition() 迁移
  status               String
  /// 上传人（剪辑师）
  uploadedByStaffId    String    @map("uploaded_by_staff_id") @db.Uuid
  /// 上传时间
  uploadedAt           DateTime  @map("uploaded_at") @db.Timestamptz(3)
  /// 最近一次质检记录；未质检为空
  qcRecordId           String?   @map("qc_record_id") @db.Uuid
  /// 推送人（交付经理）
  pushedByStaffId      String?   @map("pushed_by_staff_id") @db.Uuid
  /// 推送时间
  pushedAt             DateTime? @map("pushed_at") @db.Timestamptz(3)
  /// 推送时确定的查看方式：weapp / album / portal / wecom；前三种由系统按样片播放开关写入，wecom 由交付经理勾选
  previewChannels      String[]  @default([]) @map("preview_channels")
  /// 经企业微信发送水印版的时间
  offlineSentAt        DateTime? @map("offline_sent_at") @db.Timestamptz(3)
  /// 标记“已发送”的员工
  offlineSentByStaffId String?   @map("offline_sent_by_staff_id") @db.Uuid
  /// 商家首次经下载页或相册保存访问样片文件的时间，由访问留痕回写
  firstViewedAt        DateTime? @map("first_viewed_at") @db.Timestamptz(3)
  /// 商家在小程序勾选“我已查看”的时间
  viewedAckAt          DateTime? @map("viewed_ack_at") @db.Timestamptz(3)
  /// 勾选“我已查看”的商家用户
  viewedAckByUserId    String?   @map("viewed_ack_by_user_id") @db.Uuid
  /// 商家决定（确认或提出修改）的时间；交付经理代录时为代录时间
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz(3)
  /// 做出决定的商家用户；交付经理代录时为空
  decidedByUserId      String?   @map("decided_by_user_id") @db.Uuid
  /// 决定时的客户端来源：weapp / portal / admin（代录为 admin）；未决为空
  decideClient         String?   @map("decide_client")
  /// 商家确认时声明的查看方式：weapp / album / portal / wecom
  confirmViewedVia     String?   @map("confirm_viewed_via")
  /// 代录修改意见的交付经理
  onBehalfStaffId      String?   @map("on_behalf_staff_id") @db.Uuid
  /// 修改意见类型：compose 合成问题 / ad_content 广告内容
  feedbackKind         String?   @map("feedback_kind")
  /// 修改意见，不超过 200 字（应用层校验）
  feedbackNote         String?   @map("feedback_note")
  /// 修改意见指向的时间点（毫秒）
  feedbackTimeMs       Int?      @map("feedback_time_ms")
  /// 修改意见截图，经 file_ref 登记
  /// 不建外键：数组列
  feedbackFileIds      String[]  @default([]) @map("feedback_file_ids") @db.Uuid
  /// 乐观锁版本号；每次迁移加 1
  lockVersion          Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity             Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_sample_entity_id")
  /// 所属门店（归属复合外键）
  store              Store          @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_sample_store_entity")
  /// 所属工单
  deliveryTicket     DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_sample_delivery_ticket_id")
  /// 样片文件
  file               FileObject     @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_sample_file_id")
  /// 最近一次质检记录
  qcRecord           QcRecord?      @relation(fields: [qcRecordId], references: [id], onDelete: Restrict, map: "fk_sample_qc_record_id")
  /// 上传人
  uploadedByStaff    Staff          @relation("SampleUploadedByStaff", fields: [uploadedByStaffId], references: [id], onDelete: Restrict, map: "fk_sample_uploaded_by_staff_id")
  /// 推送人
  pushedByStaff      Staff?         @relation("SamplePushedByStaff", fields: [pushedByStaffId], references: [id], onDelete: Restrict, map: "fk_sample_pushed_by_staff_id")
  /// 标记“已经企业微信发送”的员工
  offlineSentByStaff Staff?         @relation("SampleOfflineSentByStaff", fields: [offlineSentByStaffId], references: [id], onDelete: Restrict, map: "fk_sample_offline_sent_by_staff_id")
  /// 代录修改意见的交付经理
  onBehalfStaff      Staff?         @relation("SampleOnBehalfStaff", fields: [onBehalfStaffId], references: [id], onDelete: Restrict, map: "fk_sample_on_behalf_staff_id")
  /// 做出决定的商家用户
  decidedByUser      MerchantUser?  @relation("SampleDecidedByUser", fields: [decidedByUserId], references: [id], onDelete: Restrict, map: "fk_sample_decided_by_user_id")
  /// 勾选“我已查看”的商家用户
  viewedAckByUser    MerchantUser?  @relation("SampleViewedAckByUser", fields: [viewedAckByUserId], references: [id], onDelete: Restrict, map: "fk_sample_viewed_ack_by_user_id")

  @@unique([deliveryTicketId, versionNo], map: "uq_sample_delivery_ticket_id_version_no")
  @@index([storeId], map: "ix_sample_store_id")
  @@index([fileId], map: "ix_sample_file_id")
  @@map("sample")
}

/// 成片剧集：每集每变体每修订一行，流程视角（质检状态、是否当前版、补发替换集）
model EpisodeOutput {
  /// 主键，UUID v7，应用生成
  id                String   @id(map: "pk_episode_output") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId          String   @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId           String   @map("store_id") @db.Uuid
  /// 所属工单
  deliveryTicketId  String   @map("delivery_ticket_id") @db.Uuid
  /// 集号，从 1 起
  episodeNo         Int      @map("episode_no")
  /// 平台变体：common / douyin / wechat_channels；V1.0 只写 common
  variant           String   @default("common")
  /// 修订号，同一集同一变体内从 1 递增
  revisionNo        Int      @default(1) @map("revision_no") @db.SmallInt
  /// 成片文件（类别 final_episode；样片采用为第 1 集时为 sample_video），经 file_ref 登记
  fileId            String   @map("file_id") @db.Uuid
  /// 文件大小（字节），登记时从 file_object 复制；出接口转字符串
  sizeBytes         BigInt   @map("size_bytes")
  /// 时长（毫秒），登记时从 media 的探测结果复制
  durationMs        Int?     @map("duration_ms")
  /// 来源：manual_upload / sample_adopted / restamped / auto_compose（V1.1，只声明）
  source            String   @default("manual_upload")
  /// 状态：uploaded / check_rejected / qc_passed / qc_rejected / replaced
  status            String
  /// 是否当前版本；质检通过才置真，每集每变体至多一行
  isCurrent         Boolean  @default(false) @map("is_current")
  /// 交付后补发时所属的补发单；非补发登记为空
  deliveryReissueId String?  @map("delivery_reissue_id") @db.Uuid
  /// 最近一次质检记录；未质检为空
  qcRecordId        String?  @map("qc_record_id") @db.Uuid
  /// 上传人（剪辑师）
  uploadedByStaffId String   @map("uploaded_by_staff_id") @db.Uuid
  /// 上传时间
  uploadedAt        DateTime @map("uploaded_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_episode_output_entity_id")
  /// 所属门店（归属复合外键）
  store           Store            @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_episode_output_store_entity")
  /// 所属工单
  deliveryTicket  DeliveryTicket   @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_episode_output_delivery_ticket_id")
  /// 成片文件
  file            FileObject       @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_episode_output_file_id")
  /// 所属补发单
  deliveryReissue DeliveryReissue? @relation(fields: [deliveryReissueId], references: [id], onDelete: Restrict, map: "fk_episode_output_delivery_reissue_id")
  /// 最近一次质检记录
  qcRecord        QcRecord?        @relation(fields: [qcRecordId], references: [id], onDelete: Restrict, map: "fk_episode_output_qc_record_id")
  /// 上传人
  uploadedByStaff Staff            @relation(fields: [uploadedByStaffId], references: [id], onDelete: Restrict, map: "fk_episode_output_uploaded_by_staff_id")

  @@unique([deliveryTicketId, episodeNo, variant, revisionNo], map: "uq_episode_output_ticket_episode_variant_revision")
  @@index([storeId], map: "ix_episode_output_store_id")
  @@index([fileId], map: "ix_episode_output_file_id")
  @@index([deliveryReissueId], map: "ix_episode_output_delivery_reissue_id")
  @@map("episode_output")
}

/// 质检记录：对样片、单集、成片包的一次清单检查结论；写入后不可改、不可删（触发器），重新质检另写一行
model QcRecord {
  /// 主键，UUID v7，应用生成
  id                 String   @id(map: "pk_qc_record") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId           String   @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId            String   @map("store_id") @db.Uuid
  /// 所属工单
  deliveryTicketId   String   @map("delivery_ticket_id") @db.Uuid
  /// 质检对象类型：sample 样片 / episode_output 单集 / delivery_ticket 成片包级（推送前，对象是工单）
  targetType         String   @map("target_type")
  /// 质检对象 id；成片包级质检填本工单 id
  /// 不建外键：按 target_type 多态
  targetId           String   @map("target_id") @db.Uuid
  /// 清单模板编码：qc.sample / qc.episode / qc.package，由 target_type 决定
  /// 不建外键：与 checklist_version_no 一起按值引用 checklist_template (code, version_no)（M56）
  checklistCode      String   @map("checklist_code")
  /// 清单模板版本号（checklist_template.version_no）
  checklistVersionNo Int      @map("checklist_version_no")
  /// 逐项结论：[{ key, result: pass | fail | na, note }]
  results            Json
  /// 结论：pass / fail
  verdict            String
  /// 不通过原因；verdict = fail 时必填
  rejectReason       String?  @map("reject_reason")
  /// 质检人（员工）
  inspectedByStaffId String   @map("inspected_by_staff_id") @db.Uuid
  /// 质检时间
  inspectedAt        DateTime @map("inspected_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)

  /// 所属主体
  entity           Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_qc_record_entity_id")
  /// 所属门店（归属复合外键）
  store            Store           @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_qc_record_store_entity")
  /// 所属工单
  deliveryTicket   DeliveryTicket  @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_qc_record_delivery_ticket_id")
  /// 质检人
  inspectedByStaff Staff           @relation(fields: [inspectedByStaffId], references: [id], onDelete: Restrict, map: "fk_qc_record_inspected_by_staff_id")
  samples          Sample[]
  episodeOutputs   EpisodeOutput[]

  @@index([deliveryTicketId, targetType], map: "ix_qc_record_delivery_ticket_id_target_type")
  @@index([targetType, targetId], map: "ix_qc_record_target_type_target_id")
  @@index([storeId], map: "ix_qc_record_store_id")
  @@map("qc_record")
}

/// 成片包的一次推送或补发：不可变的文件清单快照、交付前检查结果、发布清单文本（ZIP 缓存在 media 的 zip_bundle）
model DeliveryRelease {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_delivery_release") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId           String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId            String    @map("store_id") @db.Uuid
  /// 所属订单项
  orderItemId        String    @map("order_item_id") @db.Uuid
  /// 所属工单
  deliveryTicketId   String    @map("delivery_ticket_id") @db.Uuid
  /// 推送序号，同一订单项内从 1 递增
  releaseNo          Int       @map("release_no")
  /// 平台变体：common / douyin / wechat_channels；V1.0 只写 common
  variant            String    @default("common")
  /// 推送类型：initial 首次推送 / reissue 补发
  kind               String
  /// 技术状态：pushed 生效中 / superseded 已被新包取代 / closed 已关闭
  state              String
  /// 集数
  episodeCount       Int       @map("episode_count")
  /// 清单内文件总字节数；出接口转字符串
  totalBytes         BigInt    @map("total_bytes")
  /// 文件清单快照：[{ episodeNo, outputId, fileId, name, size, crc64 }]，不可变
  manifestSnapshot   Json      @map("manifest_snapshot")
  /// 相对上一包变更的集号；首次推送为空数组
  changedEpisodeNos  Int[]     @default([]) @map("changed_episode_nos")
  /// 渲染好的发布清单文本（不超过 200KB）；推送后可修订（同事务调 media 作废 ZIP）。打包时由 delivery 经 ensureZip 传给 media 落成文件，文件 id 在 zip_bundle.publish_list_file_id
  publishListText    String?   @map("publish_list_text")
  /// 交付前检查的清单模板编码，固定 delivery.precheck
  /// 不建外键：与 checklist_version_no 一起按值引用 checklist_template (code, version_no)（M56）
  checklistCode      String    @map("checklist_code")
  /// 交付前检查的清单模板版本号（checklist_template.version_no）
  checklistVersionNo Int       @map("checklist_version_no")
  /// 交付前检查的逐项结论：[{ key, result, note }]，原样保存
  precheckResults    Json      @map("precheck_results")
  /// 补发原因，字典 reissue_reason 的编码；补发时必填
  reasonCode         String?   @map("reason_code")
  /// 推送或补发说明
  note               String?
  /// 推送人（发布专员）
  pushedByStaffId    String    @map("pushed_by_staff_id") @db.Uuid
  /// 推送时间
  pushedAt           DateTime  @map("pushed_at") @db.Timestamptz(3)
  /// 被新包取代的时间
  supersededAt       DateTime? @map("superseded_at") @db.Timestamptz(3)
  /// 关闭时间；重开时清空
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 关闭原因：cancelled 订单项取消或退回 / usage_ended 使用期结束
  closeReason        String?   @map("close_reason")
  /// 推送请求的幂等键，同一订单项内唯一
  idempotencyKey     String    @map("idempotency_key")
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_release_entity_id")
  /// 所属门店（归属复合外键）
  store                Store                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_release_store_entity")
  /// 所属订单项
  orderItem            OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_delivery_release_order_item_id")
  /// 所属工单
  deliveryTicket       DeliveryTicket        @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_delivery_release_delivery_ticket_id")
  /// 推送人
  pushedByStaff        Staff                 @relation(fields: [pushedByStaffId], references: [id], onDelete: Restrict, map: "fk_delivery_release_pushed_by_staff_id")
  deliveryReissues     DeliveryReissue[]
  downloadGrants       DownloadGrant[]
  deliveryDownloadLogs DeliveryDownloadLog[]

  @@unique([orderItemId, releaseNo], map: "uq_delivery_release_order_item_id_release_no")
  @@unique([orderItemId, idempotencyKey], map: "uq_delivery_release_order_item_id_idempotency_key")
  @@index([deliveryTicketId], map: "ix_delivery_release_delivery_ticket_id")
  @@index([storeId], map: "ix_delivery_release_store_id")
  @@map("delivery_release")
}

/// 补发单：成片包推送后替换个别集，从发起到发布（或取消）
model DeliveryReissue {
  /// 主键，UUID v7，应用生成
  id                         String    @id(map: "pk_delivery_reissue") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId                   String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId                    String    @map("store_id") @db.Uuid
  /// 所属工单
  deliveryTicketId           String    @map("delivery_ticket_id") @db.Uuid
  /// 状态：open 在途 / published 已发布 / cancelled 已取消；不写状态历史
  status                     String
  /// 计划替换的集号，至少 1 个
  episodeNos                 Int[]     @map("episode_nos")
  /// 补发原因，字典 reissue_reason 的编码
  reasonCode                 String    @map("reason_code")
  /// 补发说明，必填
  note                       String
  /// 发起人（交付经理或主管）
  openedByStaffId            String    @map("opened_by_staff_id") @db.Uuid
  /// 发起时间
  openedAt                   DateTime  @map("opened_at") @db.Timestamptz(3)
  /// 发布补发时生成的成片包；未发布为空
  publishedDeliveryReleaseId String?   @map("published_delivery_release_id") @db.Uuid
  /// 关闭（发布或取消）时间
  closedAt                   DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt                  DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt                  DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                   Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_reissue_entity_id")
  /// 所属门店（归属复合外键）
  store                    Store            @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_reissue_store_entity")
  /// 所属工单
  deliveryTicket           DeliveryTicket   @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_delivery_reissue_delivery_ticket_id")
  /// 发起人
  openedByStaff            Staff            @relation(fields: [openedByStaffId], references: [id], onDelete: Restrict, map: "fk_delivery_reissue_opened_by_staff_id")
  /// 发布补发时生成的成片包
  publishedDeliveryRelease DeliveryRelease? @relation(fields: [publishedDeliveryReleaseId], references: [id], onDelete: Restrict, map: "fk_delivery_reissue_published_delivery_release_id")
  episodeOutputs           EpisodeOutput[]

  @@index([deliveryTicketId, openedAt], map: "ix_delivery_reissue_delivery_ticket_id_opened_at")
  @@index([storeId], map: "ix_delivery_reissue_store_id")
  @@map("delivery_reissue")
}

/// 成片下载的业务授权（默认 7 天，可重新生成）；过期由 expires_at 判定
model DownloadGrant {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_download_grant") @db.Uuid
  /// 所属主体，创建时从成片包复制，不可变
  entityId          String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从成片包复制，不可变
  storeId           String    @map("store_id") @db.Uuid
  /// 所属订单项
  orderItemId       String    @map("order_item_id") @db.Uuid
  /// 授权对应的成片包
  deliveryReleaseId String    @map("delivery_release_id") @db.Uuid
  /// 被授权方类型：entity 主体 / partner 服务商（V1.1，只声明）
  granteeType       String    @map("grantee_type")
  /// 被授权方 id；entity 时等于 entity_id
  /// 不建外键：按 grantee_type 多态
  granteeId         String    @map("grantee_id") @db.Uuid
  /// 技术状态：active 有效 / superseded 已被新授权取代 / revoked 已撤销
  state             String
  /// 到期时间
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 有效天数，生成时取参数 package.link_ttl_days（1 到 30，默认 7）的快照
  validDays         Int       @map("valid_days") @db.SmallInt
  /// 生成授权的操作人类型：merchant / staff / system / partner
  actorType         String    @map("actor_type")
  /// 操作人 id；system 时为空
  /// 不建外键：按 actor_type 多态
  actorId           String?   @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空
  client            String?
  /// 撤销原因，不超过 200 字（应用层校验）
  revokeReason      String?   @map("revoke_reason")
  /// 结束（被取代或撤销）时间；有效时为空
  endedAt           DateTime? @map("ended_at") @db.Timestamptz(3)
  /// 创建时间（授权生成时间）
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_download_grant_entity_id")
  /// 所属门店（归属复合外键）
  store                Store                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_download_grant_store_entity")
  /// 所属订单项
  orderItem            OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_download_grant_order_item_id")
  /// 授权对应的成片包
  deliveryRelease      DeliveryRelease       @relation(fields: [deliveryReleaseId], references: [id], onDelete: Restrict, map: "fk_download_grant_delivery_release_id")
  deliveryDownloadLogs DeliveryDownloadLog[]

  @@index([orderItemId, createdAt(sort: Desc)], map: "ix_download_grant_order_item_id_created_at")
  @@index([deliveryReleaseId], map: "ix_download_grant_delivery_release_id")
  @@index([storeId], map: "ix_download_grant_store_id")
  @@map("download_grant")
}

/// 成片、ZIP、发布清单的每次签发下载记录（业务数据）；只增，client_ack 两列允许回写一次
model DeliveryDownloadLog {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_delivery_download_log") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq               BigInt    @unique(map: "uq_delivery_download_log_seq") @default(autoincrement())
  /// 所属主体，创建时从成片包复制
  entityId          String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从成片包复制
  storeId           String    @map("store_id") @db.Uuid
  /// 所属成片包
  deliveryReleaseId String    @map("delivery_release_id") @db.Uuid
  /// 凭哪条授权下载；员工下载为空
  downloadGrantId   String?   @map("download_grant_id") @db.Uuid
  /// 所属订单项
  orderItemId       String    @map("order_item_id") @db.Uuid
  /// 下载内容：episode 单集 / zip 整包 / publish_list 发布清单
  kind              String
  /// 集号；kind = episode 时必填
  episodeNo         Int?      @map("episode_no")
  /// 被签发的文件；zip、publish_list 取 media.ensureZip 返回的 zipFileId、publishListFileId
  fileId            String    @map("file_id") @db.Uuid
  /// 操作人类型：merchant / staff / partner（V1.1，只声明）
  actorType         String    @map("actor_type")
  /// 操作人 id
  /// 不建外键：按 actor_type 多态
  actorId           String    @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin
  client            String
  /// 签发的直链有效期（秒）
  urlTtlSec         Int       @map("url_ttl_sec")
  /// 来源 IP
  ip                String?
  /// 浏览器或客户端 UA
  userAgent         String?   @map("user_agent")
  /// 小程序回报：saved 已存相册 / failed 失败；只可从空写一次
  clientAck         String?   @map("client_ack")
  /// 回报时间；与 client_ack 同时写入
  clientAckAt       DateTime? @map("client_ack_at") @db.Timestamptz(3)
  /// 创建时间（签发时间）
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_download_log_entity_id")
  /// 所属门店（归属复合外键）
  store           Store           @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_download_log_store_entity")
  /// 所属成片包
  deliveryRelease DeliveryRelease @relation(fields: [deliveryReleaseId], references: [id], onDelete: Restrict, map: "fk_delivery_download_log_delivery_release_id")
  /// 凭哪条授权下载
  downloadGrant   DownloadGrant?  @relation(fields: [downloadGrantId], references: [id], onDelete: Restrict, map: "fk_delivery_download_log_download_grant_id")
  /// 所属订单项
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_delivery_download_log_order_item_id")
  /// 被签发的文件
  file            FileObject      @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_delivery_download_log_file_id")

  @@index([orderItemId, episodeNo, createdAt(sort: Desc)], map: "ix_delivery_download_log_order_item_id_episode_no_created_at")
  @@index([storeId, createdAt(sort: Desc)], map: "ix_delivery_download_log_store_id_created_at")
  @@map("delivery_download_log")
}

/// 发布清单：合集名、封面、标题模板、话题、简介、AI 声明；进入“成片交付”时创建，每工单一份
model PublishList {
  /// 主键，UUID v7，应用生成
  id                      String    @id(map: "pk_publish_list") @db.Uuid
  /// 所属主体，创建时从工单复制，不可变
  entityId                String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从工单复制，不可变
  storeId                 String    @map("store_id") @db.Uuid
  /// 所属工单；每工单一份
  deliveryTicketId        String    @unique(map: "uq_publish_list_delivery_ticket_id") @map("delivery_ticket_id") @db.Uuid
  /// 合集名称
  collectionName          String?   @map("collection_name")
  /// 合集封面文件；默认取剧目竖版海报
  coverFileId             String?   @map("cover_file_id") @db.Uuid
  /// 每集标题模板，如 “{剧名} 第{集数}集｜{看点}”
  titleTemplate           String?   @map("title_template")
  /// 话题标签
  topics                  String[]  @default([])
  /// 简介，不超过 200 字（应用层校验）
  intro                   String?
  /// 发布时是否需要做 AI 内容声明；随剧与制作方式带出
  isAiDeclarationRequired Boolean   @default(false) @map("is_ai_declaration_required")
  /// 最近一次保存的员工（发布专员）
  savedByStaffId          String?   @map("saved_by_staff_id") @db.Uuid
  /// 最近一次保存的时间
  savedAt                 DateTime? @map("saved_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion             Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt               DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_publish_list_entity_id")
  /// 所属门店（归属复合外键）
  store          Store          @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_publish_list_store_entity")
  /// 所属工单（一对一）
  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_publish_list_delivery_ticket_id")
  /// 合集封面文件
  coverFile      FileObject?    @relation(fields: [coverFileId], references: [id], onDelete: Restrict, map: "fk_publish_list_cover_file_id")
  /// 最近一次保存的员工
  savedByStaff   Staff?         @relation(fields: [savedByStaffId], references: [id], onDelete: Restrict, map: "fk_publish_list_saved_by_staff_id")

  @@index([storeId], map: "ix_publish_list_store_id")
  @@map("publish_list")
}

/// 发布清单的逐集覆盖内容（看点、标题、话题、简介）与“因补发而变化”的推送序号
model PublishListEpisode {
  /// 所属工单；与 episode_no 组成主键
  deliveryTicketId   String   @map("delivery_ticket_id") @db.Uuid
  /// 集号，从 1 起
  episodeNo          Int      @map("episode_no")
  /// 看点，用于标题模板渲染
  highlight          String?
  /// 逐集标题；空则按模板渲染
  title              String?
  /// 逐集话题；空则沿用清单头的话题
  topics             String[]
  /// 逐集简介；空则沿用清单头的简介
  intro              String?
  /// 最近一次因补发而变化的推送序号；商家端据此标“已更新”
  changedInReleaseNo Int?     @map("changed_in_release_no")
  /// 创建时间
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属工单
  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_publish_list_episode_delivery_ticket_id")

  @@id([deliveryTicketId, episodeNo], map: "pk_publish_list_episode")
  @@map("publish_list_episode")
}

// ===== 11-publish =====
// 分组 11-publish：渠道账号与账号核验提交、上线任务与链接回填、巡检、下架（publish，L3）。7 张表。
// 依据：docs/appendix/design/d3-flow.md 第 12–15 节；rulings M4、M17、M19、M33、M34、M44，第二轮 M46–M48、M56、M59、M60、M71–M73；catalogue.json。
// 引用的其他分组模型：Entity、Store、MerchantUser（02）、Staff、ApprovalRequest（03）、OrderItem（09）、DeliveryTicket（10）。
// 全部外键都在本片段里（M46）；带 store_id 的六张表对门店用复合外键 (store_id, entity_id) → store (id, entity_id)，名为 fk_<表>_store_entity（M47）。
// 手写约束（CHECK、部分唯一索引、部分索引、数组列的 NOT NULL、CHECK 用的函数）在 dm/sql/11-publish.sql。

/// 渠道账号：门店绑定的抖音号 / 视频号及其核验状态；只存当前值，不存任何平台密码或令牌
model ChannelAccount {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_channel_account") @db.Uuid
  /// 所属主体，创建时从门店复制，不可变
  entityId           String    @map("entity_id") @db.Uuid
  /// 所属门店；账号按门店绑定
  storeId            String    @map("store_id") @db.Uuid
  /// 平台：douyin / wechat_channels
  platform           String
  /// 账号名称（当前值），与平台主页一致
  accountName        String    @map("account_name")
  /// 抖音号或视频号 ID（当前值，商家填写的原样）
  accountUid         String    @map("account_uid")
  /// 账号 ID 去空格、转小写后的值；唯一性按它判定
  accountUidNorm     String    @map("account_uid_norm")
  /// 账号类型：enterprise / personal / none；核验时由发布专员填写，核验前为空（商家填的值在提交行的快照里，M72）
  accountType        String?   @map("account_type")
  /// 认证主体名称（企业认证时），核验时填写
  certSubjectName    String?   @map("cert_subject_name")
  /// 状态：pending_verify / available / abnormal / unbound
  status             String
  /// 异常来源：verify（核验未通过）/ manual（手动标记）；仅异常时有值
  abnormalSource     String?   @map("abnormal_source")
  /// 异常原因，字典 reject_reason（场景 account_verify）的编码
  abnormalReasonCode String?   @map("abnormal_reason_code")
  /// 异常说明
  abnormalNote       String?   @map("abnormal_note")
  /// 最近一轮提交核验的时间；首次即绑定时间
  submittedAt        DateTime  @map("submitted_at") @db.Timestamptz(3)
  /// 最近一次核验通过的时间
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  /// 最近一次核验通过的发布专员
  verifiedByStaffId  String?   @map("verified_by_staff_id") @db.Uuid
  /// 解绑时间；解绑后不再占用账号唯一键
  unboundAt          DateTime? @map("unbound_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion        Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                    Entity                     @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_channel_account_entity_id")
  /// 所属门店
  store                     Store                      @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_channel_account_store_entity")
  /// 最近一次核验通过的发布专员
  verifiedByStaff           Staff?                     @relation(fields: [verifiedByStaffId], references: [id], onDelete: Restrict, map: "fk_channel_account_verified_by_staff_id")
  orderItemAccounts         OrderItemAccount[]
  channelAccountSubmissions ChannelAccountSubmission[]
  launchTasks               LaunchTask[]
  takedownTasks             TakedownTask[]

  @@index([storeId, status], map: "ix_channel_account_store_id_status")
  @@map("channel_account")
}

/// 账号核验的每轮提交：渠道账号每提交或重新提交一次一行，与审批单一对一（kind = channel_account）
model ChannelAccountSubmission {
  /// 主键，UUID v7，应用生成
  id                String   @id(map: "pk_channel_account_submission") @db.Uuid
  /// 所属主体，创建时从渠道账号复制，不可变
  entityId          String   @map("entity_id") @db.Uuid
  /// 所属门店，创建时从渠道账号复制，不可变
  storeId           String   @map("store_id") @db.Uuid
  /// 渠道账号
  channelAccountId  String   @map("channel_account_id") @db.Uuid
  /// 该账号的第几轮核验，从 1 递增
  roundNo           Int      @map("round_no")
  /// 轮次类型：new_binding（新绑定）/ resubmit（重新提交）
  kind              String
  /// 当轮填报快照（平台、账号名称、账号 ID、商家选的账号类型），结构见文档第 4 节
  filledSnapshot    Json     @map("filled_snapshot")
  /// 当轮主页截图（file_object 的 id，分类 channel_screenshot），至少 1 张
  /// 不建外键：数组列，经 file_ref 登记
  screenshotFileIds String[] @default([]) @map("screenshot_file_ids") @db.Uuid
  /// 比对结果 [{ field, filled, recognized, match }]，核验决定时写入；结构见文档第 4 节
  compareResult     Json?    @map("compare_result")
  /// 对应的核验审批单，一对一
  approvalRequestId String   @unique(map: "uq_channel_account_submission_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 提交人（商家用户，老板）
  submittedByUserId String   @map("submitted_by_user_id") @db.Uuid
  /// 提交时间
  submittedAt       DateTime @map("submitted_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_channel_account_submission_entity_id")
  /// 所属门店
  store           Store           @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_channel_account_submission_store_entity")
  /// 渠道账号
  channelAccount  ChannelAccount  @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, map: "fk_channel_account_submission_channel_account_id")
  /// 核验审批单
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_channel_account_submission_approval_request_id")
  /// 提交人
  submittedByUser MerchantUser    @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict, map: "fk_channel_account_submission_submitted_by_user_id")

  @@unique([channelAccountId, roundNo], map: "uq_channel_account_submission_channel_account_id_round_no")
  @@map("channel_account_submission")
}

/// 上线任务：粒度“订单项 × 发布账号”；is_live 表达已上线事实，review_status 表达最近一轮回填审到哪了
model LaunchTask {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_launch_task") @db.Uuid
  /// 所属主体，创建时从订单项复制，不可变
  entityId             String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从订单项复制，不可变
  storeId              String    @map("store_id") @db.Uuid
  /// 订单项
  orderItemId          String    @map("order_item_id") @db.Uuid
  /// 所属交付工单，不可变；处理人读取时取该工单的发布专员
  deliveryTicketId     String    @map("delivery_ticket_id") @db.Uuid
  /// 发布账号
  channelAccountId     String    @map("channel_account_id") @db.Uuid
  /// 平台：douyin / wechat_channels；创建时从账号复制
  platform             String
  /// 最近一轮回填的审核结果：pending / verifying / need_fix / passed / void
  reviewStatus         String    @map("review_status")
  /// 是否已上线；一旦为真，不因之后的补充回填或退回而变回假
  isLive               Boolean   @default(false) @map("is_live")
  /// 首次变为已上线的时间
  wentLiveAt           DateTime? @map("went_live_at") @db.Timestamptz(3)
  /// 当前回填轮次号；尚未回填为 0
  currentRoundNo       Int       @default(0) @map("current_round_no")
  /// 该账号核验通过的实际上线首日
  firstLaunchDate      DateTime? @map("first_launch_date") @db.Date
  /// 已核验通过的集数（累计）
  verifiedEpisodeCount Int       @default(0) @map("verified_episode_count")
  /// 全部集数核验通过的时间
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  /// 最近一次巡检给出结论的时间
  lastPatrolledAt      DateTime? @map("last_patrolled_at") @db.Timestamptz(3)
  /// 最近一次巡检结论：normal / abnormal / recovered
  lastPatrolResult     String?   @map("last_patrol_result")
  /// 作废原因：terminated / usage_expired / account_changed；仅 void 时有值
  voidReason           String?   @map("void_reason")
  /// 创建时间（推送成片包的时间）
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity            Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_launch_task_entity_id")
  /// 所属门店
  store             Store              @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_launch_task_store_entity")
  /// 订单项
  orderItem         OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_launch_task_order_item_id")
  /// 所属交付工单
  deliveryTicket    DeliveryTicket     @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_launch_task_delivery_ticket_id")
  /// 发布账号
  channelAccount    ChannelAccount     @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, map: "fk_launch_task_channel_account_id")
  launchSubmissions LaunchSubmission[]
  patrolTasks       PatrolTask[]
  takedownTasks     TakedownTask[]

  @@unique([orderItemId, channelAccountId], map: "uq_launch_task_order_item_id_channel_account_id")
  @@index([reviewStatus], map: "ix_launch_task_review_status")
  @@index([channelAccountId], map: "ix_launch_task_channel_account_id")
  @@index([storeId, reviewStatus], map: "ix_launch_task_store_id_review_status")
  @@map("launch_task")
}

/// 链接回填：上线任务每次回填一行，与核验审批单一对一（kind = launch_link）
model LaunchSubmission {
  /// 主键，UUID v7，应用生成
  id                         String   @id(map: "pk_launch_submission") @db.Uuid
  /// 所属主体，创建时从上线任务复制，不可变
  entityId                   String   @map("entity_id") @db.Uuid
  /// 所属门店，创建时从上线任务复制，不可变
  storeId                    String   @map("store_id") @db.Uuid
  /// 上线任务
  launchTaskId               String   @map("launch_task_id") @db.Uuid
  /// 该上线任务的第几轮回填，从 1 递增
  roundNo                    Int      @map("round_no")
  /// 链接形态：collection（合集链接）/ episodes（逐集链接）
  linkKind                   String   @map("link_kind")
  /// 合集链接；只接受 https，长度不超过 2000
  collectionUrl              String?  @map("collection_url")
  /// 逐集链接 [{ episodeNo, url }]，结构见文档第 4 节
  episodeUrls                Json?    @map("episode_urls")
  /// 本次声明已发布的集数（累计）
  reportedEpisodeCount       Int      @map("reported_episode_count")
  /// 商家填报的实际上线日期（首批发布日期）
  actualLaunchDate           DateTime @map("actual_launch_date") @db.Date
  /// 提交人类型：merchant / staff / system / partner
  submitActorType            String   @map("submit_actor_type")
  /// 提交人 id；system 时为空
  /// 不建外键：操作人多态
  submitActorId              String?  @map("submit_actor_id") @db.Uuid
  /// 提交的客户端来源：weapp / portal / admin；系统动作为空
  submitClient               String?  @map("submit_client")
  /// 回填时间
  submittedAt                DateTime @map("submitted_at") @db.Timestamptz(3)
  /// 对应的核验审批单，一对一
  approvalRequestId          String   @unique(map: "uq_launch_submission_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 本轮结果：pending / passed / passed_partial / returned / revoked / withdrawn
  result                     String   @default("pending")
  /// 本轮核验通过的集数（累计）；通过时写入
  verifiedEpisodeCount       Int?     @map("verified_episode_count")
  /// 链接核验截图（file_object 的 id，分类 evidence），选填
  /// 不建外键：数组列，经 file_ref 登记
  evidenceFileIds            String[] @default([]) @map("evidence_file_ids") @db.Uuid
  /// 撤销核验通过后重开的行指向被撤销的那一行；商家回填的行为空
  reopenOfLaunchSubmissionId String?  @unique(map: "uq_launch_submission_reopen_of_launch_submission_id") @map("reopen_of_launch_submission_id") @db.Uuid
  /// 创建时间
  createdAt                  DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                  DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_launch_submission_entity_id")
  /// 所属门店
  store           Store             @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_launch_submission_store_entity")
  /// 上线任务
  launchTask      LaunchTask        @relation(fields: [launchTaskId], references: [id], onDelete: Restrict, map: "fk_launch_submission_launch_task_id")
  /// 核验审批单
  approvalRequest ApprovalRequest   @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_launch_submission_approval_request_id")
  /// 被撤销的那一行
  reopenOf        LaunchSubmission? @relation("LaunchSubmissionReopenOf", fields: [reopenOfLaunchSubmissionId], references: [id], onDelete: Restrict, map: "fk_launch_submission_reopen_of_launch_submission_id")
  /// 反向：撤销后重开的那一行（自引用的另一侧，不是列）
  reopenedAs      LaunchSubmission? @relation("LaunchSubmissionReopenOf")

  @@unique([launchTaskId, roundNo], map: "uq_launch_submission_launch_task_id_round_no")
  @@map("launch_submission")
}

/// 每周巡检抽查批次：一周一行，按周幂等
model PatrolBatch {
  /// 主键，UUID v7，应用生成
  id            String       @id(map: "pk_patrol_batch") @db.Uuid
  /// 周起始日（周一，按 Asia/Shanghai 取日）
  weekStartDate DateTime     @unique(map: "uq_patrol_batch_week_start_date") @map("week_start_date") @db.Date
  /// 生成抽查名单时已上线的上线任务总数
  liveTotal     Int          @default(0) @map("live_total")
  /// 本批每周抽样生成的巡检任务数
  sampledCount  Int          @default(0) @map("sampled_count")
  /// 每周抽查名单的生成时间；空 = 尚未生成（批次行因手动巡检先建）
  generatedAt   DateTime?    @map("generated_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt     DateTime     @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt     DateTime     @map("updated_at") @db.Timestamptz(3)
  patrolTasks   PatrolTask[]

  @@map("patrol_batch")
}

/// 巡检任务：挂在当周批次上的“上线任务”巡检，记录清单结果、异常类型、通知与恢复
model PatrolTask {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_patrol_task") @db.Uuid
  /// 所属主体，创建时从上线任务复制，不可变
  entityId           String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从上线任务复制，不可变
  storeId            String    @map("store_id") @db.Uuid
  /// 巡检批次
  patrolBatchId      String    @map("patrol_batch_id") @db.Uuid
  /// 上线任务（订单项 × 账号）
  launchTaskId       String    @map("launch_task_id") @db.Uuid
  /// 所属交付工单，不可变；处理人读取时取该工单的发布专员
  deliveryTicketId   String    @map("delivery_ticket_id") @db.Uuid
  /// 订单项，创建时从上线任务复制
  orderItemId        String    @map("order_item_id") @db.Uuid
  /// 来源：weekly_sample / manual / reissue
  source             String
  /// 状态：pending / normal / abnormal / recovered / void
  status             String
  /// 清单模板编码，固定为 patrol.check；给出结论时写入
  /// 不建外键：按值引用 checklist_template (code, version_no)（M56）
  checklistCode      String?   @map("checklist_code")
  /// 清单模板版本号（checklist_template.version_no）
  checklistVersionNo Int?      @map("checklist_version_no")
  /// 清单结果 [{ key, result, note }]，结构见文档第 4 节
  results            Json?
  /// 异常类型，字典 patrol_issue 的编码
  abnormalKindCode   String?   @map("abnormal_kind_code")
  /// 异常说明；发现异常时必填
  note               String?
  /// 巡检截图（file_object 的 id，分类 evidence）；给出结论（正常、异常、已恢复）时至少 1 张
  /// 不建外键：数组列，经 file_ref 登记
  evidenceFileIds    String[]  @default([]) @map("evidence_file_ids") @db.Uuid
  /// 最近一次给出巡检结论（正常、异常、已恢复）的时间
  checkedAt          DateTime? @map("checked_at") @db.Timestamptz(3)
  /// 最近一次给出巡检结论的员工
  checkedByStaffId   String?   @map("checked_by_staff_id") @db.Uuid
  /// 发现异常的时间
  foundAt            DateTime? @map("found_at") @db.Timestamptz(3)
  /// 首次通知商家的时间
  notifiedAt         DateTime? @map("notified_at") @db.Timestamptz(3)
  /// 复查确认已恢复的时间
  recoveredAt        DateTime? @map("recovered_at") @db.Timestamptz(3)
  /// 再次提醒的次数
  remindCount        Int       @default(0) @map("remind_count") @db.SmallInt
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_patrol_task_entity_id")
  /// 所属门店
  store          Store          @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_patrol_task_store_entity")
  /// 巡检批次
  patrolBatch    PatrolBatch    @relation(fields: [patrolBatchId], references: [id], onDelete: Restrict, map: "fk_patrol_task_patrol_batch_id")
  /// 上线任务
  launchTask     LaunchTask     @relation(fields: [launchTaskId], references: [id], onDelete: Restrict, map: "fk_patrol_task_launch_task_id")
  /// 所属交付工单
  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_patrol_task_delivery_ticket_id")
  /// 订单项
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_patrol_task_order_item_id")
  /// 最近一次给出巡检结论的员工
  checkedByStaff Staff?         @relation(fields: [checkedByStaffId], references: [id], onDelete: Restrict, map: "fk_patrol_task_checked_by_staff_id")

  @@index([patrolBatchId, launchTaskId], map: "ix_patrol_task_patrol_batch_id_launch_task_id")
  @@index([status, deliveryTicketId], map: "ix_patrol_task_status_delivery_ticket_id")
  @@index([launchTaskId], map: "ix_patrol_task_launch_task_id")
  @@map("patrol_task")
}

/// 下架任务与核查：粒度“订单项 × 发布账号”，商家确认下架方式，发布专员按清单核查并留证据截图
model TakedownTask {
  /// 主键，UUID v7，应用生成
  id                        String    @id(map: "pk_takedown_task") @db.Uuid
  /// 所属主体，创建时从上线任务复制，不可变
  entityId                  String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从上线任务复制，不可变
  storeId                   String    @map("store_id") @db.Uuid
  /// 订单项
  orderItemId               String    @map("order_item_id") @db.Uuid
  /// 所属交付工单，不可变；处理人读取时取该工单的发布专员
  deliveryTicketId          String    @map("delivery_ticket_id") @db.Uuid
  /// 对应的上线任务
  launchTaskId              String    @map("launch_task_id") @db.Uuid
  /// 发布账号
  channelAccountId          String    @map("channel_account_id") @db.Uuid
  /// 生成原因：expiry / early_end / platform_termination / terminated_after_delivery
  triggerKind               String    @map("trigger_kind")
  /// 核查依据：live（该账号已核验上线）/ delivered_unverified（成片已交付但该账号未通过核验）
  basis                     String
  /// 使用期止日；订单项止日变更（续期、平台原因终止）时未核查的任务同步
  usageEndDate              DateTime  @map("usage_end_date") @db.Date
  /// 商家应完成下架的日期：到期类 = 止日；终止类 = 终止执行日 + 1；随止日同步
  dueDate                   DateTime  @map("due_date") @db.Date
  /// 状态：pending_merchant / merchant_confirmed / checked / void
  status                    String
  /// 商家确认的下架方式：delete / private / not_published
  merchantMethod            String?   @map("merchant_method")
  /// 商家确认时间
  merchantConfirmedAt       DateTime? @map("merchant_confirmed_at") @db.Timestamptz(3)
  /// 确认下架的商家用户（老板）
  merchantConfirmedByUserId String?   @map("merchant_confirmed_by_user_id") @db.Uuid
  /// 核查时限；商家确认时算出
  checkDueAt                DateTime? @map("check_due_at") @db.Timestamptz(3)
  /// 核查时限的参数快照（策略 takedown.check），结构见文档第 4 节
  slaSnapshot               Json?     @map("sla_snapshot")
  /// 抽查仍在线的次数
  stillOnlineCount          Int       @default(0) @map("still_online_count") @db.SmallInt
  /// 最近一次升级交付主管的时间
  escalatedAt               DateTime? @map("escalated_at") @db.Timestamptz(3)
  /// 违约提醒的次数
  breachNoticeCount         Int       @default(0) @map("breach_notice_count") @db.SmallInt
  /// 核查方式：evidence（逐条核查留证）/ sampled_out（按抽查口径未抽中、凭商家确认放行）；核查完成时写入
  checkMethod               String?   @map("check_method")
  /// 清单模板编码：takedown.check / takedown.absence_check；逐条核查时写入
  /// 不建外键：按值引用 checklist_template (code, version_no)（M56）
  checklistCode             String?   @map("checklist_code")
  /// 清单模板版本号（checklist_template.version_no）
  checklistVersionNo        Int?      @map("checklist_version_no")
  /// 清单结果 [{ key, result, note }]，结构见文档第 4 节
  results                   Json?
  /// 证据截图（file_object 的 id，分类 evidence）；逐条核查时至少 2 张，保存不少于 3 年
  /// 不建外键：数组列，经 file_ref 登记
  evidenceFileIds           String[]  @default([]) @map("evidence_file_ids") @db.Uuid
  /// 核查人（发布专员）；按抽查口径放行的为空
  checkedByStaffId          String?   @map("checked_by_staff_id") @db.Uuid
  /// 核查完成时间（逐条核查通过或按抽查放行）
  checkedAt                 DateTime? @map("checked_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt                 DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                 DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                  Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_takedown_task_entity_id")
  /// 所属门店
  store                   Store          @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_takedown_task_store_entity")
  /// 订单项
  orderItem               OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_takedown_task_order_item_id")
  /// 所属交付工单
  deliveryTicket          DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_takedown_task_delivery_ticket_id")
  /// 对应的上线任务
  launchTask              LaunchTask     @relation(fields: [launchTaskId], references: [id], onDelete: Restrict, map: "fk_takedown_task_launch_task_id")
  /// 发布账号
  channelAccount          ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, map: "fk_takedown_task_channel_account_id")
  /// 确认下架的商家用户
  merchantConfirmedByUser MerchantUser?  @relation(fields: [merchantConfirmedByUserId], references: [id], onDelete: Restrict, map: "fk_takedown_task_merchant_confirmed_by_user_id")
  /// 核查人
  checkedByStaff          Staff?         @relation(fields: [checkedByStaffId], references: [id], onDelete: Restrict, map: "fk_takedown_task_checked_by_staff_id")

  @@index([status, dueDate], map: "ix_takedown_task_status_due_date")
  @@index([storeId, status], map: "ix_takedown_task_store_id_status")
  @@index([launchTaskId], map: "ix_takedown_task_launch_task_id")
  @@index([channelAccountId, status], map: "ix_takedown_task_channel_account_id_status")
  @@map("takedown_task")
}

// ===== 12-support =====
// 分组 12-support：客服工单（support 模块，L3，3 张表）
// 只含本分组的 model；CHECK、数组列的 NOT NULL、部分索引与部分唯一索引、触发器见 dm/sql/12-support.sql
// 全部外键（含 M47 的门店归属复合外键、条目指向工单的三列复合外键）都在本片段里

/// 客服工单（KF…）：商家在小程序提交或客服在后台登记的售后问题，带负责人、状态与三类时限
model ServiceTicket {
  /// 主键，UUID v7，应用生成
  id                  String    @id(map: "pk_service_ticket") @db.Uuid
  /// 工单号：KF + yyyymmdd + 3 位日流水，当日超过 999 自动扩位；由 biz_sequence 在事务内取号
  ticketNo            String    @unique(map: "uq_service_ticket_ticket_no") @map("ticket_no")
  /// 所属主体 → entity.id；创建时从门店复制，不可改
  entityId            String    @map("entity_id") @db.Uuid
  /// 所属门店 → store (id, entity_id) 复合外键；不可改
  storeId             String    @map("store_id") @db.Uuid
  /// 来源：weapp 商家在小程序提交；online_chat 客服按在线客服会话登记；phone 客服按来电登记
  source              String
  /// 提出问题的商家用户 → merchant_user.id；小程序提交必填，后台登记可空
  submitterUserId     String?   @map("submitter_user_id") @db.Uuid
  /// 后台登记人 → staff.id；小程序提交为空
  registeredByStaffId String?   @map("registered_by_staff_id") @db.Uuid
  /// 问题类型：字典 ticket_type 的编码（K01…），两端同一份字典
  /// 不建外键：字典编码按值引用，由不变量校验存在
  typeCode            String    @map("type_code")
  /// 优先级：high 高；mid 中；low 低。小程序提交取字典项的默认优先级，员工可改
  priority            String
  /// 问题描述（不超过 500 字，契约层校验）；提交后不可改
  description         String
  /// 问题图片（file_object 的 id，类别 ticket_attachment），至多 9 张；提交后不可改
  /// 不建外键：有序小集合，经 file_ref 登记（ref_type = service_ticket，角色 image）
  imageFileIds        String[]  @default([]) @map("image_file_ids") @db.Uuid
  /// 联系电话密文（AES-256-GCM）
  contactPhoneEnc     String?   @map("contact_phone_enc")
  /// 联系电话脱敏串，如 138****5678
  contactPhoneMask    String?   @map("contact_phone_mask")
  /// 当前负责人（客服或交付经理）→ staff.id；没有当班客服时为空，进入客服主管待办
  ownerStaffId        String?   @map("owner_staff_id") @db.Uuid
  /// 状态：pending 待受理；processing 处理中；awaiting_confirm 待商家确认；resolved 已解决；closed 已关闭
  status              String
  /// 关闭原因（M55 系统枚举）：duplicate 重复工单；invalid 无效工单；withdrawn 商家撤回
  closeReason         String?   @map("close_reason")
  /// 商家自己撤回时选的原因：字典 ticket_withdraw_reason 的编码；仅 close_reason = withdrawn 时有值
  /// 不建外键：字典编码按值引用，由不变量校验存在
  withdrawReasonCode  String?   @map("withdraw_reason_code")
  /// 关闭说明（不超过 200 字）；员工关闭必填
  closeNote           String?   @map("close_note")
  /// 关闭时间；人工纠偏重新打开时清空
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 当前一轮的响应截止时间：小程序提交与重新打开时写入，负责人回复商家或工单结束后清空
  responseDueAt       DateTime? @map("response_due_at") @db.Timestamptz(3)
  /// 首次回复商家的时间（待受理 → 处理中时写入，只写一次）
  firstResponseAt     DateTime? @map("first_response_at") @db.Timestamptz(3)
  /// 给出处理方案的截止时间：创建时刻 + 24 自然小时；两种来源都在创建时写入
  solutionDueAt       DateTime  @map("solution_due_at") @db.Timestamptz(3)
  /// 首次给出处理方案的时间：勾选“此回复为处理方案”的回复或提交处理结果，取较早者
  solutionAt          DateTime? @map("solution_at") @db.Timestamptz(3)
  /// 最近一次进入待商家确认的时间
  awaitingConfirmAt   DateTime? @map("awaiting_confirm_at") @db.Timestamptz(3)
  /// 自动解决时间：进入待商家确认 + 3 个自然日；只在待商家确认期间有值
  autoResolveAt       DateTime? @map("auto_resolve_at") @db.Timestamptz(3)
  /// 解决时间；重新打开时清空
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// 解决方式：merchant 商家确认；auto 到期未确认自动解决
  resolvedVia         String?   @map("resolved_via")
  /// 商家重新打开的次数
  reopenedCount       Int       @default(0) @map("reopened_count") @db.SmallInt
  /// 最近一次响应超时升级至客服主管的时间
  escalatedAt         DateTime? @map("escalated_at") @db.Timestamptz(3)
  /// 时限参数快照 ServiceTicketSlaSnapshot：response、solution、autoResolve 三段
  slaSnapshot         Json      @map("sla_snapshot")
  /// 乐观锁版本号
  lockVersion         Int       @default(0) @map("lock_version")
  /// 创建时间（提交或登记时刻）
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity               Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_service_ticket_entity_id")
  /// 所属门店；复合外键同时保证门店属于 entity_id 所指主体（M47）
  store                Store                @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_service_ticket_store_entity")
  /// 提出问题的商家用户
  submitterUser        MerchantUser?        @relation(fields: [submitterUserId], references: [id], onDelete: Restrict, map: "fk_service_ticket_submitter_user_id")
  /// 当前负责人
  ownerStaff           Staff?               @relation("ServiceTicketOwnerStaff", fields: [ownerStaffId], references: [id], onDelete: Restrict, map: "fk_service_ticket_owner_staff_id")
  /// 后台登记人
  registeredByStaff    Staff?               @relation("ServiceTicketRegisteredByStaff", fields: [registeredByStaffId], references: [id], onDelete: Restrict, map: "fk_service_ticket_registered_by_staff_id")
  serviceTicketEntries ServiceTicketEntry[]
  serviceTicketRefs    ServiceTicketRef[]

  @@unique([id, entityId, storeId], map: "uq_service_ticket_id_entity_id_store_id")
  @@index([storeId, createdAt(sort: Desc)], map: "ix_service_ticket_store_id_created_at")
  @@index([ownerStaffId, status], map: "ix_service_ticket_owner_staff_id_status")
  @@index([status, createdAt(sort: Desc)], map: "ix_service_ticket_status_created_at")
  @@map("service_ticket")
}

/// 客服工单会话时间线：商家消息、员工回复、内部备注、系统事件；写入后不改
model ServiceTicketEntry {
  /// 主键，UUID v7，应用生成；同一工单内按 created_at、id 排序
  id                  String   @id(map: "pk_service_ticket_entry") @db.Uuid
  /// 所属工单 → service_ticket.id
  serviceTicketId     String   @map("service_ticket_id") @db.Uuid
  /// 所属主体 → entity.id；创建时从工单复制
  entityId            String   @map("entity_id") @db.Uuid
  /// 所属门店 → store (id, entity_id) 复合外键；创建时从工单复制
  storeId             String   @map("store_id") @db.Uuid
  /// 条目类型：merchant_message 商家消息；staff_reply 回复商家；internal_note 内部备注；system_event 系统事件
  kind                String
  /// 标签：submit 提交工单；supplement 补充说明；reopen 重新打开；reply 回复；solution 处理方案；result 处理结果；transfer 分配与转派；status 状态变更；biz_event 关联业务事件
  tag                 String?
  /// 操作人类型：merchant / staff / system / partner（V1.0 只声明）
  actorType           String   @map("actor_type")
  /// 操作人 id（merchant_user.id 或 staff.id）；system 时为空
  /// 不建外键：操作人多态
  actorId             String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空
  client              String?
  /// 正文（不超过 500 字）；系统事件为后台看到的文案
  body                String?
  /// 系统事件面向商家的文案；为空时商家端显示 body
  merchantBody        String?  @map("merchant_body")
  /// 图片（file_object 的 id，类别 ticket_attachment），至多 9 张
  /// 不建外键：有序小集合，经 file_ref 登记（ref_type = service_ticket_entry，角色 image）
  imageFileIds        String[] @default([]) @map("image_file_ids") @db.Uuid
  /// 深链 ServiceTicketEntryLink：{ route, params, label? }，路由表与站内消息共用
  link                Json?
  /// 商家是否可见；内部备注恒为 false，商家消息与回复恒为 true
  isVisibleToMerchant Boolean  @default(false) @map("is_visible_to_merchant")
  /// 是否计为“处理方案”：勾选了“此回复为处理方案”的回复，或处理结果
  isSolution          Boolean  @default(false) @map("is_solution")
  /// 来源出站事件 outbox_event.id：只有关联业务事件条目（tag = biz_event）有值，同一工单内唯一
  /// 不建外键：只为去重与排障留 id；出站事件只在 V1.0 不清理（M65）
  outboxEventId       String?  @map("outbox_event_id") @db.Uuid
  /// 条目时间：业务事件条目取源事件的 occurred_at，其余取写入时刻；时间线按它排序
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)

  /// 所属工单；复合外键同时保证条目的归属列与工单一致
  serviceTicket ServiceTicket @relation(fields: [serviceTicketId, entityId, storeId], references: [id, entityId, storeId], onDelete: Restrict, map: "fk_service_ticket_entry_service_ticket_id")
  /// 所属主体
  entity        Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_service_ticket_entry_entity_id")
  /// 所属门店；复合外键同时保证门店属于 entity_id 所指主体（M47）
  store         Store         @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_service_ticket_entry_store_entity")

  @@index([serviceTicketId, createdAt], map: "ix_service_ticket_entry_service_ticket_id_created_at")
  @@map("service_ticket_entry")
}

/// 客服工单关联的业务对象：订购单、付款单、交付工单、广告、审批单；行只增删不改，关联错的行可物理删除（M95）
model ServiceTicketRef {
  /// 所属工单 → service_ticket.id
  serviceTicketId String   @map("service_ticket_id") @db.Uuid
  /// 业务对象类型（最终表名）：drama_order / billing_order / delivery_ticket / ad / approval_request
  refType         String   @map("ref_type")
  /// 业务对象 id
  /// 不建外键：按 ref_type 多态；审批单在 L1、付款单在 L2，同层的订购、交付、广告不在同步调用白名单
  refId           String   @map("ref_id") @db.Uuid
  /// 建立关联的时间
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)

  /// 所属工单
  serviceTicket ServiceTicket @relation(fields: [serviceTicketId], references: [id], onDelete: Restrict, map: "fk_service_ticket_ref_service_ticket_id")

  @@id([serviceTicketId, refType, refId], map: "pk_service_ticket_ref")
  @@index([refType, refId], map: "ix_service_ticket_ref_ref_type_ref_id")
  @@map("service_ticket_ref")
}

// ===== 13-notify-docs =====
// 分组 13-notify-docs：通知与人工催办限频、协议、同意记录、授权书
// 模块：notify（9 张）、docs（5 张），都在 L1
// 14 张表：notify_scene、wx_template_slot、sms_template、notification、notification_delivery、
//          merchant_message、staff_message、wx_subscribe_quota、manual_reminder_log、
//          agreement、agreement_version、agreement_consent、license_letter、license_letter_revision
// 只含本分组的 model；CHECK、部分索引、部分唯一索引、触发器见 dm/sql/13-notify-docs.sql（外键全部在本片段）

/// 通知场景开关与通道绑定：场景定义在代码注册表，库里只存可切换的开关、订阅槽位与短信策略
model NotifyScene {
  /// 场景键（自然主键），与代码注册表一致，如 m.sample_pending、s.approval_pending
  sceneKey                 String   @id(map: "pk_notify_scene") @map("scene_key")
  /// 受众，冗余自注册表：merchant 商家 / staff 员工
  audience                 String
  /// 后台显示名
  name                     String
  /// 外部通道开关（画板上的启用开关）：关闭后不发订阅消息、短信、企业微信、邮件，站内消息照发
  extEnabled               Boolean  @default(true) @map("ext_enabled")
  /// 场景总开关：关闭后站内也不发；仅超级管理员可改，须填原因并写审计
  sceneEnabled             Boolean  @default(true) @map("scene_enabled")
  /// 订阅消息槽位 → wx_template_slot.slot_key；空 = 不发订阅消息
  wxTemplateSlotKey        String?  @map("wx_template_slot_key")
  /// 短信策略：never 不发 / fallback 订阅未送达才补发 / always 总是发
  smsPolicy                String   @default("never") @map("sms_policy")
  /// 短信模板 → sms_template.template_key
  smsTemplateKey           String?  @map("sms_template_key")
  /// 允许发短信的节点（字符串数组，如 ["T-1"]、["R1"]）；空 = 全部节点
  smsNodes                 Json?    @map("sms_nodes")
  /// 发送时段：immediate 立即 / window 08:00–21:00 之外顺延 / scheduled 由提醒规则定时派生
  sendWindow               String   @map("send_window")
  /// 订阅消息与短信均未送达时，是否转交付经理人工跟进（派发 s.merchant_unreached）
  managerEscalationEnabled Boolean  @default(false) @map("manager_escalation_enabled")
  /// 合并窗口（秒）：大于 0 时同一接收人同一场景在窗口内的外部通道只保留第一条，站内照发
  collapseWindowSec        Int      @default(0) @map("collapse_window_sec")
  /// 乐观锁；后台改开关时带 expectedVersion
  lockVersion              Int      @default(0) @map("lock_version")
  /// 最近修改人（员工）→ staff.id；迁移播种后未改过为空
  updatedByStaffId         String?  @map("updated_by_staff_id") @db.Uuid
  /// 创建时间（播种时间）
  createdAt                DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                DateTime @map("updated_at") @db.Timestamptz(3)

  /// 订阅消息槽位
  wxTemplateSlot WxTemplateSlot? @relation(fields: [wxTemplateSlotKey], references: [slotKey], onDelete: Restrict, map: "fk_notify_scene_wx_template_slot_key")
  /// 短信模板
  smsTemplate    SmsTemplate?    @relation(fields: [smsTemplateKey], references: [templateKey], onDelete: Restrict, map: "fk_notify_scene_sms_template_key")
  /// 最近修改人
  updatedByStaff Staff?          @relation(fields: [updatedByStaffId], references: [id], onDelete: Restrict, map: "fk_notify_scene_updated_by_staff_id")
  notifications  Notification[]
  notificationFanouts NotificationFanout[]

  @@index([wxTemplateSlotKey], map: "ix_notify_scene_wx_template_slot_key")
  @@index([smsTemplateKey], map: "ix_notify_scene_sms_template_key")
  @@map("notify_scene")
}

/// 微信订阅消息模板槽位：槽位键 → 模板 ID 与字段定义，每个环境各自配置，与场景解耦
model WxTemplateSlot {
  /// 槽位键（自然主键），如 service_progress、svc_expiry
  slotKey            String             @id(map: "pk_wx_template_slot") @map("slot_key")
  /// 模板标题；同一次授权调用里标题不能重复
  title              String
  /// 微信侧模板 ID；空 = 未配置，全链路不发
  providerTemplateId String?            @map("provider_template_id")
  /// 模板字段定义数组 [{name, type, label}]，与微信后台逐字一致
  fields             Json
  /// 槽位状态：active 可用 / unconfigured 未配置 / disabled 已停用
  status             String
  /// 字段类错误（47003）连续失败的通知数；任一次成功清零
  failStreak         Int                @default(0) @map("fail_streak")
  /// 停用原因：template_invalid 模板不存在或已删除 / field_mismatch_streak 字段错误连续超限 / manual 人工停用
  disabledReason     String?            @map("disabled_reason")
  /// 创建时间（播种时间）
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(3)
  notifyScenes       NotifyScene[]
  wxSubscribeQuotas  WxSubscribeQuota[]

  @@map("wx_template_slot")
}

/// 短信模板登记：模板键 → 服务商模板 ID、签名、变量定义、保活与失效探测状态
model SmsTemplate {
  /// 模板键（自然主键），如 verify_code、launch_remind
  templateKey            String                 @id(map: "pk_sms_template") @map("template_key")
  /// 类型：verify 验证码类（不受发送时段限制）/ notice 通知类
  kind                   String
  /// 服务商侧模板 ID；空 = 未配置
  providerTemplateId     String?                @map("provider_template_id")
  /// 短信签名，按环境配置；空 = 未配置
  signName               String?                @map("sign_name")
  /// 有序变量定义数组 [{name, maxLen}]
  params                 Json
  /// 模板状态：active / pending_carrier 运营商报备中 / unconfigured 未配置 / suspect 疑似失效 / disabled 已停用
  status                 String
  /// 最近一次发送成功的时间；保活与失效探测用
  lastOkAt               DateTime?              @map("last_ok_at") @db.Timestamptz(3)
  /// 创建时间（播种时间）
  createdAt              DateTime               @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt              DateTime               @map("updated_at") @db.Timestamptz(3)
  notifyScenes           NotifyScene[]
  notificationDeliveries NotificationDelivery[]

  @@map("sms_template")
}

/// 通知：一次“场景 × 业务对象 × 节点 × 接收人”，带去重键，是所有派发的幂等锚点
model Notification {
  /// 主键，UUID v7，应用生成
  id                  String   @id(map: "pk_notification") @db.Uuid
  /// 场景 → notify_scene.scene_key
  notifySceneKey      String   @map("notify_scene_key")
  /// 去重键：{场景业务键}:{节点}:{接收人}；重复事件、规则重扫都靠它幂等
  dedupeKey           String   @unique(map: "uq_notification_dedupe_key") @map("dedupe_key")
  /// 触发它的出站事件 → outbox_event.id；规则派生的为空（人工催办经 manual_reminder_log 的事件派发，带事件 id）
  /// 不建外键：catalogue 的 cross_module_fks 定为只存 id；事件行 V1.0 不清理（M65），将来定了保留期也不应被通知挡住
  sourceOutboxEventId String?  @map("source_outbox_event_id") @db.Uuid
  /// 提醒规则键（如 R2.launch）；非规则派生的为空
  sourceRule          String?  @map("source_rule")
  /// 业务对象类型，取最终表名（如 sample、billing_order）；没有业务对象的为空
  bizType             String?  @map("biz_type")
  /// 业务对象 id；按 biz_type 多态
  /// 不建外键：多态引用，指向各层的业务表
  bizId               String?  @map("biz_id") @db.Uuid
  /// 节点：N0 首发 / R1 催办 / T-7、T-1、T-0 日期型 / M 人工 / C 任务生成
  node                String   @default("N0")
  /// 接收的商家用户 → merchant_user.id；与 staff_id 恰有一个非空
  merchantUserId      String?  @map("merchant_user_id") @db.Uuid
  /// 接收的员工 → staff.id；与 merchant_user_id 恰有一个非空
  staffId             String?  @map("staff_id") @db.Uuid
  /// 所属主体 → entity.id；平台级通知与账号级通知（新微信登录、换绑手机号）为空
  entityId            String?  @map("entity_id") @db.Uuid
  /// 所属门店 → store.id；主体级、账号级或平台级通知为空
  storeId             String?  @map("store_id") @db.Uuid
  /// 场景 load() 读出的渲染变量；不放手机号、证照号、验证码
  vars                Json
  /// 派发时的购买入口模式：in_app / offline_contract / hidden；按主体计算，员工场景与账号级通知为空
  copyMode            String?  @map("copy_mode")
  /// 创建时间（派发时间）
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)

  /// 场景
  notifyScene            NotifyScene            @relation(fields: [notifySceneKey], references: [sceneKey], onDelete: Restrict, map: "fk_notification_notify_scene_key")
  /// 接收的商家用户
  merchantUser           MerchantUser?          @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_notification_merchant_user_id")
  /// 接收的员工
  staff                  Staff?                 @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_notification_staff_id")
  /// 所属主体
  entity                 Entity?                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_notification_entity_id")
  /// 所属门店；复合外键保证门店属于该主体（store_id 为空时不检查）
  store                  Store?                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_notification_store_entity")
  notificationDeliveries NotificationDelivery[]
  merchantMessage        MerchantMessage?
  staffMessage           StaffMessage?

  @@index([notifySceneKey, createdAt], map: "ix_notification_notify_scene_key_created_at")
  @@index([bizType, bizId], map: "ix_notification_biz_type_biz_id")
  @@index([merchantUserId, createdAt], map: "ix_notification_merchant_user_id_created_at")
  @@index([staffId, createdAt], map: "ix_notification_staff_id_created_at")
  @@index([entityId], map: "ix_notification_entity_id")
  @@index([storeId], map: "ix_notification_store_id")
  @@map("notification")
}

/// 公告通知的持久化分页任务，notify L1；仅进度 CAS，不写业务状态历史。
model NotificationFanout {
  id                   String    @id(map: "pk_notification_fanout") @db.Uuid
  /// 只存事件 id；与 notification.sourceOutboxEventId 相同，不引用保留期未定的 outbox。
  sourceOutboxEventId   String    @map("source_outbox_event_id") @db.Uuid
  notifySceneKey       String    @map("notify_scene_key")
  siteNoticeId         String    @map("site_notice_id") @db.Uuid
  /// (merchant_user_id, entity_id) 有序二元 keyset；只是进度，不是接收人外键。
  cursorMerchantUserId String?   @map("cursor_merchant_user_id") @db.Uuid
  cursorEntityId       String?   @map("cursor_entity_id") @db.Uuid
  status               String    @default("pending")
  dueAt                DateTime  @map("due_at") @db.Timestamptz(3)
  attemptNo            Int       @default(0) @map("attempt_no")
  leaseUntil           DateTime? @map("lease_until") @db.Timestamptz(3)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  notifyScene NotifyScene @relation(fields: [notifySceneKey], references: [sceneKey], onDelete: Restrict, map: "fk_notification_fanout_notify_scene_key")
  siteNotice  SiteNotice  @relation(fields: [siteNoticeId], references: [id], onDelete: Restrict, map: "fk_notification_fanout_site_notice_id")

  @@unique([notifySceneKey, siteNoticeId], map: "uq_notification_fanout_scene_notice")
  @@index([siteNoticeId], map: "ix_notification_fanout_site_notice_id")
  @@map("notification_fanout")
}

/// 投递：通知在某个通道上的一次发送；同时是到期任务、发送日志与成功率数据源；验证码等直发也借用本表
model NotificationDelivery {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_notification_delivery") @db.Uuid
  /// 所属通知 → notification.id；直发投递为空
  notificationId     String?   @map("notification_id") @db.Uuid
  /// 是否直发（验证码、激活码、账号安全通知、值班告警、保活、测试发送）；与 notification_id 为空等价
  isDirect           Boolean   @default(false) @map("is_direct")
  /// 通道：inbox 站内 / wx_subscribe 订阅消息 / sms 短信 / wecom 企业微信应用消息 / mail 邮件
  channel            String
  /// 重发序号：自动产生的投递为 0（一个通知在一个通道上至多一条），人工重发为上一条 + 1
  resendNo           Int       @default(0) @map("resend_no") @db.SmallInt
  /// 来源：primary 首发 / fallback 补发 / manual 人工重发 / direct 直发
  origin             String
  /// 投递状态（技术状态，不写状态历史）：pending / sending / sent / failed / skipped / cancelled
  status             String
  /// 终态非成功的原因；只在 failed、skipped、cancelled 时有值，取值见文档
  reason             String?
  /// 到期时间（已按发送时段顺延）
  dueAt              DateTime  @map("due_at") @db.Timestamptz(3)
  /// 认领序号：每次认领加 1；所有结果落库都以它为条件
  attemptNo          Int       @default(0) @map("attempt_no") @db.SmallInt
  /// 最多认领次数
  maxAttempts        Int       @default(3) @map("max_attempts") @db.SmallInt
  /// sending 的租约到期时间
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz(3)
  /// 发起外部调用前写入；租约回收据此区分“没调过”与“调了没结果”
  callStartedAt      DateTime? @map("call_started_at") @db.Timestamptz(3)
  /// 投递目标的引用：微信身份 id / 手机号 HMAC / 企业微信 userid / 邮箱 HMAC（测试发送的订阅消息存 openid 的 HMAC）；明文不落本表
  targetRef          String?   @map("target_ref")
  /// 脱敏后的目标（138****5678、a***@x.com），发送日志页展示
  targetMasked       String?   @map("target_masked")
  /// 直发用途：verify_code / staff_activation / account_notice / ops_alert / keepalive / test
  purpose            String?
  /// 直发的幂等键（调用方重试时用，如 sms_verification:{id}、staff_act:{activationId}）
  directKey          String?   @unique(map: "uq_notification_delivery_direct_key") @map("direct_key")
  /// 短信模板 → sms_template.template_key；短信通道必填，其他通道为空
  smsTemplateKey     String?   @map("sms_template_key")
  /// 发送时使用的服务商模板 ID 快照
  providerTemplateId String?   @map("provider_template_id")
  /// 服务商返回的消息 id；回执与下发结果事件按它回写
  providerMsgId      String?   @map("provider_msg_id")
  /// 通道错误码（发送调用的同步结果）
  errorCode          String?   @map("error_code")
  /// 通道错误信息
  errorMsg           String?   @map("error_msg")
  /// 异步回执的最终结果码（短信：SUCCESS 或 errCode；订阅消息下发结果事件：errorCode）；只追加写，不改变状态机
  receiptStatus      String?   @map("receipt_status")
  /// 回执上报时间（短信取 reportedAt；订阅消息事件取 webhook_event 的接收时间）
  receiptReportedAt  DateTime? @map("receipt_reported_at") @db.Timestamptz(3)
  /// 通道返回成功的时间
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(3)
  /// 进入终态的时间
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属通知
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Restrict, map: "fk_notification_delivery_notification_id")
  /// 短信模板
  smsTemplate  SmsTemplate?  @relation(fields: [smsTemplateKey], references: [templateKey], onDelete: Restrict, map: "fk_notification_delivery_sms_template_key")

  @@unique([notificationId, channel, resendNo], map: "uq_notification_delivery_notification_channel_resend")
  @@index([channel, createdAt], map: "ix_notification_delivery_channel_created_at")
  @@index([targetRef, channel, createdAt], map: "ix_notification_delivery_target_ref_channel_created_at")
  @@index([smsTemplateKey, createdAt], map: "ix_notification_delivery_sms_template_key_created_at")
  @@map("notification_delivery")
}

/// 商家端站内消息：收件箱行，与通知一对一，派发时同事务写入
model MerchantMessage {
  /// 主键，UUID v7，应用生成；按时间有序，列表游标与 read-all 的 upToId 用它
  id             String    @id(map: "pk_merchant_message") @db.Uuid
  /// 所属通知 → notification.id；一对一
  notificationId String    @unique(map: "uq_merchant_message_notification_id") @map("notification_id") @db.Uuid
  /// 收件人 → merchant_user.id
  merchantUserId String    @map("merchant_user_id") @db.Uuid
  /// 所属主体 → entity.id；空 = 账号级消息（新微信登录、换绑手机号），在任何主体下都可见
  entityId       String?   @map("entity_id") @db.Uuid
  /// 所属门店 → store.id；空 = 主体级或账号级消息（套餐、积分、发票等）
  storeId        String?   @map("store_id") @db.Uuid
  /// 是否只有当前老板可读；取自场景的 ownerOnly，读取时再校验当前角色
  isOwnerOnly    Boolean   @default(false) @map("is_owner_only")
  /// 站内分类：order / delivery / launch / plan_points / review / store / service / system
  category       String
  /// 标题：按接收人角色与购买模式渲染后的成品文案
  title          String
  /// 正文：成品文案；店员版本不含积分与金额
  body           String
  /// 按钮文案
  ctaText        String?   @map("cta_text")
  /// 深链 {route, params}，结构见文档第 4 节
  link           Json
  /// 已读时间；空 = 未读
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间（标记已读时写入）
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属通知
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict, map: "fk_merchant_message_notification_id")
  /// 收件人
  merchantUser MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_merchant_message_merchant_user_id")
  /// 所属主体
  entity       Entity?      @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_merchant_message_entity_id")
  /// 所属门店；复合外键保证门店属于该主体（store_id 为空时不检查）
  store        Store?       @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_merchant_message_store_entity")

  @@index([merchantUserId, entityId, id(sort: Desc)], map: "ix_merchant_message_merchant_user_id_entity_id_id")
  @@index([entityId], map: "ix_merchant_message_entity_id")
  @@index([storeId], map: "ix_merchant_message_store_id")
  @@map("merchant_message")
}

/// 后台员工站内消息（后台铃铛），与通知一对一
model StaffMessage {
  /// 主键，UUID v7，应用生成；按时间有序
  id             String    @id(map: "pk_staff_message") @db.Uuid
  /// 所属通知 → notification.id；一对一
  notificationId String    @unique(map: "uq_staff_message_notification_id") @map("notification_id") @db.Uuid
  /// 收件员工 → staff.id
  staffId        String    @map("staff_id") @db.Uuid
  /// 消息类别：todo 待办 / alert 预警 / approval 审批 / system 系统
  kind           String
  /// 标题
  title          String
  /// 正文
  body           String
  /// 后台页面链接 {route, params}，结构见文档第 4 节
  link           Json
  /// 已读时间；空 = 未读
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间（标记已读时写入）
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属通知
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict, map: "fk_staff_message_notification_id")
  /// 收件员工
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_staff_message_staff_id")

  @@index([staffId, id(sort: Desc)], map: "ix_staff_message_staff_id_id")
  @@map("staff_message")
}

/// 订阅消息额度估计值：每个微信身份 × 槽位一行；不是证据表，随微信身份级联删除
model WxSubscribeQuota {
  /// 微信身份 → wechat_identity.id；额度属于点了“允许”的那个 openid。身份行被删时级联删除（改绑也是删旧行、插新行）
  wechatIdentityId  String    @map("wechat_identity_id") @db.Uuid
  /// 槽位 → wx_template_slot.slot_key
  wxTemplateSlotKey String    @map("wx_template_slot_key")
  /// 所属商家用户 → merchant_user.id；冗余，创建时取自身份行，不可改（身份行的账号也不可改）；发送时按用户找可用额度
  merchantUserId    String    @map("merchant_user_id") @db.Uuid
  /// 估计剩余可发条数，不小于 0
  estRemaining      Int       @default(0) @map("est_remaining")
  /// 状态：ok 正常 / rejected 用户在服务通知里关闭 / banned 模板被封
  state             String    @default("ok")
  /// 最近一次授权（accept）时间
  lastAcceptAt      DateTime? @map("last_accept_at") @db.Timestamptz(3)
  /// 最近一次预留额度（发送）时间
  lastSendAt        DateTime? @map("last_send_at") @db.Timestamptz(3)
  /// 最近一次发送失败的微信错误码
  lastErrorCode     String?   @map("last_error_code")
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 微信身份
  wechatIdentity WechatIdentity @relation(fields: [wechatIdentityId], references: [id], onDelete: Cascade, map: "fk_wx_subscribe_quota_wechat_identity_id")
  /// 槽位
  wxTemplateSlot WxTemplateSlot @relation(fields: [wxTemplateSlotKey], references: [slotKey], onDelete: Restrict, map: "fk_wx_subscribe_quota_wx_template_slot_key")
  /// 所属商家用户
  merchantUser   MerchantUser   @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_wx_subscribe_quota_merchant_user_id")

  @@id([wechatIdentityId, wxTemplateSlotKey], map: "pk_wx_subscribe_quota")
  @@index([merchantUserId, wxTemplateSlotKey], map: "ix_wx_subscribe_quota_merchant_user_id_slot")
  @@index([wxTemplateSlotKey], map: "ix_wx_subscribe_quota_wx_template_slot_key")
  @@map("wx_subscribe_quota")
}

/// 人工催办限频闸：发催办通知前先插一行，同一对象同一场景每日 1 次；只增
model ManualReminderLog {
  /// 主键，UUID v7，应用生成
  id            String   @id(map: "pk_manual_reminder_log") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq           BigInt   @unique(map: "uq_manual_reminder_log_seq") @default(autoincrement())
  /// 被催办对象的类型，取最终表名：delivery_ticket / ad / order_item / takedown_task / patrol_task / subscription_term
  subjectType   String   @map("subject_type")
  /// 被催办对象 id；按 subject_type 多态
  /// 不建外键：多态引用，且指向上层（L2、L3）的表
  subjectId     String   @map("subject_id") @db.Uuid
  /// 催办场景：confirm_plan / confirm_ad / confirm_sample / golive / takedown / breach / patrol_fix / renewal
  scene         String
  /// 催办发生的业务日（Asia/Shanghai），限频按它计
  bizDate       DateTime @map("biz_date") @db.Date
  /// 发起催办的员工 → staff.id
  sentByStaffId String   @map("sent_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  /// 发起催办的员工
  sentByStaff Staff @relation(fields: [sentByStaffId], references: [id], onDelete: Restrict, map: "fk_manual_reminder_log_sent_by_staff_id")

  @@unique([subjectType, subjectId, scene, bizDate], map: "uq_manual_reminder_log_subject_scene_biz_date")
  @@index([sentByStaffId, createdAt], map: "ix_manual_reminder_log_sent_by_staff_id_created_at")
  @@map("manual_reminder_log")
}

/// 协议清单：V1.0 由迁移播种 6 份，后台不可增删
model Agreement {
  /// 协议键（自然主键）：user / privacy / member / points / custom_license / ad_service
  key               String             @id(map: "pk_agreement")
  /// 协议名称（带书名号，如《用户服务协议》）
  name              String
  /// 同意主体：user 用户（含店员）/ entity 经营主体（老板操作）/ partner 服务商（V1.0 只声明）
  subjectKind       String             @map("subject_kind")
  /// 同意方式：checkbox 勾选 / by_action 付款即同意 / esign 第三方电子签（V1.0 只声明）
  consentMode       String             @map("consent_mode")
  /// 会落同意记录的签署场景，取值同 agreement_consent.scene
  scenes            String[]           @default([])
  /// 后台“签署场景”一栏的说明文案，如“首次登录时勾选同意”
  signSceneLabel    String             @map("sign_scene_label")
  /// 后台“适用对象”一栏的说明文案，如“全部用户”
  audienceLabel     String             @map("audience_label")
  /// 起始产品版本：V1.0 / V1.1
  sinceVersion      String             @map("since_version")
  /// 列表排序号
  sortNo            Int                @map("sort_no")
  /// 创建时间（播种时间）
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime           @map("updated_at") @db.Timestamptz(3)
  agreementVersions AgreementVersion[]

  @@map("agreement")
}

/// 协议版本：Word + PDF 双文件、展示版 HTML、内容哈希、到点生效
model AgreementVersion {
  /// 主键，UUID v7，应用生成
  id                  String    @id(map: "pk_agreement_version") @db.Uuid
  /// 所属协议 → agreement.key
  agreementKey        String    @map("agreement_key")
  /// 主版本号；由超级管理员手动升
  major               Int       @db.SmallInt
  /// 次版本号；新建版本时自动加 1
  minor               Int       @db.SmallInt
  /// 版本状态（簿记，不写状态历史）：draft 草稿 / pending 待生效 / active 生效中 / superseded 已失效 / withdrawn 已撤回
  status              String
  /// 生效时间；到点生效的唯一依据。草稿可空，其余状态必有
  effectiveAt         DateTime? @map("effective_at") @db.Timestamptz(3)
  /// 变更摘要，1–60 字；草稿可空，其余状态必有。版本记录、重新同意弹窗、规则变更公告用
  summary             String?
  /// 是否需要用户重新同意；涉及权利义务或个人信息处理规则变化时开启
  isReconsentRequired Boolean   @default(true) @map("is_reconsent_required")
  /// 法务上传的 Word（展示版来源）→ file_object.id；只传 PDF 时为空
  sourceFileId        String?   @map("source_file_id") @db.Uuid
  /// 法务上传的 PDF（下载版，证据基准文件）→ file_object.id；草稿可空
  pdfFileId           String?   @map("pdf_file_id") @db.Uuid
  /// 由 Word 转出并清洗后的展示版 HTML；只传 PDF 时为空
  contentHtml         String?   @map("content_html")
  /// PDF 文件字节的 SHA-256（十六进制小写 64 位）；同意记录引用它
  contentSha256       String?   @map("content_sha256")
  /// 展示版 HTML 的 SHA-256（十六进制小写 64 位）
  htmlSha256          String?   @map("html_sha256")
  /// 操作人自证“正文已经法务审定”；为 true 才能进入待生效
  isLegalApproved     Boolean   @default(false) @map("is_legal_approved")
  /// member / points 版本的规则变更公告 → site_notice.id
  siteNoticeId        String?   @map("site_notice_id") @db.Uuid
  /// 公告期不足时填写的原因，不超过 100 字
  shortNoticeReason   String?   @map("short_notice_reason")
  /// 生效时应同意人数快照（重新同意进度条的分母）
  expectedConsents    Int?      @map("expected_consents")
  /// 新建该版本的员工 → staff.id
  createdByStaffId    String    @map("created_by_staff_id") @db.Uuid
  /// 保存为待生效的员工（画板“发布人”）→ staff.id
  publishedByStaffId  String?   @map("published_by_staff_id") @db.Uuid
  /// 簿记翻转为生效中的时间
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(3)
  /// 乐观锁；编辑草稿时带 expectedVersion
  lockVersion         Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属协议
  agreement         Agreement          @relation(fields: [agreementKey], references: [key], onDelete: Restrict, map: "fk_agreement_version_agreement_key")
  /// 下载版 PDF
  pdfFile           FileObject?        @relation("AgreementVersionPdfFile", fields: [pdfFileId], references: [id], onDelete: Restrict, map: "fk_agreement_version_pdf_file_id")
  /// Word 源文件
  sourceFile        FileObject?        @relation("AgreementVersionSourceFile", fields: [sourceFileId], references: [id], onDelete: Restrict, map: "fk_agreement_version_source_file_id")
  /// 规则变更公告
  siteNotice        SiteNotice?        @relation(fields: [siteNoticeId], references: [id], onDelete: Restrict, map: "fk_agreement_version_site_notice_id")
  /// 新建该版本的员工
  createdByStaff    Staff              @relation("AgreementVersionCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_agreement_version_created_by_staff_id")
  /// 保存为待生效的员工
  publishedByStaff  Staff?             @relation("AgreementVersionPublishedBy", fields: [publishedByStaffId], references: [id], onDelete: Restrict, map: "fk_agreement_version_published_by_staff_id")
  agreementConsents AgreementConsent[]

  // 版本号唯一是部分唯一索引（撤回的行不占号），见 SQL 的 uq_agreement_version_agreement_key_major_minor
  @@unique([id, agreementKey], map: "uq_agreement_version_id_agreement_key")
  @@index([agreementKey, effectiveAt(sort: Desc)], map: "ix_agreement_version_agreement_key_effective_at")
  @@index([pdfFileId], map: "ix_agreement_version_pdf_file_id")
  @@index([sourceFileId], map: "ix_agreement_version_source_file_id")
  @@index([siteNoticeId], map: "ix_agreement_version_site_notice_id")
  @@map("agreement_version")
}

/// 协议同意记录（证据，只增）：每次交易、登录、加入落一条，记版本、内容哈希、场景、单据、身份与设备快照
model AgreementConsent {
  /// 主键，UUID v7，应用生成
  id                 String   @id(map: "pk_agreement_consent") @db.Uuid
  /// 自增序号；对外的“同意记录编号”取它的十进制字符串
  seq                BigInt   @unique(map: "uq_agreement_consent_seq") @default(autoincrement())
  /// 协议键（冗余自版本行，与 agreement_version_id 一起做复合外键）
  agreementKey       String   @map("agreement_key")
  /// 同意的版本 → agreement_version.id
  agreementVersionId String   @map("agreement_version_id") @db.Uuid
  /// 同意时该版本 PDF 的 SHA-256（冗余，防版本行被替换）
  contentSha256      String   @map("content_sha256")
  /// 操作人 → merchant_user.id；账号注销只改状态、不删行
  merchantUserId     String   @map("merchant_user_id") @db.Uuid
  /// 当时登录的小程序 appid 快照
  appid              String?
  /// 当时登录的微信身份 openid 的 HMAC（32 字节）快照；不建到微信身份表的外键
  openidHmac         Bytes?   @map("openid_hmac")
  /// 当时的登录手机号密文；作为合同证据留存，不随注销清空
  phoneEnc           String   @map("phone_enc")
  /// 当时的登录手机号脱敏串（138****5678）
  phoneMask          String   @map("phone_mask")
  /// 当时经办人称呼的脱敏串（如 王*）；没有称呼时为空。授权书“经办人”取它与 phone_mask
  operatorNameMask   String?  @map("operator_name_mask")
  /// 当时的商家角色快照：owner 老板 / clerk 店员；尚无成员关系时为空
  role               String?
  /// 所属主体 → entity.id；主体级协议必填
  entityId           String?  @map("entity_id") @db.Uuid
  /// 当时的主体名称快照
  entityName         String?  @map("entity_name")
  /// 当时的统一社会信用代码密文快照（列名同 entity.uscc_enc）
  usccEnc            String?  @map("uscc_enc")
  /// 当时的统一社会信用代码脱敏串（列名同 entity.uscc_mask）
  usccMask           String?  @map("uscc_mask")
  /// 下单门店 → store.id
  storeId            String?  @map("store_id") @db.Uuid
  /// 签署场景：login / reconsent / member_join / plan_purchase / topup / order_submit / ad_request
  scene              String
  /// 关联单据类型，取最终表名：billing_order / drama_order / ad；无单据的同意为空
  bizType            String?  @map("biz_type")
  /// 关联单据 id
  /// 不建外键：多态引用，指向 L2、L3 的表
  bizId              String?  @map("biz_id") @db.Uuid
  /// 关联单据的业务单号快照（FK… / LYX… / GG…），由调用方传入；与 biz_id 同有同无
  bizNo              String?  @map("biz_no")
  /// 同意方式：checkbox 勾选 / by_action 付款即同意 / prior_consent 沿用此前对同一版本的同意（只用于广告需求）
  method             String
  /// 同意时间（业务时间，应用时钟）
  consentedAt        DateTime @map("consented_at") @db.Timestamptz(3)
  /// 请求来源 IP（规范化后的文本地址）
  ip                 String
  /// 请求的 User-Agent，截断到 300 字符
  userAgent          String?  @map("user_agent")
  /// 设备信息快照：机型、系统、微信版本、基础库版本、小程序版本号，结构见文档第 4 节（契约 ConsentDevice）
  deviceSnapshot     Json     @map("device_snapshot")
  /// 请求号，与访问日志关联
  requestId          String   @map("request_id")
  /// 创建时间
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)

  /// 同意的版本；复合外键保证 agreement_key 与版本行一致
  agreementVersion AgreementVersion @relation(fields: [agreementVersionId, agreementKey], references: [id, agreementKey], onDelete: Restrict, map: "fk_agreement_consent_agreement_version_id")
  /// 操作人
  merchantUser     MerchantUser     @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_agreement_consent_merchant_user_id")
  /// 所属主体
  entity           Entity?          @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_agreement_consent_entity_id")
  /// 下单门店；复合外键保证门店属于该主体（store_id 为空时不检查）
  store            Store?           @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_agreement_consent_store_entity")
  dramaOrders      DramaOrder[]
  ads              Ad[]

  @@index([agreementVersionId], map: "ix_agreement_consent_agreement_version_id")
  @@index([merchantUserId, agreementKey, consentedAt], map: "ix_agreement_consent_merchant_user_id_agreement_key")
  @@index([entityId, agreementKey, consentedAt], map: "ix_agreement_consent_entity_id_agreement_key")
  @@index([bizType, bizId], map: "ix_agreement_consent_biz_type_biz_id")
  @@index([consentedAt], map: "ix_agreement_consent_consented_at")
  @@index([storeId], map: "ix_agreement_consent_store_id")
  @@map("agreement_consent")
}

/// 《定制内容授权书》信件：订单项 × 平台账号一份，保存法律要素现状（状态、起止日）与验真码
model LicenseLetter {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_license_letter") @db.Uuid
  /// 授权书编号：SQ + 订购单号数字部分 - 订单项序号 - 平台码（DY / SPH），换账号或人工作废后重建时再追加 -序号
  letterNo          String    @unique(map: "uq_license_letter_letter_no") @map("letter_no")
  /// 订购单 → drama_order.id
  /// 不建外键：docs 在 L1，不引用 L3 的表
  dramaOrderId      String    @map("drama_order_id") @db.Uuid
  /// 订单项 → order_item.id
  /// 不建外键：docs 在 L1，不引用 L3 的表
  orderItemId       String    @map("order_item_id") @db.Uuid
  /// 发布账号 → channel_account.id
  /// 不建外键：docs 在 L1，不引用 L3 的表
  channelAccountId  String    @map("channel_account_id") @db.Uuid
  /// 归属主体 → entity.id（可见范围）
  entityId          String    @map("entity_id") @db.Uuid
  /// 下单门店 → store.id
  storeId           String    @map("store_id") @db.Uuid
  /// 剧目 → drama.id
  dramaId           String    @map("drama_id") @db.Uuid
  /// 账号所在平台：douyin 抖音 / wechat_channels 视频号
  platform          String
  /// 状态：pending_effective 待生效 / effective 生效中 / voided 已作废；“已失效（到期）”是派生状态
  status            String
  /// 使用期起始日；上线核验通过后才有
  periodStart       DateTime? @map("period_start") @db.Date
  /// 使用期止日（订单项的 usage_end_date）
  periodEnd         DateTime  @map("period_end") @db.Date
  /// 最新 ready 的版次 → license_letter_revision.id；首版渲染完成前为空
  currentRevisionId String?   @unique(map: "uq_license_letter_current_revision_id") @map("current_revision_id") @db.Uuid
  /// 验真码：16 位随机串，用于验真页地址，不可枚举
  verifyCode        String    @unique(map: "uq_license_letter_verify_code") @map("verify_code")
  /// 作废原因：cancelled 订单项取消 / terminated 违约终止 / account_removed 账号被移出 / manual 人工作废（同事务重出新信）
  voidReason        String?   @map("void_reason")
  /// 作废时间
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz(3)
  /// 乐观锁；法律要素每变一次加 1
  lockVersion       Int       @default(0) @map("lock_version")
  /// 创建时间（首版生成时间）
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity          Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_license_letter_entity_id")
  /// 下单门店；复合外键保证门店属于该主体
  store           Store                   @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_license_letter_store_entity")
  /// 剧目
  drama           Drama                   @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_license_letter_drama_id")
  /// 当前版次；复合外键保证它是本信件的版次
  currentRevision LicenseLetterRevision?  @relation("LicenseLetterCurrentRevision", fields: [currentRevisionId, id], references: [id, licenseLetterId], onDelete: Restrict, onUpdate: Restrict, map: "fk_license_letter_current_revision_id")
  /// 反向：本信件的全部版次
  revisions       LicenseLetterRevision[] @relation("LicenseLetterRevisions")

  @@index([entityId, createdAt(sort: Desc)], map: "ix_license_letter_entity_id_created_at")
  @@index([storeId], map: "ix_license_letter_store_id")
  @@index([orderItemId], map: "ix_license_letter_order_item_id")
  @@index([dramaOrderId], map: "ix_license_letter_drama_order_id")
  @@index([dramaId], map: "ix_license_letter_drama_id")
  @@map("license_letter")
}

/// 授权书的每一版 PDF：快照、内容指纹、渲染状态、签署信息、文件
model LicenseLetterRevision {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_license_letter_revision") @db.Uuid
  /// 所属授权书 → license_letter.id
  licenseLetterId  String    @map("license_letter_id") @db.Uuid
  /// 版次号，从 1 起；锁住订单项与信件行后取 max + 1
  revNo            Int       @map("rev_no")
  /// 出版原因：initial 首版 / go_live 上线生效 / period_changed 期限变化 / correction 人工更正 / resign 签署方式升级后补签
  reason           String
  /// 触发来源（evt-{出站事件 id} / guard-{请求号} / inv-{校验批次} / 人工操作号）；只用于追溯，不参与幂等
  triggerRef       String    @map("trigger_ref")
  /// 渲染所需的全部入参；渲染只读它，不再查库。结构见文档第 4 节
  letterSnapshot   Json      @map("letter_snapshot")
  /// 内容指纹：letter_snapshot 规范化 JSON 的 SHA-256（十六进制小写 64 位）；印在 PDF 页脚
  contentFp        String    @map("content_fp")
  /// 模板版本（如 v1）；模板在代码仓库里版本化
  templateVersion  String    @map("template_version")
  /// 渲染状态（技术状态）：queued / rendering / ready / failed
  renderStatus     String    @map("render_status")
  /// 渲染认领序号
  renderAttemptNo  Int       @default(0) @map("render_attempt_no") @db.SmallInt
  /// 渲染租约到期时间
  renderLeaseUntil DateTime? @map("render_lease_until") @db.Timestamptz(3)
  /// 已签名的 PDF 文件 → file_object.id（secure 桶）
  fileId           String?   @map("file_id") @db.Uuid
  /// 最终（已签名）文件字节的 SHA-256；只在验真页展示，不印在文件里
  pdfSha256        String?   @map("pdf_sha256")
  /// 签署方式：platform_cert 平台机构数字证书 / esign_seal 电子签平台企业自动签 / stamp 只贴印章图样
  signMode         String?   @map("sign_mode")
  /// 数字证书序列号
  certSerial       String?   @map("cert_serial")
  /// 数字证书颁发机构
  certIssuer       String?   @map("cert_issuer")
  /// 平台签署时间；ready 的版次必有
  platformSignedAt DateTime? @map("platform_signed_at") @db.Timestamptz(3)
  /// 商家签署时间；只在双方电子签时有值
  merchantSignedAt DateTime? @map("merchant_signed_at") @db.Timestamptz(3)
  /// 电子签平台驱动名
  esignProvider    String?   @map("esign_provider")
  /// 电子签平台的签署流程号
  esignFlowId      String?   @map("esign_flow_id")
  /// 创建时间（入队时间）
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 渲染并签署完成的时间
  readyAt          DateTime? @map("ready_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属授权书
  licenseLetter   LicenseLetter   @relation("LicenseLetterRevisions", fields: [licenseLetterId], references: [id], onDelete: Restrict, map: "fk_license_letter_revision_license_letter_id")
  /// 已签名的 PDF 文件
  file            FileObject?     @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_license_letter_revision_file_id")
  /// 反向：把本版次作为当前版次的信件（至多一封）
  currentOfLetter LicenseLetter[] @relation("LicenseLetterCurrentRevision")

  @@unique([licenseLetterId, revNo], map: "uq_license_letter_revision_license_letter_id_rev_no")
  @@unique([id, licenseLetterId], map: "uq_license_letter_revision_id_license_letter_id")
  @@index([fileId], map: "ix_license_letter_revision_file_id")
  @@map("license_letter_revision")
}

// ===== 14-config-data =====
// 分组 14-config-data：字典、参数、站点配置、开关、清单模板（config，L0）；埋点（analytics，L4）；报表快照（reports，L4）；导出（exports，L4）。13 张表。
// 依据：docs/appendix/design/d6-notify-docs-data.md 第 4、5 节；d3-flow.md 第 10.1、10.2 节（清单模板）；
//       catalogue.json；rulings M10、M14、M15、M19、M24、M33、M34、M35、M44；第二轮按 M46–M57、M60、M77、M92 修订。
// 第三轮（M101、M109、M110 与各分组的请求）只改文档里的播种数据、参数键与登记说明，本片段的表结构不变。
// config 在 L0，不引用上层的表：created_by_staff_id、updated_by_staff_id、image_file_id、ref_id 等只存 id，不建外键。
// analytics 的三张表不建任何外键（归属列可空；将来可整块迁到分析库）。
// 本分组的外键：dict_item.dict_type_key → dict_type；dict_item (dict_type_key, parent_code) → dict_item (dict_type_key, code)；
//               report_month_close.closed_by_staff_id → staff；export_job.requested_by_staff_id → staff；export_job.file_id → file_object。
// 引用的其他分组模型：Staff（03）、FileObject（06）。
// analytics_event 是按 occurred_at 月度 RANGE 分区的表：Prisma 只描述列与主键，分区由手写 SQL 把这张表换成分区表（见 14-config-data.sql）。

/// 数据字典类型：结构、编码规则、是否可新增、停用策略、对小程序是否可见、版本号；行由迁移播种
model DictType {
  /// 类型键（自然键），如 industry、region、genre；代码里登记的常量
  typeKey           String     @id(map: "pk_dict_type") @map("type_key")
  /// 类型名称，如“行业品类”
  name              String
  /// 结构：flat 平铺 / tree 树
  structure         String
  /// 最大层级：平铺为 1，树为 2 或 3
  maxDepth          Int        @map("max_depth") @db.SmallInt
  /// 顺序生成编码的前缀，如 C、G、T；不按顺序生成的类型（国标区划码、系统枚举）为空
  codePrefix        String?    @map("code_prefix")
  /// 顺序号的位数，如 2；与 code_prefix 同有同无
  codeWidth         Int?       @map("code_width") @db.SmallInt
  /// 下一个待发的一级编码序号；新增字典项时锁本行取号
  nextCodeNo        Int        @default(1) @map("next_code_no")
  /// 是否系统枚举（真相在代码，字典只放显示名与说明）
  isSystem          Boolean    @default(false) @map("is_system")
  /// 后台是否可新增字典项
  canCreate         Boolean    @default(true) @map("can_create")
  /// 停用策略：free 可停用 / block_if_referenced 被引用则不可停用 / never 不可停用
  disablePolicy     String     @map("disable_policy")
  /// 小程序是否可读这个类型
  isMerchantVisible Boolean    @default(false) @map("is_merchant_visible")
  /// 该类型的数据版本号：任一字典项新增或修改时加 1，两端据此判断本地缓存是否过期
  versionNo         Int        @default(1) @map("version_no")
  /// 创建时间，应用时钟写入
  createdAt         DateTime   @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt         DateTime   @map("updated_at") @db.Timestamptz(3)
  dictItems         DictItem[]

  @@map("dict_type")
}

/// 数据字典项：列表或树加扩展属性；业务表存不可变的 code，不建外键；只停用不删除
model DictItem {
  /// 主键，UUID v7，应用生成
  id               String   @id(map: "pk_dict_item") @db.Uuid
  /// 所属字典类型（dict_type.type_key）；创建后不可改
  dictTypeKey      String   @map("dict_type_key")
  /// 编码：业务表引用的就是它；保存后不可改
  code             String
  /// 上级编码（同类型内）；一级项为空
  parentCode       String?  @map("parent_code")
  /// 名称，不超过 20 个字；同级不重名
  name             String
  /// 说明（列名随类型显示为“适用场景”“默认规则”等），不超过 40 个字
  description      String?
  /// 是否启用；停用后不再出现在新的选择中，历史数据不受影响
  isEnabled        Boolean  @default(true) @map("is_enabled")
  /// 标记，如“特殊行业”“功能区”
  tags             String[] @default([])
  /// 扩展属性，按类型的 Zod schema 校验
  ext              Json     @default("{}")
  /// 同级内的排列顺序，从 0 起
  position         Int      @default(0)
  /// 乐观锁版本号
  lockVersion      Int      @default(0) @map("lock_version")
  /// 不建外键：config 在 L0，不引用 staff。创建人（员工）；迁移播种的行为空
  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  /// 不建外键：config 在 L0，不引用 staff。最近修改人（员工）
  updatedByStaffId String?  @map("updated_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  /// 关系：dict_type_key → dict_type.type_key
  dictType DictType   @relation(fields: [dictTypeKey], references: [typeKey], onDelete: Restrict, map: "fk_dict_item_dict_type_key")
  /// 关系：(dict_type_key, parent_code) → dict_item (dict_type_key, code)，同类型内自引用
  parent   DictItem?  @relation("DictItemParent", fields: [dictTypeKey, parentCode], references: [dictTypeKey, code], onDelete: Restrict, map: "fk_dict_item_parent_code")
  /// 反向关系：下级字典项（自引用的具名关系，prisma format 不会自动补，必须手写）
  children DictItem[] @relation("DictItemParent")

  @@unique([dictTypeKey, code], map: "uq_dict_item_dict_type_key_code")
  @@index([dictTypeKey, parentCode, position], map: "ix_dict_item_dict_type_key_parent_code_position")
  @@map("dict_item")
}

/// 参数值：参数定义在代码里，值按生效时间追加；一行 = 某个键从某时刻起的值；生效前可撤销一次
model ParamValue {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_param_value") @db.Uuid
  /// 自增序号，即参数修订号（保存接口的 expectedRev 比对它）；出接口时转字符串
  seq              BigInt    @unique(map: "uq_param_value_seq") @default(autoincrement())
  /// 参数键，必须是代码里已定义的键，如 sla.ticket.sample_making、remind.offline.days
  key              String
  /// 参数值，写入前按代码里的定义校验类型与范围
  value            Json
  /// 生效时间：立即生效写保存时刻，可预约未来时刻
  effectiveAt      DateTime  @map("effective_at") @db.Timestamptz(3)
  /// 撤销时间；只能在生效前写一次
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 变更原因，不超过 100 个字
  reason           String?
  /// 不建外键：config 在 L0，不引用 staff。保存人（员工）
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  @@map("param_value")
}

/// 站点配置修订：商城配置、首页推荐位的整份 JSON；草稿 → 发布 → 归档
model SiteConfigRevision {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_site_config_revision") @db.Uuid
  /// 配置键：mall 商城配置 / home_recommend 首页推荐位
  configKey          String    @map("config_key")
  /// 修订号：发布时取“当前已发布版 + 1”；草稿期为空
  revNo              Int?      @map("rev_no")
  /// 状态：draft 草稿 / published 已发布 / archived 已归档；不写状态历史
  status             String
  /// 整份配置内容，按 config_key 对应的 Zod schema 校验
  content            Json
  /// 草稿基于哪一版已发布内容；发布时与当前已发布版的 rev_no 比对
  baseRevNo          Int?      @map("base_rev_no")
  /// 备注，不超过 100 个字
  note               String?
  /// 乐观锁版本号（草稿整份覆盖时比对）
  lockVersion        Int       @default(0) @map("lock_version")
  /// 不建外键：config 在 L0，不引用 staff。创建人（员工）；迁移播种的初始版为空
  createdByStaffId   String?   @map("created_by_staff_id") @db.Uuid
  /// 不建外键：config 在 L0，不引用 staff。发布人（员工）；草稿与播种的初始版为空
  publishedByStaffId String?   @map("published_by_staff_id") @db.Uuid
  /// 发布时间；草稿为空
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  @@unique([configKey, revNo], map: "uq_site_config_revision_config_key_rev_no")
  @@map("site_config_revision")
}

/// 首页 Banner：各有时间窗，保存即生效；展示状态按 is_enabled 与时间窗派生，不落库
model HomeBanner {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_home_banner") @db.Uuid
  /// 标题，后台识别用，不超过 30 个字
  title            String
  /// 不建外键：config 在 L0，不引用 file_object；经 file_ref 登记（ref_type = home_banner，role = image）。Banner 图片
  imageFileId      String    @map("image_file_id") @db.Uuid
  /// 跳转类型：drama 短剧详情 / mall 商城分类 / page 小程序页面 / none 不跳转
  jumpKind         String    @map("jump_kind")
  /// 跳转目标；none 时为空。结构见文档第 4 节
  jumpTarget       Json?     @map("jump_target")
  /// 开始时间
  startAt          DateTime  @map("start_at") @db.Timestamptz(3)
  /// 结束时间；为空表示长期有效
  endAt            DateTime? @map("end_at") @db.Timestamptz(3)
  /// 是否启用
  isEnabled        Boolean   @default(true) @map("is_enabled")
  /// 轮播顺序，从 0 起
  position         Int       @default(0)
  /// 乐观锁版本号
  lockVersion      Int       @default(0) @map("lock_version")
  /// 不建外键：config 在 L0，不引用 staff。创建人（员工）
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 不建外键：config 在 L0，不引用 staff。最近修改人（员工）
  updatedByStaffId String?   @map("updated_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  @@map("home_banner")
}

/// 规则变更公告记录：价目修订、计费参数、协议版本变更保存时同事务建立；驱动站内消息与首页公告条
model SiteNotice {
  /// 主键，UUID v7，应用生成；plan_revision、billing_param、agreement_version 的公告外键指向它
  id                 String             @id(map: "pk_site_notice") @db.Uuid
  /// 公告类型，也是 ref_id 的多态类型：plan_revision / billing_param / agreement_version
  kind               String
  /// 不建外键：多态引用，且 L0 不引用上层表。plan_revision.id / billing_param.change_id（变更集）/ agreement_version.id
  refId              String             @map("ref_id") @db.Uuid
  /// 公告标题，不超过 40 个字
  title              String
  /// 变更摘要，由操作人在保存变更时填写，不超过 200 个字
  summary            String
  /// 不含价格数字的摘要：购买入口为 offline_contract（showPrice = false）时站内消息与公告条用它；plan_revision、billing_param 必填
  summaryNoPrice     String?            @map("summary_no_price")
  /// 规则生效时刻
  effectiveAt        DateTime           @map("effective_at") @db.Timestamptz(3)
  /// 公告时刻，应用时钟写入
  announcedAt        DateTime           @map("announced_at") @db.Timestamptz(3)
  /// 公告期天数 = floor((effective_at − announced_at) / 1 天)
  leadDays           Int                @map("lead_days")
  /// 公告期不足时的原因；只可能来自协议版本
  shortNoticeReason  String?            @map("short_notice_reason")
  /// 深链 { route, params }
  link               Json
  /// 是否进首页公告条
  barEnabled         Boolean            @default(true) @map("bar_enabled")
  /// 状态：announced 已公告 / withdrawn 已撤回；不写状态历史
  status             String             @default("announced")
  /// 不建外键：config 在 L0，不引用 staff。保存变更的员工
  createdByStaffId   String             @map("created_by_staff_id") @db.Uuid
  /// 不建外键：config 在 L0，不引用 staff。撤回人（员工）
  withdrawnByStaffId String?            @map("withdrawn_by_staff_id") @db.Uuid
  /// 撤回时间；withdrawn 时必有
  withdrawnAt        DateTime?          @map("withdrawn_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(3)
  planRevisions      PlanRevision[]
  billingParams      BillingParam[]
  agreementVersions  AgreementVersion[]
  notificationFanouts NotificationFanout[]

  // (kind, ref_id) 只在 announced 的行里唯一（撤回后可再次公告），部分唯一索引在 SQL 里：uq_site_notice_kind_ref_id_announced
  @@map("site_notice")
}

/// 特性开关：键 → 有序规则 → 值；版本隐藏、内容形态、通道急停与版本下限
model FeatureFlag {
  /// 开关键（自然键），必须是代码里登记过的键，如 weapp.video.trailer.enabled
  key              String   @id(map: "pk_feature_flag")
  /// 值类型：bool / enum / json
  valueType        String   @map("value_type")
  /// 无规则命中时的值
  defaultValue     Json     @map("default_value")
  /// 有序规则数组，首条命中即返回；结构见文档第 4 节
  rules            Json     @default("[]")
  /// 下发范围：client 下发给小程序与后台 / server 只在服务端用
  exposedTo        String   @map("exposed_to")
  /// 说明
  description      String?
  /// 乐观锁版本号
  lockVersion      Int      @default(0) @map("lock_version")
  /// 不建外键：config 在 L0，不引用 staff。最近修改人（员工）；迁移播种后未改过的为空
  updatedByStaffId String?  @map("updated_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

/// 清单模板：可配置、带版本；质检、交付前检查、链接核验、巡检、下架核查、账号核验共用；业务表按 (code, version_no) 逻辑引用
model ChecklistTemplate {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_checklist_template") @db.Uuid
  /// 模板编码：qc.sample / qc.episode / qc.package / delivery.precheck / launch.verify / patrol.check / takedown.check / takedown.absence_check / account.verify
  code             String
  /// 版本号，同一编码内从 1 递增
  versionNo        Int       @map("version_no")
  /// 条目数组 [{ key, label, required, allowNa, merchantVisible, hint }]；启用后不可改
  items            Json
  /// 状态：draft 草稿 / active 启用中 / retired 已停用；不写状态历史
  status           String
  /// 启用时间
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(3)
  /// 停用时间；retired 时必有
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(3)
  /// 乐观锁版本号（草稿编辑时比对）
  lockVersion      Int       @default(0) @map("lock_version")
  /// 不建外键：config 在 L0，不引用 staff。创建人（员工）；迁移播种的初始模板为空
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  @@unique([code, versionNo], map: "uq_checklist_template_code_version_no")
  @@map("checklist_template")
}

/// 埋点事件：端上上报、出站派生、用例直记三种来源；按 occurred_at 月度 RANGE 分区；只增
model AnalyticsEvent {
  /// 分区键：服务端校正后的发生时间
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  /// 行标识，UUID v7，应用生成；与 occurred_at 组成主键（分区表主键须含分区键）
  id             String   @db.Uuid
  /// 事件去重标识，1–128 个字符：端上 UUID；出站派生为 out-{出站事件 id}-{name}；直记为 srv-…
  eventId        String   @map("event_id")
  /// 事件名，取值在事件注册表（packages/contract），如 app_launch、order_submit
  name           String
  /// 来源：client 端上上报 / outbox 出站派生 / direct 用例直记
  source         String
  /// 操作人类型：merchant / staff / system / partner（V1.0 不写入 partner）
  actorType      String   @map("actor_type")
  /// 不建外键：analytics 不与业务表建外键。操作人 id；system 与游客为空
  actorId        String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空
  client         String?
  /// 不建外键：analytics 不与业务表建外键。事件归属的商家用户（merchant_user.id）；游客与无归属的系统事件为空
  merchantUserId String?  @map("merchant_user_id") @db.Uuid
  /// 本机匿名标识（端上首次启动生成）；游客只有它
  anonymousId    String?  @map("anonymous_id") @db.Uuid
  /// 商家角色快照：owner / clerk
  role           String?
  /// 不建外键：analytics 不与业务表建外键。所属主体
  entityId       String?  @map("entity_id") @db.Uuid
  /// 不建外键：analytics 不与业务表建外键。所属门店
  storeId        String?  @map("store_id") @db.Uuid
  /// 城市编码（字典 region 的市级编码），服务端按门店档案填
  cityCode       String?  @map("city_code")
  /// 品类编码（字典 industry 的二级编码），服务端按门店档案填
  categoryCode   String?  @map("category_code")
  /// 客户端平台：ios / android / harmony / windows / mac / devtools
  clientPlatform String?  @map("client_platform")
  /// 客户端版本
  clientVersion  String?  @map("client_version")
  /// 会话标识，每次冷启动一个
  sessionId      String?  @map("session_id") @db.Uuid
  /// 微信场景值
  scene          Int?
  /// 事件属性，按事件注册表里该事件的 schema 校验
  props          Json     @default("{}")
  /// 收件时间（落库时间）
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([occurredAt, id], map: "pk_analytics_event")
  @@index([name, occurredAt], map: "ix_analytics_event_name_occurred_at")
  @@map("analytics_event")
}

/// 埋点事件去重表：event_id 唯一；每日清理 8 天前的行
model AnalyticsEventDedup {
  /// 事件去重标识（自然键），同 analytics_event.event_id，1–128 个字符
  eventId    String   @id(map: "pk_analytics_event_dedup") @map("event_id")
  /// 收件时间
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt], map: "ix_analytics_event_dedup_received_at")
  @@map("analytics_event_dedup")
}

/// 匿名标识与用户的关联：登录成功时把本机 anonymous_id 关联到用户，用于“访问 → 登录”漏斗拼接
model AnalyticsIdentity {
  /// 本机匿名标识（自然键）
  anonymousId    String   @id(map: "pk_analytics_identity") @map("anonymous_id") @db.Uuid
  /// 不建外键：analytics 不与业务表建外键。关联到的商家用户（merchant_user.id）
  merchantUserId String   @map("merchant_user_id") @db.Uuid
  /// 关联时间（登录成功的时刻），应用时钟写入
  linkedAt       DateTime @map("linked_at") @db.Timestamptz(3)

  @@index([merchantUserId], map: "ix_analytics_identity_merchant_user_id")
  @@map("analytics_identity")
}

/// 报表月度快照：把经营概览等跨域报表的整份结果固化；快照内容不可改，重出产生新修订
model ReportMonthClose {
  /// 主键，UUID v7，应用生成
  id                  String   @id(map: "pk_report_month_close") @db.Uuid
  /// 报表键：V1.0 只有 overview
  reportKey           String   @map("report_key")
  /// 月份，取当月 1 日（Asia/Shanghai）
  monthDate           DateTime @map("month_date") @db.Date
  /// 修订号：正常为 1，续费率定稿为 2，重出快照继续递增
  revisionNo          Int      @map("revision_no")
  /// 状态：closed 当前有效 / superseded 已被新修订取代；不写状态历史
  status              String
  /// 快照内容 { billing, cash, orders, cross }，与报表接口响应同构
  payload             Json
  /// 各指标是否最终值，如 {"renewalRate":"provisional"}
  finality            Json
  /// 指标口径版本（代码常量 METRIC_DEF_VERSION 的快照）
  metricDefVersion    Int      @map("metric_def_version")
  /// 固化时刻；cash 只含入账时间不晚于它的付款
  cutoffAt            DateTime @map("cutoff_at") @db.Timestamptz(3)
  /// 不建外键：所拷贝的计费月结行；billing_month_close 上线时不建（M10），首个月结前为空
  billingMonthCloseId String?  @map("billing_month_close_id") @db.Uuid
  /// 写入快照的时间
  closedAt            DateTime @map("closed_at") @db.Timestamptz(3)
  /// 触发重出快照的员工；系统固化（月结事件订阅者、续费率定稿任务）为空
  closedByStaffId     String?  @map("closed_by_staff_id") @db.Uuid
  /// 重出快照的原因；员工重出时必填
  reason              String?
  /// 创建时间，应用时钟写入
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间（被取代时），应用时钟写入
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)

  /// 关系：closed_by_staff_id → staff.id
  closedByStaff Staff? @relation(fields: [closedByStaffId], references: [id], onDelete: Restrict, map: "fk_report_month_close_closed_by_staff_id")

  @@unique([reportKey, monthDate, revisionNo], map: "uq_report_month_close_report_key_month_date_revision_no")
  @@map("report_month_close")
}

/// 导出任务：异步生成 xlsx / csv；申请、认领与租约、文件、过期、下载计数
model ExportJob {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_export_job") @db.Uuid
  /// 任务单号：DC + 8 位日期 + 流水
  jobNo                String    @unique(map: "uq_export_job_job_no") @map("job_no")
  /// 导出键，导出注册表里的键，如 report.overview、payments.list
  exportKey            String    @map("export_key")
  /// 筛选条件、月份等请求参数
  params               Json
  /// 去重用哈希：sha256(规范化后的 params + format + is_masked)，十六进制小写 64 位
  paramsHash           String    @map("params_hash")
  /// 文件格式：xlsx / csv；xlsx 超过行数上限时执行中改为 csv
  format               String
  /// 申请人（员工）
  requestedByStaffId   String    @map("requested_by_staff_id") @db.Uuid
  /// 申请时的数据范围与权限点快照；只作审计，执行时按此刻的权限重查
  requestScopeSnapshot Json      @map("request_scope_snapshot")
  /// 敏感列是否脱敏
  isMasked             Boolean   @default(true) @map("is_masked")
  /// 不脱敏导出的原因；is_masked = false 时必填
  reason               String?
  /// 状态：queued / running / succeeded / failed / expired / cancelled；技术状态，不写状态历史
  status               String    @default("queued")
  /// 认领序号：每次认领加 1；落库以它相符为条件
  attemptNo            Int       @default(0) @map("attempt_no") @db.SmallInt
  /// 租约到期时间；running 时必有，每写完一批续租
  leaseUntil           DateTime? @map("lease_until") @db.Timestamptz(3)
  /// 导出行数
  rowCount             Int?      @map("row_count")
  /// 导出文件；succeeded 时必有，过期后行保留
  fileId               String?   @map("file_id") @db.Uuid
  /// 文件字节数；出接口时转字符串
  sizeBytes            BigInt?   @map("size_bytes")
  /// 文件内容的 sha256，十六进制小写 64 位
  sha256               String?
  /// 失败原因摘要，展示给申请人
  error                String?
  /// 文件过期时间 = 完成时刻 + 保留时长（参数，默认 24 小时）
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(3)
  /// 下载次数
  downloadCount        Int       @default(0) @map("download_count")
  /// 最近一次下载时间
  lastDownloadedAt     DateTime? @map("last_downloaded_at") @db.Timestamptz(3)
  /// 申请时间，应用时钟写入
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近一次被认领的时间
  startedAt            DateTime? @map("started_at") @db.Timestamptz(3)
  /// 进入 succeeded、failed、cancelled 的时间
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：requested_by_staff_id → staff.id
  requestedByStaff Staff       @relation(fields: [requestedByStaffId], references: [id], onDelete: Restrict, map: "fk_export_job_requested_by_staff_id")
  /// 关系：file_id → file_object.id
  file             FileObject? @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_export_job_file_id")

  @@index([requestedByStaffId, createdAt(sort: Desc)], map: "ix_export_job_requested_by_staff_id_created_at")
  @@index([fileId], map: "ix_export_job_file_id")
  @@map("export_job")
}

// ===== 15-integration-ops =====
// 分组 15-integration-ops：回调收件（security，L0）、租约与告警、不变量校验结果（ops，L4）。5 张表。
// 依据：docs/appendix/design/d4-identity.md 第 9.6 节；d2-payment.md 第 3.10、4.4 节；
//       d7-platform.md 第 7.6、9.3、9.4、9.6 节；d3-flow.md 第 25.4–25.7 节；d1-ledger.md 第 9 节；
//       catalogue.json；decisions.md 第 9 节；rulings M19、M23、M30、M33、M42、M44、M48、M52、M63、M76、M96。
// webhook_event 在 L0：不引用上层的表，没有外键。
// ops 的三张表在 L4：对 staff 建外键；invariant_violation.subject_id 是多态引用，只存 id。
// 没有注释掉的关系字段，手写 SQL 里没有外键（M46）；本分组的表不带 entity_id、store_id，M47 不适用。
// providers 模块没有表（外部能力配置走环境变量与受控配置）。

/// 回调收件箱：全系统一张，去重键 (provider, event_id)；内联与收件箱两种处理方式
model WebhookEvent {
  /// 主键，UUID v7，应用生成
  id              String    @id(map: "pk_webhook_event") @db.Uuid
  /// 回调来源：wechatpay / wechat / wecom / ci / asr / sms / esign（esign 在 V1.0 只声明）
  provider        String
  /// 来源方的事件标识，由该来源的 eventId() 给出；与 provider 一起唯一（ci、asr 为 media_job id + 云端任务号）
  eventId         String    @map("event_id")
  /// 来源方的事件类型，如 TRANSACTION.SUCCESS、wxa_media_check
  eventType       String    @map("event_type")
  /// 这一行实际走的处理方式：inline 内联 / inbox 收件箱
  mode            String
  /// 报文到达时间
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  /// 来源专有的载荷；微信支付只存不含 openid 的摘要与 APIv3 密文；清除后只留 summary 键
  payload         Json?
  /// 原始报文的 sha256，32 字节，始终保存
  payloadDigest   Bytes     @map("payload_digest")
  /// 载荷里密文所用密钥的版本（密钥环里的 kid）；没有存密文的行为空
  keyVersion      String?   @map("key_version")
  /// 处理状态：received / processed / ignored / failed / dead
  processState    String    @map("process_state")
  /// 已尝试处理的次数
  attempts        Int       @default(0)
  /// 下一次处理的最早时间；received、failed 必有
  nextAttemptAt   DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  /// 处理完成时间；processed、ignored 必有
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  /// 最近一次处理失败的错误摘要
  error           String?
  /// 载荷计划清除时间 = 到达时间 + 该来源的保留天数；不存载荷的行为空
  payloadPurgeAt  DateTime? @map("payload_purge_at") @db.Timestamptz(3)
  /// 载荷实际清除时间；清除后 payload 为空或只剩 summary
  payloadPurgedAt DateTime? @map("payload_purged_at") @db.Timestamptz(3)
  /// 落库时间
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, eventId], map: "uq_webhook_event_provider_event_id")
  @@index([provider, receivedAt], map: "ix_webhook_event_provider_received_at")
  @@map("webhook_event")
}

/// worker 单活租约：至多一行 primary（由第一次续约插入），谁持有租约谁干活；/health 读它判断 worker 存活与探针新鲜度
model WorkerLease {
  /// 租约名，固定为 primary
  name          String    @id(map: "pk_worker_lease")
  /// 持有者：<节点名>:<进程启动时生成的 uuid>
  holder        String
  /// 持有者运行的镜像标签（不是乐观锁版本号）
  holderVersion String    @map("holder_version")
  /// 本任期开始时间（数据库时间）
  acquiredAt    DateTime  @map("acquired_at") @db.Timestamptz(3)
  /// 最近一次续约时间（数据库时间）；主动让出时改成很早的时间
  heartbeatAt   DateTime  @map("heartbeat_at") @db.Timestamptz(3)
  /// 探针最近一次跑完的时间；/health 的 probeAgeSec 读它
  probeAt       DateTime? @map("probe_at") @db.Timestamptz(3)
  /// 落库时间（第一次续约插入行的时间）
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间（续约、写探针时间时一并写）
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("worker_lease")
}

/// 告警事件：探针规则越限与事件型告警共用，按指纹去重，记录次数、通知、认领与恢复
model AlertEvent {
  /// 主键，UUID v7，应用生成
  id             String    @id(map: "pk_alert_event") @db.Uuid
  /// 指纹 = 规则键，或 规则键:维度；未恢复的行里唯一
  fingerprint    String
  /// 规则键，小写点分，如 queue.backlog、outbox.exhausted
  rule           String
  /// 级别：P1 / P2 / P3；未恢复期间随越限程度只升不降
  severity       String
  /// 类型：probe 探针型 / event 事件型
  kind           String
  /// 状态：open 未恢复 / acked 已认领 / resolved 已恢复
  status         String
  /// 首次发生时间
  firstSeenAt    DateTime  @map("first_seen_at") @db.Timestamptz(3)
  /// 最近一次发生时间
  lastSeenAt     DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// 恢复时间；resolved 必有
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// 未恢复期间累计发生次数
  occurrences    Int       @default(1)
  /// 探针型：连续正常的次数，达到 3 即恢复；事件型恒为 0
  okStreak       Int       @default(0) @map("ok_streak") @db.SmallInt
  /// 最近一次测量值或事件详情，不放个人信息
  lastValue      Json?     @map("last_value")
  /// 最近一次发通知的时间
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz(3)
  /// 已发通知次数
  notifyCount    Int       @default(0) @map("notify_count")
  /// 认领人（员工）；命令行认领也须指定员工；与 acked_at 同有同无
  ackedByStaffId String?   @map("acked_by_staff_id") @db.Uuid
  /// 认领时间
  ackedAt        DateTime? @map("acked_at") @db.Timestamptz(3)
  /// 处理说明；发布预检越过该告警的记录也写在这里
  note           String?
  /// 落库时间
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  ackedByStaff Staff? @relation(fields: [ackedByStaffId], references: [id], onDelete: Restrict, map: "fk_alert_event_acked_by_staff_id")

  @@index([resolvedAt], map: "ix_alert_event_resolved_at")
  @@index([severity, lastSeenAt], map: "ix_alert_event_severity_last_seen_at")
  @@index([ackedByStaffId], map: "ix_alert_event_acked_by_staff_id")
  @@map("alert_event")
}

/// 不变量校验的一次运行：quick / full；定时、发布后、演练、手工触发
model InvariantRun {
  /// 主键，UUID v7，应用生成
  id                  String               @id(map: "pk_invariant_run") @db.Uuid
  /// 运行方式：quick 只查最近有变动的主体 / full 全量
  mode                String
  /// 触发来源：schedule 定时 / deploy 发布后 / drill 恢复演练 / manual 手工
  trigger             String
  /// 运行范围 { since, entityIds, modules, codes }；全量且不限检查项时为空
  scope               Json?
  /// 运行状态：running / succeeded / failed
  status              String
  /// 开始时间
  startedAt           DateTime             @map("started_at") @db.Timestamptz(3)
  /// 结束时间；running 时为空
  finishedAt          DateTime?            @map("finished_at") @db.Timestamptz(3)
  /// 已执行的检查项数
  checksRun           Int                  @default(0) @map("checks_run")
  /// 本次运行各检查项返回的违规条数（含此前已存在、仍未解决的）
  violationsFound     Int                  @default(0) @map("violations_found")
  /// 运行失败的错误摘要
  error               String?
  /// 落库时间
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  invariantViolations InvariantViolation[]

  @@index([mode, startedAt], map: "ix_invariant_run_mode_started_at")
  @@map("invariant_run")
}

/// 不变量违规明细：同一违规持续存在时只更新 last_seen_at；后台填写处理结论
model InvariantViolation {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_invariant_violation") @db.Uuid
  /// 首次发现它的那次运行；经端口上报的违规（补偿扫描）为空
  invariantRunId    String?   @map("invariant_run_id") @db.Uuid
  /// 检查项编号：<命名空间>.<编号>，如 billing.I3、flow.STUCK_TICKET
  code              String
  /// 登记该检查项的模块
  module            String
  /// 级别：P1 资金类 / P2 其他
  severity          String
  /// 违规对象的类型，取最终表名；全局性违规为空
  subjectType       String?   @map("subject_type")
  /// 不建外键：按 subject_type 多态；违规对象的 id；全局性违规为空
  subjectId         String?   @map("subject_id") @db.Uuid
  /// 违规对象的文本键（复合主键或自然键的表、缺失的行）；有对象时与 subject_id 二选一；全局性违规可用它区分多条（如参数键）
  subjectKey        String?   @map("subject_key")
  /// 期望值、实际值、相关对象、所属主体（entityId）、自愈动作
  detail            Json
  /// 首次发现时间
  firstSeenAt       DateTime  @map("first_seen_at") @db.Timestamptz(3)
  /// 最近一次发现时间
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// 检查项自愈完成的时间；再次发现而这次没自愈时清空；不能自愈或未自愈为空
  autoHealedAt      DateTime? @map("auto_healed_at") @db.Timestamptz(3)
  /// 处理时间（人工处理，或 heal_only 检查项自愈后自动关闭）；为空表示未解决
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// 处理人（员工；命令行也须指定员工）；heal_only 自动关闭的行为空
  resolvedByStaffId String?   @map("resolved_by_staff_id") @db.Uuid
  /// 处理结论，处理时必填；自动关闭的行为 auto_healed
  resolution        String?
  /// 落库时间
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  invariantRun    InvariantRun? @relation(fields: [invariantRunId], references: [id], onDelete: Restrict, map: "fk_invariant_violation_invariant_run_id")
  resolvedByStaff Staff?        @relation(fields: [resolvedByStaffId], references: [id], onDelete: Restrict, map: "fk_invariant_violation_resolved_by_staff_id")

  @@index([invariantRunId], map: "ix_invariant_violation_invariant_run_id")
  @@index([subjectType, subjectId], map: "ix_invariant_violation_subject")
  @@index([resolvedByStaffId], map: "ix_invariant_violation_resolved_by_staff_id")
  @@map("invariant_violation")
}
