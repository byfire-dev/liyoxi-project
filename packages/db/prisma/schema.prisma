  phoneEnc                           String             @map("phone_enc")
  /// 手机号盲索引（HMAC-SHA256，32 字节），唯一
  phoneBidx                          Bytes              @unique(map: "uq_staff_phone_bidx") @map("phone_bidx")
  /// 手机号脱敏串（前 3 后 4）
  phoneMask                          String             @map("phone_mask")
