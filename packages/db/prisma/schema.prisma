}

/// 员工一次性激活码 / 重置码：只存哈希，24 小时有效，错 5 次作废
model StaffActivation {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_staff_activation") @db.Uuid
  /// 所属员工
  staffId          String    @map("staff_id") @db.Uuid
  /// 用途：activate / reset_password
  purpose          String
  /// 8 位数字字母码的 sha256（32 字节）；库里没有明文
  codeHash         Bytes     @map("code_hash")
  /// 下发方式：sms / manual
  delivery         String
  /// 过期时间（创建 + 24 小时）
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 校验失败次数，满 5 次作废
  attempts         Int       @default(0)
  /// 使用时间；非空表示已用
  usedAt           DateTime? @map("used_at") @db.Timestamptz(3)
  /// 作废时间（重新生成、错满 5 次、账号被禁用）
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 生成人（员工）；命令行引导时为空
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属员工
  staff          Staff  @relation("StaffActivationStaff", fields: [staffId], references: [id], onDelete: Restrict, map: "fk_staff_activation_staff_id")
  /// 生成人
  createdByStaff Staff? @relation("StaffActivationCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_staff_activation_created_by_staff_id")

  @@index([staffId], map: "ix_staff_activation_staff_id")
  @@index([expiresAt], map: "ix_staff_activation_expires_at")
  @@map("staff_activation")
}

/// 后台员工会话：Cookie 会话，空闲 60 分钟滑动、绝对 12 小时；带 step-up 时间
model StaffSession {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_staff_session") @db.Uuid
  /// 所属员工
  staffId           String    @map("staff_id") @db.Uuid
  /// 会话令牌的 sha256（32 字节）；Cookie 里是 32 字节随机数
  tokenHash         Bytes     @unique(map: "uq_staff_session_token_hash") @map("token_hash")
  /// 登录方式：password+totp / password+recovery
  authMethod        String    @map("auth_method")
  /// 登录来源 IP（原值）
  ip                String
  /// 浏览器 UA，服务端截断到 512 字符
  userAgent         String?   @map("user_agent")
  /// 创建（登录）时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近活跃时间，距上次更新超过 60 秒才写
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// 空闲过期时间（滑动）
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  /// 绝对过期时间
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// 最近一次验证第二因子的时间；登录成功时即写为登录时刻
  stepupAt          DateTime  @map("stepup_at") @db.Timestamptz(3)
  /// 吊销时间
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 吊销原因：logout / disabled / password_reset / mfa_reset / phone_changed / admin
  revokeReason      String?   @map("revoke_reason")
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属员工
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_staff_session_staff_id")

  @@index([absoluteExpiresAt], map: "ix_staff_session_absolute_expires_at")
  @@map("staff_session")
}

/// 轮询分配池成员：交付经理（按城市）、剪辑师、发布专员、客服
model AssignmentPoolMember {
  /// 池：delivery_manager / editor / publisher / cs
  pool      String
  /// 池内员工
  staffId   String   @map("staff_id") @db.Uuid
  /// 城市编码（行政区划字典编码）；空串 = 不限城市；只有交付经理池按城市
  cityCode  String   @default("") @map("city_code")
  /// 当班 / 接单中开关；只有客服池可关
  onDuty    Boolean  @default(true) @map("on_duty")
  /// 创建时间
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  /// 池内员工
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_assignment_pool_member_staff_id")

  @@id([pool, staffId, cityCode], map: "pk_assignment_pool_member")
  @@index([staffId], map: "ix_assignment_pool_member_staff_id")
  @@map("assignment_pool_member")
}

/// 轮询游标：每个池 × 范围记录上一次分配到的员工
model AssignmentCursor {
  /// 池：delivery_manager / editor / publisher / cs
  pool        String
  /// 范围键：城市编码或 all
  scopeKey    String   @map("scope_key")
  /// 上一次分配到的员工
  lastStaffId String?  @map("last_staff_id") @db.Uuid
  /// 创建时间
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  /// 上一次分配到的员工
  lastStaff Staff? @relation(fields: [lastStaffId], references: [id], onDelete: Restrict, map: "fk_assignment_cursor_last_staff_id")

  @@id([pool, scopeKey], map: "pk_assignment_cursor")
  @@map("assignment_cursor")
}

/// 改派记录：员工禁用移交或转移交付经理时逐对象一行，同一批次共用 batch_id
model AssignmentHistory {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_assignment_history") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq                BigInt    @unique(map: "uq_assignment_history_seq") @default(autoincrement())
  /// 批次号：一次禁用、移交或转移共用一个
  batchId            String    @map("batch_id") @db.Uuid
  /// 在办来源：store_manager / ticket_editor / ticket_publisher / ad_editor / service_ticket_owner / follow_up_owner
  source             String
  /// 被改派对象的类型（最终表名）：store / drama_order / delivery_ticket / ad / service_ticket / follow_up
  subjectType        String    @map("subject_type")
  /// 被改派对象的 id
  /// 不建外键：多态引用，多数对象在更高层
  subjectId          String    @map("subject_id") @db.Uuid
  /// 原负责人
  fromStaffId        String    @map("from_staff_id") @db.Uuid
  /// 新负责人
  toStaffId          String    @map("to_staff_id") @db.Uuid
  /// 原因：resigned / reassigned / long_leave / workload / merchant_request / staff_change / invariant_fix / other
  reasonCode         String    @map("reason_code")
  /// 交接说明
  note               String?
  /// 操作人类型：staff / system
  actorType          String    @map("actor_type")
  /// 操作人 id；system 时为空
  /// 不建外键：操作人多态
  actorId            String?   @map("actor_id") @db.Uuid
  /// 客户端来源：admin；系统动作为空
  client             String?
  /// 新交付经理联系商家的截止时间（门店交付经理变更的行必有，其余行为空）
  contactDueAt       DateTime? @map("contact_due_at") @db.Timestamptz(3)
  /// 联系时限的参数快照，结构见文档第 4 节
  slaSnapshot        Json?     @map("sla_snapshot")
  /// “已联系”标记时间
  contactedAt        DateTime? @map("contacted_at") @db.Timestamptz(3)
  /// 标记“已联系”的员工
  contactedByStaffId String?   @map("contacted_by_staff_id") @db.Uuid
  /// 联系义务作废时间：联系前同一门店又被改派（再次转移或接收人被禁用）
  contactVoidedAt    DateTime? @map("contact_voided_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 原负责人
  fromStaff        Staff  @relation("AssignmentHistoryFrom", fields: [fromStaffId], references: [id], onDelete: Restrict, map: "fk_assignment_history_from_staff_id")
  /// 新负责人
  toStaff          Staff  @relation("AssignmentHistoryTo", fields: [toStaffId], references: [id], onDelete: Restrict, map: "fk_assignment_history_to_staff_id")
  /// 标记“已联系”的员工
  contactedByStaff Staff? @relation("AssignmentHistoryContactedBy", fields: [contactedByStaffId], references: [id], onDelete: Restrict, map: "fk_assignment_history_contacted_by_staff_id")

  @@index([subjectType, subjectId], map: "ix_assignment_history_subject")
  @@index([batchId], map: "ix_assignment_history_batch_id")
  @@index([fromStaffId], map: "ix_assignment_history_from_staff_id")
  @@index([toStaffId], map: "ix_assignment_history_to_staff_id")
  @@map("assignment_history")
}

/// 运营跟进记录：逾期未上线、续费、补发后确认等；主体多态，可带下次跟进时间与续费意向
model FollowUp {
  /// 主键，UUID v7，应用生成
  id           String    @id(map: "pk_follow_up") @db.Uuid
  /// 跟进对象类型（最终表名）：order_item / subscription_term / store / patrol_task / takedown_task / delivery_reissue
  subjectType  String    @map("subject_type")
  /// 跟进对象 id
  /// 不建外键：多态引用，多数对象在更高层
  subjectId    String    @map("subject_id") @db.Uuid
  /// 所属主体
  entityId     String    @map("entity_id") @db.Uuid
  /// 所属门店；续费跟进按主体归属时为空
  storeId      String?   @map("store_id") @db.Uuid
  /// 沟通方式：wecom / phone / visit / system；空 = 未注明（如“逾期跟踪”的记录弹窗）
  channel      String?
  /// 沟通内容或系统生成的待办主题（≤200 字，契约层校验）
  content      String
  /// 续费意向：confirmed / considering / declined；只有续费跟进填写
  intent       String?
  /// 下次跟进时间；非空且未完成即为在办的跟进待办
  nextFollowAt DateTime? @map("next_follow_at") @db.Timestamptz(3)
  /// 负责跟进的员工（提醒对象）；员工禁用时改派
  ownerStaffId String?   @map("owner_staff_id") @db.Uuid
  /// 跟进事项完成时间
  doneAt       DateTime? @map("done_at") @db.Timestamptz(3)
  /// 完成说明
  doneNote     String?   @map("done_note")
  /// 记录人类型：staff / system
  actorType    String    @map("actor_type")
  /// 记录人 id；system 时为空
  /// 不建外键：操作人多态
  actorId      String?   @map("actor_id") @db.Uuid
  /// 客户端来源：admin；系统动作为空
  client       String?
  /// 乐观锁版本号（改派、改期、标记完成可能并发）
  lockVersion  Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_follow_up_entity_id")
  /// 所属门店（复合外键保证门店属于本行的主体，M47）
  store      Store? @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_follow_up_store_entity")
  /// 负责跟进的员工
  ownerStaff Staff? @relation(fields: [ownerStaffId], references: [id], onDelete: Restrict, map: "fk_follow_up_owner_staff_id")

  @@index([subjectType, subjectId, createdAt], map: "ix_follow_up_subject_created_at")
  @@index([entityId, createdAt], map: "ix_follow_up_entity_id_created_at")
  @@index([storeId, createdAt], map: "ix_follow_up_store_id_created_at")
  @@map("follow_up")
}

/// 审计日志：ops / activity / access 三条流，只追加，与业务写同事务；门店活动流是它的一个查询
model AuditLog {
  /// 主键，UUID v7，应用生成
  id                 String   @id(map: "pk_audit_log") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq                BigInt   @unique(map: "uq_audit_log_seq") @default(autoincrement())
  /// 写入时间；由插入触发器写 clock_timestamp()，应用传值会被覆盖
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 日志编号：RZ + yyyyMMdd（Asia/Shanghai）+ 序号；由插入触发器生成
  logNo              String   @unique(map: "uq_audit_log_log_no") @default("") @map("log_no")
  /// 流：ops / activity / access
  stream             String
  /// 类别编码（代码登记，不写 CHECK），取值见文档第 3 节
  category           String
  /// 机器可读的动作：<领域>.<对象>.<动作>
  action             String
  /// 写入时渲染好的中文标题
  summary            String
  /// 操作人类型：merchant / staff / system / partner
  actorType          String   @map("actor_type")
  /// 操作人 id；system 时为空
  /// 不建外键：L0 的表只存 id
  actorId            String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin / cli（运维命令行，只在本表允许，M102）；系统动作为空
  client             String?
  /// 操作人名称快照（员工姓名 / “商家”“店员” / “系统”）
  actorName          String   @map("actor_name")
  /// 操作人角色快照（“交付主管”“财务”“老板”“自动任务”）
  actorRole          String   @map("actor_role")
  /// 代操作时的被代理主体
  /// 不建外键：L0 的表只存 id
  onBehalfOfEntityId String?  @map("on_behalf_of_entity_id") @db.Uuid
  /// 对象类型（最终表名，格式 CHECK，M52）
  targetType         String?  @map("target_type")
  /// 对象 id（uuid 主键的表；不是 uuid 的 id 由 audit.record 转入 target_key）
  /// 不建外键：多态引用
  targetId           String?  @map("target_id") @db.Uuid
  /// 对象的自然键（staff_role、dict_type、feature_flag 等不用 uuid 主键的表）
  targetKey          String?  @map("target_key")
  /// 对象标签快照（如“星河洗车 · TZ20260930002”）
  targetLabel        String?  @map("target_label")
  /// 所属主体
  /// 不建外键：L0 的表只存 id
  entityId           String?  @map("entity_id") @db.Uuid
  /// 所属门店
  /// 不建外键：L0 的表只存 id
  storeId            String?  @map("store_id") @db.Uuid
  /// 原因编码
  reasonCode         String?  @map("reason_code")
  /// 原因说明
  reasonText         String?  @map("reason_text")
  /// 变更前（仅变更字段，敏感字段已脱敏）
  before             Json?
  /// 变更后（仅变更字段，敏感字段已脱敏）
  after              Json?
  /// 扩展键值（审批状态、规则、通知、影响范围等）
  meta               Json?
  /// 请求追踪号
  requestId          String?  @map("request_id")
  /// 会话 id（三类会话之一）
  /// 不建外键：L0 的表只存 id，且会话行会被清理
  sessionId          String?  @map("session_id") @db.Uuid
  /// 登录方式：password+totp / password+recovery / weapp / portal / system
  authMethod         String?  @map("auth_method")
  /// 来源 IP（原值，展示时脱敏）
  ip                 String?
  /// 浏览器或客户端 UA
  userAgent          String?  @map("user_agent")
  /// 系统任务或命令行的命令名（如 cli.staff.bootstrap、cli.alerts.ack）
  jobName            String?  @map("job_name")
  /// 周期任务的定时器行
  /// 不建外键：L0 的表只存 id，定时器行触发后会被清理
  timerId            String?  @map("timer_id") @db.Uuid

  @@index([stream, createdAt(sort: Desc)], map: "ix_audit_log_stream_created_at")
  @@index([stream, category, createdAt(sort: Desc)], map: "ix_audit_log_stream_category_created_at")
  @@index([actorType, actorId, createdAt(sort: Desc)], map: "ix_audit_log_actor_created_at")
  @@index([targetType, targetId], map: "ix_audit_log_target")
  @@map("audit_log")
}

/// 登录与安全事件：三个身份空间共用，保留 12 个月
model AuthEvent {
  /// 主键，UUID v7，应用生成
  id        String   @id(map: "pk_auth_event") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq       BigInt   @unique(map: "uq_auth_event_seq") @default(autoincrement())
  /// 事件时间
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  /// 身份空间：merchant / staff / portal
  space     String
  /// 账号 id：merchant、portal 空间为 merchant_user.id，staff 空间为 staff.id；未识别时为空
  /// 不建外键：多态引用，L0 的表只存 id
  subjectId String?  @map("subject_id") @db.Uuid
  /// 事件：login_success / login_fail / locked / step_up / identity_rebound / identity_removed / reverify_required / logout / offnet_denied
  event     String
  /// 认证方式（按 space 不同），取值见文档第 3 节
  method    String?
  /// 来源 IP（原值）
  ip        String?
  /// 浏览器或客户端 UA
  userAgent String?  @map("user_agent")
  /// 事件明细，结构见文档第 4 节
  detail    Json?

  @@index([space, subjectId, createdAt], map: "ix_auth_event_space_subject_created_at")
  @@index([event, createdAt], map: "ix_auth_event_event_created_at")
  @@index([createdAt], map: "ix_auth_event_created_at")
  @@map("auth_event")
}

/// 统一单级审批单：只记录“批没批”；内容与执行状态在一对一的领域表
model ApprovalRequest {
  /// 主键，UUID v7，应用生成
  id                    String    @id(map: "pk_approval_request") @db.Uuid
  /// 业务单号：TK / TZ / YQ / ZH + yyyyMMdd + 流水；没有编号的类型为空
  requestNo             String?   @unique(map: "uq_approval_request_request_no") @map("request_no")
  /// 审批类型（approval_kind，12 个取值）
  kind                  String
  /// 大类：review（商家提交的审核）/ approval（员工发起的审批）
  category              String
  /// 对象类型（最终表名），按 kind 固定
  subjectType           String    @map("subject_type")
  /// 对象 id
  /// 不建外键：按 kind 多态，多数对象在更高层
  subjectId             String    @map("subject_id") @db.Uuid
  /// 所属主体；平台级与部分账号类类型为空
  entityId              String?   @map("entity_id") @db.Uuid
  /// 所属门店；主体维度与平台级类型为空
  storeId               String?   @map("store_id") @db.Uuid
  /// 所属交付工单，只作数据范围键，不可变
  /// 不建外键：L1 不引用 L3
  deliveryTicketId      String?   @map("delivery_ticket_id") @db.Uuid
  /// 同一对象第几次提交
  roundNo               Int       @default(1) @map("round_no")
  /// 状态：pending / approved / rejected / withdrawn
  status                String
  /// 展示摘要快照（提交时由该 kind 的处理器生成，之后不变；不含领域内容与敏感明文），结构见文档第 4 节
  summarySnapshot       Json      @map("summary_snapshot")
  /// 清单模板编码（checklist_template.code）
  /// 不建外键：按 (code, version_no) 取值引用（M56）
  checklistCode         String?   @map("checklist_code")
  /// 清单模板版本号（checklist_template.version_no）
  checklistVersionNo    Int?      @map("checklist_version_no")
  /// 清单结论，结构见文档第 4 节
  checklistResult       Json?     @map("checklist_result")
  /// 驳回原因编码（字典 reject_reason 的编码）
  reasonCodes           String[]  @default([]) @map("reason_codes")
  /// 决定或撤回说明；驳回必填
  decisionNote          String?   @map("decision_note")
  /// 提交人类型：merchant / staff / system / partner
  submitActorType       String    @map("submit_actor_type")
  /// 提交人 id；system 时为空
  /// 不建外键：操作人多态
  submitActorId         String?   @map("submit_actor_id") @db.Uuid
  /// 提交的客户端来源：weapp / portal / admin；系统动作为空
  submitClient          String?   @map("submit_client")
  /// 发起员工（员工发起，或系统代某员工生成时填该员工）
  requesterStaffId      String?   @map("requester_staff_id") @db.Uuid
  /// 发起员工当时所在的组（快照）
  requesterStaffGroupId String?   @map("requester_staff_group_id") @db.Uuid
  /// 提交时间
  submittedAt           DateTime  @map("submitted_at") @db.Timestamptz(3)
  /// 决定时限
  dueAt                 DateTime? @map("due_at") @db.Timestamptz(3)
  /// 时限参数快照，结构见文档第 4 节
  slaSnapshot           Json?     @map("sla_snapshot")
  /// 审批人（通过或驳回的员工）
  decidedByStaffId      String?   @map("decided_by_staff_id") @db.Uuid
  /// 是否由系统自动决定
  isDecidedBySystem     Boolean   @default(false) @map("is_decided_by_system")
  /// 进入终态的时间（通过、驳回、撤回）
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz(3)
  /// 决定时勾选的核对项
  confirmChecks         String[]  @default([]) @map("confirm_checks")
  /// 在途去重键（kind:subject）；只供没有执行步的类型使用
  dedupeKey             String?   @map("dedupe_key")
  /// 幂等键（员工发起时由客户端带入）
  idempotencyKey        String?   @map("idempotency_key")
  /// 乐观锁版本号
  lockVersion           Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                   Entity?                   @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_approval_request_entity_id")
  /// 所属门店（复合外键保证门店属于本行的主体，M47）
  store                    Store?                    @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_approval_request_store_entity")
  /// 发起员工
  requesterStaff           Staff?                    @relation("ApprovalRequestRequester", fields: [requesterStaffId], references: [id], onDelete: Restrict, map: "fk_approval_request_requester_staff_id")
  /// 发起员工当时所在的组
  requesterStaffGroup      StaffGroup?               @relation(fields: [requesterStaffGroupId], references: [id], onDelete: Restrict, map: "fk_approval_request_requester_staff_group_id")
  /// 审批人
  decidedByStaff           Staff?                    @relation("ApprovalRequestDecidedBy", fields: [decidedByStaffId], references: [id], onDelete: Restrict, map: "fk_approval_request_decided_by_staff_id")
  accountChangeRequest     AccountChangeRequest?
  qualificationSubmission  QualificationSubmission?
  pointAdjustmentRequest   PointAdjustmentRequest?
  termExtensionRequest     TermExtensionRequest?
  transferProof            TransferProof?
  refundRequest            RefundRequest?
  financeConfigRevision    FinanceConfigRevision?
  cancelRequest            CancelRequest?
  channelAccountSubmission ChannelAccountSubmission?
  launchSubmission         LaunchSubmission?

  @@index([kind, status, dueAt], map: "ix_approval_request_kind_status_due_at")
  @@index([deliveryTicketId, status], map: "ix_approval_request_delivery_ticket_id_status")
  @@index([storeId, kind], map: "ix_approval_request_store_id_kind")
  @@index([entityId, kind], map: "ix_approval_request_entity_id_kind")
  @@index([subjectType, subjectId, kind], map: "ix_approval_request_subject_kind")
  @@index([requesterStaffId, status], map: "ix_approval_request_requester_staff_id_status")
  @@map("approval_request")
}

// ===== 04-profile =====
// 分组 04-profile：门店档案与资质审核（模块 profile，L1）
// 五张表：store_profile、store_profile_media、store_service_item、qualification_submission、qualification_doc
// 外键全部在本片段（M46、M47）；CHECK、部分唯一索引、表达式索引与防改触发器见 dm/sql/04-profile.sql

/// 门店档案当前值（与 store 一对一）：建档前三步的标量字段、资质联系人、完整度缓存、复制来源、资质相关时间点
model StoreProfile {
  /// 门店 id；主键即外键，与 store 一对一
  storeId                            String    @id(map: "pk_store_profile") @map("store_id") @db.Uuid
  /// 归属主体，建行时从 store 复制，不可变
  entityId                           String    @map("entity_id") @db.Uuid
  /// 品牌名称，2～30 字
  brandName                          String?   @map("brand_name")
  /// 品牌 Logo 文件
  logoFileId                         String?   @map("logo_file_id") @db.Uuid
  /// 一级行业，字典 industry 的编码；重审字段
  industryCode                       String?   @map("industry_code")
  /// 二级品类，字典 industry 的二级编码；重审字段
  categoryCode                       String?   @map("category_code")
  /// 省，字典 region 的编码；重审字段
  provinceCode                       String?   @map("province_code")
  /// 市，字典 region 的编码；重审字段
  cityCode                           String?   @map("city_code")
  /// 区县，只存行政区划编码；重审字段
  districtCode                       String?   @map("district_code")
  /// 功能区编码（字典 region 里 functionalZone = true 的项）；只是标注，不触发重审
  zoneCode                           String?   @map("zone_code")
  /// 详细地址，明文；重审字段
  addressDetail                      String?   @map("address_detail")
  /// 地图选点名称
  poiName                            String?   @map("poi_name")
  /// 选点纬度
  latitude                           Decimal?  @db.Decimal(9, 6)
  /// 选点经度
  longitude                          Decimal?  @db.Decimal(9, 6)
  /// 营业时间，时段数组 [{ start, end }]
  businessHours                      Json      @default("[]") @map("business_hours")
  /// 门店联系电话（手机或座机），公开信息，不加密，≤20 字
  storeTel                           String?   @map("store_tel")
  /// 人均消费（分）
  avgSpendFen                        Int?      @map("avg_spend_fen")
  /// 品牌简介，≤300 字
  brandIntro                         String?   @map("brand_intro")
  /// 优惠活动，用于片尾引导
  promoText                          String?   @map("promo_text")
  /// 团购信息
  groupBuyText                       String?   @map("group_buy_text")
  /// 核心卖点标签编码，至多 5 个
  sellingPointCodes                  String[]  @default([]) @map("selling_point_codes")
  /// 卖点补充说明，≤100 字
  sellingNote                        String?   @map("selling_note")
  /// 广告风格偏好编码（V1.1 字段位，V1.0 不写入）
  adStyleCode                        String?   @map("ad_style_code")
  /// 禁用内容（V1.1 字段位，V1.0 不写入）
  bannedTerms                        String?   @map("banned_terms")
  /// 资质联系人姓名
  contactName                        String?   @map("contact_name")
  /// 资质联系人手机号密文（AES-256-GCM）
  contactPhoneEnc                    String?   @map("contact_phone_enc")
  /// 资质联系人手机号脱敏串（前 3 后 4）
  contactPhoneMask                   String?   @map("contact_phone_mask")
  /// 联系人手机号来源：login / sms_verified / unverified
  contactPhoneSource                 String?   @map("contact_phone_source")
  /// 联系人手机号短信验证通过的时间
  contactPhoneVerifiedAt             DateTime? @map("contact_phone_verified_at") @db.Timestamptz(3)
  /// 完整度缓存（百分数 0～100）
  completenessPct                    Int       @default(0) @map("completeness_pct") @db.SmallInt
  /// 已填必填项数（缓存）
  requiredFilled                     Int       @default(0) @map("required_filled") @db.SmallInt
  /// 全部必填项数（缓存）
  requiredTotal                      Int       @default(0) @map("required_total") @db.SmallInt
  /// 复制来源门店（同一主体）
  copiedFromStoreId                  String?   @map("copied_from_store_id") @db.Uuid
  /// 创建时勾选的复制项：basic / service / media / brand_assets
  copyOptions                        String[]  @default([]) @map("copy_options")
  /// 最近一次通过的资质轮次
  effectiveQualificationSubmissionId String?   @map("effective_qualification_submission_id") @db.Uuid
  /// 首次提交资质的时间
  firstSubmittedAt                   DateTime? @map("first_submitted_at") @db.Timestamptz(3)
  /// 首次审核通过的时间
  firstVerifiedAt                    DateTime? @map("first_verified_at") @db.Timestamptz(3)
  /// 最近一次审核决定的时间
  lastDecidedAt                      DateTime? @map("last_decided_at") @db.Timestamptz(3)
  /// 终局驳回（无法补正）的时间
  finalRejectedAt                    DateTime? @map("final_rejected_at") @db.Timestamptz(3)
  /// 最近一次档案修改时间（展示用）
  lastEditedAt                       DateTime? @map("last_edited_at") @db.Timestamptz(3)
  /// 最近修改人类型：merchant / staff / system / partner
  lastEditActorType                  String?   @map("last_edit_actor_type")
  /// 最近修改人 id（system 时为空）
  /// 不建外键：操作人多态（商家用户或员工）
  lastEditActorId                    String?   @map("last_edit_actor_id") @db.Uuid
  /// 最近修改的客户端来源：weapp / portal / admin
  lastEditClient                     String?   @map("last_edit_client")
  /// 乐观锁版本号
  lockVersion                        Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt                          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属门店；归属复合外键 (store_id, entity_id) → store(id, entity_id)（M47）
  store                            Store                    @relation("StoreProfileStore", fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_profile_store_entity")
  /// 归属主体
  entity                           Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_profile_entity_id")
  /// Logo 文件
  logoFile                         FileObject?              @relation(fields: [logoFileId], references: [id], onDelete: Restrict, map: "fk_store_profile_logo_file_id")
  /// 复制来源门店；复合外键保证来源与本门店属同一主体
  copiedFromStore                  Store?                   @relation("StoreProfileCopiedFromStore", fields: [copiedFromStoreId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_profile_copied_from_store_entity")
  /// 生效的资质轮次；复合外键保证是本门店的轮次
  effectiveQualificationSubmission QualificationSubmission? @relation(fields: [effectiveQualificationSubmissionId, storeId, entityId], references: [id, storeId, entityId], onDelete: Restrict, map: "fk_store_profile_effective_qualification_submission_id")

  /// 与 store 一对一：复合外键 (store_id, entity_id) 需要同列的唯一约束，Prisma 才按一对一处理
  @@unique([storeId, entityId], map: "uq_store_profile_store_id_entity_id")
  @@index([entityId], map: "ix_store_profile_entity_id")
  @@index([cityCode, districtCode], map: "ix_store_profile_city_code_district_code")
  @@index([industryCode, categoryCode], map: "ix_store_profile_industry_code_category_code")
  @@map("store_profile")
}

/// 档案媒体行：门头、店内环境、实拍、宣传素材四组；移除只写 removed_at
model StoreProfileMedia {
  /// 主键，UUID v7
  id                String    @id(map: "pk_store_profile_media") @db.Uuid
  /// 归属主体
  entityId          String    @map("entity_id") @db.Uuid
  /// 归属门店
  storeId           String    @map("store_id") @db.Uuid
  /// 分组：door / interior / product / promo
  mediaGroup        String    @map("media_group")
  /// 组内顺序，从 1 起
  position          Int       @db.SmallInt
  /// 文件
  fileId            String    @map("file_id") @db.Uuid
  /// 类型：image / video
  mediaKind         String    @map("media_kind")
  /// 图注（V1.0 留列，不开放填写）
  caption           String?
  /// 复制档案带入时的来源门店（同一主体）
  copiedFromStoreId String?   @map("copied_from_store_id") @db.Uuid
  /// 创建人类型：merchant / staff / system / partner（员工代改新增的行为 staff）
  createActorType   String    @map("create_actor_type")
  /// 创建人 id（system 时为空）
  /// 不建外键：操作人多态（商家用户或员工）
  createActorId     String?   @map("create_actor_id") @db.Uuid
  /// 创建时的客户端来源：weapp / portal / admin；系统动作为空
  createClient      String?   @map("create_client")
  /// 被删除或被替换的时间；行不物理删除（草稿门店同样只停用，M93）
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity          Entity     @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_profile_media_entity_id")
  /// 归属门店；归属复合外键（M47）
  store           Store      @relation("StoreProfileMediaStore", fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_profile_media_store_entity")
  /// 文件
  file            FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_store_profile_media_file_id")
  /// 复制来源门店；复合外键保证来源与本门店属同一主体
  copiedFromStore Store?     @relation("StoreProfileMediaCopiedFromStore", fields: [copiedFromStoreId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_profile_media_copied_from_store_entity")

  @@index([fileId], map: "ix_store_profile_media_file_id")
  @@map("store_profile_media")
}

/// 门店主推服务（每家门店未移除的行 1～10 项）；移除只写 removed_at
model StoreServiceItem {
  /// 主键，UUID v7
  id               String    @id(map: "pk_store_service_item") @db.Uuid
  /// 归属主体
  entityId         String    @map("entity_id") @db.Uuid
  /// 归属门店
  storeId          String    @map("store_id") @db.Uuid
  /// 排序，从 1 起
  position         Int       @db.SmallInt
  /// 名称
  name             String
  /// 现价（分），大于 0
  priceFen         Int       @map("price_fen")
  /// 原价（分），不低于现价
  originalPriceFen Int?      @map("original_price_fen")
  /// 图片文件
  imageFileId      String?   @map("image_file_id") @db.Uuid
  /// 简介，≤20 字
  intro            String?
  /// 被移除的时间；行不物理删除（草稿门店同样只停用，M93）
  removedAt        DateTime? @map("removed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity    Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_service_item_entity_id")
  /// 归属门店；归属复合外键（M47）
  store     Store       @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_service_item_store_entity")
  /// 图片文件
  imageFile FileObject? @relation(fields: [imageFileId], references: [id], onDelete: Restrict, map: "fk_store_service_item_image_file_id")

  @@map("store_service_item")
}

/// 资质轮次：门店的一轮资质材料一行；先是草稿，提交后与一张审批单一对一，决定、撤回或丢弃后关闭
model QualificationSubmission {
  /// 主键，UUID v7；审批单以它为“资质记录 ID”
  id                                  String    @id(map: "pk_qualification_submission") @db.Uuid
  /// 归属主体
  entityId                            String    @map("entity_id") @db.Uuid
  /// 归属门店（资质逐店提交）
  storeId                             String    @map("store_id") @db.Uuid
  /// 轮次类型：initial / new_store / change
  kind                                String
  /// 被驳回的上一轮；非空时队列里显示“重新提交”
  resubmitOfQualificationSubmissionId String?   @map("resubmit_of_qualification_submission_id") @db.Uuid
  /// 门店内的轮次号，提交时写入，从 1 递增；与审批单的 round_no 同为 integer
  roundNo                             Int?      @map("round_no")
  /// 商家所选主体类型：enterprise / individual
  claimedEntityType                   String?   @map("claimed_entity_type")
  /// 本轮送审的门店名称；提交后非空
  proposedStoreName                   String?   @map("proposed_store_name")
  /// 本轮送审的一级行业编码；提交后非空
  proposedIndustryCode                String?   @map("proposed_industry_code")
  /// 本轮送审的二级品类编码；提交后非空
  proposedCategoryCode                String?   @map("proposed_category_code")
  /// 本轮送审的地址快照；提交后非空
  proposedAddressSnapshot             Json?     @map("proposed_address_snapshot")
  /// change 轮次相对生效值改了哪几类：store_name / address / industry / docs / entity_license
  changedFields                       String[]  @default([]) @map("changed_fields")
  /// 提交时的联系人快照（不含明文手机号）
  contactSnapshot                     Json?     @map("contact_snapshot")
  /// 信息确认勾选时间
  declarationConfirmedAt              DateTime? @map("declaration_confirmed_at") @db.Timestamptz(3)
  /// 信息确认文案版本号
  declarationVersion                  String?   @map("declaration_version")
  /// 系统比对汇总（不含识别原值）
  checkSummary                        Json?     @map("check_summary")
  /// 最近一次比对时间
  checksRanAt                         DateTime? @map("checks_ran_at") @db.Timestamptz(3)
  /// 审批单；提交时写入，一对一
  approvalRequestId                   String?   @unique(map: "uq_qualification_submission_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 提交时间；空 = 草稿
  submittedAt                         DateTime? @map("submitted_at") @db.Timestamptz(3)
  /// 提交人（老板）
  submittedByUserId                   String?   @map("submitted_by_user_id") @db.Uuid
  /// 关闭时间：审批被决定或撤回、草稿被丢弃时写入；空 = 在途
  closedAt                            DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 结论：approved / rejected / withdrawn / discarded；关闭时写一次
  outcome                             String?
  /// 通过方式：normal / corrected / override
  approveMode                         String?   @map("approve_mode")
  /// 系统自动驳回的原因：duplicate_entity
  systemRejectCode                    String?   @map("system_reject_code")
  /// 终局驳回（无法补正）的时间；只出现在 initial、new_store 轮次
  finalRejectedAt                     DateTime? @map("final_rejected_at") @db.Timestamptz(3)
  /// 草稿创建人（老板）
  createdByUserId                     String    @map("created_by_user_id") @db.Uuid
  /// 乐观锁版本号；草稿编辑、审核员修正字段、证照行改动都递增
  lockVersion                         Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt                           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                           DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity            Entity                    @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_qualification_submission_entity_id")
  /// 归属门店；归属复合外键（M47）
  store             Store                     @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_qualification_submission_store_entity")
  /// 被驳回的上一轮
  resubmitOf        QualificationSubmission?  @relation("QualificationSubmissionResubmitOf", fields: [resubmitOfQualificationSubmissionId], references: [id], onDelete: Restrict, map: "fk_qualification_submission_resubmit_of")
  /// 反向：以本轮为上一轮的重新提交轮次（自引用的另一侧，不是列）
  resubmissions     QualificationSubmission[] @relation("QualificationSubmissionResubmitOf")
  /// 审批单
  approvalRequest   ApprovalRequest?          @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_qualification_submission_approval_request_id")
  /// 提交人
  submittedByUser   MerchantUser?             @relation("QualificationSubmissionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, map: "fk_qualification_submission_submitted_by_user_id")
  /// 草稿创建人
  createdByUser     MerchantUser              @relation("QualificationSubmissionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_qualification_submission_created_by_user_id")
  storeProfiles     StoreProfile[]
  qualificationDocs QualificationDoc[]

  /// 供证照行与档案行的复合外键引用：保证子行与轮次属同一门店、同一主体
  @@unique([id, storeId, entityId], map: "uq_qualification_submission_id_store_id_entity_id")
  @@unique([storeId, roundNo], map: "uq_qualification_submission_store_id_round_no")
  @@index([storeId, submittedAt(sort: Desc)], map: "ix_qualification_submission_store_id_submitted_at")
  @@index([entityId, kind], map: "ix_qualification_submission_entity_id_kind")
  @@map("qualification_submission")
}

/// 证照行：挂在资质轮次下，每轮的行是本轮要审的全集（新上传或原样带入）
model QualificationDoc {
  /// 主键，UUID v7
  id                            String    @id(map: "pk_qualification_doc") @db.Uuid
  /// 归属主体
  entityId                      String    @map("entity_id") @db.Uuid
  /// 提交这一轮的门店
  storeId                       String    @map("store_id") @db.Uuid
  /// 所属轮次
  qualificationSubmissionId     String    @map("qualification_submission_id") @db.Uuid
  /// 证照类型：business_license / branch_license / industry_permit
  docType                       String    @map("doc_type")
  /// 行业许可证类型编码（字典编码）；industry_permit 时必填
  permitType                    String?   @map("permit_type")
  /// 归属：entity（营业执照）/ store（其余）
  scope                         String
  /// 证照图片文件
  fileId                        String    @map("file_id") @db.Uuid
  /// 识别结果；识别不可用时为空
  ocrResultId                   String?   @map("ocr_result_id") @db.Uuid
  /// 来源：uploaded（本轮新上传）/ carried（原样带入）
  origin                        String
  /// 带入的来源证照行；carried 时必填
  carriedFromQualificationDocId String?   @map("carried_from_qualification_doc_id") @db.Uuid
  /// 商家核对后的提交值，JSON 密文
  submittedFieldsEnc            String?   @map("submitted_fields_enc")
  /// 审核员修正值，JSON 密文
  reviewedFieldsEnc             String?   @map("reviewed_fields_enc")
  /// 逐项比对结论（不含原值）
  fieldChecks                   Json      @default("[]") @map("field_checks")
  /// 证照上的主体名称或经营者名称（明文）
  holderName                    String?   @map("holder_name")
  /// 证件号密文：统一社会信用代码或许可证编号
  certNoEnc                     String?   @map("cert_no_enc")
  /// 证件号盲索引（HMAC），用于信用代码查重
  certNoBidx                    Bytes?    @map("cert_no_bidx")
  /// 证件号脱敏串
  certNoMask                    String?   @map("cert_no_mask")
  /// 法定代表人、经营者或负责人姓名密文
  principalNameEnc              String?   @map("principal_name_enc")
  /// 法定代表人、经营者或负责人姓名脱敏串（只留姓）
  principalNameMask             String?   @map("principal_name_mask")
  /// 负责人角色：legal_rep / operator / branch_head
  principalRole                 String?   @map("principal_role")
  /// 识别出的证照主体类型：enterprise / individual / branch / unknown
  subjectType                   String?   @map("subject_type")
  /// 有效期起始日（营业期限或许可证有效期）
  validStartDate                DateTime? @map("valid_start_date") @db.Date
  /// 有效期截止日
  validEndDate                  DateTime? @map("valid_end_date") @db.Date
  /// 营业期限为“长期”
  isLongTerm                    Boolean   @default(false) @map("is_long_term")
  /// 本轮对这张证照的结论：accepted / rejected；决定前为空
  verdict                       String?
  /// 生效时间：所在轮次通过时写入
  effectiveAt                   DateTime? @map("effective_at") @db.Timestamptz(3)
  /// 被后一轮的生效行取代的时间
  supersededAt                  DateTime? @map("superseded_at") @db.Timestamptz(3)
  /// 从草稿移除、被重新上传替换或所属草稿被丢弃的时间；空 = 本轮的有效行
  removedAt                     DateTime? @map("removed_at") @db.Timestamptz(3)
  /// 上传人（老板）；carried 行复制来源行的值
  uploadedByUserId              String    @map("uploaded_by_user_id") @db.Uuid
  /// 创建时间
  createdAt                     DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                     DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity                  Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_qualification_doc_entity_id")
  /// 提交这一轮的门店；归属复合外键（M47）
  store                   Store                   @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_qualification_doc_store_entity")
  /// 所属轮次；复合外键保证证照行与轮次属同一门店、同一主体
  qualificationSubmission QualificationSubmission @relation(fields: [qualificationSubmissionId, storeId, entityId], references: [id, storeId, entityId], onDelete: Restrict, map: "fk_qualification_doc_qualification_submission_id")
  /// 证照图片文件
  file                    FileObject              @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_qualification_doc_file_id")
  /// 识别结果
  ocrResult               OcrResult?              @relation(fields: [ocrResultId], references: [id], onDelete: Restrict, map: "fk_qualification_doc_ocr_result_id")
  /// 带入的来源证照行
  carriedFrom             QualificationDoc?       @relation("QualificationDocCarriedFrom", fields: [carriedFromQualificationDocId], references: [id], onDelete: Restrict, map: "fk_qualification_doc_carried_from_qualification_doc_id")
  /// 反向：由本行带入的后续证照行（自引用的另一侧，不是列）
  carriedTo               QualificationDoc[]      @relation("QualificationDocCarriedFrom")
  /// 上传人
  uploadedByUser          MerchantUser            @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict, map: "fk_qualification_doc_uploaded_by_user_id")

  @@map("qualification_doc")
}

// ===== 05-content =====
// 分组 05-content：短剧库（content，L1）。6 张表，全局资源，不带 entity_id、store_id。
// 依据：docs/appendix/design/d8-content.md 第 3 节；catalogue.json；rulings M19、M33、M34、M46、M48、M59、M74。
// 引用的其他分组模型：Staff（03）、FileObject（06）。Drama 对 Staff 有两条关系，各写关系名（M46）。

/// 剧目：基础、商业、状态（草稿 / 已上架 / 已下架）与运营字段；状态机 machine = drama
model Drama {
  /// 主键，UUID v7，应用生成
  id                      String    @id(map: "pk_drama") @db.Uuid
  /// 剧名，不超过 20 字（应用层校验）
  title                   String
  /// 状态：draft 草稿 / listed 已上架 / delisted 已下架；只经 flow.transition() 迁移
  status                  String
  /// 最近一次状态迁移的时间
  statusChangedAt         DateTime  @map("status_changed_at") @db.Timestamptz(3)
  /// 首次上架时间；重新上架不重置，写入后不可改
  firstListedAt           DateTime? @map("first_listed_at") @db.Timestamptz(3)
  /// 最近一次上架时间
  listedAt                DateTime? @map("listed_at") @db.Timestamptz(3)
  /// 最近一次下架时间
  delistedAt              DateTime? @map("delisted_at") @db.Timestamptz(3)
  /// 最近一次下架的原因：ops_strategy / rights_issue / content_revision / other / license_expired
  delistReasonCode        String?   @map("delist_reason_code")
  /// 下架说明，选填，不超过 200 字（应用层校验）
  delistNote              String?   @map("delist_note")
  /// 归档时间；归档是终态，写入后不可改，触发原片引用释放
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(3)
  /// 竖版封面文件，指向 file_object（类别 poster），经 file_ref 登记
  posterFileId            String?   @map("poster_file_id") @db.Uuid
  /// 总集数，不小于 1
  totalEpisodes           Int?      @map("total_episodes")
  /// 单集时长（秒），展示时格式化
  episodeDurationSec      Int?      @map("episode_duration_sec")
  /// 题材，字典 genre 的编码数组，不建外键
  genreCodes              String[]  @default([]) @map("genre_codes")
  /// 卖点标签，字典 selling_tag 的编码数组，至多 3 个
  sellingTagCodes         String[]  @default([]) @map("selling_tag_codes")
  /// 出品方
  producerName            String?   @map("producer_name")
  /// 主演，自由文本，参与搜索
  castNames               String?   @map("cast_names")
  /// 剧情简介，不超过 300 字（应用层校验）
  synopsis                String?
  /// 角色介绍：[{name, actor, desc}]，至多 8 个，数组顺序即展示顺序
  roles                   Json      @default("[]")
  /// 微短剧类别：class_1 一类 / class_2 二类 / class_3 三类
  dramaClass              String?   @map("drama_class")
  /// 热度等级：S / A / B / C，决定模板积分价
  heatTier                String?   @map("heat_tier")
  /// 适配行业，字典 industry 的一级编码数组
  industryCodes           String[]  @default([]) @map("industry_codes")
  /// 目标观众，自由文本
  targetAudience          String?   @map("target_audience")
  /// 允许的植入形式：opening / ending / corner / mid_roll；V1.0 只接受前两个
  allowedPlacements       String[]  @default([]) @map("allowed_placements")
  /// 试看集数（V1.1），0 到 10；空表示取参数默认值（集数一律 integer，M59）
  trialEpisodeCount       Int?      @map("trial_episode_count")
  /// 综合排序的人工加权分，0 到 100
  manualBoost             Int       @default(0) @map("manual_boost") @db.SmallInt
  /// 原片本身是否 AI 制作
  isAiGenerated           Boolean   @default(false) @map("is_ai_generated")
  /// 是否允许改动正片：undecided 未定（口径待法务）/ allowed 允许 / forbidden 不允许；V1.0 不参与校验（M74）
  bodyEditPolicy          String    @default("undecided") @map("body_edit_policy")
  /// 原片内容有实质变更后，许可信息是否待重新核验
  isPermitRecheckRequired Boolean   @default(false) @map("is_permit_recheck_required")
  /// 创建人（员工）
  createdByStaffId        String    @map("created_by_staff_id") @db.Uuid
  /// 最近一次保存资料的员工；系统动作不改写
  updatedByStaffId        String    @map("updated_by_staff_id") @db.Uuid
  /// 乐观锁版本号
  lockVersion             Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt               DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 竖版封面文件
  posterFile              FileObject?              @relation(fields: [posterFileId], references: [id], onDelete: Restrict, map: "fk_drama_poster_file_id")
  /// 创建人
  createdByStaff          Staff                    @relation("DramaCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_created_by_staff_id")
  /// 最近一次保存资料的员工
  updatedByStaff          Staff                    @relation("DramaUpdatedByStaff", fields: [updatedByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_updated_by_staff_id")
  dramaEpisodes           DramaEpisode[]
  dramaPermits            DramaPermit[]
  dramaCopyrights         DramaCopyright[]
  dramaCopyrightRevisions DramaCopyrightRevision[]
  dramaStats              DramaStat[]
  dramaTrailers           DramaTrailer[]
  dramaEpisodeMasters     DramaEpisodeMaster[]
  dramaPriceRevisions     DramaPriceRevision[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  deliveryTickets         DeliveryTicket[]
  licenseLetters          LicenseLetter[]

  @@index([status], map: "ix_drama_status")
  @@index([genreCodes], map: "ix_drama_genre_codes", type: Gin)
  @@index([industryCodes], map: "ix_drama_industry_codes", type: Gin)
  @@map("drama")
}

/// 剧集：集号、标题、时长，另留 V1.1、V2.0 的点位列
model DramaEpisode {
  /// 主键，UUID v7，应用生成
  id           String   @id(map: "pk_drama_episode") @db.Uuid
  /// 所属剧目
  dramaId      String   @map("drama_id") @db.Uuid
  /// 集号，从 1 起，同一部剧内唯一
  episodeNo    Int      @map("episode_no")
  /// 单集标题
  title        String?
  /// 时长（毫秒），取当前原片的时长，由 content 收到 drama.masters_changed 后回填
  durationMs   Int?     @map("duration_ms")
  /// 中插点位（V1.1 预留，V1.0 不写）
  insertPoints Json?    @map("insert_points")
  /// 可定制镜头位（V2.0 预留，V1.0 不写）
  customSlots  Json?    @map("custom_slots")
  /// 创建时间
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目
  drama Drama @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_episode_drama_id")

  @@unique([dramaId, episodeNo], map: "uq_drama_episode_drama_id_episode_no")
  @@map("drama_episode")
}

/// 许可信息：剧 × 播出平台 × 编号种类；上架过的剧换号即换行
model DramaPermit {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_drama_permit") @db.Uuid
  /// 所属剧目
  dramaId          String    @map("drama_id") @db.Uuid
  /// 播出平台：all 不区分平台 / douyin / wechat_channels
  platform         String
  /// 编号种类：license_no 许可证号 / approval_no 批准文件编号 / program_no 节目编号
  permitKind       String    @map("permit_kind")
  /// 编号
  permitNo         String    @map("permit_no")
  /// 许可文件扫描件（file_object 的 id 数组），不建外键，经 file_ref 登记
  scanFileIds      String[]  @default([]) @map("scan_file_ids") @db.Uuid
  /// 行状态：active 活动 / retired 已停用；不写状态历史
  status           String
  /// 停用时间
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(3)
  /// 停用原因
  retireReason     String?   @map("retire_reason")
  /// 备注
  note             String?
  /// 创建人（员工）
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目
  drama          Drama @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_permit_drama_id")
  /// 创建人
  createdByStaff Staff @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_permit_created_by_staff_id")

  @@index([dramaId], map: "ix_drama_permit_drama_id")
  @@map("drama_permit")
}

/// 版权信息当前值，每部剧一行；license_end_date 是成片使用期止日的唯一来源
model DramaCopyright {
  /// 主键，即剧目 id
  dramaId                         String    @id(map: "pk_drama_copyright") @map("drama_id") @db.Uuid
  /// 版权来源：own 自有 / licensed 授权
  source                          String?
  /// 授权平台：douyin / wechat_channels，即可发布平台的上限
  platforms                       String[]  @default([])
  /// 授权地域，自由文本
  territory                       String?
  /// 是否具备信息网络传播权
  hasNetworkRight                 Boolean   @default(false) @map("has_network_right")
  /// 是否可转授权
  canSublicense                   Boolean   @default(false) @map("can_sublicense")
  /// 是否可剪辑植入
  canEditEmbed                    Boolean   @default(false) @map("can_edit_embed")
  /// 是否可改编
  canAdapt                        Boolean   @default(false) @map("can_adapt")
  /// 版权有效期起（Asia/Shanghai 日期）
  licenseStartDate                DateTime? @map("license_start_date") @db.Date
  /// 版权有效期止，即剧目授权期结束日、成片使用期止日
  licenseEndDate                  DateTime? @map("license_end_date") @db.Date
  /// 权属证明文件（file_object 的 id 数组），不建外键，经 file_ref 登记
  proofFileIds                    String[]  @default([]) @map("proof_file_ids") @db.Uuid
  /// 最近一条修订；首次上架前为空
  currentDramaCopyrightRevisionId String?   @map("current_drama_copyright_revision_id") @db.Uuid
  /// 乐观锁版本号
  lockVersion                     Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt                       DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt                       DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目（一对一）
  drama                         Drama                   @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_copyright_drama_id")
  /// 最近一条修订；复合外键保证修订属于同一部剧（指针为空时不校验）
  currentDramaCopyrightRevision DramaCopyrightRevision? @relation(fields: [currentDramaCopyrightRevisionId, dramaId], references: [id, dramaId], onDelete: Restrict, map: "fk_drama_copyright_current_drama_copyright_revision_id")

  @@index([licenseEndDate], map: "ix_drama_copyright_license_end_date")
  @@map("drama_copyright")
}

/// 版权信息修订（只增）：首次录入、续期、缩短、范围变更、更正
model DramaCopyrightRevision {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_drama_copyright_revision") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq               BigInt    @unique(map: "uq_drama_copyright_revision_seq") @default(autoincrement())
  /// 所属剧目
  dramaId           String    @map("drama_id") @db.Uuid
  /// 修订类型：initial / extend / shorten / scope_change / correction
  changeKind        String    @map("change_kind")
  /// 变更后的全部版权字段（完整值，不是增量）
  copyrightSnapshot Json      @map("copyright_snapshot")
  /// 变更前的止日；initial 行为空
  prevEndDate       DateTime? @map("prev_end_date") @db.Date
  /// 变更后的止日；任何修订都必有（上架后止日不可为空）
  newEndDate        DateTime  @map("new_end_date") @db.Date
  /// 变更原因
  reason            String
  /// 本次变更的依据文件（file_object 的 id 数组），不建外键，经 file_ref 登记；剧目归档时才释放
  proofFileIds      String[]  @default([]) @map("proof_file_ids") @db.Uuid
  /// 操作人（员工）
  createdByStaffId  String    @map("created_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)

  /// 所属剧目
  drama           Drama            @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_copyright_revision_drama_id")
  /// 操作人
  createdByStaff  Staff            @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_copyright_revision_created_by_staff_id")
  dramaCopyrights DramaCopyright[]

  @@unique([id, dramaId], map: "uq_drama_copyright_revision_id_drama_id")
  @@index([dramaId, seq], map: "ix_drama_copyright_revision_drama_id_seq")
  @@map("drama_copyright_revision")
}

/// 订购统计（派生、可重算）：由周期任务经 DramaUsagePort 取数后按剧 upsert 覆盖，不删行
model DramaStat {
  /// 主键，即剧目 id
  dramaId     String   @id(map: "pk_drama_stat") @map("drama_id") @db.Uuid
  /// 近 30 天订购部数
  orders30d   Int      @default(0) @map("orders_30d")
  /// 当月订购部数
  ordersMtd   Int      @default(0) @map("orders_mtd")
  /// 上线中成片部数
  liveItems   Int      @default(0) @map("live_items")
  /// 本行统计的取数时刻
  refreshedAt DateTime @map("refreshed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目（一对一）
  drama Drama @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_stat_drama_id")

  @@map("drama_stat")
}

// ===== 06-media =====
// 分组 06-media：文件、媒体任务、素材、素材理解、证照识别、ZIP 缓存（模块 media，L1）。21 张表。
// 依据：docs/appendix/design/d5-media.md 第 3–10 节；catalogue.json；rulings M8、M15、M16、M18、M19、M20、M22、M33、M34、M38、M44、M45，第二轮 M46–M50、M58、M60、M63，第三轮 M93（门店不物理删除，去掉只为删门店外键检查而建的索引）。
// 引用的其他分组模型：Entity、Store（02）、Staff（03）、Drama（05）。
// 全部外键都在本片段里（M46）；带 store_id 的五张表对门店用复合外键 (store_id, entity_id) → store (id, entity_id)，名为 fk_<表>_store_entity（M47）。
// CHECK、部分索引、部分唯一索引、触发器，以及素材检索的三元组 GIN 索引见 dm/sql/06-media.sql
// （gin_trgm_ops 依赖 00-common.sql 里的 pg_trgm，而校验与合并都先执行 Prisma 的建表语句、后执行公共文件，写在片段里建不成）。
// 同一对模型之间有多个关系的地方（FileObject → Store、指向 FileObject 的多个文件列、PlayableAsset 的两个指针、两处自引用）都写了关系名；
// 本分组内的反向字段手写，指向其他分组模型的反向字段由校验工具补。

/// 文件对象：四个桶内所有对象（含系统派生物）的唯一登记；业务表只存 file_id，不存 URL
model FileObject {
  /// 自动补的反向关系字段
  agreementVersionPdfFileList    AgreementVersion[] @relation("AgreementVersionPdfFile")
  /// 自动补的反向关系字段
  agreementVersionSourceFileList AgreementVersion[] @relation("AgreementVersionSourceFile")
  /// 主键，UUID v7，应用生成
  id                             String             @id(map: "pk_file_object") @db.Uuid
  /// 正式区所在桶：secure / asset / media / pub
  bucket                         String
  /// 正式区对象键，登记时即确定，全小写 ASCII
  objectKey                      String             @map("object_key")
  /// 写入区所在桶：secure / asset / media；pub 类文件为 asset；系统生成的文件为空
  incomingBucket                 String?            @map("incoming_bucket")
  /// 写入区对象键；入库后置空；系统生成的文件为空
  incomingKey                    String?            @map("incoming_key")
  /// 文件分类码（32 个，见文档 3.1）
  category                       String
  /// 归属范围：platform / entity / store
  scopeType                      String             @map("scope_type")
  /// 归属主体；scope_type 为 entity、store 时必填
  entityId                       String?            @map("entity_id") @db.Uuid
  /// 归属门店；scope_type 为 store 时必填
  storeId                        String?            @map("store_id") @db.Uuid
  /// 上传人类型：merchant / staff / system
  uploadActorType                String             @map("upload_actor_type")
  /// 上传人 id（商家用户或员工）；system 时为空
  /// 不建外键：操作人多态（merchant_user 或 staff）
  uploadActorId                  String?            @map("upload_actor_id") @db.Uuid
  /// 上传的客户端来源：weapp / portal / admin；system 时为空
  uploadClient                   String?            @map("upload_client")
  /// 员工代商家上传时的门店
  onBehalfStoreId                String?            @map("on_behalf_store_id") @db.Uuid
  /// 状态：pending / promoting / stored / rejected / expired / deleting / deleted（技术状态）
  status                         String
  /// 拒收原因：size_mismatch / bad_magic / changed_after_confirm / copy_verify_failed / stamp_failed
  rejectReason                   String?            @map("reject_reason")
  /// 上传通道：post / multipart / server
  uploadMode                     String?            @map("upload_mode")
  /// 端上生成的幂等与续传标识
  clientToken                    String?            @map("client_token")
  /// 所属批量上传批次
  uploadBatchId                  String?            @map("upload_batch_id") @db.Uuid
  /// 登记时声明的字节数
  declaredSize                   BigInt             @map("declared_size")
  /// 登记时声明的 MIME（归一化后）
  declaredMime                   String             @map("declared_mime")
  /// 扩展名（小写，不带点）
  ext                            String
  /// 原始文件名
  originalName                   String?            @map("original_name")
  /// 正式区对象的字节数
  sizeBytes                      BigInt?            @map("size_bytes")
  /// 入库时写入的规范类型（由扩展名推出）
  mime                           String?
  /// 正式区对象的 ETag
  etag                           String?
  /// 正式区对象的 x-cos-hash-crc64ecma
  crc64                          String?
  /// 确认时记录的写入区对象 ETag（条件复制用）
  incomingEtag                   String?            @map("incoming_etag")
  /// 确认时记录的写入区对象 CRC64
  incomingCrc64                  String?            @map("incoming_crc64")
  /// SHA-256（64 位小写十六进制）；仅在服务端完整读过该文件时填写
  sha256                         String?
  /// 内容安全审核状态：none / pending / pass / review / block
  moderationState                String             @default("none") @map("moderation_state")
  /// 审核明细（通道、结论、命中标签）
  moderationDetail               Json?              @map("moderation_detail")
  /// 已签发临时密钥的次数，上限 30
  stsIssued                      Int                @default(0) @map("sts_issued")
  /// 上传凭证过期时间
  uploadExpiresAt                DateTime?          @map("upload_expires_at") @db.Timestamptz(3)
  /// “确认中”标记的到期时间
  confirmingUntil                DateTime?          @map("confirming_until") @db.Timestamptz(3)
  /// 入库时间
  storedAt                       DateTime?          @map("stored_at") @db.Timestamptz(3)
  /// 首次被引用的时间；空表示从未被引用
  firstLinkedAt                  DateTime?          @map("first_linked_at") @db.Timestamptz(3)
  /// 可清除时间，由 file_ref 推导的缓存；空表示不清除
  purgeAfter                     DateTime?          @map("purge_after") @db.Timestamptz(3)
  /// 清除完成时间；恢复后置空
  deletedAt                      DateTime?          @map("deleted_at") @db.Timestamptz(3)
  /// 彻底删除标记：员工彻底删除的时刻；只出现在 deleted，非空后不再恢复（A141）
  erasedAt                       DateTime?          @map("erased_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt                      DateTime           @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                      DateTime           @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity        Entity?      @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_file_object_entity_id")
  /// 归属门店；复合外键保证门店属于该主体（任一列为空时不检查）
  store         Store?       @relation("FileObjectStore", fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_file_object_store_entity")
  /// 员工代传时的门店
  onBehalfStore Store?       @relation("FileObjectOnBehalfStore", fields: [onBehalfStoreId], references: [id], onDelete: Restrict, map: "fk_file_object_on_behalf_store_id")
  /// 所属批次
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict, map: "fk_file_object_upload_batch_id")

  /// 反向：媒体探测事实（一对一）
  mediaInfo               MediaInfo?              @relation("MediaInfoFile")
  /// 反向：以本文件为封面的媒体探测行
  mediaInfoCoverOf        MediaInfo[]             @relation("MediaInfoCoverFile")
  /// 反向：制作留痕（一对一）
  productionRecord        ProductionRecord?       @relation("ProductionRecordFile")
  /// 反向：由本文件规格化或补标得到的制作文件
  productionDerivatives   ProductionRecord[]      @relation("ProductionRecordDerivedFromFile")
  /// 反向：以本文件为源的可播放资产
  playableAssetSources    PlayableAsset[]         @relation("PlayableAssetSourceFile")
  /// 反向：以本文件为封面的可播放资产
  playableAssetCovers     PlayableAsset[]         @relation("PlayableAssetCoverFile")
  /// 反向：以本文件为原片的版本行
  dramaEpisodeMasters     DramaEpisodeMaster[]    @relation("DramaEpisodeMasterFile")
  /// 反向：以本文件为中间规格产物的版本行（V1.1）
  dramaEpisodeMezzanineOf DramaEpisodeMaster[]    @relation("DramaEpisodeMasterMezzanineFile")
  /// 反向：以本文件为 ZIP 的缓存行
  zipBundlesAsZip         ZipBundle[]             @relation("ZipBundleZipFile")
  /// 反向：以本文件为发布清单文件的缓存行
  zipBundlesAsPublishList ZipBundle[]             @relation("ZipBundlePublishListFile")
  staffs                  Staff[]
  storeProfiles           StoreProfile[]
  storeProfileMedias      StoreProfileMedia[]
  storeServiceItems       StoreServiceItem[]
  qualificationDocs       QualificationDoc[]
  dramas                  Drama[]
  fileRefs                FileRef[]
  mediaChecks             MediaCheck[]
  uploadBatchItems        UploadBatchItem[]
  storeAssetFiles         StoreAssetFile[]
  storeAssetInsights      StoreAssetInsight[]
  ocrResults              OcrResult[]
  transferProofs          TransferProof[]
  refundTxns              RefundTxn[]
  wxBillFiles             WxBillFile[]
  invoiceDocs             InvoiceDoc[]
  adVersions              AdVersion[]
  samples                 Sample[]
  episodeOutputs          EpisodeOutput[]
  deliveryDownloadLogs    DeliveryDownloadLog[]
  publishLists            PublishList[]
  licenseLetterRevisions  LicenseLetterRevision[]
  exportJobs              ExportJob[]

  @@unique([bucket, objectKey], map: "uq_file_object_bucket_object_key")
  @@index([storeId, category, id(sort: Desc)], map: "ix_file_object_store_id_category_id")
  @@map("file_object")
}

/// 文件引用登记：谁在用这个文件、释放后保留到何时；清除只看这张表
model FileRef {
  /// 主键，UUID v7，应用生成
  id         String    @id(map: "pk_file_ref") @db.Uuid
  /// 被引用的文件
  fileId     String    @map("file_id") @db.Uuid
  /// 引用方类型：FILE_REF_TYPES 登记表的键，取最终表名；例外 derivative（派生封面）
  refType    String    @map("ref_type")
  /// 引用方行 id；derivative 时为源文件 id
  /// 不建外键：多态引用，引用方分布在各模块
  refId      String    @map("ref_id") @db.Uuid
  /// 引用角色，如 main / ep / list / zip / source / rendition / cover / logo / image / reference
  role       String    @default("main")
  /// 引用状态：live / released
  state      String
  /// 释放后的保留截止时间，此前不得清除；live 时为空
  keepUntil  DateTime? @map("keep_until") @db.Timestamptz(3)
  /// 释放时间；live 时为空
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 被引用的文件
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_file_ref_file_id")

  @@unique([fileId, refType, refId, role], map: "uq_file_ref_file_id_ref_type_ref_id_role")
  @@index([refType, refId], map: "ix_file_ref_ref_type_ref_id")
  @@map("file_ref")
}

/// 清除任务每次运行的记录；数量与字节熔断、人工放行与驳回的载体
model FilePurgeRun {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_file_purge_run") @db.Uuid
  /// 运行模式：list_only / auto
  mode             String
  /// 运行状态：proposed / held / approved / running / done / aborted / rejected
  state            String
  /// 候选文件数，上限 5000
  candidateCount   Int       @map("candidate_count")
  /// 候选文件总字节数
  candidateBytes   BigInt    @map("candidate_bytes")
  /// 分分类统计：{ 分类码: { count, bytes } }
  byCategory       Json      @map("by_category")
  /// 本次候选的文件 id（上限 5000）
  /// 不建外键：数组列；清除候选不是“使用”，也不经 file_ref 登记
  candidateIds     String[]  @map("candidate_ids") @db.Uuid
  /// 熔断原因
  heldReason       String?   @map("held_reason")
  /// 放行或驳回的员工
  decidedByStaffId String?   @map("decided_by_staff_id") @db.Uuid
  /// 放行或驳回的时间
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  /// 实际清除的文件数
  deletedCount     Int?      @map("deleted_count")
  /// 复核不通过（守卫触发）的次数；累计 3 次中止
  guardTrips       Int?      @map("guard_trips")
  /// 开始执行时间
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  /// 结束时间
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 放行或驳回的员工
  decidedByStaff Staff? @relation(fields: [decidedByStaffId], references: [id], onDelete: Restrict, map: "fk_file_purge_run_decided_by_staff_id")

  @@index([state, createdAt(sort: Desc)], map: "ix_file_purge_run_state_created_at")
  @@map("file_purge_run")
}

/// 媒体探测事实：与 file_object 一对一，仅图片、音频、视频；不含结论
model MediaInfo {
  /// 文件 id；主键即外键
  fileId           String   @id(map: "pk_media_info") @map("file_id") @db.Uuid
  /// 媒体类型：video / audio / image
  kind             String
  /// 实际探测到的容器
  container        String?
  /// 时长（毫秒）
  durationMs       Int?     @map("duration_ms")
  /// 编码宽度
  width            Int?
  /// 编码高度
  height           Int?
  /// 旋转角度：0 / 90 / 180 / 270
  rotation         Int      @default(0) @db.SmallInt
  /// 旋转后的显示宽度；判横竖只用显示尺寸
  displayWidth     Int?     @map("display_width")
  /// 旋转后的显示高度
  displayHeight    Int?     @map("display_height")
  /// 帧率分子
  fpsNum           Int?     @map("fps_num")
  /// 帧率分母
  fpsDen           Int?     @map("fps_den")
  /// 视频编码
  vcodec           String?
  /// 视频编码档次
  vprofile         String?
  /// 像素格式
  pixFmt           String?  @map("pix_fmt")
  /// 音频编码
  acodec           String?
  /// 音频采样率
  audioSampleRate  Int?     @map("audio_sample_rate")
  /// 声道数
  audioChannels    Int?     @map("audio_channels") @db.SmallInt
  /// 音轨条数
  audioStreamCount Int?     @map("audio_stream_count") @db.SmallInt
  /// 码率（kbps）
  bitrateKbps      Int?     @map("bitrate_kbps")
  /// moov 是否在 mdat 之前；非 MP4、MOV 容器恒为 false
  isFaststart      Boolean  @default(false) @map("is_faststart")
  /// 音视频流时长差（毫秒）
  avDriftMs        Int?     @map("av_drift_ms")
  /// 回读到的 AIGC 隐式标识；没有为空
  aigcMeta         Json?    @map("aigc_meta")
  /// 系统抽取的封面帧文件
  coverFileId      String?  @map("cover_file_id") @db.Uuid
  /// 探测实现的版本
  probeVersion     Int      @map("probe_version") @db.SmallInt
  /// ffprobe 原始输出（裁剪后）
  raw              Json
  /// 探测时间
  probedAt         DateTime @map("probed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  /// 被探测的文件
  file      FileObject  @relation("MediaInfoFile", fields: [fileId], references: [id], onDelete: Restrict, map: "fk_media_info_file_id")
  /// 封面帧文件
  coverFile FileObject? @relation("MediaInfoCoverFile", fields: [coverFileId], references: [id], onDelete: Restrict, map: "fk_media_info_cover_file_id")

  @@map("media_info")
}

/// 体检结论：一个文件按其分类对应的规格做一次体检（硬性项、预警项、门禁）
model MediaCheck {
  /// 文件 id；主键即外键
  fileId          String   @id(map: "pk_media_check") @map("file_id") @db.Uuid
  /// 体检规格：master / trailer_src / ad / sample / final / asset
  profile         String
  /// 规则版本
  ruleVersion     Int      @map("rule_version") @db.SmallInt
  /// 门禁结论：pass / reject
  gate            String
  /// 硬性项：[{code, pass, actual, expected}]
  hard            Json
  /// 预警项：[{code, level, actual, note}]
  soft            Json
  /// 体检时用到的上下文快照：{masterId, masterDurationMs, headAdMs, tailAdMs, aiUsed}
  contextSnapshot Json?    @map("context_snapshot")
  /// 体检时间
  checkedAt       DateTime @map("checked_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  /// 被体检的文件
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_media_check_file_id")

  @@map("media_check")
}

/// 后台批量上传批次（整部原片或成片），整批提交或不提交
model UploadBatch {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_upload_batch") @db.Uuid
  /// 批次用途：drama_master / final_release；决定 target_id 指向哪张表
  purpose          String
  /// 目标对象 id：drama_master 时为 drama.id，final_release 时为 order_item.id
  /// 不建外键：按 purpose 多态，order_item 在 L3
  targetId         String    @map("target_id") @db.Uuid
  /// 平台版本：common / douyin / wechat_channels；V1.0 只写 common
  variant          String    @default("common")
  /// 创建批次的员工，也是批次的持有人
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 批次状态：matching / uploading / verifying / ready / committed / canceled / expired（技术状态）
  state            String
  /// 该剧总集数（登记时快照）
  expectedCount    Int       @map("expected_count")
  /// 覆盖范围：full 整部 / partial 部分集
  scope            String
  /// 替换原因：quality_fix 画质修复 / license_info_fix 片头许可信息更正 / other 其他（说明写 note）；替换原片时必填，成片批次为空
  replaceReason    String?   @map("replace_reason")
  /// 原片内容是否有实质变更（须重新核验许可信息）
  isContentChanged Boolean   @default(false) @map("is_content_changed")
  /// 整批的 AI 使用声明，成片批次必填，可被条目覆盖
  aiUsage          Json?     @map("ai_usage")
  /// 成片批次的制作上下文：{headAdVersionId, tailAdVersionId, productionTier}
  productionCtx    Json?     @map("production_ctx")
  /// 备注，不超过 200 字
  note             String?
  /// 幂等键
  idempotencyKey   String    @map("idempotency_key")
  /// 批次有效期：最近一次活动后 72 小时，且不超过创建后 7 天
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 提交时间
  committedAt      DateTime? @map("committed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 创建批次的员工
  createdByStaff      Staff                @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_upload_batch_created_by_staff_id")
  fileObjects         FileObject[]
  uploadBatchItems    UploadBatchItem[]
  dramaEpisodeMasters DramaEpisodeMaster[]

  @@unique([createdByStaffId, idempotencyKey], map: "uq_upload_batch_created_by_staff_id_idempotency_key")
  @@index([purpose, targetId], map: "ix_upload_batch_purpose_target_id")
  @@map("upload_batch")
}

/// 批次条目：文件与集号的匹配关系及条目状态；体检结论读 media_check
model UploadBatchItem {
  /// 主键，UUID v7，应用生成
  id            String   @id(map: "pk_upload_batch_item") @db.Uuid
  /// 所属批次
  uploadBatchId String   @map("upload_batch_id") @db.Uuid
  /// 条目对应的文件
  fileId        String   @map("file_id") @db.Uuid
  /// 原始文件名（匹配集号的依据）
  originalName  String   @map("original_name")
  /// 匹配到的集号；空表示未匹配
  episodeNo     Int?     @map("episode_no")
  /// 匹配方式：pattern / sequence / manual
  matchMethod   String?  @map("match_method")
  /// 条目状态：pending / uploaded / checked / rejected / skipped / replaced
  state         String
  /// 条目级 AI 使用声明；空表示用批次的
  aiUsage       Json?    @map("ai_usage")
  /// 创建时间
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属批次
  uploadBatch UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict, map: "fk_upload_batch_item_upload_batch_id")
  /// 条目对应的文件
  file        FileObject  @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_upload_batch_item_file_id")

  @@unique([uploadBatchId, fileId], map: "uq_upload_batch_item_upload_batch_id_file_id")
  @@index([fileId], map: "ix_upload_batch_item_file_id")
  @@map("upload_batch_item")
}

/// 媒体任务：所有需要等结果的外部或本机媒体工作；带租约、回查与父对象汇合，队列只做唤醒
model MediaJob {
  /// 主键，UUID v7，应用生成
  id                 String              @id(map: "pk_media_job") @db.Uuid
  /// 任务种类（16 种）：promote / probe / restamp / transcode_mp4 / watermark_sample / normalize / zip_package / audit_image / audit_image_wx / audit_video / audit_text / asr / vision / doc_extract / digest / ocr
  kind               String
  /// 执行方标识，如 ci / local / mediatool / wechat / asr:tencent / llm:ark；取自配置，不是枚举
  provider           String
  /// 执行方式：local 本机或同步调用 / remote 提交后回查
  mode               String
  /// 任务处理的对象类型：file_object / zip_bundle / store_asset / ocr_result
  subjectType        String              @map("subject_type")
  /// 任务处理的对象 id
  /// 不建外键：多态引用
  subjectId          String              @map("subject_id") @db.Uuid
  /// 收尾时要先锁的父对象类型：store_asset / playable_asset / upload_batch / production_record / zip_bundle
  parentType         String?             @map("parent_type")
  /// 父对象 id；production_record 时为其主键 file_id
  /// 不建外键：多态引用
  parentId           String?             @map("parent_id") @db.Uuid
  /// 去重键：kind + 输入指纹 + 参数版本（+ 代次）
  dedupeKey          String              @unique(map: "uq_media_job_dedupe_key") @map("dedupe_key")
  /// 任务状态：queued / running / submitting / submitted / succeeded / failed / canceled（技术状态）
  state              String
  /// 已尝试次数（第几次尝试）
  attemptNo          Int                 @default(0) @map("attempt_no") @db.SmallInt
  /// 最多尝试次数
  maxAttempts        Int                 @default(3) @map("max_attempts") @db.SmallInt
  /// 领取它的 worker 实例标识
  leaseOwner         String?             @map("lease_owner")
  /// 外部任务号；微信内容安全为 trace_id
  externalJobId      String?             @map("external_job_id")
  /// 任务输入，含预先确定的输出键
  input              Json
  /// 任务结果（回查结果整份落库）
  output             Json?
  /// 错误码
  errorCode          String?             @map("error_code")
  /// 错误信息（截断到 500 字）
  errorMessage       String?             @map("error_message")
  /// 最近一次错误是否可重试；只在 error_code 非空时有意义
  isRetryable        Boolean             @default(false) @map("is_retryable")
  /// queued：下次执行时间；running、submitting：租约到期时间；submitted：下次回查时间
  nextRunAt          DateTime            @map("next_run_at") @db.Timestamptz(3)
  /// 超时判定时间
  deadlineAt         DateTime            @map("deadline_at") @db.Timestamptz(3)
  /// 计量值（分钟、次、千 tokens、GB）；成本估算用，不是账务金额
  billableQty        Decimal?            @map("billable_qty") @db.Decimal(12, 3)
  /// 计量单位
  billableUnit       String?             @map("billable_unit")
  /// 估算成本，单位 10^-6 元；出接口转字符串
  estCostMicro       BigInt?             @map("est_cost_micro")
  /// 首次领取时间
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(3)
  /// 结束时间（成功、失败或取消）
  finishedAt         DateTime?           @map("finished_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt          DateTime            @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime            @map("updated_at") @db.Timestamptz(3)
  storeAssetInsights StoreAssetInsight[]

  @@index([subjectType, subjectId, kind], map: "ix_media_job_subject_type_subject_id_kind")
  @@index([kind, createdAt], map: "ix_media_job_kind_created_at")
  @@map("media_job")
}

/// 制作留痕：每个样片、成片、广告文件一行，记所用原片与广告版本、AI 使用声明与标识状态、入库流水线进度
model ProductionRecord {
  /// 文件 id；主键即外键
  fileId               String   @id(map: "pk_production_record") @map("file_id") @db.Uuid
  /// 文件种类：sample / final / ad
  kind                 String
  /// 订购项 id；样片、成片必填
  /// 不建外键：L1 不引用 L3 的 order_item
  orderItemId          String?  @map("order_item_id") @db.Uuid
  /// 广告 id；广告必填
  /// 不建外键：L1 不引用 L3 的 ad
  adId                 String?  @map("ad_id") @db.Uuid
  /// 集号
  episodeNo            Int?     @map("episode_no")
  /// 平台版本：common / douyin / wechat_channels；V1.0 只写 common
  variant              String   @default("common")
  /// 产物来源：manual_upload / normalized / restamped / render / ai_assisted
  source               String
  /// 规格化、补标产物指向的来源文件
  derivedFromFileId    String?  @map("derived_from_file_id") @db.Uuid
  /// 渲染条目 id（V1.1）；V1.0 恒为空
  /// 不建外键：render_item 表 V1.0 不建
  renderItemId         String?  @map("render_item_id") @db.Uuid
  /// 订购项档位快照：standard / advanced / top；广告为空
  productionTier       String?  @map("production_tier")
  /// 所用原片版本
  dramaEpisodeMasterId String?  @map("drama_episode_master_id") @db.Uuid
  /// 原片版本的认定方式：checkout 取料记录 / declared 表单指定 / current_fallback 取当前原片
  masterSource         String?  @map("master_source")
  /// 所用片头广告版本
  /// 不建外键：L1 不引用 L3 的 ad_version
  headAdVersionId      String?  @map("head_ad_version_id") @db.Uuid
  /// 所用片尾广告版本
  /// 不建外键：L1 不引用 L3 的 ad_version
  tailAdVersionId      String?  @map("tail_ad_version_id") @db.Uuid
  /// AI 使用声明：{used, tools, declaredBy, declaredAt, forcedByDrama}
  aiUsage              Json     @map("ai_usage")
  /// AI 隐式标识状态：not_required / pending / verified / failed
  aigcState            String   @map("aigc_state")
  /// 标识来源：upstream 上游工具带来 / stamped 本系统写入
  aigcOrigin           String?  @map("aigc_origin")
  /// 入库流水线进度：uploading / checking / ready / rejected（技术状态）
  pipelineState        String   @map("pipeline_state")
  /// 差异度指标，预留；V1.0 恒为空
  similarity           Json?
  /// 上传的员工；系统产物为空
  uploadedByStaffId    String?  @map("uploaded_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(3)

  /// 本行描述的文件
  file               FileObject          @relation("ProductionRecordFile", fields: [fileId], references: [id], onDelete: Restrict, map: "fk_production_record_file_id")
  /// 来源文件
  derivedFromFile    FileObject?         @relation("ProductionRecordDerivedFromFile", fields: [derivedFromFileId], references: [id], onDelete: Restrict, map: "fk_production_record_derived_from_file_id")
  /// 所用原片版本
  dramaEpisodeMaster DramaEpisodeMaster? @relation(fields: [dramaEpisodeMasterId], references: [id], onDelete: Restrict, map: "fk_production_record_drama_episode_master_id")
  /// 上传的员工
  uploadedByStaff    Staff?              @relation(fields: [uploadedByStaffId], references: [id], onDelete: Restrict, map: "fk_production_record_uploaded_by_staff_id")

  @@map("production_record")
}

/// 取料记录：某剪辑师为某订购项某集最近一次取到的原片版本
model MasterCheckout {
  /// 订购项 id
  /// 不建外键：L1 不引用 L3 的 order_item
  orderItemId          String   @map("order_item_id") @db.Uuid
  /// 集号
  episodeNo            Int      @map("episode_no")
  /// 取料的员工（剪辑师）
  staffId              String   @map("staff_id") @db.Uuid
  /// 最近一次取到的原片版本
  dramaEpisodeMasterId String   @map("drama_episode_master_id") @db.Uuid
  /// 最近一次取料时间
  checkedOutAt         DateTime @map("checked_out_at") @db.Timestamptz(3)
  /// 取料次数
  checkoutCount        Int      @default(1) @map("checkout_count")
  /// 创建时间
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(3)

  /// 取料的员工
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_master_checkout_staff_id")
  /// 取到的原片版本
  dramaEpisodeMaster DramaEpisodeMaster @relation(fields: [dramaEpisodeMasterId], references: [id], onDelete: Restrict, map: "fk_master_checkout_drama_episode_master_id")

  @@id([orderItemId, episodeNo, staffId], map: "pk_master_checkout")
  @@map("master_checkout")
}

/// 可播放资产：预告片、样片、广告共用的播放抽象，播放接口只认它
model PlayableAsset {
  /// 主键，UUID v7，应用生成
  id           String    @id(map: "pk_playable_asset") @db.Uuid
  /// 归属主体，创建时从源文件复制，不可变；预告片等平台级资产为空
  entityId     String?   @map("entity_id") @db.Uuid
  /// 归属门店，创建时从源文件复制，不可变；预告片等平台级资产为空
  storeId      String?   @map("store_id") @db.Uuid
  /// 资产种类：trailer / sample / ad
  kind         String
  /// 源文件
  sourceFileId String    @map("source_file_id") @db.Uuid
  /// 属主类型：drama / order_item / ad
  ownerType    String    @map("owner_type")
  /// 属主 id
  /// 不建外键：按 owner_type 多态，order_item、ad 在 L3
  ownerId      String    @map("owner_id") @db.Uuid
  /// 资产状态：processing / ready / failed / retired（技术状态）
  state        String
  /// 时长（毫秒）
  durationMs   Int?      @map("duration_ms")
  /// 宽度
  width        Int?
  /// 高度
  height       Int?
  /// 播放档位：[{quality, fileId, width, height, bitrateKbps}]
  renditions   Json?
  /// 封面文件
  coverFileId  String?   @map("cover_file_id") @db.Uuid
  /// 实际使用的水印：{template, text}
  watermark    Json?
  /// 转码规格版本
  specVersion  Int       @map("spec_version") @db.SmallInt
  /// 失败原因（截断到 500 字）
  error        String?
  /// 就绪时间
  readyAt      DateTime? @map("ready_at") @db.Timestamptz(3)
  /// 停用时间
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity     Entity?     @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_playable_asset_entity_id")
  /// 归属门店；复合外键保证门店属于该主体（预告片两列为空，不检查）
  store      Store?      @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_playable_asset_store_entity")
  /// 源文件
  sourceFile FileObject  @relation("PlayableAssetSourceFile", fields: [sourceFileId], references: [id], onDelete: Restrict, map: "fk_playable_asset_source_file_id")
  /// 封面文件
  coverFile  FileObject? @relation("PlayableAssetCoverFile", fields: [coverFileId], references: [id], onDelete: Restrict, map: "fk_playable_asset_cover_file_id")

  /// 反向：以本资产为目标的预告片指针
  trailerTargets  DramaTrailer[] @relation("DramaTrailerTarget")
  /// 反向：以本资产为当前播放的预告片指针
  trailerCurrents DramaTrailer[] @relation("DramaTrailerCurrent")

  @@unique([kind, sourceFileId, specVersion], map: "uq_playable_asset_kind_source_file_id_spec_version")
  @@index([ownerType, ownerId, kind], map: "ix_playable_asset_owner_type_owner_id_kind")
  @@map("playable_asset")
}

/// ZIP 缓存：某个属主（V1.0 只有成片包的一次发布批次）的打包状态、代次与 ZIP 文件；可随时重打
model ZipBundle {
  /// 主键，UUID v7，应用生成
  id                String   @id(map: "pk_zip_bundle") @db.Uuid
  /// 属主类型：delivery_release（V1.0 唯一取值）
  ownerType         String   @map("owner_type")
  /// 属主 id
  /// 不建外键：按 owner_type 多态，delivery_release 在 L3
  ownerId           String   @map("owner_id") @db.Uuid
  /// 打包状态：none / building / ready / failed（技术状态）
  zipState          String   @default("none") @map("zip_state")
  /// 打包代次；每次重新打包、每次作废都加 1，写进打包任务的 dedupe_key
  zipGen            Int      @default(0) @map("zip_gen")
  /// 当前 ZIP 文件；仅 ready 时非空
  zipFileId         String?  @map("zip_file_id") @db.Uuid
  /// 与当前 ZIP 同代次生成的发布清单文件（分类 publish_list）；仅 ready 时可非空，清单文本为空时为空
  publishListFileId String?  @map("publish_list_file_id") @db.Uuid
  /// 创建时间
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  /// 当前 ZIP 文件
  zipFile         FileObject? @relation("ZipBundleZipFile", fields: [zipFileId], references: [id], onDelete: Restrict, map: "fk_zip_bundle_zip_file_id")
  /// 当前发布清单文件
  publishListFile FileObject? @relation("ZipBundlePublishListFile", fields: [publishListFileId], references: [id], onDelete: Restrict, map: "fk_zip_bundle_publish_list_file_id")

  @@unique([ownerType, ownerId], map: "uq_zip_bundle_owner_type_owner_id")
  @@map("zip_bundle")
}

/// 预告片指针：每部剧当前生效的预告片（target 与 current 两个资产），防止迟到的转码结果覆盖较新的设置
model DramaTrailer {
  /// 剧目 id；主键即外键
  dramaId                String   @id(map: "pk_drama_trailer") @map("drama_id") @db.Uuid
  /// 最近一次设置的资产（可能还在转码）
  targetPlayableAssetId  String   @map("target_playable_asset_id") @db.Uuid
  /// 当前对外播放的资产
  currentPlayableAssetId String?  @map("current_playable_asset_id") @db.Uuid
  /// 设置预告片的员工
  setByStaffId           String   @map("set_by_staff_id") @db.Uuid
  /// 设置时间
  setAt                  DateTime @map("set_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt              DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt              DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目
  drama                Drama          @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_trailer_drama_id")
  /// 最近一次设置的资产
  targetPlayableAsset  PlayableAsset  @relation("DramaTrailerTarget", fields: [targetPlayableAssetId], references: [id], onDelete: Restrict, map: "fk_drama_trailer_target_playable_asset_id")
  /// 当前对外播放的资产
  currentPlayableAsset PlayableAsset? @relation("DramaTrailerCurrent", fields: [currentPlayableAssetId], references: [id], onDelete: Restrict, map: "fk_drama_trailer_current_playable_asset_id")
  /// 设置预告片的员工
  setByStaff           Staff          @relation(fields: [setByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_trailer_set_by_staff_id")

  @@map("drama_trailer")
}

/// 原片版本：每集原片的版本行（版本号递增，每集至多一个当前版本），只在批次提交时创建
model DramaEpisodeMaster {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_drama_episode_master") @db.Uuid
  /// 所属剧目
  dramaId          String    @map("drama_id") @db.Uuid
  /// 集号，从 1 起
  episodeNo        Int       @map("episode_no")
  /// 版本号，同一集内从 1 递增
  revNo            Int       @map("rev_no")
  /// 原片文件
  fileId           String    @map("file_id") @db.Uuid
  /// 版本状态：ready / superseded
  state            String
  /// 是否当前版本；每集至多一个
  isCurrent        Boolean   @default(false) @map("is_current")
  /// 时长（毫秒）
  durationMs       Int?      @map("duration_ms")
  /// 产生该版本的批次
  uploadBatchId    String?   @map("upload_batch_id") @db.Uuid
  /// 替换原因（从批次复制）：quality_fix / license_info_fix / other
  replaceReason    String?   @map("replace_reason")
  /// 内容是否有实质变更（须重新核验许可信息）
  isContentChanged Boolean   @default(false) @map("is_content_changed")
  /// 提交批次的员工
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 成为当前版本的时间
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(3)
  /// 中间规格产物文件（V1.1 预留，V1.0 恒为空）
  mezzanineFileId  String?   @map("mezzanine_file_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属剧目
  drama             Drama              @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_episode_master_drama_id")
  /// 原片文件
  file              FileObject         @relation("DramaEpisodeMasterFile", fields: [fileId], references: [id], onDelete: Restrict, map: "fk_drama_episode_master_file_id")
  /// 中间规格产物文件
  mezzanineFile     FileObject?        @relation("DramaEpisodeMasterMezzanineFile", fields: [mezzanineFileId], references: [id], onDelete: Restrict, map: "fk_drama_episode_master_mezzanine_file_id")
  /// 产生该版本的批次
  uploadBatch       UploadBatch?       @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict, map: "fk_drama_episode_master_upload_batch_id")
  /// 提交批次的员工
  createdByStaff    Staff              @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_episode_master_created_by_staff_id")
  productionRecords ProductionRecord[]
  masterCheckouts   MasterCheckout[]

  @@unique([dramaId, episodeNo, revNo], map: "uq_drama_episode_master_drama_id_episode_no_rev_no")
  @@index([fileId], map: "ix_drama_episode_master_file_id")
  @@map("drama_episode_master")
}

/// 门店素材：图片、视频、录音、音频、文档、文字；处理进度、复核与可用性、采用次数三个正交维度
model StoreAsset {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_store_asset") @db.Uuid
  /// 归属主体；也用于识别结果在主体内复用
  entityId             String    @map("entity_id") @db.Uuid
  /// 归属门店
  storeId              String    @map("store_id") @db.Uuid
  /// 素材类型：image / video / recording / audio / document / text
  type                 String
  /// 标题，系统生成，可被复核人修改，不超过 60 字
  title                String?
  /// 文字类素材正文，不超过 500 字
  textBody             String?   @map("text_body")
  /// 补充说明，不超过 200 字
  note                 String?
  /// 上传人类型：merchant / staff
  uploadActorType      String    @map("upload_actor_type")
  /// 上传人 id（商家用户或代传的员工）
  /// 不建外键：操作人多态（merchant_user 或 staff）
  uploadActorId        String    @map("upload_actor_id") @db.Uuid
  /// 上传的客户端来源：weapp / portal / admin
  uploadClient         String    @map("upload_client")
  /// 上传时的商家角色快照：owner / clerk；员工代传为空
  uploadActorRole      String?   @map("upload_actor_role")
  /// 响应的素材需求；须是本门店的需求（复合外键）
  storeAssetDemandId   String?   @map("store_asset_demand_id") @db.Uuid
  /// 复制来源：从同主体其他门店复制而来（只复制引用与洞察，不复制文件）；须是同一主体的素材（复合外键）
  sourceStoreAssetId   String?   @map("source_store_asset_id") @db.Uuid
  /// 处理进度：pending / processing / processed
  processingState      String    @map("processing_state")
  /// 是否有理解步骤失败或被跳过
  isInsightPartial     Boolean   @default(false) @map("is_insight_partial")
  /// 复核状态：unreviewed / reviewed
  reviewState          String    @map("review_state")
  /// 可用性：ready / reference_only / need_reshoot / need_portrait_auth；只有复核人能写
  usability            String?
  /// 肖像授权材料（分类 portrait_auth）；不建外键，经 file_ref 登记（store_asset / portrait_auth）
  portraitAuthFileIds  String[]  @default([]) @map("portrait_auth_file_ids") @db.Uuid
  /// 复核人确认肖像授权齐全的时间；空表示未确认
  portraitAuthorizedAt DateTime? @map("portrait_authorized_at") @db.Timestamptz(3)
  /// 被采用次数
  adoptedCount         Int       @default(0) @map("adopted_count")
  /// 内容安全审核状态（汇总各文件与文本）：none / pending / pass / review / block
  moderationState      String    @default("none") @map("moderation_state")
  /// 检索文本：标题 + 标签 + 转写摘录 + 上传人
  searchText           String?   @map("search_text")
  /// 复核的员工
  reviewedByStaffId    String?   @map("reviewed_by_staff_id") @db.Uuid
  /// 复核时间
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(3)
  /// 复核截止时间（上传后 1 个工作日）；复制得到的已复核素材为空
  dueAt                DateTime? @map("due_at") @db.Timestamptz(3)
  /// 复核时限参数快照（SlaSnapshot）：{policy, amount, unit, calendarVersion, computedAt}
  slaSnapshot          Json?     @map("sla_snapshot")
  /// 删除时间（后台软删除）
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// 幂等键
  idempotencyKey       String    @map("idempotency_key")
  /// 乐观锁版本号；复核保存（标题、标签、可用性）时校验并加 1
  lockVersion          Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity           Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_asset_entity_id")
  /// 归属门店；复合外键保证门店属于该主体
  store            Store             @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_asset_store_entity")
  /// 响应的素材需求；复合外键保证需求属于本门店
  storeAssetDemand StoreAssetDemand? @relation(fields: [storeAssetDemandId, storeId], references: [id, storeId], onDelete: Restrict, map: "fk_store_asset_store_asset_demand_id")
  /// 复制来源；复合外键保证来源属于同一主体
  sourceStoreAsset StoreAsset?       @relation("StoreAssetSource", fields: [sourceStoreAssetId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_asset_source_store_asset_id")
  /// 复核的员工
  reviewedByStaff  Staff?            @relation(fields: [reviewedByStaffId], references: [id], onDelete: Restrict, map: "fk_store_asset_reviewed_by_staff_id")

  /// 反向：由本素材复制出的素材
  copies             StoreAsset[]        @relation("StoreAssetSource")
  storeAssetFiles    StoreAssetFile[]
  storeAssetInsights StoreAssetInsight[]
  storeAssetTags     StoreAssetTag[]
  storeAssetUsages   StoreAssetUsage[]

  @@unique([storeId, idempotencyKey], map: "uq_store_asset_store_id_idempotency_key")
  @@unique([id, entityId], map: "uq_store_asset_id_entity_id")
  @@map("store_asset")
}

/// 素材与文件的有序关联：一条素材可含多个文件
model StoreAssetFile {
  /// 所属素材
  storeAssetId String   @map("store_asset_id") @db.Uuid
  /// 素材内的排列顺序，从 1 起
  position     Int      @db.SmallInt
  /// 文件
  fileId       String   @map("file_id") @db.Uuid
  /// 创建时间
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  /// 所属素材
  storeAsset StoreAsset @relation(fields: [storeAssetId], references: [id], onDelete: Restrict, map: "fk_store_asset_file_store_asset_id")
  /// 文件
  file       FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_store_asset_file_file_id")

  @@id([storeAssetId, position], map: "pk_store_asset_file")
  @@unique([storeAssetId, fileId], map: "uq_store_asset_file_store_asset_id_file_id")
  @@index([fileId], map: "ix_store_asset_file_file_id")
  @@map("store_asset_file")
}

/// 素材理解的机器产出：一步一行，可重跑（转写、识图、文档文本、结构化条目、汇总、技术规格）
model StoreAssetInsight {
  /// 主键，UUID v7，应用生成
  id                            String   @id(map: "pk_store_asset_insight") @db.Uuid
  /// 所属素材
  storeAssetId                  String   @map("store_asset_id") @db.Uuid
  /// 对应的文件；汇总步骤为空
  fileId                        String?  @map("file_id") @db.Uuid
  /// 步骤种类：transcript / vision / doc_text / structured_items / digest / tech_spec
  kind                          String
  /// 提示词版本
  promptVersion                 Int      @map("prompt_version") @db.SmallInt
  /// 执行方标识
  provider                      String?
  /// 模型名
  model                         String?
  /// 步骤结果：ok / skipped / failed
  status                        String
  /// 步骤产出，结构随 kind 而定
  content                       Json
  /// 同主体内复用时指向来源洞察行
  reusedFromStoreAssetInsightId String?  @map("reused_from_store_asset_insight_id") @db.Uuid
  /// 产生它的媒体任务
  mediaJobId                    String?  @map("media_job_id") @db.Uuid
  /// 创建时间
  createdAt                     DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                     DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属素材
  storeAsset                  StoreAsset         @relation(fields: [storeAssetId], references: [id], onDelete: Restrict, map: "fk_store_asset_insight_store_asset_id")
  /// 对应的文件
  file                        FileObject?        @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_store_asset_insight_file_id")
  /// 复用来源
  reusedFromStoreAssetInsight StoreAssetInsight? @relation("StoreAssetInsightReuse", fields: [reusedFromStoreAssetInsightId], references: [id], onDelete: Restrict, map: "fk_store_asset_insight_reused_from_store_asset_insight_id")
  /// 产生它的媒体任务
  mediaJob                    MediaJob?          @relation(fields: [mediaJobId], references: [id], onDelete: Restrict, map: "fk_store_asset_insight_media_job_id")

  /// 反向：复用了本行结果的洞察行
  reusedBy StoreAssetInsight[] @relation("StoreAssetInsightReuse")

  @@index([fileId, kind], map: "ix_store_asset_insight_file_id_kind")
  @@map("store_asset_insight")
}

/// 素材标签：内容、用途、时效三个维度；来源区分机器、上传人、复核人
model StoreAssetTag {
  /// 主键，UUID v7，应用生成
  id             String    @id(map: "pk_store_asset_tag") @db.Uuid
  /// 所属素材
  storeAssetId   String    @map("store_asset_id") @db.Uuid
  /// 标签维度：content / usage / timeliness
  dimension      String
  /// 标签编码（字典类型 asset_tag 的 dict_item.code，封闭词表）；其 ext.dimension 须等于本行 dimension
  /// 不建外键：字典编码；存在与类型由 config.N7 按 DICT_REFS 校验，维度一致由 media.I17 校验
  tagCode        String    @map("tag_code")
  /// 时效起始日（时效为日期区间时使用）
  validStartDate DateTime? @map("valid_start_date") @db.Date
  /// 时效结束日
  validEndDate   DateTime? @map("valid_end_date") @db.Date
  /// 标签来源：auto / uploader / reviewer
  source         String
  /// 是否经复核确认；复核后的标签展示时覆盖机器与上传人的
  isConfirmed    Boolean   @default(false) @map("is_confirmed")
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属素材
  storeAsset StoreAsset @relation(fields: [storeAssetId], references: [id], onDelete: Restrict, map: "fk_store_asset_tag_store_asset_id")

  @@unique([storeAssetId, dimension, tagCode, source], map: "uq_store_asset_tag_store_asset_id_dimension_tag_code_source")
  @@index([tagCode, dimension], map: "ix_store_asset_tag_tag_code_dimension")
  @@map("store_asset_tag")
}

/// 素材使用记录：被引用为参考或被采用
model StoreAssetUsage {
  /// 主键，UUID v7，应用生成
  id           String   @id(map: "pk_store_asset_usage") @db.Uuid
  /// 被使用的素材
  storeAssetId String   @map("store_asset_id") @db.Uuid
  /// 使用方类型：ad / drama_order / order_item / ad_version / episode_output
  usedByType   String   @map("used_by_type")
  /// 使用方 id
  /// 不建外键：按 used_by_type 多态，使用方都在 L3
  usedById     String   @map("used_by_id") @db.Uuid
  /// 使用方式：reference 参考 / adopted 采用
  role         String
  /// 创建时间（即使用时间）
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  /// 被使用的素材
  storeAsset StoreAsset @relation(fields: [storeAssetId], references: [id], onDelete: Restrict, map: "fk_store_asset_usage_store_asset_id")

  @@unique([storeAssetId, usedByType, usedById, role], map: "uq_store_asset_usage_store_asset_id_used_by_role")
  @@index([usedByType, usedById], map: "ix_store_asset_usage_used_by_type_used_by_id")
  @@map("store_asset_usage")
}

/// 素材需求：交付经理向门店征集素材
model StoreAssetDemand {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_store_asset_demand") @db.Uuid
  /// 归属主体
  entityId         String    @map("entity_id") @db.Uuid
  /// 归属门店
  storeId          String    @map("store_id") @db.Uuid
  /// 需求名称，不超过 20 字
  title            String
  /// 拍摄说明，选填，不超过 200 字
  shootingNote     String?   @map("shooting_note")
  /// 完成日期（该日及之前完成），按 Asia/Shanghai 取日
  dueDate          DateTime  @map("due_date") @db.Date
  /// 通知对象：owner_and_clerks 老板和店员 / owner_only 仅老板
  notifyScope      String    @map("notify_scope")
  /// 需求状态：open 进行中 / done 已完成 / canceled 已撤销；“已逾期”由 due_date 派生
  status           String
  /// 发起的员工（交付经理）
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 结束时间（完成或撤销）
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_asset_demand_entity_id")
  /// 归属门店；复合外键保证门店属于该主体
  store          Store        @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_asset_demand_store_entity")
  /// 发起的员工
  createdByStaff Staff        @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_store_asset_demand_created_by_staff_id")
  storeAssets    StoreAsset[]

  @@unique([id, storeId], map: "uq_store_asset_demand_id_store_id")
  @@index([storeId, status, dueDate], map: "ix_store_asset_demand_store_id_status_due_date")
  @@map("store_asset_demand")
}

/// 证照与回单的 OCR 识别结果（应用层加密）；识别值只存这一处
model OcrResult {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_ocr_result") @db.Uuid
  /// 归属主体，从被识别的文件复制
  entityId         String    @map("entity_id") @db.Uuid
  /// 发起识别的门店（调用方传入的业务上下文，如资质轮次所属门店），不从文件复制；回单识别为空
  storeId          String?   @map("store_id") @db.Uuid
  /// 被识别的文件
  fileId           String    @map("file_id") @db.Uuid
  /// 证照类型：business_license / industry_permit / bank_receipt
  docType          String    @map("doc_type")
  /// 行业许可证类型（字典编码，如 food_business）
  /// 不建外键：字典编码不是枚举
  permitType       String?   @map("permit_type")
  /// 识别执行方：tencent / aliyun / llm / none；取自配置，不是枚举
  provider         String
  /// 识别结果：pending 识别中 / ok / unavailable / unreadable
  status           String
  /// 归一化字段 JSON 的密文（AES-256-GCM）
  fieldsEnc        String?   @map("fields_enc")
  /// 识别告警：[{code}]
  warnings         Json      @default("[]")
  /// 厂商原始返回的密文；30 天后清空
  rawEnc           String?   @map("raw_enc")
  /// 原始返回的清空时间
  rawPurgeAt       DateTime? @map("raw_purge_at") @db.Timestamptz(3)
  /// 发起识别的操作人类型：merchant / staff / system
  requestActorType String    @map("request_actor_type")
  /// 发起识别的操作人 id；system 时为空
  /// 不建外键：操作人多态（merchant_user 或 staff）
  requestActorId   String?   @map("request_actor_id") @db.Uuid
  /// 发起识别的客户端来源：weapp / portal / admin；system 时为空
  requestClient    String?   @map("request_client")
  /// 识别耗时（毫秒）
  latencyMs        Int?      @map("latency_ms")
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属主体
  entity            Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_ocr_result_entity_id")
  /// 发起识别的门店；复合外键保证门店属于该主体（为空时不检查）
  store             Store?             @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_ocr_result_store_entity")
  /// 被识别的文件
  file              FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_ocr_result_file_id")
  qualificationDocs QualificationDoc[]
  transferProofs    TransferProof[]

  @@index([fileId, id(sort: Desc)], map: "ix_ocr_result_file_id_id")
  @@index([storeId, createdAt], map: "ix_ocr_result_store_id_created_at")
  @@map("ocr_result")
}

// ===== 07-billing-ledger =====
// 分组 07-billing-ledger：价目、订阅、积分账本（billing，L2）。21 张表。
// 依据：docs/appendix/design/d1-ledger.md 第 4–9 节；catalogue.json；rulings M12、M15、M16、M19、M24、M33、M34、M35、M44、M45，
//   第二轮 M46、M47、M48、M54、M55、M57、M66、M67、M75。
//   第三轮（M93、M98–M100 与其他分组的请求）没有表结构改动；引用 store 的外键都是 onDelete: Restrict（M93）。
// 引用的其他分组模型：Entity、Store（02）、Staff、ApprovalRequest（03）、Drama（05）、BillingOrder、RefundRequest（08）、SiteNotice（14）。
// 关系名（M46）：同一对模型之间有多个关系时每个关系都写了关系名：SubscriptionTerm ↔ PlanRevision、SubscriptionEvent ↔ Plan / PlanRevision、
//   PointLot ↔ PointLot（自引用）、PointLot ↔ PointLedgerEntry、TermExtensionRequest ↔ SubscriptionTerm。对方模型上的反向字段是初稿手写的，按 M46③ 保留；
//   其余关系的反向字段由校验工具自动补。指向其他分组模型的关系每对只有一个（08 的模型没有指回本分组的外键）。
// 归属复合外键（M47）：point_hold、ledger_operation 的门店外键是 (store_id, entity_id) → store(id, entity_id)，另保留 entity_id 的单列外键。
// 只存 id、不建外键的列：point_hold.ref_id、point_lot.source_id、ledger_operation.ref_id（多态）；各表的 actor_id（操作人多态）；
//   price_tier_revision.batch_id、billing_param.change_id（应用生成的批次标识）；point_entry_valuation.point_ledger_entry_seq（冗余的排序列）。

/// 套餐版本：版本码、名称、升降级比较用的 rank、上下架；价格与权益在 plan_revision
model Plan {
  /// 主键，UUID v7，应用生成
  id          String   @id(map: "pk_plan") @db.Uuid
  /// 版本码：basic / pro / flagship，可新增；创建后不改，进入付款单快照与埋点
  code        String   @unique(map: "uq_plan_code")
  /// 版本名称：基础版 / 专业版 / 旗舰版
  name        String
  /// 升降级比较：目标 rank 高为升级，低为降级
  rank        Int      @unique(map: "uq_plan_rank")
  /// 可见范围：public 公开；entity 大客户专属（V1.0 只声明，不写入）
  scope       String   @default("public")
  /// 是否上架。下架后不可新购与续费，已有周期不受影响
  isListed    Boolean  @default(false) @map("is_listed")
  /// 乐观锁版本号
  lockVersion Int      @default(0) @map("lock_version")
  /// 创建时间，应用时钟写入
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  /// 反向：以本版本为变更前版本的订阅事件
  subscriptionEventsFrom SubscriptionEvent[]  @relation("SubscriptionEventFromPlan")
  /// 反向：以本版本为变更后版本的订阅事件
  subscriptionEventsTo   SubscriptionEvent[]  @relation("SubscriptionEventToPlan")
  planRevisions          PlanRevision[]
  subscriptionTerms      SubscriptionTerm[]
  grantSchedules         GrantSchedule[]
  pointLots              PointLot[]
  pointLedgerEntries     PointLedgerEntry[]
  billingEntityDailies   BillingEntityDaily[]

  @@map("plan")
}

/// 套餐价目修订：带生效时间的完整价目与权益；不可变，只能在生效前撤销
model PlanRevision {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_plan_revision") @db.Uuid
  /// 所属套餐
  planId           String    @map("plan_id") @db.Uuid
  /// 该套餐的第几次修订，从 1 起
  revisionNo       Int       @map("revision_no")
  /// 月费（分），大于 0
  monthlyFeeFen    Int       @map("monthly_fee_fen")
  /// 每月套餐积分，大于 0
  monthlyPoints    Int       @map("monthly_points")
  /// 订剧与广告折扣（万分比），5000 到 10000；9 折 = 9000，原价 = 10000
  discountBp       Int       @map("discount_bp")
  /// 制作模型：standard 标准 / advanced 高级 / top 顶级；top 时订剧不加扣
  productionModel  String    @map("production_model")
  /// 可管理门店数，不小于 1
  maxStores        Int       @map("max_stores")
  /// 成员数上限（不含老板）；空 = 不限（后台输入 0 表示不限）
  maxMembers       Int?      @map("max_members")
  /// 制作排期：standard 标准 / priority 优先 / rush 加急
  schedulePriority String    @map("schedule_priority")
  /// 是否含月度效果报告
  hasMonthlyReport Boolean   @default(false) @map("has_monthly_report")
  /// 各购买周期的总价（分），键为月数；默认 = 月费 × 月数，季付年付优惠只改这里。结构见第 4 节
  cyclePrices      Json      @map("cycle_prices")
  /// 生效时间
  effectiveAt      DateTime  @map("effective_at") @db.Timestamptz(3)
  /// 公告时间；首个修订豁免公告，为空。服务层校验 effective_at ≥ 保存时刻 + noticeDays
  announcedAt      DateTime? @map("announced_at") @db.Timestamptz(3)
  /// 公告记录；与 announced_at 同有同无。先建公告、再插本行，插入时写好（不可事后补写）
  siteNoticeId     String?   @map("site_notice_id") @db.Uuid
  /// 首期优惠位；V1.0 只有 {"type":"previous_revision"} 一种。结构见第 4 节
  legacyPromo      Json?     @map("legacy_promo")
  /// 撤销时间；只能在生效前写一次
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 创建人（员工）；上线播种的初始行为空
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  /// 关系：plan_id → plan.id
  plan                     Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_plan_revision_plan_id")
  /// 关系：site_notice_id → site_notice.id
  siteNotice               SiteNotice?          @relation(fields: [siteNoticeId], references: [id], onDelete: Restrict, map: "fk_plan_revision_site_notice_id")
  /// 关系：created_by_staff_id → staff.id
  createdByStaff           Staff?               @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_plan_revision_created_by_staff_id")
  /// 反向：当前价目修订为本行的周期
  subscriptionTermsCurrent SubscriptionTerm[]   @relation("SubscriptionTermPlanRevision")
  /// 反向：购买时价目修订为本行的周期
  subscriptionTermsInitial SubscriptionTerm[]   @relation("SubscriptionTermInitialPlanRevision")
  /// 反向：以本修订为变更前修订的订阅事件
  subscriptionEventsFrom   SubscriptionEvent[]  @relation("SubscriptionEventFromPlanRevision")
  /// 反向：以本修订为变更后修订的订阅事件
  subscriptionEventsTo     SubscriptionEvent[]  @relation("SubscriptionEventToPlanRevision")
  planPromoClaims          PlanPromoClaim[]
  grantSchedules           GrantSchedule[]
  pointLots                PointLot[]
  billingEntityDailies     BillingEntityDaily[]

  @@unique([planId, revisionNo], map: "uq_plan_revision_plan_id_revision_no")
  @@map("plan_revision")
}

/// 首期优惠使用记录：每个主体对每个带首期优惠的价目修订只能用一次
model PlanPromoClaim {
  /// 主键，UUID v7，应用生成
  id             String   @id(map: "pk_plan_promo_claim") @db.Uuid
  /// 使用优惠的主体
  entityId       String   @map("entity_id") @db.Uuid
  /// 被占用优惠的价目修订（快照里的 claimRevisionId，即带 legacy_promo 的那一版）
  planRevisionId String   @map("plan_revision_id") @db.Uuid
  /// 占用优惠的付款单
  billingOrderId String   @map("billing_order_id") @db.Uuid
  /// 占用时刻，取履约事务的账本时钟
  usedAt         DateTime @map("used_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity       Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_plan_promo_claim_entity_id")
  /// 关系：plan_revision_id → plan_revision.id
  planRevision PlanRevision @relation(fields: [planRevisionId], references: [id], onDelete: Restrict, map: "fk_plan_promo_claim_plan_revision_id")
  /// 关系：billing_order_id → billing_order.id
  billingOrder BillingOrder @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_plan_promo_claim_billing_order_id")

  @@unique([entityId, planRevisionId], map: "uq_plan_promo_claim_entity_id_plan_revision_id")
  @@index([billingOrderId], map: "ix_plan_promo_claim_billing_order_id")
  @@map("plan_promo_claim")
}

/// 加购积分包：加购积分包的档位，可原地修改
model PointPack {
  /// 主键，UUID v7，应用生成
  id          String   @id(map: "pk_point_pack") @db.Uuid
  /// 积分数，不小于 100；上架中的积分包之间不重复
  points      Int
  /// 价格（分），大于 0；允许不等于积分数，商家端按配置渲染
  priceFen    Int      @map("price_fen")
  /// 是否上架；新增即上架
  isListed    Boolean  @default(true) @map("is_listed")
  /// 展示顺序，小的在前
  position    Int      @default(0)
  /// 乐观锁版本号
  lockVersion Int      @default(0) @map("lock_version")
  /// 创建时间，应用时钟写入
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("point_pack")
}

/// 等级模板价修订：热度等级 S / A / B / C 的模板积分价，带生效时间，不可变
model PriceTierRevision {
  /// 主键，UUID v7，应用生成
  id               String   @id(map: "pk_price_tier_revision") @db.Uuid
  /// 热度等级：S / A / B / C（见 catalogue enums_shared 的 heat_tier）
  tier             String
  /// 模板积分价，100 到 20000
  points           Int
  /// 生效时间；“保存后立即生效”取账本时钟的当前时刻
  effectiveAt      DateTime @map("effective_at") @db.Timestamptz(3)
  /// 同一次保存的各档共用的批次标识（应用生成，不指向任何表）；服务层校验同一生效时刻 S ≥ A ≥ B ≥ C
  /// 不建外键：批次标识，不是外键
  batchId          String   @map("batch_id") @db.Uuid
  /// 创建人（员工）；上线播种的初始行为空
  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：created_by_staff_id → staff.id
  createdByStaff Staff? @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_price_tier_revision_created_by_staff_id")

  @@unique([tier, effectiveAt], map: "uq_price_tier_revision_tier_effective_at")
  @@index([batchId], map: "ix_price_tier_revision_batch_id")
  @@map("price_tier_revision")
}

/// 单剧定价修订：单剧调价记录，带生效时间，可在生效前撤销
model DramaPriceRevision {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_drama_price_revision") @db.Uuid
  /// 剧目
  dramaId          String    @map("drama_id") @db.Uuid
  /// 定价方式：template 按模板 / custom 单剧调整
  mode             String
  /// 单剧积分价；custom 时必填且不小于 100，template 时为空
  customPoints     Int?      @map("custom_points")
  /// 旧价：保存时刻该剧的积分价 P(drama, 保存时刻)；该剧当时没有可用价格（无等级、无调价）为空。调价记录“旧价 → 新价”用
  prevPoints       Int?      @map("prev_points")
  /// 新价：保存时按已知的价目算出的 P(drama, effective_at)；custom 等于 custom_points，template 取该剧当时等级的模板价
  newPoints        Int       @map("new_points")
  /// 生效时间：保存后立即，或某日 00:00（北京时间）
  effectiveAt      DateTime  @map("effective_at") @db.Timestamptz(3)
  /// 调整原因：quality 制作质量 / genre_fit 题材适配 / release_timing 上新时间 / license_remaining 剩余授权期 / restore_template 恢复模板价
  reasonCode       String    @map("reason_code")
  /// 备注，自由文本
  note             String?
  /// 撤销时间；只能在生效前写一次
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 创建人（员工）
  createdByStaffId String    @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  /// 关系：drama_id → drama.id
  drama          Drama @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_drama_price_revision_drama_id")
  /// 关系：created_by_staff_id → staff.id
  createdByStaff Staff @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_drama_price_revision_created_by_staff_id")

  @@index([dramaId, effectiveAt], map: "ix_drama_price_revision_drama_id_effective_at")
  @@map("drama_price_revision")
}

/// 积分规则参数：进入单据快照的计费参数，按键存储、逐键生效
model BillingParam {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_billing_param") @db.Uuid
  /// 参数键，12 个取值：adUnitPoints、adFreeRevisions、topModelSurchargeBp、cancelDeductionBp、expiredTermRefund、minLicenseMonths、renewalReminderDays、prorationBaseDays、planRefundWindowHours、enabledCycles、maxScheduledTerms、noticeDays。含义与默认值见第 4.3 节
  key              String
  /// 该键的完整值（不是增量），每个键各有 Zod schema。结构见第 4 节
  value            Json
  /// 生效时间；需提前公告的键不得早于保存时刻 + noticeDays（服务层校验）
  effectiveAt      DateTime  @map("effective_at") @db.Timestamptz(3)
  /// 同一次保存的各键共用的变更集标识（应用生成，不指向任何表）；后台“变更记录”按它聚合
  /// 不建外键：变更集标识，不是外键
  changeId         String    @map("change_id") @db.Uuid
  /// 变更说明
  note             String?
  /// 公告记录；需提前公告的键必填（清单是代码常量 NOTICE_REQUIRED_KEYS，服务层校验）。同一变更集里需公告的各行共用一条公告
  siteNoticeId     String?   @map("site_notice_id") @db.Uuid
  /// 撤销时间；只能在生效前写一次
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 创建人（员工）；上线播种的初始行为空
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  /// 创建时间，应用时钟写入
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  /// 关系：site_notice_id → site_notice.id
  siteNotice     SiteNotice? @relation(fields: [siteNoticeId], references: [id], onDelete: Restrict, map: "fk_billing_param_site_notice_id")
  /// 关系：created_by_staff_id → staff.id
  createdByStaff Staff?      @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_billing_param_created_by_staff_id")

  @@index([changeId], map: "ix_billing_param_change_id")
  @@map("billing_param")
}

/// 主体计费账户：每主体一行，是改钱改积分事务的唯一行锁，并缓存订阅状态与余额
model BillingAccount {
  /// 主体，主键兼外键
  entityId                  String    @id(map: "pk_billing_account") @map("entity_id") @db.Uuid
  /// 订阅状态缓存：none 从未开通 / active 生效中 / expired 已过期。由 advance 等账本函数维护，只用于后台筛选与扫描；权益判断不读它
  subStatus                 String    @default("none") @map("sub_status")
  /// 当前生效周期；active 时必填，否则为空
  currentSubscriptionTermId String?   @map("current_subscription_term_id") @db.Uuid
  /// 缓存：当前周期未过期套餐批次的可用合计
  planAvailableQty          Int       @default(0) @map("plan_available_qty")
  /// 缓存：加购批次的可用合计（不管是否停用）
  addonAvailableQty         Int       @default(0) @map("addon_available_qty")
  /// 缓存：全部批次的冻结合计
  heldTotalQty              Int       @default(0) @map("held_total_qty")
  /// 下一个要处理的时刻 = min(当前周期 ends_at, 最早的待发放 due_at)；每分钟扫描查它
  nextDueAt                 DateTime? @map("next_due_at") @db.Timestamptz(3)
  /// 该主体最近一次账本操作的时刻，保证账本时钟单调；从未操作为空
  lastOpAt                  DateTime? @map("last_op_at") @db.Timestamptz(3)
  /// 最近一次期末清零的数量，供“已清零 N”展示
  lastExpiredQty            Int?      @map("last_expired_qty")
  /// 最近一次期末清零的时刻；与 last_expired_qty 同有同无
  lastExpiredAt             DateTime? @map("last_expired_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt                 DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt                 DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity                  Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_billing_account_entity_id")
  /// 关系：current_subscription_term_id → subscription_term.id
  currentSubscriptionTerm SubscriptionTerm? @relation(fields: [currentSubscriptionTermId], references: [id], onDelete: Restrict, map: "fk_billing_account_current_subscription_term_id")

  @@index([nextDueAt], map: "ix_billing_account_next_due_at")
  @@index([subStatus], map: "ix_billing_account_sub_status")
  @@map("billing_account")
}

/// 订阅周期：一次套餐购买对应一个周期，带权益快照
model SubscriptionTerm {
  /// 主键，UUID v7，应用生成
  id                    String    @id(map: "pk_subscription_term") @db.Uuid
  /// 主体
  entityId              String    @map("entity_id") @db.Uuid
  /// 该主体的第几个周期，从 1 起
  termNo                Int       @map("term_no")
  /// 来源：new 首次开通 / renew 续接 / resume 过期后重新开通
  origin                String
  /// 当前版本；升级后更新
  planId                String    @map("plan_id") @db.Uuid
  /// 当前价目修订；升级后更新
  planRevisionId        String    @map("plan_revision_id") @db.Uuid
  /// 购买时适用的价目修订；不随升级改变
  initialPlanRevisionId String    @map("initial_plan_revision_id") @db.Uuid
  /// 购买周期（月），不小于 1；可选值由参数 enabledCycles 决定
  months                Int
  /// 购买该周期的应付金额（分），不含之后的升级补差
  priceTotalFen         Int       @map("price_total_fen")
  /// 月度分摊金额 = floor(周期总价 ÷ 月数)；升级后改为新版本的值；MRR 用
  monthlyEquivFen       Int       @map("monthly_equiv_fen")
  /// 权益快照：每月套餐积分
  monthlyPoints         Int       @map("monthly_points")
  /// 权益快照：订剧与广告折扣（万分比）
  discountBp            Int       @map("discount_bp")
  /// 权益快照：制作模型，取值同 plan_revision.production_model
  productionModel       String    @map("production_model")
  /// 权益快照：可管理门店数
  maxStores             Int       @map("max_stores")
  /// 权益快照：成员数上限；空 = 不限
  maxMembers            Int?      @map("max_members")
  /// 权益快照：制作排期，取值同 plan_revision.schedule_priority
  schedulePriority      String    @map("schedule_priority")
  /// 权益快照：是否含月度效果报告
  hasMonthlyReport      Boolean   @default(false) @map("has_monthly_report")
  /// 锚定日（1 到 31）：开通当天是几号；连续续费沿用，过期后重新开通时重置
  anchorDay             Int       @map("anchor_day") @db.SmallInt
  /// 起始日（含），北京时间
  startDate             DateTime  @map("start_date") @db.Date
  /// 止日（含），含补偿延长
  endDate               DateTime  @map("end_date") @db.Date
  /// 起点时刻。首期与过期后续费 = 履约事务的账本时钟；预约周期 = 上一周期 ends_at
  startsAt              DateTime  @map("starts_at") @db.Timestamptz(3)
  /// 终点时刻（不含）= end_date 次日 00:00（北京时间）
  endsAt                DateTime  @map("ends_at") @db.Timestamptz(3)
  /// 累计补偿延长天数
  extendedDays          Int       @default(0) @map("extended_days")
  /// 周期状态：scheduled 预约未生效 / active 生效中 / ended 已到期 / refunded 已退款 / cancelled 未生效即退款
  status                String
  /// 非空 = 退款处理中（主体级闸门，M66）：退款申请提交时写入；申请以 not_executed 关闭、开始执行时清空；补记渠道退款遇此标记时不回收、不清空（M100、A156）
  refundRequestId       String?   @map("refund_request_id") @db.Uuid
  /// 退款规则：window 窗口内 / qualification_failed 资质终审不通过 / override 规则外（与 refund_request.rule_code 同值，M67）。与 refund_request_id 同有同无
  refundRule            String?   @map("refund_rule")
  /// 来源付款单；一张付款单至多建一个周期
  sourceBillingOrderId  String    @unique(map: "uq_subscription_term_source_billing_order_id") @map("source_billing_order_id") @db.Uuid
  /// 生效时刻；scheduled、cancelled 为空
  activatedAt           DateTime? @map("activated_at") @db.Timestamptz(3)
  /// 最近一次到期处理的逻辑时刻（= 当时的 ends_at）；延长补批复活时清空
  endedAt               DateTime? @map("ended_at") @db.Timestamptz(3)
  /// 退款作废时刻；refunded、cancelled 时必填
  refundedAt            DateTime? @map("refunded_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity                  Entity                 @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_subscription_term_entity_id")
  /// 关系：plan_id → plan.id
  plan                    Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_subscription_term_plan_id")
  /// 关系：plan_revision_id → plan_revision.id
  planRevision            PlanRevision           @relation("SubscriptionTermPlanRevision", fields: [planRevisionId], references: [id], onDelete: Restrict, map: "fk_subscription_term_plan_revision_id")
  /// 关系：initial_plan_revision_id → plan_revision.id
  initialPlanRevision     PlanRevision           @relation("SubscriptionTermInitialPlanRevision", fields: [initialPlanRevisionId], references: [id], onDelete: Restrict, map: "fk_subscription_term_initial_plan_revision_id")
  /// 关系：refund_request_id → refund_request.id
  refundRequest           RefundRequest?         @relation(fields: [refundRequestId], references: [id], onDelete: Restrict, map: "fk_subscription_term_refund_request_id")
  /// 关系：source_billing_order_id → billing_order.id
  sourceBillingOrder      BillingOrder           @relation(fields: [sourceBillingOrderId], references: [id], onDelete: Restrict, map: "fk_subscription_term_source_billing_order_id")
  /// 反向：发起时以本周期为当前周期的延长单
  termExtensionsRequested TermExtensionRequest[] @relation("TermExtensionRequestedTerm")
  /// 反向：实际作用在本周期上的延长单
  termExtensionsApplied   TermExtensionRequest[] @relation("TermExtensionAppliedTerm")
  billingAccounts         BillingAccount[]
  subscriptionEvents      SubscriptionEvent[]
  grantSchedules          GrantSchedule[]
  pointLots               PointLot[]
  pointHolds              PointHold[]
  billingEntityDailies    BillingEntityDaily[]
  dramaOrders             DramaOrder[]

  @@unique([entityId, termNo], map: "uq_subscription_term_entity_id_term_no")
  @@index([entityId, status, startsAt], map: "ix_subscription_term_entity_id_status_starts_at")
  @@index([status, endsAt], map: "ix_subscription_term_status_ends_at")
  @@index([refundRequestId], map: "ix_subscription_term_refund_request_id")
  @@map("subscription_term")
}

/// 订阅事件：订阅的事实表（只增），等价于订阅的状态历史
model SubscriptionEvent {
  /// 主键，UUID v7，应用生成
  id                 String   @id(map: "pk_subscription_event") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq                BigInt   @unique(map: "uq_subscription_event_seq") @default(autoincrement())
  /// 主体
  entityId           String   @map("entity_id") @db.Uuid
  /// 事件所属的周期
  subscriptionTermId String   @map("subscription_term_id") @db.Uuid
  /// 事件类型，12 个取值：activated、renewal_scheduled、rolled_over、upgraded、downgrade_scheduled、extended、expired、resumed、refund_suspended、refund_resumed、refunded、cancelled。含义见第 3.1 节
  type               String
  /// 变更前的版本；升降级、续费换版本时填
  fromPlanId         String?  @map("from_plan_id") @db.Uuid
  /// 变更后的版本
  toPlanId           String?  @map("to_plan_id") @db.Uuid
  /// 变更前的价目修订
  fromPlanRevisionId String?  @map("from_plan_revision_id") @db.Uuid
  /// 变更后的价目修订
  toPlanRevisionId   String?  @map("to_plan_revision_id") @db.Uuid
  /// 关联付款单：开通、续费、升级时填
  billingOrderId     String?  @map("billing_order_id") @db.Uuid
  /// 事件细节，按 type 各有 Zod schema。结构见第 4 节
  payload            Json?
  /// 业务生效时刻；到点类事件取逻辑时间（如到期时刻）
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  /// 归属业务日（北京时间）；到期类事件取周期最后一天
  bizDate            DateTime @map("biz_date") @db.Date
  /// 操作人类型：merchant 商家用户 / staff 员工 / system 系统 / partner 服务商（V1.0 只声明）。见 catalogue enums_shared
  actorType          String   @map("actor_type")
  /// 操作人：商家用户或员工的 id；system 时为空
  /// 不建外键：操作人多态（merchant_user / staff），按 actor_type 区分
  actorId            String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空。见 catalogue enums_shared
  client             String?
  /// 创建时间，应用时钟写入
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_subscription_event_entity_id")
  /// 关系：subscription_term_id → subscription_term.id
  subscriptionTerm SubscriptionTerm @relation(fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_subscription_event_subscription_term_id")
  /// 关系：from_plan_id → plan.id
  fromPlan         Plan?            @relation("SubscriptionEventFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict, map: "fk_subscription_event_from_plan_id")
  /// 关系：to_plan_id → plan.id
  toPlan           Plan?            @relation("SubscriptionEventToPlan", fields: [toPlanId], references: [id], onDelete: Restrict, map: "fk_subscription_event_to_plan_id")
  /// 关系：from_plan_revision_id → plan_revision.id
  fromPlanRevision PlanRevision?    @relation("SubscriptionEventFromPlanRevision", fields: [fromPlanRevisionId], references: [id], onDelete: Restrict, map: "fk_subscription_event_from_plan_revision_id")
  /// 关系：to_plan_revision_id → plan_revision.id
  toPlanRevision   PlanRevision?    @relation("SubscriptionEventToPlanRevision", fields: [toPlanRevisionId], references: [id], onDelete: Restrict, map: "fk_subscription_event_to_plan_revision_id")
  /// 关系：billing_order_id → billing_order.id
  billingOrder     BillingOrder?    @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_subscription_event_billing_order_id")

  @@index([entityId, occurredAt], map: "ix_subscription_event_entity_id_occurred_at")
  @@index([subscriptionTermId], map: "ix_subscription_event_subscription_term_id")
  @@index([type, bizDate], map: "ix_subscription_event_type_biz_date")
  @@map("subscription_event")
}

/// 月度发放计划：周期创建时一次生成 N 行，记每月应发积分与分摊的套餐款
model GrantSchedule {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_grant_schedule") @db.Uuid
  /// 所属周期
  subscriptionTermId String    @map("subscription_term_id") @db.Uuid
  /// 主体（从周期复制）
  entityId           String    @map("entity_id") @db.Uuid
  /// 月序号，从 0 起到 N−1（与快照里的 monthIndex 同值）
  monthNo            Int       @map("month_no") @db.SmallInt
  /// 应发时刻；第 0 个月 = 周期 starts_at，其余 = 当月发放日 00:00（北京时间）
  dueAt              DateTime  @map("due_at") @db.Timestamptz(3)
  /// 应发日期 = due_at 的北京时间日期
  dueDate            DateTime  @map("due_date") @db.Date
  /// 该月应发积分，大于 0；升级后改为新版本的值
  points             Int
  /// 该月分摊的套餐款（分）：周期实付 ÷ 月数向下取整，尾差放最后一个月；升级后加上该月差价
  valueFen           Int       @map("value_fen")
  /// 发放时的版本
  planId             String    @map("plan_id") @db.Uuid
  /// 发放时的价目修订
  planRevisionId     String    @map("plan_revision_id") @db.Uuid
  /// 状态：pending 待发放 / granted 已发放 / cancelled 已取消（套餐退款）
  status             String    @default("pending")
  /// 发放后生成的批次；granted 时必填
  pointLotId         String?   @map("point_lot_id") @db.Uuid
  /// 发放时刻（逻辑时间 = due_at）；granted 时必填
  grantedAt          DateTime? @map("granted_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：subscription_term_id → subscription_term.id
  subscriptionTerm SubscriptionTerm @relation(fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_grant_schedule_subscription_term_id")
  /// 关系：entity_id → entity.id
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_grant_schedule_entity_id")
  /// 关系：plan_id → plan.id
  plan             Plan             @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_grant_schedule_plan_id")
  /// 关系：plan_revision_id → plan_revision.id
  planRevision     PlanRevision     @relation(fields: [planRevisionId], references: [id], onDelete: Restrict, map: "fk_grant_schedule_plan_revision_id")
  /// 关系：point_lot_id → point_lot.id
  pointLot         PointLot?        @relation(fields: [pointLotId], references: [id], onDelete: Restrict, map: "fk_grant_schedule_point_lot_id")

  @@unique([subscriptionTermId, monthNo], map: "uq_grant_schedule_subscription_term_id_month_no")
  @@index([status, dueAt], map: "ix_grant_schedule_status_due_at")
  @@index([entityId, status], map: "ix_grant_schedule_entity_id_status")
  @@map("grant_schedule")
}

/// 积分批次：积分按来源、到期、入账成本存放；七个桶之和恒等于入账数量
model PointLot {
  /// 主键，UUID v7，应用生成
  id                       String    @id(map: "pk_point_lot") @db.Uuid
  /// 主体
  entityId                 String    @map("entity_id") @db.Uuid
  /// 积分类型：plan 套餐积分 / addon 加购积分。见 catalogue enums_shared 的 point_lot_kind
  kind                     String
  /// 来源类别：grant_monthly 月度发放 / grant_upgrade 升级补发 / purchase 加购 / adjust 调整增加 / conversion 原周期已结束的退回转为加购。不是表名，对应关系见第 3 节
  sourceType               String    @map("source_type")
  /// 来源对象：发放计划 / 升级付款单 / 加购付款单 / 审批单 / 退回所在的账本操作
  /// 不建外键：按 source_type 多态（grant_schedule / billing_order / approval_request / ledger_operation）
  sourceId                 String    @map("source_id") @db.Uuid
  /// 同一来源对象下的序号：grant_upgrade = 发放计划的 month_no；conversion = 该次退回里的第几个转出批次（从 1 起）；其余为 0
  sourceNo                 Int       @default(0) @map("source_no") @db.SmallInt
  /// 所属周期；plan 必填，addon 为空
  subscriptionTermId       String?   @map("subscription_term_id") @db.Uuid
  /// 来源版本，报表按版本拆分；plan 必填（调整增加的套餐批次取当前周期的版本），addon 为空
  planId                   String?   @map("plan_id") @db.Uuid
  /// 来源价目修订；与 plan_id 同有同无
  planRevisionId           String?   @map("plan_revision_id") @db.Uuid
  /// conversion 时指向原套餐批次；其余为空
  originPointLotId         String?   @map("origin_point_lot_id") @db.Uuid
  /// conversion 时指向原批次的那条“转出”流水，估值按它取转入价值；其余为空
  originPointLedgerEntryId String?   @map("origin_point_ledger_entry_id") @db.Uuid
  /// 入账时刻（逻辑时间）
  grantedAt                DateTime  @map("granted_at") @db.Timestamptz(3)
  /// 入账归属业务日（北京时间）
  bizDate                  DateTime  @map("biz_date") @db.Date
  /// 到期时刻；plan 必填且 = 所属周期 ends_at（延长时同步顺延），addon 为空（长期有效）
  expiresAt                DateTime? @map("expires_at") @db.Timestamptz(3)
  /// 入账数量，大于 0，入账后不变
  originalQty              Int       @map("original_qty")
  /// 可用
  availableQty             Int       @map("available_qty")
  /// 冻结（订购、广告占用）
  heldQty                  Int       @default(0) @map("held_qty")
  /// 已消耗（开始制作后）
  consumedQty              Int       @default(0) @map("consumed_qty")
  /// 已清零
  expiredQty               Int       @default(0) @map("expired_qty")
  /// 套餐退款作废
  revokedQty               Int       @default(0) @map("revoked_qty")
  /// 转为加购积分转出
  convertedOutQty          Int       @default(0) @map("converted_out_qty")
  /// 手动调整扣减
  adjustedOutQty           Int       @default(0) @map("adjusted_out_qty")
  /// 入账成本（分）：这批积分对应的实付金额，入账后不变；conversion 为空（估值取原批次转出流水的价值），调整增加为 0
  costBasisFen             Int?      @map("cost_basis_fen")
  /// 创建时间，应用时钟写入
  createdAt                DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间；估值任务按它找有变动的批次
  updatedAt                DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity                 Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_point_lot_entity_id")
  /// 关系：subscription_term_id → subscription_term.id
  subscriptionTerm       SubscriptionTerm?     @relation(fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_point_lot_subscription_term_id")
  /// 关系：plan_id → plan.id
  plan                   Plan?                 @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_point_lot_plan_id")
  /// 关系：plan_revision_id → plan_revision.id
  planRevision           PlanRevision?         @relation(fields: [planRevisionId], references: [id], onDelete: Restrict, map: "fk_point_lot_plan_revision_id")
  /// 关系：origin_point_lot_id → point_lot.id
  originPointLot         PointLot?             @relation("PointLotOrigin", fields: [originPointLotId], references: [id], onDelete: Restrict, map: "fk_point_lot_origin_point_lot_id")
  /// 关系：origin_point_ledger_entry_id → point_ledger_entry.id
  originPointLedgerEntry PointLedgerEntry?     @relation("PointLotOriginEntry", fields: [originPointLedgerEntryId], references: [id], onDelete: Restrict, map: "fk_point_lot_origin_point_ledger_entry_id")
  /// 反向：由本批次转出的加购批次
  convertedPointLots     PointLot[]            @relation("PointLotOrigin")
  /// 反向：本批次的流水
  ledgerEntries          PointLedgerEntry[]    @relation("PointLedgerEntryLot")
  grantSchedules         GrantSchedule[]
  pointHoldAllocs        PointHoldAlloc[]
  pointEntryValuations   PointEntryValuation[]

  @@unique([sourceType, sourceId, sourceNo], map: "uq_point_lot_source_type_source_id_source_no")
  @@index([entityId], map: "ix_point_lot_entity_id")
  @@index([subscriptionTermId], map: "ix_point_lot_subscription_term_id")
  @@index([updatedAt], map: "ix_point_lot_updated_at")
  @@map("point_lot")
}

/// 冻结单：一笔订购明细、一条广告或一次超次修改占用的积分，带计价快照
model PointHold {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_point_hold") @db.Uuid
  /// 主体
  entityId           String    @map("entity_id") @db.Uuid
  /// 下单门店
  storeId            String    @map("store_id") @db.Uuid
  /// 用途：order_item 订购明细 / ad 广告 / ad_revision 超次修改。见 catalogue enums_shared 的 point_hold_purpose
  purpose            String
  /// 业务引用的类型，取最终表名：order_item / ad / ad_revision；也是幂等键 hold:{ref_type}:{ref_id} 的一段
  refType            String    @map("ref_type")
  /// 业务引用：订单项、广告、广告修改记录的 id
  /// 不建外键：按 ref_type 多态，且 L2 不引用 L3；反向由订购侧持有外键
  refId              String    @map("ref_id") @db.Uuid
  /// 展示聚合键：同一订购单或同一次广告提交的业务单号；不是外键
  groupRef           String?   @map("group_ref")
  /// 应扣积分 S，大于 0
  qty                Int
  /// 状态：held 已冻结 / captured 已扣减 / released 已释放 / refunded_partial 部分退回 / refunded_full 全额退回
  status             String
  /// 累计退回给商家的数量（含转为加购积分的部分）
  returnedQty        Int       @default(0) @map("returned_qty")
  /// 累计“原周期已结束、不予退回”的数量；仅快照里 expiredTermRefund 取 forfeit 时出现
  forfeitedQty       Int       @default(0) @map("forfeited_qty")
  /// 计价与规则快照，由 hold 在账户锁内生成。结构见第 4 节
  pricingSnapshot    Json      @map("pricing_snapshot")
  /// 冻结时的生效周期；套餐退款判断“本周期是否用过积分”用它
  subscriptionTermId String    @map("subscription_term_id") @db.Uuid
  /// 冻结时刻（账本时钟）
  heldAt             DateTime  @map("held_at") @db.Timestamptz(3)
  /// 扣减时刻；captured 及之后的状态必填
  capturedAt         DateTime? @map("captured_at") @db.Timestamptz(3)
  /// 进入 released 或 refunded_full 的时刻
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 操作人类型：merchant 商家用户 / staff 员工 / system 系统 / partner 服务商（V1.0 只声明）。见 catalogue enums_shared
