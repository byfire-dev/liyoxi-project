  isLead                             Boolean            @default(false) @map("is_lead")
  /// 所属员工分组
  staffGroupId                       String?            @map("staff_group_id") @db.Uuid
  /// 账号状态：pending / active / disabled
  status                             String
  /// 口令哈希（scrypt$N$r$p$salt$hash）；空 = 尚未激活或已被重置
  passwordHash                       String?            @map("password_hash")
  /// 最近一次设置口令的时间
  passwordChangedAt                  DateTime?          @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP 密钥密文（独立的 MFA 密钥加密）
  totpSecretEnc                      String?            @map("totp_secret_enc")
  /// TOTP 绑定完成时间；非空表示已绑定
  totpEnrolledAt                     DateTime?          @map("totp_enrolled_at") @db.Timestamptz(3)
  /// 绑定中的 TOTP 密钥密文（暂存，确认后转正并清空）
  totpPendingSecretEnc               String?            @map("totp_pending_secret_enc")
  /// 绑定中密钥的生成时间
  totpPendingAt                      DateTime?          @map("totp_pending_at") @db.Timestamptz(3)
  /// 最近一次通过校验的 TOTP 时间步，新校验必须严格大于它
  totpLastStep                       Int?               @map("totp_last_step")
  /// 一次性恢复码的 sha256 列表，用掉即移除，结构见文档第 4 节
  recoveryCodes                      Json               @default("[]") @map("recovery_codes")
  /// 企业微信成员 userid，唯一；解绑后保留，供企业微信回调对到员工
  wecomUserid                        String?            @unique(map: "uq_staff_wecom_userid") @map("wecom_userid")
