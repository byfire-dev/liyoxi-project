/// 经营主体：租户骨架、主体名称与统一社会信用代码、认证结论
model Entity {
  /// 主键，UUID v7
  id                   String    @id(map: "pk_entity") @db.Uuid
  /// 生命周期：active / abandoned / closed
  lifecycle            String
  /// 认证结论（initial 轮次的结论）：unsubmitted / pending / verified / rejected；由 profile 经 tenant 的函数写
  verificationStatus   String    @map("verification_status")
  /// 营业执照主体名称；认证通过时写入
