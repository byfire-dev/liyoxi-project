/// 门店：租户骨架、生命周期、交付经理与资质结论（档案在 store_profile）
model Store {
  /// 自动补的反向关系字段
  storeProfileStore                    StoreProfile?       @relation("StoreProfileStore")
  /// 自动补的反向关系字段
  storeProfileCopiedFromStoreList      StoreProfile[]      @relation("StoreProfileCopiedFromStore")
  /// 自动补的反向关系字段
  storeProfileMediaStoreList           StoreProfileMedia[] @relation("StoreProfileMediaStore")
  /// 自动补的反向关系字段
  storeProfileMediaCopiedFromStoreList StoreProfileMedia[] @relation("StoreProfileMediaCopiedFromStore")
  /// 自动补的反向关系字段
  fileObjectStoreList                  FileObject[]        @relation("FileObjectStore")
  /// 自动补的反向关系字段
  fileObjectOnBehalfStoreList          FileObject[]        @relation("FileObjectOnBehalfStore")
  /// 主键，UUID v7
  id                                   String              @id(map: "pk_store") @db.Uuid
  /// 所属主体
  entityId                             String              @map("entity_id") @db.Uuid
  /// 门店名称；首家门店创建时可为空
  name                                 String?
  /// 是否首家门店（历史标记，不随停用转移）
  isPrimary                            Boolean             @default(false) @map("is_primary")
  /// 生命周期：active / archived
  lifecycle                            String
  /// 资质结论：unsubmitted / pending / verified / rejected；由 profile 经 tenant 的函数写
  qualificationStatus                  String              @default("unsubmitted") @map("qualification_status")
  /// 交付经理；为空表示待分配
  deliveryManagerId                    String?             @map("delivery_manager_id") @db.Uuid
  /// 停用时间
  archivedAt                           DateTime?           @map("archived_at") @db.Timestamptz(3)
  /// 停用操作人类型：merchant / staff / system / partner
  archiveActorType                     String?             @map("archive_actor_type")
  /// 停用操作人 id；system 时为空
  /// 不建外键：多态引用（merchant_user 或 staff）
  archiveActorId                       String?             @map("archive_actor_id") @db.Uuid
  /// 停用操作的客户端来源：weapp / portal / admin；系统动作为空
  archiveClient                        String?             @map("archive_client")
