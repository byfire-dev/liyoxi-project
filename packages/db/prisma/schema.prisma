  /// 在办事项接收人
  handoverToStaff Staff?      @relation("StaffHandoverTo", fields: [handoverToStaffId], references: [id], onDelete: Restrict, map: "fk_staff_handover_to_staff_id")
  /// 创建人
  createdByStaff  Staff?      @relation("StaffCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_staff_created_by_staff_id")

  // 以下是反向关系字段。同一对模型之间有多个关系时，prisma format 自动补出的反向字段会重名，
  // 所以本分组内的这几组由片段自己写出；只有一个关系的反向字段仍交给 format 补。
  /// 反向：由我禁用的员工
  disabledStaffs               Staff[]                  @relation("StaffDisabledBy")
