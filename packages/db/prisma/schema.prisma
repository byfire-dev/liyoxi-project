  /// 所属主体
  entity            Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_change_request_entity_id")
  /// 所属门店（归属复合外键）
  store             Store                @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_plan_change_request_store_entity")
  /// 所属方案
  deliveryPlan      DeliveryPlan         @relation(fields: [deliveryPlanId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_change_request_delivery_plan_id")
  /// 提出人
  createdByUser     MerchantUser         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_change_request_created_by_user_id")
  /// 针对的版本（复合外键，保证版本存在）
  onVersion         DeliveryPlanVersion  @relation("DeliveryPlanChangeRequestOnVersion", fields: [deliveryPlanId, onVersionNo], references: [deliveryPlanId, versionNo], onDelete: Restrict, map: "fk_delivery_plan_change_request_on_version")
  /// 解决它的版本（复合外键）
  resolvedByVersion DeliveryPlanVersion? @relation("DeliveryPlanChangeRequestResolvedByVersion", fields: [deliveryPlanId, resolvedByVersionNo], references: [deliveryPlanId, versionNo], onDelete: Restrict, map: "fk_delivery_plan_change_request_resolved_by_version")

  @@index([deliveryPlanId, createdAt], map: "ix_delivery_plan_change_request_delivery_plan_id_created_at")
  @@index([storeId], map: "ix_delivery_plan_change_request_store_id")
  @@map("delivery_plan_change_request")
