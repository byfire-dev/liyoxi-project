// 狸有戏现行数据库结构；首版 166 张模型从冻结底稿迁入，后续独立迁移增 notification_fanout。
// 冻结底稿只用于首版等价证明；现行结构经迁移快照与库→schema 差异检查核对。
// 按分组分段（// ===== 分组 =====），每段对应 docs/data-model/<分组>.md。
// 手写约束（CHECK、部分唯一索引、排他约束、触发器）不在本文件里：首版迁移 prisma/migrations/ 由本文件
// 的建表语句接上 docs/data-model/constraints/ 拼出（scripts/build-init-migration.mjs）。结构以迁移为准。
// 标“自动补的反向关系字段”的字段由合并脚本补出，只为满足 Prisma 的双向关系要求。
generator client {
  provider = "prisma-client"
  output   = "../dist/generated"
}

datasource db {
  provider = "postgresql"
}

// ===== 01-kernel-flow =====
// 分组 01-kernel-flow：内核与流程基础（kernel、events、timers、flow、sla，全部 L0）。7 张表。
// 依据：docs/appendix/design/d3-flow.md 第 3.3、19–22、25.2 节；d7-platform.md 第 3.1、7.3、7.6 节；
//       catalogue.json；rulings M14、M19、M21、M22、M31、M33、M34、M44、M45、M48、M52、M53、M65；第三轮 M101–M103。
// L0 的表不引用上层的表：entity_id、store_id、subject_id、aggregate_id、actor_id 只存 id，不建外键（M47 不适用）。
// 本分组唯一的外键：outbox_delivery.outbox_event_id → outbox_event.id（写在本片段，手写 SQL 里没有外键）。

/// 幂等记录：写接口的幂等行与业务写同事务；并发同键请求阻塞在主键上，只持久化成功结果
model IdempotencyRecord {
  /// 路由的 operationId，如 m.order.submit
  scope       String
  /// 操作人键：<操作人类型>:<操作人 id>；类型段只取 merchant / staff / system / partner
  actorKey    String    @map("actor_key")
  /// Idempotency-Key 请求头，不超过 128 个字符，字符集 [A-Za-z0-9:_-]
  key         String
  /// sha256(方法 + 路径参数 + 规范化后的请求体；商家端另计入 X-Store-Id，A121)，十六进制小写 64 位
  requestHash String    @map("request_hash")
  /// 处理状态：done 已完成 / in_progress 三段式用例占用中
  state       String
  /// 仅三段式：本次处理的占用到期时间
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  /// 用例函数的返回值（角色裁剪之前的 DTO），重放时由路由层重新裁剪
  result      Json?
  /// 落库时间
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间（写入 result、三段式改状态或续占）
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// 过期时间 = created_at + 24 小时；过期行每小时物理删除
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)

  @@id([scope, actorKey, key], map: "pk_idempotency_record")
  @@index([expiresAt], map: "ix_idempotency_record_expires_at")
  @@map("idempotency_record")
}

/// 业务单号流水：按前缀 + 业务日取号，事务内自增
model BizSequence {
  /// 单号前缀：LYX / FK / GG / KF / TK / TZ / YQ / ZH / KP / CY / DC
  prefix    String
  /// 业务日，按 Asia/Shanghai 取日
  bizDate   DateTime @map("biz_date") @db.Date
  /// 下一个待发的流水号，从 1 起；取号语句返回 next_val - 1
  nextVal   Int      @map("next_val")
  /// 落库时间（当日该前缀第一次取号）
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次取号时间；取号语句的 DO UPDATE 同时写 now()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([prefix, bizDate], map: "pk_biz_sequence")
  @@map("biz_sequence")
}

/// 出站事件：业务事务内写入的领域事件；published_at 表示已为每个订阅者生成投递行
model OutboxEvent {
  /// 主键，UUID v7，应用生成
  id               String           @id(map: "pk_outbox_event") @db.Uuid
  /// 自增序号，中继按它升序扫描；不出接口
  seq              BigInt           @unique(map: "uq_outbox_event_seq") @default(autoincrement())
  /// 事件类型，如 order.started；取值登记在 packages/contract 的事件目录
  eventType        String           @map("event_type")
  /// 聚合类型，取最终表名（只做格式校验，取值登记在 packages/contract）；没有聚合行的系统级事件为空
  aggregateType    String?          @map("aggregate_type")
  /// 不建外键：L0 不引用上层表；聚合行的 id，按 aggregate_type 多态
  aggregateId      String?          @map("aggregate_id") @db.Uuid
  /// 不建外键：L0 只存 id；所属主体，平台级事件为空
  entityId         String?          @map("entity_id") @db.Uuid
  /// 不建外键：L0 只存 id；所属门店，主体级与平台级事件为空
  storeId          String?          @map("store_id") @db.Uuid
  /// 事件负载 { v: 数字版本号, … }：只放 id 与必要快照，订阅者回库读当前状态
  payload          Json
  /// 操作人类型：merchant / staff / system / partner（V1.0 不写入 partner）
  actorType        String           @map("actor_type")
  /// 不建外键：L0 只存 id；操作人 id，system 时为空
  actorId          String?          @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空；不含 audit_log 独有的 cli（M102）
  client           String?
  /// 商家角色快照：owner / clerk；操作人不是商家时为空
  actorRole        String?          @map("actor_role")
  /// 客户端平台，取自 X-Client-Platform（ios / android / harmony / windows / mac / devtools）
  clientPlatform   String?          @map("client_platform")
  /// 客户端版本，取自 X-Client-Version
  clientVersion    String?          @map("client_version")
  /// 请求追踪号（X-Request-Id）；worker 处理该事件时的日志带同一个值
  requestId        String?          @map("request_id")
  /// 事件发生时间，取业务事务的应用时钟
  occurredAt       DateTime         @map("occurred_at") @db.Timestamptz(3)
  /// 去重键：同一事实只应发一次时使用，如 tmr:{定时器去重键}
  dedupeKey        String?          @unique(map: "uq_outbox_event_dedupe_key") @map("dedupe_key")
  /// 已为每个订阅者生成投递行的时间；只能从空写一次
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  /// 落库时间
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  outboxDeliveries OutboxDelivery[]

  @@index([aggregateType, aggregateId], map: "ix_outbox_event_aggregate_type_aggregate_id")
  @@map("outbox_event")
}

/// 出站投递：事件 × 订阅者一行，库里的投递真相（状态、失败次数、租约、派发序号、死信）
model OutboxDelivery {
  /// 所属出站事件
  outboxEventId String    @map("outbox_event_id") @db.Uuid
  /// 订阅者注册名（代码登记），如 support.onBizEvent；不含冒号与连字符
  subscriber    String
  /// 投递状态：pending / leased / done / retry / dead；技术状态，不写状态历史
  status        String    @default("pending")
  /// 处理失败次数（含处理器失联）；入队失败不计
  attempts      Int       @default(0) @db.SmallInt
  /// 派发序号：每次派发 + 1，是任务 jobId 的一段，也是消费时的接管判据
  dispatchNo    Int       @default(0) @map("dispatch_no")
  /// 下次可派发时间；失败退避时后移
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// 租约到期时间；leased 时必有
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  /// 本次派发是否已成功交给执行通道
  isEnqueued    Boolean   @default(false) @map("is_enqueued")
  /// 最近一次失败的错误摘要
  lastError     String?   @map("last_error")
  /// 消费成功时间；done 时必有
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// 落库时间（中继展开的时间）
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict, map: "fk_outbox_delivery_outbox_event_id")

  @@id([outboxEventId, subscriber], map: "pk_outbox_delivery")
  @@map("outbox_delivery")
}

/// 定时器：一行一个时限，到期时间是业务真相；周期任务的每一期也是一行
model Timer {
  /// 主键，UUID v7，应用生成
  id          String    @id(map: "pk_timer") @db.Uuid
  /// 规则编码，对应代码里注册的处理器，如 order.start、sla.breach
  kind        String
  /// 主体类型，取最终表名（只做格式校验，取值登记在 packages/contract）；周期任务行为空
  subjectType String?   @map("subject_type")
  /// 不建外键：L0 不引用上层表；主体行的 id，按 subject_type 多态；周期任务行为空
  subjectId   String?   @map("subject_id") @db.Uuid
  /// 不建外键：L0 只存 id；所属主体，可空
  entityId    String?   @map("entity_id") @db.Uuid
  /// 不建外键：L0 只存 id；所属门店，可空
  storeId     String?   @map("store_id") @db.Uuid
  /// 到期时间（业务真相）
  fireAt      DateTime  @map("fire_at") @db.Timestamptz(3)
  /// 处理失败后的下次重试时间；不改 fire_at
  retryAt     DateTime? @map("retry_at") @db.Timestamptz(3)
  /// 语义去重键，含目标日期、轮次、版本或用途；未取消的行里唯一（fired、skipped、failed 都占键）
  dedupeKey   String    @map("dedupe_key")
  /// 创建时的参数快照，结构按 kind 定义；时限类为 SlaSnapshot
  payload     Json?
  /// 状态：scheduled / dispatched / fired / skipped / cancelled / failed；技术状态，不写状态历史
  status      String    @default("scheduled")
  /// 认领序号：每次认领 + 1，是任务 jobId 的一段，也是执行时的接管判据
  dispatchNo  Int       @default(0) @map("dispatch_no")
  /// 处理失败次数（处理器抛错或失联）；入队失败不计
  attempts    Int       @default(0) @db.SmallInt
  /// 本次认领是否已成功交给执行通道
  isEnqueued  Boolean   @default(false) @map("is_enqueued")
  /// 租约到期时间；dispatched 时必有
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(3)
  /// 处理完成时间；fired、skipped 时必有
  firedAt     DateTime? @map("fired_at") @db.Timestamptz(3)
  /// 最近一次失败的错误摘要
  lastError   String?   @map("last_error")
  /// 运行摘要（周期任务的处理条数、备份对象键与大小等）
  result      Json?
  /// 落库时间
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次更新时间
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([kind, fireAt], map: "ix_timer_kind_fire_at")
  @@map("timer")
}

/// 状态变更历史：flow.transition() 每次迁移写一行，只追加；停留时长在写入时固化
model StatusTransition {
  /// 主键，UUID v7，应用生成
  id               String   @id(map: "pk_status_transition") @db.Uuid
  /// 自增序号，同一对象的历史按它排序；不出接口
  seq              BigInt   @unique(map: "uq_status_transition_seq") @default(autoincrement())
  /// 状态机，取最终表名（25 张业务状态机表之一；只做格式校验，取值登记在 packages/contract）
  machine          String
  /// 不建外键：L0 不引用上层表；状态机对象的 id，按 machine 多态
  subjectId        String   @map("subject_id") @db.Uuid
  /// 被迁移的状态列名，如 status、lifecycle、qualification_status；同一张表有两个状态列时靠它分链
  stateField       String   @map("state_field")
  /// 不建外键：L0 只存 id；所属主体，全局对象（短剧、员工）为空
  entityId         String?  @map("entity_id") @db.Uuid
  /// 不建外键：L0 只存 id；所属门店，可空
  storeId          String?  @map("store_id") @db.Uuid
  /// 迁移前状态；对象创建时为空
  fromState        String?  @map("from_state")
  /// 迁移后状态；不改状态的动作 from_state = to_state
  toState          String   @map("to_state")
  /// 状态机事件名；暂停、恢复、改派、改期、补发等也各写一行；人工纠偏固定为 admin.force
  event            String
  /// 操作人类型：merchant / staff / system / partner（V1.0 不写入 partner）
  actorType        String   @map("actor_type")
  /// 不建外键：L0 只存 id；操作人 id，system 时为空
  actorId          String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空；不含 audit_log 独有的 cli（M102）
  client           String?
  /// 不建外键：L0 只存 id；被代理的商家用户（V1.1 经授权代为确认时写入，V1.0 不写入）
  onBehalfOfUserId String?  @map("on_behalf_of_user_id") @db.Uuid
  /// 原因编码（字典编码或状态机内的原因常量）
  reasonCode       String?  @map("reason_code")
  /// 说明；人工纠偏时必填，去掉首尾空白后不少于 10 个字
  note             String?
  /// 事件载荷摘要（版本号、轮次、数量、暂停原因等）
  payload          Json?
  /// 是否人工纠偏（flow.adminTransition）
  isForced         Boolean  @default(false) @map("is_forced")
  /// 迁移发生时间，取业务事务的应用时钟
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)
  /// 业务日，occurred_at 按 Asia/Shanghai 取日，报表按它分组
  bizDate          DateTime @map("biz_date") @db.Date
  /// 与同一链上一行之间的自然秒（A144）
  elapsedSeconds   Int?     @map("elapsed_seconds")
  /// 与同一链上一行之间的工作分钟（A144；from = to 的行照常切段），写入时按当时的日历算好
  elapsedWorkMin   Int?     @map("elapsed_work_min")
  /// 请求或事件的追踪号
  requestId        String?  @map("request_id")
  /// 落库时间
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([machine, subjectId, stateField, seq], map: "ix_status_transition_machine_subject_id_state_field_seq")
  @@index([machine, stateField, toState, occurredAt], map: "ix_status_transition_machine_state_field_to_state_occurred_at")
  @@map("status_transition")
}

/// 工作日历：一天一行，年度放假安排导入时覆盖
model WorkCalendarDay {
  /// 日期（Asia/Shanghai），自然键
  day             DateTime @id(map: "pk_work_calendar_day") @db.Date
  /// 是否工作日；与 kind 一致
  isWorkday       Boolean  @default(true) @map("is_workday")
  /// 类型：weekday 平日 / weekend 周末 / holiday 放假 / adjusted_workday 调休上班
  kind            String
  /// 节日或调休名称，如“国庆节”“国庆调休”
  note            String?
  /// 最近一次改变本日类型的导入批次号；导入有实际变化时全表最大值 + 1，内容相同的重复导入不升
  calendarVersion Int      @map("calendar_version")
  /// 落库时间
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 最近一次实际改动本行的时间；内容相同的重复导入不改
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("work_calendar_day")
}

// ===== 02-identity-tenant =====
// 分组 02-identity-tenant：身份与租户（identity 8 张、tenant 6 张、portal 1 张）
// 只含本分组的 model；CHECK、部分索引、数组列的 NOT NULL、触发器见 dm/sql/02-identity-tenant.sql

// ───────────────────────── identity ─────────────────────────

/// 商家用户账号：一个手机号一个账号，可挂多个微信身份
model MerchantUser {
  /// 自动补的反向关系字段
  qualificationSubmissionSubmittedByList QualificationSubmission[] @relation("QualificationSubmissionSubmittedBy")
  /// 自动补的反向关系字段
  qualificationSubmissionCreatedByList   QualificationSubmission[] @relation("QualificationSubmissionCreatedBy")
  /// 自动补的反向关系字段
  sampleDecidedByUserList                Sample[]                  @relation("SampleDecidedByUser")
  /// 自动补的反向关系字段
  sampleViewedAckByUserList              Sample[]                  @relation("SampleViewedAckByUser")
  /// 主键，UUID v7，应用生成
  id                                     String                    @id(map: "pk_merchant_user") @db.Uuid
  /// 手机号密文（AES-256-GCM）；注销后为空
  phoneEnc                               String?                   @map("phone_enc")
  /// 手机号盲索引（HMAC-SHA256，32 字节）；唯一，空值不参与；注销后为空
  phoneBidx                              Bytes?                    @unique(map: "uq_merchant_user_phone_bidx") @map("phone_bidx")
  /// 手机号脱敏串（前 3 后 4）；注销后为空
  phoneMask                              String?                   @map("phone_mask")
  /// 手机号后四位，后台按后四位检索用；注销后为空
  phoneLast4                             String?                   @map("phone_last4")
  /// 称呼（不超过 20 字）；登录后可填，加入门店时必填；注销后为空
  displayName                            String?                   @map("display_name")
  /// 账号状态：active / disabled / deleted
  status                                 String
  /// 注册来源类型：organic / sales / campaign / partner；首触写入，不可改
  sourceType                             String                    @map("source_type")
  /// 首触时启动参数里的渠道码原值
  sourceChannelCode                      String?                   @map("source_channel_code")
  /// 首触时启动参数里的邀请码原值
  sourceInviteCode                       String?                   @map("source_invite_code")
  /// 首触时的小程序场景值
  sourceScene                            Int?                      @map("source_scene")
  /// 判定来源时命中的登记码；没有命中为空
  sourceReferralCodeId                   String?                   @map("source_referral_code_id") @db.Uuid
  /// 用户级协议当前版本集合的指纹，由 identity 写入
  consentStamp                           String?                   @map("consent_stamp")
  /// 最近活跃时间：登录与会话续期时更新，同一天只写一次
  lastActiveAt                           DateTime                  @map("last_active_at") @db.Timestamptz(3)
  /// 休眠保护的人工放行窗口截止时间；过期即失效
  dormantBypassUntil                     DateTime?                 @map("dormant_bypass_until") @db.Timestamptz(3)
  /// 创建时间
  createdAt                              DateTime                  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                              DateTime                  @map("updated_at") @db.Timestamptz(3)
  /// 注销或被判定为空账号清理的时间
  deletedAt                              DateTime?                 @map("deleted_at") @db.Timestamptz(3)

  /// 命中的登记码
  sourceReferralCode         ReferralCode?               @relation(fields: [sourceReferralCodeId], references: [id], onDelete: Restrict, map: "fk_merchant_user_source_referral_code_id")
  wechatIdentities           WechatIdentity[]
  userSessions               UserSession[]
  portalSessions             PortalSession[]
  merchantUserNotices        MerchantUserNotice[]
  smsVerifications           SmsVerification[]
  wecomContacts              WecomContact[]
  accountChangeRequests      AccountChangeRequest[]
  entities                   Entity[]
  entityMembers              EntityMember[]
  invitations                Invitation[]
  portalTickets              PortalTicket[]
  qualificationDocs          QualificationDoc[]
  billingOrders              BillingOrder[]
  transferProofs             TransferProof[]
  invoiceRequests            InvoiceRequest[]
  cartItems                  CartItem[]
  dramaOrders                DramaOrder[]
  ads                        Ad[]
  deliveryPlanChangeRequests DeliveryPlanChangeRequest[]
  channelAccountSubmissions  ChannelAccountSubmission[]
  takedownTasks              TakedownTask[]
  serviceTickets             ServiceTicket[]
  notifications              Notification[]
  merchantMessages           MerchantMessage[]
  wxSubscribeQuotas          WxSubscribeQuota[]
  agreementConsents          AgreementConsent[]

  @@index([phoneLast4], map: "ix_merchant_user_phone_last4")
  @@index([sourceReferralCodeId], map: "ix_merchant_user_source_referral_code_id")
  @@map("merchant_user")
}

/// 微信身份（appid + openid），多对一挂到商家账号
model WechatIdentity {
  /// 主键，UUID v7
  id                 String   @id(map: "pk_wechat_identity") @db.Uuid
  /// 所属商家账号；创建后不可改（改绑按删旧行、插新行实现）
  merchantUserId     String   @map("merchant_user_id") @db.Uuid
  /// 小程序 appid
  appid              String
  /// 该 appid 下的 openid；不加密
  openid             String
  /// unionid，小程序绑定开放平台后才有
  unionid            String?
  /// 是否允许静默登录；退出登录、被强制下线后为 false
  silentLoginEnabled Boolean  @default(true) @map("silent_login_enabled")
  /// 最近一次登录时间
  lastLoginAt        DateTime @map("last_login_at") @db.Timestamptz(3)
  /// 最近活跃时间：登录时写，之后距上次写入超过 30 分钟才再写；通知挑选 openid、WechatOpenIdPort 取近两小时活跃的 openid
  lastActiveAt       DateTime @map("last_active_at") @db.Timestamptz(3)
  /// 创建时间，即绑定到当前账号的时间（草案的 first_bound_at）
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属商家账号
  merchantUser      MerchantUser       @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_wechat_identity_merchant_user_id")
  userSessions      UserSession[]
  wxSubscribeQuotas WxSubscribeQuota[]

  @@unique([appid, openid], map: "uq_wechat_identity_appid_openid")
  @@index([merchantUserId], map: "ix_wechat_identity_merchant_user_id")
  @@index([unionid], map: "ix_wechat_identity_unionid")
  @@map("wechat_identity")
}

/// 商家端会话：一次登录（一台设备）一行，不透明令牌
model UserSession {
  /// 主键，即令牌里的 sid
  id                String    @id(map: "pk_user_session") @db.Uuid
  /// 会话所属账号
  merchantUserId    String    @map("merchant_user_id") @db.Uuid
  /// 登录所用的微信身份；身份行被删除后置空
  wechatIdentityId  String?   @map("wechat_identity_id") @db.Uuid
  /// 令牌密钥部分的 sha256（32 字节）；库里不存令牌本身
  tokenHash         Bytes     @map("token_hash")
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  /// 最近一次请求时间，同一天只写一次
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  /// 空闲过期时间，滑动 30 天
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  /// 绝对过期时间，创建后 90 天
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// 最近一次请求的客户端 IP
  lastIp            String    @map("last_ip")
  /// 设备信息，服务端截断到 512 字符
  deviceInfo        String?   @map("device_info")
  /// 吊销时间
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 吊销原因：logout / identity_rebound / identity_removed / phone_change / admin / evicted / account_deleted
  revokeReason      String?   @map("revoke_reason")

  /// 会话所属账号
  merchantUser   MerchantUser    @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_user_session_merchant_user_id")
  /// 登录所用的微信身份
  wechatIdentity WechatIdentity? @relation(fields: [wechatIdentityId], references: [id], onDelete: SetNull, map: "fk_user_session_wechat_identity_id")

  @@index([wechatIdentityId], map: "ix_user_session_wechat_identity_id")
  @@index([absoluteExpiresAt], map: "ix_user_session_absolute_expires_at")
  @@map("user_session")
}

/// 电脑端下载页会话：老板在小程序里对某台电脑的一次授权
model PortalSession {
  /// 主键，UUID v7
  id               String    @id(map: "pk_portal_session") @db.Uuid
  /// Cookie 里 32 字节随机数的 sha256
  tokenHash        Bytes     @unique(map: "uq_portal_session_token_hash") @map("token_hash")
  /// 换出本会话的扫码票据；一张票据只换一次会话
  /// 不建外键：避免 identity 与 portal 之间出现双向外键（M37）；票据 7 天后物理删除
  portalTicketId   String    @unique(map: "uq_portal_session_portal_ticket_id") @map("portal_ticket_id") @db.Uuid
  /// 授权的老板
  approvedByUserId String    @map("approved_by_user_id") @db.Uuid
  /// 授权范围：主体
  entityId         String    @map("entity_id") @db.Uuid
  /// 授权范围：门店
  storeId          String    @map("store_id") @db.Uuid
  /// 授权范围类型，V1.0 只有 store
  grantScope       String    @map("grant_scope")
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)
  /// 过期时间，创建后 2 小时，不滑动
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 换取会话的电脑的 IP
  ip               String
  /// 换取会话的浏览器 User-Agent
  userAgent        String    @map("user_agent")
  /// 吊销时间
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 吊销原因：owner_revoked / membership_changed / account_action / portal_logout / expired
  revokeReason     String?   @map("revoke_reason")

  /// 授权的老板
  approvedByUser MerchantUser @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict, map: "fk_portal_session_approved_by_user_id")
  /// 授权范围：主体
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_portal_session_entity_id")
  /// 授权范围：门店（复合外键保证门店属于该主体）
  store          Store        @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_portal_session_store_entity")

  @@index([expiresAt], map: "ix_portal_session_expires_at")
  @@map("portal_session")
}

/// 账号上的一次性提示，首页置顶展示，点“知道了”后关闭
model MerchantUserNotice {
  /// 主键，UUID v7
  id             String    @id(map: "pk_merchant_user_notice") @db.Uuid
  /// 提示所属账号
  merchantUserId String    @map("merchant_user_id") @db.Uuid
  /// 提示类型：new_wechat_bound
  kind           String
  /// 文案里的事件发生时间
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  /// 用户点“知道了”的时间；为空表示仍需展示
  ackedAt        DateTime? @map("acked_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 提示所属账号
  merchantUser MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_merchant_user_notice_merchant_user_id")

  @@index([merchantUserId], map: "ix_merchant_user_notice_merchant_user_id")
  @@map("merchant_user_notice")
}

/// 商家侧短信验证码：每次发送一行，只存哈希
model SmsVerification {
  /// 主键，UUID v7
  id             String    @id(map: "pk_sms_verification") @db.Uuid
  /// 用途：phone_change / contact_phone / login
  purpose        String
  /// 发起验证的账号；login 用途在账号不存在时为空
  merchantUserId String?   @map("merchant_user_id") @db.Uuid
  /// 目标手机号的盲索引（32 字节）
  phoneBidx      Bytes     @map("phone_bidx")
  /// 验证码的哈希（32 字节）；库里没有明文
  codeHash       Bytes     @map("code_hash")
  /// 过期时间
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 已尝试的校验次数；到上限即作废
  attempts       Int       @default(0)
  /// 校验通过并被使用的时间
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  /// 创建时间，即发送时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 发起验证的账号
  merchantUser MerchantUser? @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_sms_verification_merchant_user_id")

  @@index([phoneBidx, createdAt], map: "ix_sms_verification_phone_bidx_created_at")
  @@index([merchantUserId, purpose, createdAt], map: "ix_sms_verification_merchant_user_id_purpose")
  @@index([expiresAt], map: "ix_sms_verification_expires_at")
  @@map("sms_verification")
}

/// 商家用户与员工的企业微信外部联系人关系，由企业微信回调写入
model WecomContact {
  /// 主键，UUID v7
  id                 String    @id(map: "pk_wecom_contact") @db.Uuid
  /// 商家用户；回调到达时对不上号为空，之后按 unionid 回填
  merchantUserId     String?   @map("merchant_user_id") @db.Uuid
  /// 被添加的员工
  staffId            String    @map("staff_id") @db.Uuid
  /// 企业微信外部联系人标识的密文
  externalUseridEnc  String    @map("external_userid_enc")
  /// 外部联系人标识的盲索引（32 字节），回调按它找行
  externalUseridBidx Bytes     @map("external_userid_bidx")
  /// 外部联系人的 unionid（企业微信与开放平台主体打通后才有）；用于与 wechat_identity.unionid 对号
  unionid            String?
  /// 添加时间：取回调的 CreateTime（webhook_event 载荷的 createTime），不取处理时间
  addedAt            DateTime  @map("added_at") @db.Timestamptz(3)
  /// 关系解除时间：del_external_contact、del_follow_user 回调的 CreateTime；不删行
  removedAt          DateTime? @map("removed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 商家用户
  merchantUser MerchantUser? @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_wecom_contact_merchant_user_id")
  /// 被添加的员工
  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_wecom_contact_staff_id")

  @@index([merchantUserId, staffId], map: "ix_wecom_contact_merchant_user_id_staff_id")
  @@map("wecom_contact")
}

/// 账号类变更申请（换绑手机号、老板更换、老板复核）的内容与执行结果；与审批单一对一
model AccountChangeRequest {
  /// 主键，UUID v7
  id                String    @id(map: "pk_account_change_request") @db.Uuid
  /// 对应的审批单，一对一；单号与审批状态在审批单上
  approvalRequestId String    @unique(map: "uq_account_change_request_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 变更类型：phone_rebind / owner_transfer / owner_reverify
  kind              String
  /// 目标账号（换绑、复核）；老板更换为空
  merchantUserId    String?   @map("merchant_user_id") @db.Uuid
  /// 目标主体（老板更换必填）；换绑、复核填账号所属主体，没有则为空
  entityId          String?   @map("entity_id") @db.Uuid
  /// 新手机号密文（换绑的新号码、老板更换的新老板号码）；申请执行或关闭后置空
  newPhoneEnc       String?   @map("new_phone_enc")
  /// 新手机号脱敏串；留作证据
  newPhoneMask      String?   @map("new_phone_mask")
  /// 证明材料文件（换绑、老板更换至少 1 个）；不建外键，经 file_ref 登记
  proofFileIds      String[]  @map("proof_file_ids") @db.Uuid
  /// 核实方式（老板复核必填）
  verifyMethod      String?   @map("verify_method")
  /// 核实记录（老板复核必填）
  verifyRecord      String?   @map("verify_record")
  /// 发起原因编码（字典编码，不建外键）
  reasonCode        String    @map("reason_code")
  /// 发起原因说明
  reasonText        String    @map("reason_text")
  /// 生效时间：审批通过的同一事务里写入
  appliedAt         DateTime? @map("applied_at") @db.Timestamptz(3)
  /// 执行结果快照（按类型）
  resultSnapshot    Json?     @map("result_snapshot")
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 对应的审批单
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_account_change_request_approval_request_id")
  /// 目标账号
  merchantUser    MerchantUser?   @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_account_change_request_merchant_user_id")
  /// 目标主体
  entity          Entity?         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_account_change_request_entity_id")

  @@index([merchantUserId], map: "ix_account_change_request_merchant_user_id")
  @@index([entityId], map: "ix_account_change_request_entity_id")
  @@map("account_change_request")
}

