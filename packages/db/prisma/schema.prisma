/// 用户在主体中的角色（老板 / 店员）与成员关系
model EntityMember {
  /// 主键，UUID v7
  id                String    @id(map: "pk_entity_member") @db.Uuid
  /// 所属主体
  entityId          String    @map("entity_id") @db.Uuid
  /// 商家用户
  merchantUserId    String    @map("merchant_user_id") @db.Uuid
  /// 角色：owner / clerk
  role              String
  /// 成员关系状态：active / removed
  status            String
  /// 成员称呼：加入时自填，老板可改为备注名
  displayName       String?   @map("display_name")
  /// 上次选择的门店，只用于恢复界面，不参与授权
  lastStoreId       String?   @map("last_store_id") @db.Uuid
  /// 加入时所用的邀请；老板为空
  invitationId      String?   @map("invitation_id") @db.Uuid
  /// 邀请人的成员关系；老板为空
  invitedByMemberId String?   @map("invited_by_member_id") @db.Uuid
  /// 移除时间
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  /// 移除操作人类型：merchant / staff / system / partner
  removeActorType   String?   @map("remove_actor_type")
  /// 移除操作人 id；system 时为空
  /// 不建外键：多态引用（merchant_user 或 staff）
  removeActorId     String?   @map("remove_actor_id") @db.Uuid
  /// 移除操作的客户端来源：weapp / portal / admin；系统动作为空
  removeClient      String?   @map("remove_client")
  /// 移除原因：by_owner / self / dormant / owner_transfer / account_deleted / draft_abandoned / store_archived / entity_closed
  removeReason      String?   @map("remove_reason")
  /// 创建时间，即加入时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_entity_member_entity_id")
  /// 商家用户
  merchantUser    MerchantUser  @relation(fields: [merchantUserId], references: [id], onDelete: Restrict, map: "fk_entity_member_merchant_user_id")
  /// 上次选择的门店（复合外键保证门店属于本主体）
  lastStore       Store?        @relation(fields: [lastStoreId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_entity_member_last_store_entity")
  /// 加入时所用的邀请
  invitation      Invitation?   @relation("EntityMemberJoinedVia", fields: [invitationId], references: [id], onDelete: Restrict, map: "fk_entity_member_invitation_id")
  /// 邀请人的成员关系（复合外键保证同一主体）
  invitedByMember EntityMember? @relation("EntityMemberInvitedBy", fields: [invitedByMemberId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_entity_member_invited_by_member_entity")

  // 以下反向字段是初稿手写的（带关系名的关系：同一对模型之间有多条关系、自引用），按 M46 ③ 保留
  /// 反向：由本成员邀请加入的成员
  invitedMembers      EntityMember[] @relation("EntityMemberInvitedBy")
  /// 反向：本成员所属的门店行
  storeMemberships    StoreMember[]  @relation("StoreMemberMembership")
  /// 反向：由本成员加入门店的行
  storeMembersAdded   StoreMember[]  @relation("StoreMemberAddedBy")
  /// 反向：本成员发出的邀请
  invitationsSent     Invitation[]   @relation("InvitationInviter")
  /// 反向：接受后落到本成员关系上的邀请
  invitationsAccepted Invitation[]   @relation("InvitationAcceptedMember")

  @@unique([id, entityId], map: "uq_entity_member_id_entity_id")
  @@index([entityId], map: "ix_entity_member_entity_id")
  @@index([merchantUserId], map: "ix_entity_member_merchant_user_id")
  @@map("entity_member")
}

/// 店员所属门店（老板隐含拥有全部门店，不建行）
model StoreMember {
  /// 店员的成员关系
  entityMemberId  String   @map("entity_member_id") @db.Uuid
  /// 门店
  storeId         String   @map("store_id") @db.Uuid
  /// 所属主体，供两条复合外键使用
  entityId        String   @map("entity_id") @db.Uuid
  /// 把店员加入该门店的成员（邀请人或调整所属门店的老板）
  addedByMemberId String   @map("added_by_member_id") @db.Uuid
  /// 创建时间，即加入该门店的时间
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)

  /// 店员的成员关系（复合外键保证同一主体）
  entityMember  EntityMember @relation("StoreMemberMembership", fields: [entityMemberId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_member_entity_member_entity")
  /// 门店（复合外键保证同一主体）
  store         Store        @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_member_store_entity")
  /// 所属主体
  entity        Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_store_member_entity_id")
  /// 把店员加入该门店的成员（复合外键保证同一主体）
  addedByMember EntityMember @relation("StoreMemberAddedBy", fields: [addedByMemberId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_store_member_added_by_member_entity")

  @@id([entityMemberId, storeId], map: "pk_store_member")
  @@index([storeId], map: "ix_store_member_store_id")
  @@map("store_member")
}

/// 店员邀请：一次性 token，24 小时有效，待接受占名额
model Invitation {
  /// 主键，UUID v7
  id               String    @id(map: "pk_invitation") @db.Uuid
  /// 所属主体
  entityId         String    @map("entity_id") @db.Uuid
  /// 邀请加入的门店
  storeId          String    @map("store_id") @db.Uuid
  /// 邀请的角色，V1.0 固定 clerk
  role             String
  /// 邀请人的成员关系
  inviterMemberId  String    @map("inviter_member_id") @db.Uuid
  /// token（32 字节随机数）的 sha256；接受时按它查找
  tokenHash        Bytes     @unique(map: "uq_invitation_token_hash") @map("token_hash")
  /// token 的密文，只用于把未分享的卡片再次返回给邀请人；离开 pending 后清空
  tokenEnc         String?   @map("token_enc")
  /// 老板填写的备注名（不超过 10 字）
  remarkName       String?   @map("remark_name")
  /// 定向手机号的盲索引（32 字节）；填了则只有该号码能接受
  targetPhoneBidx  Bytes?    @map("target_phone_bidx")
  /// 状态：pending / accepted / revoked / expired
  status           String
  /// 用户点“发送给微信好友”时端上上报的时间
  sharedAt         DateTime? @map("shared_at") @db.Timestamptz(3)
  /// 过期时间，创建后 24 小时；未分享的卡片复用时重置
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 接受时间
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// 接受邀请的商家用户
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  /// 接受后建立或复用的成员关系
  acceptedMemberId String?   @map("accepted_member_id") @db.Uuid
  /// 撤回时间
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// 撤回操作人类型：merchant / staff / system / partner
  revokeActorType  String?   @map("revoke_actor_type")
  /// 撤回操作人 id；system 时为空
  /// 不建外键：多态引用（merchant_user 或 staff）
  revokeActorId    String?   @map("revoke_actor_id") @db.Uuid
  /// 撤回操作的客户端来源：weapp / portal / admin；系统动作为空
  revokeClient     String?   @map("revoke_client")
  /// 撤回原因：by_owner / unshared_leave / store_archived / entity_closed
  revokeReason     String?   @map("revoke_reason")
  /// 客户端请求号，创建幂等
  clientRequestId  String    @map("client_request_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity         Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_invitation_entity_id")
  /// 邀请加入的门店（复合外键保证门店属于该主体）
  store          Store         @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_invitation_store_entity")
  /// 邀请人的成员关系（复合外键保证同一主体）
  inviterMember  EntityMember  @relation("InvitationInviter", fields: [inviterMemberId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_invitation_inviter_member_entity")
  /// 接受邀请的商家用户
  acceptedByUser MerchantUser? @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict, map: "fk_invitation_accepted_by_user_id")
  /// 接受后建立或复用的成员关系（复合外键保证同一主体）
  acceptedMember EntityMember? @relation("InvitationAcceptedMember", fields: [acceptedMemberId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_invitation_accepted_member_entity")

  // 反向字段（初稿手写，按 M46 ③ 保留）：与 EntityMember 之间有三条带名关系
  /// 反向：经本邀请加入的成员关系
  joinedMembers EntityMember[] @relation("EntityMemberJoinedVia")

  @@unique([inviterMemberId, clientRequestId], map: "uq_invitation_inviter_member_id_client_request_id")
  @@index([entityId, createdAt], map: "ix_invitation_entity_id_created_at")
  @@index([storeId], map: "ix_invitation_store_id")
  @@map("invitation")
}

/// 渠道码与邀请码登记：注册归因时服务端按它判定来源
model ReferralCode {
  /// 主键，UUID v7
  id           String    @id(map: "pk_referral_code") @db.Uuid
  /// 码值，统一存大写；渠道码与邀请码共用一个命名空间
  code         String    @unique(map: "uq_referral_code_code")
  /// 来源类型：sales / campaign / partner（partner 在 V1.0 只声明）
  sourceType   String    @map("source_type")
  /// 归属员工；sales 必填，创建后不可改
  ownerStaffId String?   @map("owner_staff_id") @db.Uuid
  /// 渠道或活动名称，后台与报表展示用
  label        String?
  /// 状态：active / disabled
  status       String
  /// 停用时间
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion  Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归属员工
  ownerStaff    Staff?         @relation(fields: [ownerStaffId], references: [id], onDelete: Restrict, map: "fk_referral_code_owner_staff_id")
  merchantUsers MerchantUser[]
  entities      Entity[]

  @@index([ownerStaffId], map: "ix_referral_code_owner_staff_id")
  @@map("referral_code")
}

// ───────────────────────── portal ─────────────────────────

/// 电脑端下载页扫码登录票据：电脑创建，老板在小程序确认，电脑凭 pollSecret 换取会话
model PortalTicket {
  /// 主键，UUID v7；portal_session.portal_ticket_id 指向它
  id               String    @id(map: "pk_portal_ticket") @db.Uuid
  /// 对外标识：16 字节随机数的 base64url（22 个字符），写在二维码与轮询地址里
  publicId         String    @unique(map: "uq_portal_ticket_public_id") @map("public_id")
  /// 8 位 Crockford Base32 短码，扫不出码时手动输入；pending 期间唯一
  shortCode        String    @map("short_code")
  /// pollSecret（32 字节随机数）的 sha256
  pollSecretHash   Bytes     @map("poll_secret_hash")
  /// 两位配对数字，显示在电脑屏幕上
  pairDigits       String    @map("pair_digits")
  /// 状态：pending / approved / rejected / consumed；过期不落状态
  status           String
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)
  /// 过期时间，创建后 PORTAL_TICKET_TTL（部署配置，默认 120 秒）
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 发起票据的浏览器 IP
  ip               String
  /// 发起票据的浏览器 User-Agent
  userAgent        String    @map("user_agent")
  /// 确认授权的老板
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  /// 授权范围：主体；确认前为空
  entityId         String?   @map("entity_id") @db.Uuid
  /// 授权范围：门店；确认前为空
  storeId          String?   @map("store_id") @db.Uuid
  /// 确认时间
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  /// 换取会话的时间
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// 换取会话的尝试次数
  exchangeAttempts Int       @default(0) @map("exchange_attempts") @db.SmallInt

  /// 确认授权的老板
  approvedByUser MerchantUser? @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict, map: "fk_portal_ticket_approved_by_user_id")
  /// 授权范围：主体
  entity         Entity?       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_portal_ticket_entity_id")
  /// 授权范围：门店（复合外键保证门店属于该主体）
  store          Store?        @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_portal_ticket_store_entity")

  @@index([createdAt], map: "ix_portal_ticket_created_at")
  @@map("portal_ticket")
}

// ===== 03-staff-authz-audit =====
// 分组 03-staff-authz-audit：员工、运营跟进记录、权限、审计与统一审批单
// 模块：staff、authz（无表）、audit、approval
// 12 张表：staff_role、staff_group、staff、staff_activation、staff_session、
//          assignment_pool_member、assignment_cursor、assignment_history、follow_up、
//          audit_log、auth_event、approval_request
// 手写约束见 dm/sql/03-staff-authz-audit.sql
// 第二轮：按 rulings M46–M92 修订（M47 复合外键、M56/M57/M60 改名等），见文档“修订记录”

/// 后台角色：8 行固定角色，自然键 key；模块等级、敏感操作权限点、数据范围
model StaffRole {
  /// 角色键（自然主键）：super_admin / cs / delivery_manager / editor / publisher / content_ops / channel_ops / finance
  key              String   @id(map: "pk_staff_role")
  /// 角色名称
  name             String
  /// 职责描述
  description      String
  /// 13 个模块的等级（n / v / o / e），结构见文档第 4 节
  moduleLevels     Json     @map("module_levels")
  /// 敏感操作权限点开关（on、leadOnly），结构见文档第 4 节
  actions          Json
  /// 数据范围：own / group / all
  dataScope        String   @map("data_scope")
  /// 是否锁定（超级管理员为 true，不可编辑）
  isLocked         Boolean  @default(false) @map("is_locked")
  /// 起始版本：v1.0 / v1.1（渠道运营为 v1.1）
  availableFrom    String   @map("available_from")
  /// 乐观锁版本号；保存为带版本的整体替换
  lockVersion      Int      @default(0) @map("lock_version")
  /// 最近保存人（员工）；迁移播种时为空
  updatedByStaffId String?  @map("updated_by_staff_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  /// 最近保存人
  updatedByStaff Staff?       @relation("StaffRoleUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: Restrict, map: "fk_staff_role_updated_by_staff_id")
  /// 反向：该角色下的员工（与 updatedByStaff 同属 Staff，须写关系名与反向字段）
  staffs         Staff[]      @relation("StaffRoleMembers")
  staffGroups    StaffGroup[]

  @@map("staff_role")
}

/// 员工分组：“本组”数据范围的组织实体；迁移时每个角色各建一个默认组
model StaffGroup {
  /// 主键，UUID v7，应用生成
  id           String   @id(map: "pk_staff_group") @db.Uuid
  /// 组名（如“交付组”）
  name         String
  /// 所属角色（staff_role.key）
  staffRoleKey String   @map("staff_role_key")
  /// 是否该角色的默认组（新员工默认进入）
  isDefault    Boolean  @default(false) @map("is_default")
  /// 创建时间
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  /// 所属角色
  staffRole        StaffRole         @relation(fields: [staffRoleKey], references: [key], onDelete: Restrict, map: "fk_staff_group_staff_role_key")
  staffs           Staff[]
  approvalRequests ApprovalRequest[]

  @@unique([staffRoleKey, name], map: "uq_staff_group_staff_role_key_name")
  @@map("staff_group")
}

/// 后台员工账号：手机号 + 密码 + TOTP；一人一角色；含登录失败分桶锁定与企业微信绑定
model Staff {
  /// 自动补的反向关系字段
  dramaCreatedByStaffList            Drama[]            @relation("DramaCreatedByStaff")
  /// 自动补的反向关系字段
  dramaUpdatedByStaffList            Drama[]            @relation("DramaUpdatedByStaff")
  /// 自动补的反向关系字段
  paymentTxnConfirmedByStaffList     PaymentTxn[]       @relation("PaymentTxnConfirmedByStaff")
  /// 自动补的反向关系字段
  paymentTxnReviewedByStaffList      PaymentTxn[]       @relation("PaymentTxnReviewedByStaff")
  /// 自动补的反向关系字段
  transferProofUploadedByStaffList   TransferProof[]    @relation("TransferProofUploadedByStaff")
  /// 自动补的反向关系字段
  transferProofReviewedByStaffList   TransferProof[]    @relation("TransferProofReviewedByStaff")
  /// 自动补的反向关系字段
  refundRequestExecutedByStaffList   RefundRequest[]    @relation("RefundRequestExecutedByStaff")
  /// 自动补的反向关系字段
  refundRequestVoidedByStaffList     RefundRequest[]    @relation("RefundRequestVoidedByStaff")
  /// 自动补的反向关系字段
  adVersionUploadedByStaffList       AdVersion[]        @relation("AdVersionUploadedByStaff")
  /// 自动补的反向关系字段
  adVersionOfflineSentByStaffList    AdVersion[]        @relation("AdVersionOfflineSentByStaff")
  /// 自动补的反向关系字段
  deliveryTicketDeliveryManagerList  DeliveryTicket[]   @relation("DeliveryTicketDeliveryManager")
