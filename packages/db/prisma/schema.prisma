  /// 陌生来源桶的连续失败次数
  failUntrusted                      Int                @default(0) @map("fail_untrusted")
  /// 陌生来源桶的锁定截止时间
  lockedUntilUntrusted               DateTime?          @map("locked_until_untrusted") @db.Timestamptz(3)
  /// 可信设备桶的连续失败次数
  failTrusted                        Int                @default(0) @map("fail_trusted")
  /// 可信设备桶的锁定截止时间
  lockedUntilTrusted                 DateTime?          @map("locked_until_trusted") @db.Timestamptz(3)
  /// 最近登录时间
  lastLoginAt                        DateTime?          @map("last_login_at") @db.Timestamptz(3)
  /// 最近登录来源 IP（原值，展示时脱敏）
  lastLoginIp                        String?            @map("last_login_ip")
  /// 禁用时间；重新启用时清空
  disabledAt                         DateTime?          @map("disabled_at") @db.Timestamptz(3)
  /// 禁用原因：resigned / reassigned / long_leave / other
