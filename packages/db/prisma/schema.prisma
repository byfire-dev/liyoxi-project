  /// 创建时间
  createdAt                          DateTime           @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                          DateTime           @map("updated_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion                        Int                @default(0) @map("lock_version")

  /// 角色
  staffRole       StaffRole   @relation("StaffRoleMembers", fields: [staffRoleKey], references: [key], onDelete: Restrict, map: "fk_staff_staff_role_key")
  /// 员工分组
  staffGroup      StaffGroup? @relation(fields: [staffGroupId], references: [id], onDelete: Restrict, map: "fk_staff_staff_group_id")
  /// “联系我”二维码文件
