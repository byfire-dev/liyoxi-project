/// 账本操作：幂等登记（op_key 全表唯一）兼流水展示行（只增）
model LedgerOperation {
  /// 主键，UUID v7，应用生成
  id                String   @id(map: "pk_ledger_operation") @db.Uuid
  /// 自增序号，只用于排序与回放，不出接口
  seq               BigInt   @unique(map: "uq_ledger_operation_seq") @default(autoincrement())
  /// 幂等键，来自“这次业务动作的身份”，如 hold:order_item:{id}。全表见第 3.3 节
  opKey             String   @unique(map: "uq_ledger_operation_op_key") @map("op_key")
  /// 操作类型，17 个取值：grant、purchase、hold、capture、release、refund、expire、unexpire、adjust、revoke、addon_suspend、addon_resume、refund_suspend、refund_resume、fulfill、extend、fix。含义见第 3.3 节
  opType            String   @map("op_type")
  /// 主体
  entityId          String   @map("entity_id") @db.Uuid
  /// 门店；主体级操作为空
  storeId           String?  @map("store_id") @db.Uuid
  /// 关联单据的类型，取最终表名：order_item、ad、ad_revision、billing_order、grant_schedule、subscription_term、approval_request、refund_request、payment_exception、cancel_request_line。与操作类型的对应见第 3.3 节；只有人工修复可空
  refType           String?  @map("ref_type")
  /// 关联单据的 id；与 ref_type 同有同无
  /// 不建外键：按 ref_type 多态，其中多数在更高层
  refId             String?  @map("ref_id") @db.Uuid
  /// 相关冻结单；冻结、扣减、释放、退回时必填
  pointHoldId       String?  @map("point_hold_id") @db.Uuid
  /// 业务生效时刻；到点类操作取逻辑时间
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  /// 归属业务日（北京时间）；期末清零取周期最后一天
  bizDate           DateTime @map("biz_date") @db.Date
  /// 本次操作对套餐积分“可用”的净变动：冻结为负，退回为正，扣减为 0
  planDeltaQty      Int      @default(0) @map("plan_delta_qty")
  /// 本次操作对加购积分“可用”的净变动
  addonDeltaQty     Int      @default(0) @map("addon_delta_qty")
  /// 操作后的可花积分（闸门关闭时为 0），即后台流水的“可用余额”列
  spendableAfterQty Int      @map("spendable_after_qty")
  /// 操作后的冻结合计
  heldAfterQty      Int      @map("held_after_qty")
  /// 展示文案的代码；文案由代码与参数拼出，不存成品字符串。只做幂等登记的操作可为空
  titleCode         String?  @map("title_code")
  /// 展示文案的参数（如部数、算式的各项）。结构见第 4 节
  titleArgs         Json?    @map("title_args")
  /// 操作人类型：merchant 商家用户 / staff 员工 / system 系统 / partner 服务商（V1.0 只声明）。见 catalogue enums_shared
  actorType         String   @map("actor_type")
  /// 操作人：商家用户或员工的 id；system 时为空
  /// 不建外键：操作人多态（merchant_user / staff），按 actor_type 区分
  actorId           String?  @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空。见 catalogue enums_shared
  client            String?
  /// 链路追踪标识
  requestId         String?  @map("request_id")
  /// 创建时间，应用时钟写入
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity                 Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_ledger_operation_entity_id")
  /// 关系：(store_id, entity_id) → store(id, entity_id)，门店须属于该主体（M47）；store_id 为空时不校验
  store                  Store?                  @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_ledger_operation_store_entity")
  /// 关系：point_hold_id → point_hold.id
  pointHold              PointHold?              @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_ledger_operation_point_hold_id")
  pointLedgerEntries     PointLedgerEntry[]
  pointAdjustmentRequest PointAdjustmentRequest?
  termExtensionRequest   TermExtensionRequest?

  @@index([entityId, occurredAt(sort: Desc)], map: "ix_ledger_operation_entity_id_occurred_at")
  @@index([refType, refId], map: "ix_ledger_operation_ref_type_ref_id")
  @@index([pointHoldId], map: "ix_ledger_operation_point_hold_id")
  @@index([bizDate], map: "ix_ledger_operation_biz_date")
  @@map("ledger_operation")
}

/// 积分流水：批次内桶到桶的数量移动，一批次一行（只增），只记数量
model PointLedgerEntry {
  /// 主键，UUID v7，应用生成
  id                String   @id(map: "pk_point_ledger_entry") @db.Uuid
  /// 自增序号：全局回放顺序，不出接口
  seq               BigInt   @unique(map: "uq_point_ledger_entry_seq") @default(autoincrement())
  /// 所属账本操作
  ledgerOperationId String   @map("ledger_operation_id") @db.Uuid
  /// 主体
  entityId          String   @map("entity_id") @db.Uuid
  /// 批次
  pointLotId        String   @map("point_lot_id") @db.Uuid
  /// 冻结单；涉及“冻结”“已消耗”两个桶的移动必填（估值按“冻结单 × 批次”建池）
  pointHoldId       String?  @map("point_hold_id") @db.Uuid
  /// 批次的积分类型（冗余，报表按来源聚合）：plan / addon
  lotKind           String   @map("lot_kind")
  /// 批次的来源版本（冗余，报表按版本拆分）；套餐批次必填，加购批次为空
  planId            String?  @map("plan_id") @db.Uuid
  /// 转出桶：external 账外 / available 可用 / held 冻结 / consumed 已消耗 / expired 已清零 / revoked 已作废 / converted_out 转加购转出 / adjusted_out 调整扣减
  fromBucket        String   @map("from_bucket")
  /// 转入桶，取值同上；合法的组合只有 14 种，见手写约束
  toBucket          String   @map("to_bucket")
  /// 数量，大于 0
  qty               Int
  /// 业务生效时刻；到点类操作取逻辑时间
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  /// 归属业务日（北京时间）；报表一律按它归集
  bizDate           DateTime @map("biz_date") @db.Date
  /// 真实写入时刻，应用时钟写入
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：ledger_operation_id → ledger_operation.id
  ledgerOperation      LedgerOperation       @relation(fields: [ledgerOperationId], references: [id], onDelete: Restrict, map: "fk_point_ledger_entry_ledger_operation_id")
  /// 关系：entity_id → entity.id
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_point_ledger_entry_entity_id")
  /// 关系：point_lot_id → point_lot.id
  pointLot             PointLot              @relation("PointLedgerEntryLot", fields: [pointLotId], references: [id], onDelete: Restrict, map: "fk_point_ledger_entry_point_lot_id")
  /// 关系：point_hold_id → point_hold.id
  pointHold            PointHold?            @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_point_ledger_entry_point_hold_id")
  /// 关系：plan_id → plan.id
  plan                 Plan?                 @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_point_ledger_entry_plan_id")
  /// 反向：以本条转出流水为来源的加购批次
  convertedPointLots   PointLot[]            @relation("PointLotOriginEntry")
  pointEntryValuations PointEntryValuation[]

  @@index([entityId, seq], map: "ix_point_ledger_entry_entity_id_seq")
  @@index([pointLotId, seq], map: "ix_point_ledger_entry_point_lot_id_seq")
  @@index([bizDate], map: "ix_point_ledger_entry_biz_date")
  @@index([ledgerOperationId], map: "ix_point_ledger_entry_ledger_operation_id")
  @@index([pointHoldId], map: "ix_point_ledger_entry_point_hold_id")
  @@map("point_ledger_entry")
}

/// 主体每日快照：主体 × 业务日的快照，可重算
model BillingEntityDaily {
  /// 业务日（北京时间）
  bizDate              DateTime @map("biz_date") @db.Date
  /// 主体
  entityId             String   @map("entity_id") @db.Uuid
  /// 当日 24:00 的订阅状态：none / active / expired
  subStatus            String   @map("sub_status")
  /// 当日 24:00 生效周期的版本；生效时必填
  planId               String?  @map("plan_id") @db.Uuid
  /// 当日 24:00 生效周期的价目修订；生效时必填
  planRevisionId       String?  @map("plan_revision_id") @db.Uuid
  /// 当日 24:00 的生效周期；生效时必填
  subscriptionTermId   String?  @map("subscription_term_id") @db.Uuid
  /// 生效周期的购买月数；生效时必填
  termMonths           Int?     @map("term_months")
  /// 月度经常性收入（分）：生效则为周期的 monthly_equiv_fen，否则 0
  mrrFen               Int      @default(0) @map("mrr_fen")
  /// 当日 24:00 套餐积分可用
  planAvailablePoints  Int      @default(0) @map("plan_available_points")
  /// 当日 24:00 加购积分可用（含停用的）
  addonAvailablePoints Int      @default(0) @map("addon_available_points")
  /// 当日 24:00 冻结
  heldPoints           Int      @default(0) @map("held_points")
  /// 积分负债 = 可用 + 冻结（含冻结，含停用的加购）
  liabilityPoints      Int      @default(0) @map("liability_points")
  /// 负债对应的折算价值（分），取自派生估值的当前口径版本
  liabilityValueFen    Int      @default(0) @map("liability_value_fen")
  /// 未发放月份的预收套餐款（分）= Σ pending 发放计划的 value_fen
  deferredPlanFeeFen   Int      @default(0) @map("deferred_plan_fee_fen")
  /// 最近一次计算时刻（承担 updated_at 的作用）
  recomputedAt         DateTime @map("recomputed_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)

  /// 关系：entity_id → entity.id
  entity           Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_billing_entity_daily_entity_id")
  /// 关系：plan_id → plan.id
  plan             Plan?             @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_billing_entity_daily_plan_id")
  /// 关系：plan_revision_id → plan_revision.id
  planRevision     PlanRevision?     @relation(fields: [planRevisionId], references: [id], onDelete: Restrict, map: "fk_billing_entity_daily_plan_revision_id")
  /// 关系：subscription_term_id → subscription_term.id
  subscriptionTerm SubscriptionTerm? @relation(fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_billing_entity_daily_subscription_term_id")

  @@id([bizDate, entityId], map: "pk_billing_entity_daily")
  @@index([entityId, bizDate], map: "ix_billing_entity_daily_entity_id_biz_date")
  @@map("billing_entity_daily")
}

/// 估值口径版本：派生估值的口径版本，V1.0 只有版本 1
model ValuationPolicy {
  /// 口径版本号，从 1 起
  versionNo            Int                   @id(map: "pk_valuation_policy") @map("version_no")
  /// 口径说明
  description          String
  /// 口径规则：入账成本的折算方式、取整与尾差规则。结构见第 4 节
  rule                 Json
  /// 创建时间，应用时钟写入
  createdAt            DateTime              @map("created_at") @db.Timestamptz(3)
  pointEntryValuations PointEntryValuation[]

  @@map("valuation_policy")
}

/// 流水的派生估值：每条流水带走或带回的价值，按口径版本各存一套，可删除重算
model PointEntryValuation {
  /// 对应的流水
  pointLedgerEntryId       String   @map("point_ledger_entry_id") @db.Uuid
  /// 口径版本号
  valuationPolicyVersionNo Int      @map("valuation_policy_version_no")
  /// 流水的 seq（冗余，写入时从流水复制）：按批次取“最新一条估值行”、按流水顺序回放用
  /// 不建外键：冗余的排序列，随 point_ledger_entry_id 确定
  pointLedgerEntrySeq      BigInt   @map("point_ledger_entry_seq")
  /// 批次（冗余，聚合用）
  pointLotId               String   @map("point_lot_id") @db.Uuid
  /// 主体（冗余，聚合用）
  entityId                 String   @map("entity_id") @db.Uuid
  /// 流水的归属业务日（冗余，聚合用）
  bizDate                  DateTime @map("biz_date") @db.Date
  /// 估值效果，11 个取值：inflow、recognize、recognize_breakage、reverse、reverse_transfer、reverse_breakage、reverse_breakage_refund、transfer_out、refund_out、adjust_out、none。含义见第 3.1 节
  effect                   String
  /// 这条流水带走或带回的价值（分），非负；方向由 effect 决定
  valueFen                 Int      @map("value_fen")
  /// 这条流水之后该批次的剩余价值（分）= 折合预收款
  remainingValueFen        Int      @map("remaining_value_fen")
  /// 计算时刻（本表整批覆盖重算，它同时是行的写入时间）
  computedAt               DateTime @map("computed_at") @db.Timestamptz(3)

  /// 关系：point_ledger_entry_id → point_ledger_entry.id
  pointLedgerEntry PointLedgerEntry @relation(fields: [pointLedgerEntryId], references: [id], onDelete: Restrict, map: "fk_point_entry_valuation_point_ledger_entry_id")
  /// 关系：valuation_policy_version_no → valuation_policy.version_no
  valuationPolicy  ValuationPolicy  @relation(fields: [valuationPolicyVersionNo], references: [versionNo], onDelete: Restrict, map: "fk_point_entry_valuation_valuation_policy_version_no")
  /// 关系：point_lot_id → point_lot.id
  pointLot         PointLot         @relation(fields: [pointLotId], references: [id], onDelete: Restrict, map: "fk_point_entry_valuation_point_lot_id")
  /// 关系：entity_id → entity.id
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_point_entry_valuation_entity_id")

  @@id([pointLedgerEntryId, valuationPolicyVersionNo], map: "pk_point_entry_valuation")
  @@index([pointLotId, valuationPolicyVersionNo, pointLedgerEntrySeq], map: "ix_point_entry_valuation_lot_version_entry_seq")
  @@index([entityId, bizDate], map: "ix_point_entry_valuation_entity_id_biz_date")
  @@index([valuationPolicyVersionNo, bizDate], map: "ix_point_entry_valuation_valuation_policy_version_no_biz_date")
  @@map("point_entry_valuation")
}

/// 积分调整单：积分手动调整的内容与入账结果，与审批单一对一
model PointAdjustmentRequest {
  /// 主键，UUID v7，应用生成
  id                     String    @id(map: "pk_point_adjustment_request") @db.Uuid
  /// 审批单，一对一
  approvalRequestId      String    @unique(map: "uq_point_adjustment_request_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 被调整的主体
  entityId               String    @map("entity_id") @db.Uuid
  /// 调整方向：increase 增加 / decrease 扣减
  direction              String
  /// 积分类型：plan 套餐积分（并入当前周期、随本期清零）/ addon 加购积分
  lotKind                String    @map("lot_kind")
  /// 调整数量，大于 0；方向由 direction 表示
  adjustPoints           Int       @map("adjust_points")
  /// 原因（系统枚举，M55）：compensation 制作问题补偿 / platform_refund 平台原因退回 / correction 纠正错误记录 / campaign 运营活动赠送 / other 其他
  reasonCode             String    @map("reason_code")
  /// 调整说明，5 到 200 字，商家可在积分明细里看到
  note                   String
  /// 关联的冻结单；platform_refund 必填（入账时走该冻结单的退回），其余选填（展示关联的订购或广告）
  pointHoldId            String?   @map("point_hold_id") @db.Uuid
  /// 来源延长单：补偿延长通过后为补发积分另建的调整单填写；其余为空
  termExtensionRequestId String?   @map("term_extension_request_id") @db.Uuid
  /// 发起时的可花积分，只供展示“可用 a → b”；入账时重新校验余额
  spendableBeforePoints  Int       @map("spendable_before_points")
  /// 入账的账本操作（幂等键 adjust:{审批单号}）；未入账为空
  ledgerOperationId      String?   @unique(map: "uq_point_adjustment_request_ledger_operation_id") @map("ledger_operation_id") @db.Uuid
  /// 入账时刻（账本时钟）；与 ledger_operation_id 同有同无
  appliedAt              DateTime? @map("applied_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt              DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：approval_request_id → approval_request.id
  approvalRequest      ApprovalRequest       @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_point_adjustment_request_approval_request_id")
  /// 关系：entity_id → entity.id
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_point_adjustment_request_entity_id")
  /// 关系：point_hold_id → point_hold.id
  pointHold            PointHold?            @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_point_adjustment_request_point_hold_id")
  /// 关系：term_extension_request_id → term_extension_request.id
  termExtensionRequest TermExtensionRequest? @relation(fields: [termExtensionRequestId], references: [id], onDelete: Restrict, map: "fk_point_adjustment_request_term_extension_request_id")
  /// 关系：ledger_operation_id → ledger_operation.id
  ledgerOperation      LedgerOperation?      @relation(fields: [ledgerOperationId], references: [id], onDelete: Restrict, map: "fk_point_adjustment_request_ledger_operation_id")

  @@index([entityId], map: "ix_point_adjustment_request_entity_id")
  @@index([pointHoldId], map: "ix_point_adjustment_request_point_hold_id")
  @@index([termExtensionRequestId], map: "ix_point_adjustment_request_term_extension_request_id")
  @@map("point_adjustment_request")
}

/// 补偿延长单：补偿延长的内容与执行结果，与审批单一对一
model TermExtensionRequest {
  /// 主键，UUID v7，应用生成
  id                        String    @id(map: "pk_term_extension_request") @db.Uuid
  /// 审批单，一对一
  approvalRequestId         String    @unique(map: "uq_term_extension_request_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 主体
  entityId                  String    @map("entity_id") @db.Uuid
  /// 发起时的当前周期，仅作记录；执行时作用的周期见 applied_subscription_term_id
  subscriptionTermId        String    @map("subscription_term_id") @db.Uuid
  /// 延长天数，1 到 90；原型档位 3 / 7 / 15 / 30 由前端限制
  days                      Int
  /// 原因，字典 extend_reason 的编码（交付延误补偿、平台故障影响使用、服务问题补偿、其他）；不建外键
  reasonCode                String    @map("reason_code")
  /// 说明，必填
  note                      String
  /// 执行时实际延长的周期；发起后原周期已续接时，它是新周期
  appliedSubscriptionTermId String?   @map("applied_subscription_term_id") @db.Uuid
  /// 执行方式：extend 未到期顺延 / revive 到期后补批（周期复活、冲回清零）
  appliedMode               String?   @map("applied_mode")
  /// 执行前该周期的止日
  prevEndDate               DateTime? @map("prev_end_date") @db.Date
  /// 执行后该周期的止日
  newEndDate                DateTime? @map("new_end_date") @db.Date
  /// 登记的账本操作（幂等键 extend:{审批单号}）；未执行为空
  ledgerOperationId         String?   @unique(map: "uq_term_extension_request_ledger_operation_id") @map("ledger_operation_id") @db.Uuid
  /// 执行时刻（账本时钟）
  appliedAt                 DateTime? @map("applied_at") @db.Timestamptz(3)
  /// 创建时间，应用时钟写入
  createdAt                 DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间，应用时钟写入
  updatedAt                 DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 关系：approval_request_id → approval_request.id
  approvalRequest         ApprovalRequest          @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_term_extension_request_approval_request_id")
  /// 关系：entity_id → entity.id
  entity                  Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_term_extension_request_entity_id")
  /// 关系：subscription_term_id → subscription_term.id
  subscriptionTerm        SubscriptionTerm         @relation("TermExtensionRequestedTerm", fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_term_extension_request_subscription_term_id")
  /// 关系：applied_subscription_term_id → subscription_term.id
  appliedSubscriptionTerm SubscriptionTerm?        @relation("TermExtensionAppliedTerm", fields: [appliedSubscriptionTermId], references: [id], onDelete: Restrict, map: "fk_term_extension_request_applied_subscription_term_id")
  /// 关系：ledger_operation_id → ledger_operation.id
  ledgerOperation         LedgerOperation?         @relation(fields: [ledgerOperationId], references: [id], onDelete: Restrict, map: "fk_term_extension_request_ledger_operation_id")
  pointAdjustmentRequests PointAdjustmentRequest[]

  @@index([entityId], map: "ix_term_extension_request_entity_id")
  @@index([subscriptionTermId], map: "ix_term_extension_request_subscription_term_id")
  @@index([appliedSubscriptionTermId], map: "ix_term_extension_request_applied_subscription_term_id")
  @@map("term_extension_request")
}

// ===== 08-billing-payment =====
// 分组 08-billing-payment：付款单、收款交易、退款、对账、发票（billing 模块的付款部分，12 张表）
// 只含本分组的 model；CHECK、部分索引、表达式唯一索引、触发器见 dm/sql/08-billing-payment.sql

/// 付款单（FK…）：开通、续费、升级、加购四类购买的业务单据，严格 5 态
model BillingOrder {
  /// 主键，UUID v7，应用生成
  id                                 String    @id(map: "pk_billing_order") @db.Uuid
  /// 付款单号：FK + yyyymmdd + 5 位日流水，超过 5 位自动扩位；预发环境加前缀 T。由 biz_sequence 在事务内取号
  orderNo                            String    @unique(map: "uq_billing_order_order_no") @map("order_no")
  /// 购买主体 → entity.id
  entityId                           String    @map("entity_id") @db.Uuid
  /// 创建时的当前门店；与 entity_id 一起 → store(id, entity_id)（复合外键，保证门店属于购买主体）。只用于列表展示，不参与鉴权
  storeId                            String?   @map("store_id") @db.Uuid
  /// 付款类型，由服务端按报价判定，前端不传：plan_new 开通；plan_renew 续费（含降级续费）；plan_upgrade 升级补差；topup 加购积分
  type                               String
  /// 付款单状态（PRD 5.3，严格 5 种）：pending_payment 待支付；pending_confirmation 待确认收款；paid 已支付；cancelled 已取消；refunded 已退款
  status                             String
  /// 收款渠道：wechat_jsapi 微信支付 JSAPI；bank_transfer 对公转账
  channel                            String
  /// 下单来源；灾备重建的付款单按原下单来源记 weapp：weapp 商家在小程序下单；admin 后台线下签约代建（退路 B）
  source                             String
  /// 内容快照 BillingOrderContent（套餐、升级、加购三种形态）。履约只认快照，不回查现价
  contentSnapshot                    Json      @map("content_snapshot")
  /// 计算式模板码（如“¥6,000 × 3 个月”），展示用；灾备重建的付款单为空
  formulaCode                        String?   @map("formula_code")
  /// 计算式参数，展示用
  formulaArgs                        Json?     @map("formula_args")
  /// 快照内容哈希；用于“同内容未完成付款单复用”
  quoteHash                          String    @map("quote_hash")
  /// 应付金额（分），大于 0；V1.0 不改价，等于报价金额
  amountFen                          Int       @map("amount_fen")
  /// 实收金额（分）：入账时写入渠道实收，不是应付
  paidAmountFen                      Int       @default(0) @map("paid_amount_fen")
  /// 已退金额（分）。不设上限：超额退款是要记录的资金事实，由不变量与 refund_over 差异单发现
  refundedAmountFen                  Int       @default(0) @map("refunded_amount_fen")
  /// 待支付截止时间。微信：创建 + billing.payment.order_timeout_minutes；对公：创建 + billing.payment.transfer_valid_days；升级单另受快照 validUntil 约束
  expiresAt                          DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 对公转账子状态；只在对公付款单未完成期间有值，进入已支付、已取消、已退款时清空：awaiting_proof 待上传凭证；proof_submitted 凭证已提交，待财务确认；proof_rejected 凭证被驳回，待重新上传；confirm_review 大额复核中（仅启用二人复核时）
  transferState                      String?   @map("transfer_state")
  /// 仅对公：创建时展示给商家的收款账户版本（config_key = bank_account 的行）→ finance_config_revision.id。角色 bank_account + 被引用表全名
  bankAccountFinanceConfigRevisionId String?   @map("bank_account_finance_config_revision_id") @db.Uuid
  /// 收款时间：微信 success_time，对公为财务确认到账时间
  paidAt                             DateTime? @map("paid_at") @db.Timestamptz(3)
  /// 入账的那笔收款交易 → payment_txn.id；一笔交易至多入账一张付款单
  paidPaymentTxnId                   String?   @unique(map: "uq_billing_order_paid_payment_txn_id") @map("paid_payment_txn_id") @db.Uuid
  /// 入账事务的时间
  appliedAt                          DateTime? @map("applied_at") @db.Timestamptz(3)
  /// 履约状态；“已支付 / 已退款 ⇔ 非 none”由不变量校验：none 未履约；done 履约完成；blocked 履约受阻
  fulfillmentStatus                  String    @default("none") @map("fulfillment_status")
  /// 履约完成的时刻：fulfill() 所在事务的账本时钟（含重试履约）。不一定是周期的生效时刻：生效期间续费、重复付款多排的预约周期在本期结束次日 00:00 生效，生效时刻取 fulfillment_result.effectiveAt
  fulfilledAt                        DateTime? @map("fulfilled_at") @db.Timestamptz(3)
  /// 履约说明，如“重复付款，多排一个周期”“升级前提已变”
  fulfillmentNote                    String?   @map("fulfillment_note")
  /// billing.fulfill() 的返回快照
  fulfillmentResult                  Json?     @map("fulfillment_result")
  /// 取消时间；补单后保留作痕迹
  cancelledAt                        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 取消原因：timeout 微信超时关单；user 老板取消；staff 员工取消；transfer_ttl 对公到期未传凭证；amount_mismatch 实收与应付不符；payer_mismatch 付款人或回传数据不符
  cancelReason                       String?   @map("cancel_reason")
  /// 全额退款成功时间
  refundedAt                         DateTime? @map("refunded_at") @db.Timestamptz(3)
  /// 冗余：存在未决差异单（列表打标“对账差异待处理”）
  hasOpenException                   Boolean   @default(false) @map("has_open_exception")
  /// 下单端平台，排查虚拟支付与策略命中用；后台代建为空：ios iOS；android Android；harmony 鸿蒙；windows Windows；mac macOS；devtools 开发者工具；unknown 未知
  clientPlatform                     String?   @map("client_platform")
  /// 下单端小程序版本号
  clientVersion                      String?   @map("client_version")
  /// 线下合同号；source = admin 必填
  contractNo                         String?   @map("contract_no")
  /// 下单的商家用户（老板）→ merchant_user.id；与 created_by_staff_id 二选一
  placedByUserId                     String?   @map("placed_by_user_id") @db.Uuid
  /// 代建付款单的员工 → staff.id（线下签约代建；灾备重建时为处理差异的财务）
  createdByStaffId                   String?   @map("created_by_staff_id") @db.Uuid
  /// V1.1 代操作人类型；V1.0 恒为空：merchant 商家用户（V1.1 的管理员）；partner 服务商
  proxyActorType                     String?   @map("proxy_actor_type")
  /// V1.1 代操作人 id；多态，不建外键；V1.0 恒为空
  proxyActorId                       String?   @map("proxy_actor_id") @db.Uuid
  /// V1.1 代操作人所用的客户端；V1.0 恒为空：weapp 小程序；portal 电脑端下载页；admin 运营管理后台
  proxyClient                        String?   @map("proxy_client")
  /// 灾备重建时记录原 out_trade_no
  rebuiltFrom                        String?   @map("rebuilt_from")
  /// 乐观锁；后台操作带 expectedVersion
  lockVersion                        Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt                          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt                          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 购买主体
  entity                           Entity                 @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_billing_order_entity_id")
  /// 创建时的当前门店（仅展示）；复合外键保证门店属于购买主体（M47），门店为空时不校验
  store                            Store?                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_billing_order_store_entity")
  /// 创建时展示的收款账户版本
  bankAccountFinanceConfigRevision FinanceConfigRevision? @relation(fields: [bankAccountFinanceConfigRevisionId], references: [id], onDelete: Restrict, map: "fk_billing_order_bank_account_finance_config_revision_id")
  /// 入账的收款交易
  paidPaymentTxn                   PaymentTxn?            @relation("BillingOrderPaidPaymentTxn", fields: [paidPaymentTxnId], references: [id], onDelete: Restrict, map: "fk_billing_order_paid_payment_txn_id")
  /// 下单的商家用户
  placedByUser                     MerchantUser?          @relation(fields: [placedByUserId], references: [id], onDelete: Restrict, map: "fk_billing_order_placed_by_user_id")
  /// 代建付款单的员工
  createdByStaff                   Staff?                 @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict, map: "fk_billing_order_created_by_staff_id")
  /// 反向：名下的收款尝试
  paymentTxns                      PaymentTxn[]           @relation("PaymentTxnBillingOrder")
  planPromoClaims                  PlanPromoClaim[]
  subscriptionTerm                 SubscriptionTerm?
  subscriptionEvents               SubscriptionEvent[]
  transferProofs                   TransferProof[]
  refundRequests                   RefundRequest[]
  refundTxns                       RefundTxn[]
  paymentExceptions                PaymentException[]
  invoiceRequests                  InvoiceRequest[]

  @@index([entityId, createdAt(sort: Desc)], map: "ix_billing_order_entity_created")
  @@index([status, channel, createdAt], map: "ix_billing_order_status_channel_created")
  @@index([storeId], map: "ix_billing_order_store_id")
  @@map("billing_order")
}

/// 收款交易：渠道侧一次收款尝试，成功的即收款流水
model PaymentTxn {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_payment_txn") @db.Uuid
  /// 所属主体 → entity.id；创建时从付款单复制，孤儿到账为空，关联到付款单时补写
  entityId           String?   @map("entity_id") @db.Uuid
  /// 付款单 → billing_order.id；仅“账单或银行有、平台无对应付款单”的孤儿交易为空
  billingOrderId     String?   @map("billing_order_id") @db.Uuid
  /// 收款渠道，同付款单：wechat_jsapi 微信支付 JSAPI；bank_transfer 对公转账
  channel            String
  /// 同一付款单的第几次尝试，从 1 起。出现第 2 次的唯一场景：付款人 openid 变了。孤儿交易：微信取商户单号里的尝试段，对公登记为 1
  attemptNo          Int       @map("attempt_no") @db.SmallInt
  /// 商户单号：{order_no}-{attempt_no 两位}-{6 位随机 [0-9A-Z]}。随机段使单号不随流水回退而重复；对公渠道同样生成，作内部引用。孤儿交易没有付款单号：微信取账单或查单返回的商户单号；对公“登记异常到账”取 {CY 差异单号}-01-{6 位随机}，关联到付款单后不改
  outTradeNo         String    @unique(map: "uq_payment_txn_out_trade_no") @map("out_trade_no")
  /// 下单时的应付金额（分），大于 0；孤儿交易取渠道实收
  amountFen          Int       @map("amount_fen")
  /// 渠道实收金额（分）：微信回调、查单、账单返回的 amount.total；对公为财务确认的到账金额。成功前为空
  channelAmountFen   Int?      @map("channel_amount_fen")
  /// 微信：预下单时取当前会话的 openid，即 JSAPI 的 payer.openid
  payerOpenid        String?   @map("payer_openid")
  /// 渠道返回的付款人：微信回调里的 payer.openid；对公为付款户名
  channelPayerRef    String?   @map("channel_payer_ref")
  /// 下单时写给微信的附加数据（不超过 128 字节）：v1.{entityId}.{orderId}.{typeCode}.{refId}.{months}
  attach             String?
  /// 回调或查单返回的附加数据；应与 attach 相同，用于入账校验与灾备重建
  channelAttach      String?   @map("channel_attach")
  /// 渠道事实，不写状态历史：created 已建（预下单在途或失败）；prepaid 已拿到 prepay_id，等用户付款；succeeded 收款成功；closed 已关闭
  status             String
  /// 入账到付款单的时间。未入账收款 = 已成功、未入账、未全额退回
  appliedAt          DateTime? @map("applied_at") @db.Timestamptz(3)
  /// 该笔收款已成功退回的金额（分）；不设上限
  refundedFen        Int       @default(0) @map("refunded_fen")
  /// 微信预支付交易会话标识，有效 2 小时
  prepayId           String?   @map("prepay_id")
  /// prepay_id 失效时间
  prepayExpiresAt    DateTime? @map("prepay_expires_at") @db.Timestamptz(3)
  /// 微信 transaction_id；对公为规范化后的银行流水号（去空白、全角转半角、去连字符、转大写）
  channelTxnNo       String?   @map("channel_txn_no")
  /// 对公：财务录入的原始流水号
  bankSerialRaw      String?   @map("bank_serial_raw")
  /// 对公：付款行（字典 bank 的编码，不建外键）；仅在流水号冲突时填写
  payerBank          String?   @map("payer_bank")
  /// 微信 success_time；对公为财务确认到账时间
  channelSuccessAt   DateTime? @map("channel_success_at") @db.Timestamptz(3)
  /// 渠道原始交易状态
  tradeStateRaw      String?   @map("trade_state_raw")
  /// 微信返回的付款银行类型
  bankType           String?   @map("bank_type")
  /// 手续费（分），对账时由交易账单回填
  feeFen             Int?      @map("fee_fen")
  /// 对公：被采纳的凭证 → transfer_proof.id
  transferProofId    String?   @unique(map: "uq_payment_txn_transfer_proof_id") @map("transfer_proof_id") @db.Uuid
  /// 对公：确认到账的财务（登记异常到账时为登记人）→ staff.id
  confirmedByStaffId String?   @map("confirmed_by_staff_id") @db.Uuid
  /// 对公：复核人 → staff.id；仅启用二人复核时有值，取复核审批单的审批人
  reviewedByStaffId  String?   @map("reviewed_by_staff_id") @db.Uuid
  /// 行级对账状态；对公收款确认即对平：pending 待对账（账单未到）；matched 已对平；diff 有差异（关联着未决差异单）；resolved 差异已处理
  reconState         String    @default("pending") @map("recon_state")
  /// 对平所依据的账单日
  reconBillDate      DateTime? @map("recon_bill_date") @db.Date
  /// 最近一次主动查单时间（节流）
  lastQueriedAt      DateTime? @map("last_queried_at") @db.Timestamptz(3)
  /// 主动查单次数
  queryCount         Int       @default(0) @map("query_count")
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity            Entity?            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_payment_txn_entity_id")
  /// 付款单
  billingOrder      BillingOrder?      @relation("PaymentTxnBillingOrder", fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_payment_txn_billing_order_id")
  /// 被采纳的对公凭证
  transferProof     TransferProof?     @relation(fields: [transferProofId], references: [id], onDelete: Restrict, map: "fk_payment_txn_transfer_proof_id")
  /// 确认到账的财务
  confirmedByStaff  Staff?             @relation("PaymentTxnConfirmedByStaff", fields: [confirmedByStaffId], references: [id], onDelete: Restrict, map: "fk_payment_txn_confirmed_by_staff_id")
  /// 复核人
  reviewedByStaff   Staff?             @relation("PaymentTxnReviewedByStaff", fields: [reviewedByStaffId], references: [id], onDelete: Restrict, map: "fk_payment_txn_reviewed_by_staff_id")
  /// 反向：以本交易入账的付款单
  paidBillingOrder  BillingOrder?      @relation("BillingOrderPaidPaymentTxn")
  refundRequests    RefundRequest[]
  refundTxns        RefundTxn[]
  paymentExceptions PaymentException[]
  wxBillLines       WxBillLine[]

  @@index([billingOrderId, attemptNo], map: "ix_payment_txn_billing_order_attempt")
  @@index([status, channelSuccessAt], map: "ix_payment_txn_status_success")
  @@index([reconState, channelSuccessAt], map: "ix_payment_txn_recon_success")
  @@index([entityId, channelSuccessAt], map: "ix_payment_txn_entity_success")
  @@map("payment_txn")
}

/// 对公转账凭证：回单文件、比对结论与财务审核结论
model TransferProof {
  /// 主键，UUID v7，应用生成
  id                      String    @id(map: "pk_transfer_proof") @db.Uuid
  /// 所属主体 → entity.id；创建时从付款单复制，不可变
  entityId                String    @map("entity_id") @db.Uuid
  /// 付款单 → billing_order.id；一张付款单可多次上传
  billingOrderId          String    @map("billing_order_id") @db.Uuid
  /// 同一付款单的第几次上传，从 1 起
  uploadNo                Int       @map("upload_no")
  /// 回单文件 → file_object.id（分类 pay_receipt，私有桶；图片不超过 5MB 或 PDF）
  fileId                  String    @map("file_id") @db.Uuid
  /// 上传的商家用户 → merchant_user.id；与 uploaded_by_staff_id 二选一
  uploadedByUserId        String?   @map("uploaded_by_user_id") @db.Uuid
  /// 后台代传的员工 → staff.id
  uploadedByStaffId       String?   @map("uploaded_by_staff_id") @db.Uuid
  /// 上传时间；也是升级报价有效期判断用的“付款人行为时刻”
  uploadedAt              DateTime  @map("uploaded_at") @db.Timestamptz(3)
  /// 识别结果 → ocr_result.id；OCR 未配置时为空。异步识别时 ocr_result 先以 pending 建行。识别值只存在 ocr_result
  ocrResultId             String?   @map("ocr_result_id") @db.Uuid
  /// 系统比对四项的结论（户名、金额、附言含付款单号、转账时间晚于创建）；只含结论，不含识别原值。仅提示，不阻断。异步识别完成后由 billing 订阅 media.ocr.completed 写入
  checkResult             Json?     @map("check_result")
  /// 财务审核结论；处理进度，不写状态历史：pending 待财务确认；accepted 已采纳（确认到账）；rejected 已驳回；superseded 被新凭证替换
  reviewStatus            String    @map("review_status")
  /// 仅二人复核：第一名财务确认的内容（流水号、付款行、到账金额）；确认人与时间在复核审批单上。复核退回时清空
  firstConfirm            Json?     @map("first_confirm")
  /// 仅二人复核：复核审批单 → approval_request.id（kind = transfer_confirm）；保存最近一次
  reviewApprovalRequestId String?   @unique(map: "uq_transfer_proof_review_approval_request_id") @map("review_approval_request_id") @db.Uuid
  /// 作出采纳或驳回结论的财务 → staff.id
  reviewedByStaffId       String?   @map("reviewed_by_staff_id") @db.Uuid
  /// 作出结论的时间
  reviewedAt              DateTime? @map("reviewed_at") @db.Timestamptz(3)
  /// 驳回原因（字典 reject_reason 的编码，场景 transfer，5 项：未到账、金额不符、户名与购买主体不一致、凭证无法识别、其他）
  rejectReasonCode        String?   @map("reject_reason_code")
  /// 驳回说明，不超过 200 字
  rejectNote              String?   @map("reject_note")
  /// 财务应处理的截止时间（上传后 1 个工作日）；sla.breach 定时器以本行为主体
  dueAt                   DateTime? @map("due_at") @db.Timestamptz(3)
  /// 计算 due_at 时的时限参数快照 SlaSnapshot（policy = review.transfer_proof）
  slaSnapshot             Json?     @map("sla_snapshot")
  /// 乐观锁；两名财务同时处理时后者得到 409
  lockVersion             Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt               DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_entity_id")
  /// 付款单
  billingOrder          BillingOrder     @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_billing_order_id")
  /// 回单文件
  file                  FileObject       @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_file_id")
  /// 上传的商家用户
  uploadedByUser        MerchantUser?    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_uploaded_by_user_id")
  /// 代传的员工
  uploadedByStaff       Staff?           @relation("TransferProofUploadedByStaff", fields: [uploadedByStaffId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_uploaded_by_staff_id")
  /// 识别结果
  ocrResult             OcrResult?       @relation(fields: [ocrResultId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_ocr_result_id")
  /// 复核审批单
  reviewApprovalRequest ApprovalRequest? @relation(fields: [reviewApprovalRequestId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_review_approval_request_id")
  /// 作出结论的财务
  reviewedByStaff       Staff?           @relation("TransferProofReviewedByStaff", fields: [reviewedByStaffId], references: [id], onDelete: Restrict, map: "fk_transfer_proof_reviewed_by_staff_id")
  paymentTxn            PaymentTxn?

  @@unique([billingOrderId, uploadNo], map: "uq_transfer_proof_billing_order_upload_no")
  @@index([reviewStatus, uploadedAt], map: "ix_transfer_proof_review_status_uploaded")
  @@index([entityId], map: "ix_transfer_proof_entity_id")
  @@map("transfer_proof")
}

/// 现金退款申请：规则核算快照与执行状态，与审批单一对一
model RefundRequest {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_refund_request") @db.Uuid
  /// 审批单 → approval_request.id，一对一；单号 TK… 取 approval_request.request_no
  approvalRequestId    String    @unique(map: "uq_refund_request_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 申请来源：customer_service 客服在付款单详情发起；exception 差异单或履约受阻转入
  source               String
  /// 所属主体 → entity.id；孤儿收款退款时为空
  entityId             String?   @map("entity_id") @db.Uuid
  /// 被退收款所属的付款单 → billing_order.id；孤儿收款为空。规则为 unapplied_receipt 时它可能是一张已支付的单（重复付款），被退的不是它的入账交易
  billingOrderId       String?   @map("billing_order_id") @db.Uuid
  /// 被退的那一笔收款交易 → payment_txn.id。除 unapplied_receipt 外都等于付款单的 paid_payment_txn_id
  paymentTxnId         String    @map("payment_txn_id") @db.Uuid
  /// 基数（分）：该笔收款的实收，或未入账收款的未退余额
  baseAmountFen        Int       @map("base_amount_fen")
  /// 扣除（分）；V1.0 只做全额退款，恒为 0
  deductAmountFen      Int       @default(0) @map("deduct_amount_fen")
  /// 申请退款金额（分）= 基数 − 扣除，大于 0；由服务端核算
  amountFen            Int       @map("amount_fen")
  /// 规则核算快照 CashRefundBreakdown（发起时调用一次并保存；含窗口截止时刻与被退周期的起止）
  breakdownSnapshot    Json      @map("breakdown_snapshot")
  /// 适用规则。套餐三条与 subscription_term.refund_rule 取值相同，发起时原样传给 suspendTermForRefund：window 套餐：开通或续费 7 天内且未使用积分；qualification_failed 套餐：资质终审不通过，免窗口；override 套餐：规则外退款（免窗口，仅超级管理员）；fulfillment_blocked 履约受阻，全额退；unapplied_receipt 未入账收款退回
  ruleCode             String    @map("rule_code")
  /// 规则文案快照，如“开通 7 天内且未使用积分（含冻结），全额退款”
  ruleText             String    @map("rule_text")
  /// 审批、执行时的复核结果，各存一份，供排查
  recheckLog           Json?     @map("recheck_log")
  /// 规则外退款（rule_code = override，仅超级管理员可发起）
  isOverride           Boolean   @default(false) @map("is_override")
  /// 申请原因（字典 refund_reason 的编码）；客服发起必填，差异转入为空（原因即差异单本身）
  reasonCode           String?   @map("reason_code")
  /// 申请说明
  note                 String?
  /// 执行状态（与 cancel_request.status 同一组取值）；审批结论另读审批单：pending_approval 已提交、待审批；pending_execution 已批准、待执行；executing 执行中（微信原路退在途）；done 已退款；not_executed 未执行即关闭（驳回、撤回、作废）
  status               String
  /// 退款路由，执行时确定：wechat_original 微信原路退；offline 线下退款登记
  execRoute            String?   @map("exec_route")
  /// 执行时限：审批通过时写入（sla.review.refund_execute，默认 1 个工作日）；执行时限的 sla.breach 定时器主体是审批单（M71）
  execDueAt            DateTime? @map("exec_due_at") @db.Timestamptz(3)
  /// 执行时限的参数快照 SlaSnapshot（policy = review.refund_execute）；与 exec_due_at 同有同无
  slaSnapshot          Json?     @map("sla_snapshot")
  /// 套餐权益已回收（revokeTerm 成功）的时刻；非空后申请单不可作废
  entitlementRevokedAt DateTime? @map("entitlement_revoked_at") @db.Timestamptz(3)
  /// 最近一次执行的财务 → staff.id
  executedByStaffId    String?   @map("executed_by_staff_id") @db.Uuid
  /// 最近一次执行的时间
  executedAt           DateTime? @map("executed_at") @db.Timestamptz(3)
  /// 退款完成时间
  doneAt               DateTime? @map("done_at") @db.Timestamptz(3)
  /// 审批通过后作废的财务 → staff.id；仅 close_reason = voided 时有值
  voidedByStaffId      String?   @map("voided_by_staff_id") @db.Uuid
  /// 最近一次执行失败的原因，供“待执行、执行中”队列展示
  execError            Json?     @map("exec_error")
  /// 申请结束时间：进入 done 或 not_executed 时写入。为空即在途
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 未执行即关闭的原因；仅 not_executed 时非空：rejected 审批驳回；withdrawn 申请人在审批前撤回；voided 审批通过后、执行前作废
  closeReason          String?   @map("close_reason")
  /// 作废说明，仅 close_reason = voided 时必填。驳回与撤回的说明在审批单的 decision_note
  closeNote            String?   @map("close_note")
  /// 乐观锁
  lockVersion          Int       @default(0) @map("lock_version")
  /// 创建时间，即申请时刻；套餐退款的窗口按这一时刻判断
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 审批单（一对一）
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_refund_request_approval_request_id")
  /// 所属主体
  entity            Entity?            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_refund_request_entity_id")
  /// 被退收款所属的付款单
  billingOrder      BillingOrder?      @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_refund_request_billing_order_id")
  /// 被退的收款交易
  paymentTxn        PaymentTxn         @relation(fields: [paymentTxnId], references: [id], onDelete: Restrict, map: "fk_refund_request_payment_txn_id")
  /// 执行人
  executedByStaff   Staff?             @relation("RefundRequestExecutedByStaff", fields: [executedByStaffId], references: [id], onDelete: Restrict, map: "fk_refund_request_executed_by_staff_id")
  /// 作废人
  voidedByStaff     Staff?             @relation("RefundRequestVoidedByStaff", fields: [voidedByStaffId], references: [id], onDelete: Restrict, map: "fk_refund_request_voided_by_staff_id")
  subscriptionTerms SubscriptionTerm[]
  refundTxns        RefundTxn[]
  paymentExceptions PaymentException[]
  invoiceRequests   InvoiceRequest[]

  @@index([status, createdAt], map: "ix_refund_request_status_created")
  @@index([status, execDueAt], map: "ix_refund_request_status_exec_due_at")
  @@index([billingOrderId], map: "ix_refund_request_billing_order_id")
  @@index([paymentTxnId], map: "ix_refund_request_payment_txn_id")
  @@index([entityId, createdAt], map: "ix_refund_request_entity_created")
  @@map("refund_request")
}

/// 退款交易：渠道侧一次退款的资金事实
model RefundTxn {
  /// 主键，UUID v7，应用生成
  id                  String    @id(map: "pk_refund_txn") @db.Uuid
  /// 所属主体 → entity.id；创建时从收款交易复制，孤儿收款退款为空
  entityId            String?   @map("entity_id") @db.Uuid
  /// 退款申请 → refund_request.id；“补记渠道退款”与差异单“线下退回”时为空
  refundRequestId     String?   @map("refund_request_id") @db.Uuid
  /// 付款单 → billing_order.id；孤儿收款为空
  billingOrderId      String?   @map("billing_order_id") @db.Uuid
  /// 原收款交易 → payment_txn.id（原路退需要它的 out_trade_no）
  paymentTxnId        String    @map("payment_txn_id") @db.Uuid
  /// 退款渠道：wechat_jsapi 微信原路退；offline 线下退款
  channel             String
  /// 发起方：system 本系统发起；external 在微信商户平台直接发起、事后补记
  origin              String
  /// 商户退款单号：{TK 单号}-{序号两位}-{6 位随机}，微信原路退与线下退款登记同一格式；重试同一次退款必须沿用。补记渠道退款取账单里的商户退款单号；差异单“线下退回”没有退款申请，取 {CY 差异单号}-{序号两位}-{6 位随机}
  outRefundNo         String    @unique(map: "uq_refund_txn_out_refund_no") @map("out_refund_no")
  /// 退款金额（分），大于 0
  amountFen           Int       @map("amount_fen")
  /// 渠道事实，不写状态历史：created 已建（是否被微信受理未知，或被明确拒绝待重试）；processing 微信已受理；succeeded 退款成功；closed 微信关闭（失败终态）；abnormal 微信侧异常（非终态）；not_accepted 经查询确认微信侧不存在该退款单（失败终态）；abandoned 异常退款经确认无法继续后人工放弃（失败终态）
  status              String
  /// 微信 refund_id；线下为规范化后的退款银行流水号
  channelRefundNo     String?   @map("channel_refund_no")
  /// 向微信提交的次数
  submitCount         Int       @default(0) @map("submit_count")
  /// 最近一次提交时间
  lastSubmitAt        DateTime? @map("last_submit_at") @db.Timestamptz(3)
  /// 是否已停止自动重试
  isRetryHalted       Boolean   @default(false) @map("is_retry_halted")
  /// 退款成功时间：微信入账时间；线下为登记时间
  successAt           DateTime? @map("success_at") @db.Timestamptz(3)
  /// 微信返回的退款入账账户描述
  userReceivedAccount String?   @map("user_received_account")
  /// 失败码，如余额不足、频率限制、超期
  failCode            String?   @map("fail_code")
  /// 失败说明
  failMessage         String?   @map("fail_message")
  /// 从失败终态被渠道事实改成成功（必开差异单）
  isLateSuccess       Boolean   @default(false) @map("is_late_success")
  /// 线下：转账日期，不晚于登记当天
  transferDate        DateTime? @map("transfer_date") @db.Date
  /// 线下：收款户名；对公付款的须等于购买主体名称
  payeeName           String?   @map("payee_name")
  /// 线下：收款开户行
  payeeBank           String?   @map("payee_bank")
  /// 线下：收款账号密文（AES-256-GCM）
  payeeAccountEnc     String?   @map("payee_account_enc")
  /// 线下：收款账号脱敏串（后 4 位）
  payeeAccountMask    String?   @map("payee_account_mask")
  /// 线下：退款回单文件 → file_object.id（分类 pay_receipt；主体未知的孤儿收款退款按平台级登记，scope_type = platform）
  receiptFileId       String?   @map("receipt_file_id") @db.Uuid
  /// 线下：登记人 → staff.id
  registeredByStaffId String?   @map("registered_by_staff_id") @db.Uuid
  /// 线下：登记说明；改走线下时必填
  note                String?
  /// 退还的手续费（分），对账时由账单回填
  feeRefundFen        Int?      @map("fee_refund_fen")
  /// 行级对账状态；线下退款登记即对平：pending 待对账；matched 已对平；diff 有差异；resolved 差异已处理
  reconState          String    @default("pending") @map("recon_state")
  /// 对平所依据的账单日
  reconBillDate       DateTime? @map("recon_bill_date") @db.Date
  /// 最近一次查询退款的时间
  lastQueriedAt       DateTime? @map("last_queried_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity            Entity?            @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_refund_txn_entity_id")
  /// 退款申请
  refundRequest     RefundRequest?     @relation(fields: [refundRequestId], references: [id], onDelete: Restrict, map: "fk_refund_txn_refund_request_id")
  /// 付款单
  billingOrder      BillingOrder?      @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_refund_txn_billing_order_id")
  /// 原收款交易
  paymentTxn        PaymentTxn         @relation(fields: [paymentTxnId], references: [id], onDelete: Restrict, map: "fk_refund_txn_payment_txn_id")
  /// 线下退款回单
  receiptFile       FileObject?        @relation(fields: [receiptFileId], references: [id], onDelete: Restrict, map: "fk_refund_txn_receipt_file_id")
  /// 线下登记人
  registeredByStaff Staff?             @relation(fields: [registeredByStaffId], references: [id], onDelete: Restrict, map: "fk_refund_txn_registered_by_staff_id")
  paymentExceptions PaymentException[]
  wxBillLines       WxBillLine[]

  @@index([refundRequestId], map: "ix_refund_txn_refund_request_id")
  @@index([paymentTxnId], map: "ix_refund_txn_payment_txn_id")
  @@index([billingOrderId], map: "ix_refund_txn_billing_order_id")
  @@index([status, successAt], map: "ix_refund_txn_status_success")
  @@index([reconState, successAt], map: "ix_refund_txn_recon_success")
  @@index([entityId], map: "ix_refund_txn_entity_id")
  @@map("refund_txn")
}

/// 差异单（CY…）：实时异常与对账差异共用的单据
model PaymentException {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_payment_exception") @db.Uuid
  /// 差异单号：CY + yyyymmdd + 3 位起、自动扩位
  exceptionNo       String    @unique(map: "uq_payment_exception_exception_no") @map("exception_no")
  /// 所属主体 → entity.id；创建时从付款单或收款交易复制，没有时为空
  entityId          String?   @map("entity_id") @db.Uuid
  /// 差异类型（收款侧 9 种、退款侧 5 种）：paid_after_cancel 已取消后收到款；amount_mismatch 实收与应付不符；payer_mismatch 付款人或回传数据与付款单不符；duplicate_receipt 已支付的付款单又收到一笔；fulfillment_blocked 已支付但履约受阻；bill_only 账单有、平台无；platform_only 平台有、账单无；status_mismatch 本库成功而渠道查询非成功等矛盾；bank_unmatched 对公到账无对应付款单（人工登记）；refund_bill_only 退款：账单有、平台无；refund_platform_only 退款：平台有、账单无；refund_amount_mismatch 退款金额不符；refund_over 累计成功退款超过实收；entitlement_unrecovered 钱已退出、权益未能收回
  kind              String
  /// 发现途径：callback 回调；query 主动查单或查询退款；apply 入账函数；reconciliation T+1 对账；manual 人工登记
  detectedBy        String    @map("detected_by")
  /// 对账发现时为账单日；实时发现时为发生日（Asia/Shanghai）
  billDate          DateTime  @map("bill_date") @db.Date
  /// 相关付款单 → billing_order.id
  billingOrderId    String?   @map("billing_order_id") @db.Uuid
  /// 相关收款交易 → payment_txn.id
  paymentTxnId      String?   @map("payment_txn_id") @db.Uuid
  /// 相关退款交易 → refund_txn.id
  refundTxnId       String?   @map("refund_txn_id") @db.Uuid
  /// 相关账单行 → wx_bill_line.id
  wxBillLineId      String?   @map("wx_bill_line_id") @db.Uuid
  /// 差异金额（分）
  amountFen         Int       @map("amount_fen")
  /// 账单侧（或渠道侧）事实
  billFact          Json?     @map("bill_fact")
  /// 平台侧事实
  platformFact      Json?     @map("platform_fact")
  /// 系统判断的原因，如“支付回调晚于取消”
  causeText         String?   @map("cause_text")
  /// 处理状态；未决 = open 或 resolving：open 待处理；resolving 已转退款申请，等待完成；resolved 已处理；auto_healed 系统自动关闭：查单或对账补记后入账成功，或由入账函数重新归类到新差异单（只留痕，不占待办）；ignored 无需处理
  status            String
  /// 处理方式：restore 补单；refund 原路或线下退款（走审批）；retried 重试履约（仅履约受阻）；rebuild_order 重建付款单并入账；link_order 关联到付款单并确认；offline_return 线下退回；record_channel_refund 补记渠道退款；corrected 数据更正；written_off 核销；none 尚未处理或无需处理
  resolution        String    @default("none")
  /// 处理说明，人工处理必填（含“转退款”时），不超过 200 字
  resolutionNote    String?   @map("resolution_note")
  /// 处理人 → staff.id：作出处理的财务；“转退款”时即写入，退款完成后沿用。系统自动关闭（auto_healed）为空
  resolvedByStaffId String?   @map("resolved_by_staff_id") @db.Uuid
  /// 处理完成时间
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// “转退款”生成的退款申请 → refund_request.id；申请被驳回、撤回、作废后与处理方式、处理人、说明一起清空，回到 open
  refundRequestId   String?   @map("refund_request_id") @db.Uuid
  /// 去重键，如 paid_after_cancel:FK…-01-7QK2M9、bill_only:2026-09-29:4200…；重跑对账、重复入账都不会重复开单
  dedupeKey         String    @unique(map: "uq_payment_exception_dedupe_key") @map("dedupe_key")
  /// 乐观锁
  lockVersion       Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity          Entity?        @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_payment_exception_entity_id")
  /// 相关付款单
  billingOrder    BillingOrder?  @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_payment_exception_billing_order_id")
  /// 相关收款交易
  paymentTxn      PaymentTxn?    @relation(fields: [paymentTxnId], references: [id], onDelete: Restrict, map: "fk_payment_exception_payment_txn_id")
  /// 相关退款交易
  refundTxn       RefundTxn?     @relation(fields: [refundTxnId], references: [id], onDelete: Restrict, map: "fk_payment_exception_refund_txn_id")
  /// 相关账单行
  wxBillLine      WxBillLine?    @relation(fields: [wxBillLineId], references: [id], onDelete: Restrict, map: "fk_payment_exception_wx_bill_line_id")
  /// 处理人
  resolvedByStaff Staff?         @relation(fields: [resolvedByStaffId], references: [id], onDelete: Restrict, map: "fk_payment_exception_resolved_by_staff_id")
  /// 转出的退款申请
  refundRequest   RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: Restrict, map: "fk_payment_exception_refund_request_id")

  @@index([status, kind], map: "ix_payment_exception_status_kind")
  @@index([billDate, status], map: "ix_payment_exception_bill_date_status")
  @@index([billingOrderId], map: "ix_payment_exception_billing_order_id")
  @@index([paymentTxnId], map: "ix_payment_exception_payment_txn_id")
  @@index([refundTxnId], map: "ix_payment_exception_refund_txn_id")
  @@index([wxBillLineId], map: "ix_payment_exception_wx_bill_line_id")
  @@index([refundRequestId], map: "ix_payment_exception_refund_request_id")
  @@index([entityId], map: "ix_payment_exception_entity_id")
  @@map("payment_exception")
}

/// 微信交易账单文件：按商户号与账单日记录下载、解析状态与归档文件
model WxBillFile {
  /// 主键，UUID v7，应用生成
  id             String    @id(map: "pk_wx_bill_file") @db.Uuid
  /// 微信支付商户号
  mchid          String
  /// 账单日（Asia/Shanghai）
  billDate       DateTime  @map("bill_date") @db.Date
  /// 账单类型：trade_all 交易账单（全部交易，`bill_type=ALL`）
  billType       String    @map("bill_type")
  /// 下载与解析进度；技术状态，不写状态历史：pending 待下载；downloaded 已下载并归档；parsed 已解析入库；empty 当日无账单；failed 下载或解析失败，待重试
  status         String
  /// 归档的账单原文件 → file_object.id；永久保留（接口只能拉近 3 个月）
  fileId         String?   @map("file_id") @db.Uuid
  /// 微信返回的文件摘要值
  sha1           String?
  /// 下载内容的摘要是否校验通过
  isHashVerified Boolean   @default(false) @map("is_hash_verified")
  /// 解析出的明细行数
  lineCount      Int?      @map("line_count")
  /// 文件尾部汇总行（解析后与明细核对）
  summary        Json?
  /// 下载尝试次数
  attemptCount   Int       @default(0) @map("attempt_count")
  /// 最近一次失败原因
  lastError      String?   @map("last_error")
  /// 下载完成时间
  downloadedAt   DateTime? @map("downloaded_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 归档的账单原文件
  file        FileObject?  @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_wx_bill_file_file_id")
  wxBillLines WxBillLine[]

  @@unique([mchid, billDate, billType], map: "uq_wx_bill_file_mchid_bill_date_bill_type")
  @@index([status, billDate], map: "ix_wx_bill_file_status_bill_date")
  @@map("wx_bill_file")
}

/// 微信交易账单明细行：账单原始字段与匹配结果
model WxBillLine {
  /// 主键，UUID v7，应用生成
  id                  String   @id(map: "pk_wx_bill_line") @db.Uuid
  /// 账单文件 → wx_bill_file.id
  wxBillFileId        String   @map("wx_bill_file_id") @db.Uuid
  /// 文件内行号，从 1 起
  lineNo              Int      @map("line_no")
  /// 账单日，从文件复制
  billDate            DateTime @map("bill_date") @db.Date
  /// 行类型：payment 收款行；refund 退款行
  lineKind            String   @map("line_kind")
  /// 交易时间：账单列“交易时间”（北京时间）转存 UTC
  tradedAt            DateTime @map("traded_at") @db.Timestamptz(3)
  /// 公众账号 ID
  appid               String
  /// 商户号
  mchid               String
  /// 微信订单号
  transactionId       String   @map("transaction_id")
  /// 商户订单号
  outTradeNo          String   @map("out_trade_no")
  /// 交易状态原值（SUCCESS、REFUND 等）
  tradeState          String   @map("trade_state")
  /// 订单金额（分）
  orderAmountFen      Int      @map("order_amount_fen")
  /// 应结订单金额（分）
  settleAmountFen     Int      @map("settle_amount_fen")
  /// 微信退款单号；退款行才有
  refundId            String?  @map("refund_id")
  /// 商户退款单号；退款行才有
  outRefundNo         String?  @map("out_refund_no")
  /// 退款金额（分）；退款行才有
  refundAmountFen     Int?     @map("refund_amount_fen")
  /// 退款状态原值；退款行才有
  refundState         String?  @map("refund_state")
  /// 商户数据包；账单含该列时才填（待核），重建付款单以查单返回的为准
  attach              String?
  /// 手续费（分）；退款行为退还的手续费，可为负
  feeFen              Int      @map("fee_fen")
  /// 费率原文
  rateText            String?  @map("rate_text")
  /// 非我方交易（共用商户号的其他系统）：appid、mchid 非我方，或商户订单号不符合我方格式；不计入差异
  isForeign           Boolean  @default(false) @map("is_foreign")
  /// 匹配结果：matched 已匹配且一致；matched_pending 退款行处理中：只核对了单号与金额，不改本库状态；diff 有差异（关联差异单）；unmatched 尚未匹配或找不到对应交易；foreign 非我方交易，跳过
  matchState          String   @map("match_state")
  /// 匹配到的收款交易 → payment_txn.id
  matchedPaymentTxnId String?  @map("matched_payment_txn_id") @db.Uuid
  /// 匹配到的退款交易 → refund_txn.id
  matchedRefundTxnId  String?  @map("matched_refund_txn_id") @db.Uuid
  /// 创建时间
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)
  /// 更新时间（重跑对账会改匹配结果）
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)

  /// 账单文件
  wxBillFile        WxBillFile         @relation(fields: [wxBillFileId], references: [id], onDelete: Restrict, map: "fk_wx_bill_line_wx_bill_file_id")
  /// 匹配到的收款交易
  matchedPaymentTxn PaymentTxn?        @relation(fields: [matchedPaymentTxnId], references: [id], onDelete: Restrict, map: "fk_wx_bill_line_matched_payment_txn_id")
  /// 匹配到的退款交易
  matchedRefundTxn  RefundTxn?         @relation(fields: [matchedRefundTxnId], references: [id], onDelete: Restrict, map: "fk_wx_bill_line_matched_refund_txn_id")
  paymentExceptions PaymentException[]

  @@unique([wxBillFileId, lineNo], map: "uq_wx_bill_line_file_line_no")
  @@index([outTradeNo], map: "ix_wx_bill_line_out_trade_no")
  @@index([outRefundNo], map: "ix_wx_bill_line_out_refund_no")
  @@index([billDate, matchState], map: "ix_wx_bill_line_bill_date_match")
  @@index([matchedPaymentTxnId], map: "ix_wx_bill_line_matched_payment_txn_id")
  @@index([matchedRefundTxnId], map: "ix_wx_bill_line_matched_refund_txn_id")
  @@map("wx_bill_line")
}

/// 每日对账汇总：按账单日与渠道记录两侧笔数金额、差异与对账状态
model ReconDay {
  /// 主键，UUID v7，应用生成
  id                  String    @id(map: "pk_recon_day") @db.Uuid
  /// 账单日（Asia/Shanghai）
  billDate            DateTime  @map("bill_date") @db.Date
  /// 收款渠道：wechat_jsapi 微信支付 JSAPI；bank_transfer 对公转账
  channel             String
  /// 平台侧收款笔数
  platformPayCount    Int       @default(0) @map("platform_pay_count")
  /// 平台侧收款金额（分）
  platformPayFen      BigInt    @default(0) @map("platform_pay_fen")
  /// 账单侧收款笔数
  billPayCount        Int       @default(0) @map("bill_pay_count")
  /// 账单侧收款金额（分）
  billPayFen          BigInt    @default(0) @map("bill_pay_fen")
  /// 平台侧退款笔数（按成功日）
  platformRefundCount Int       @default(0) @map("platform_refund_count")
  /// 平台侧退款金额（分）
  platformRefundFen   BigInt    @default(0) @map("platform_refund_fen")
  /// 账单侧退款笔数（按受理日）
  billRefundCount     Int       @default(0) @map("bill_refund_count")
  /// 账单侧退款金额（分）
  billRefundFen       BigInt    @default(0) @map("bill_refund_fen")
  /// 当日确认的对公到账笔数（仅展示）
  bankCount           Int       @default(0) @map("bank_count")
  /// 当日确认的对公到账金额（分，仅展示）
  bankFen             BigInt    @default(0) @map("bank_fen")
  /// 当日手续费合计（分）；含退款退还的手续费，可为负
  feeFen              BigInt    @default(0) @map("fee_fen")
  /// 当日发生的差异笔数：bill_date 为该日的差异单数，含已处理的，不含 auto_healed、ignored。已处理后不清零（fixed 行仍显示差异数与处理结果）
  diffCount           Int       @default(0) @map("diff_count")
  /// 当日发生的差异金额合计（分），口径同 diff_count
  diffFen             BigInt    @default(0) @map("diff_fen")
  /// 对账状态；技术状态，不写状态历史：wait 待对账（账单未到）；ok 已对平；diff 有差异；fixed 已处理差异
  status              String
  /// 对账运行次数（含“重新对账”）
  runCount            Int       @default(0) @map("run_count")
  /// 最近一次运行时间
  lastRunAt           DateTime? @map("last_run_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  @@unique([billDate, channel], map: "uq_recon_day_bill_date_channel")
  @@map("recon_day")
}

/// 开票申请（KP…）：按付款单全额申请，抬头与税号取认证主体快照
model InvoiceRequest {
  /// 主键，UUID v7，应用生成
  id                    String    @id(map: "pk_invoice_request") @db.Uuid
  /// 申请单号：KP + yyyymmdd + 3 位起、自动扩位
  requestNo             String    @unique(map: "uq_invoice_request_request_no") @map("request_no")
  /// 付款单 → billing_order.id
  billingOrderId        String    @map("billing_order_id") @db.Uuid
  /// 所属主体 → entity.id
  entityId              String    @map("entity_id") @db.Uuid
  /// 开票金额（分）；V1.0 恒等于付款单实付全额
  amountFen             Int       @map("amount_fen")
  /// 发票类型：normal 普通发票；special 增值税专用发票
  invoiceType           String    @map("invoice_type")
  /// 介质；普通发票仅电子：electronic 电子；paper 纸质
  medium                String
  /// 抬头：申请时从认证主体快照，接口不接受客户端传入
  title                 String
  /// 税号密文（AES-256-GCM）；申请时从认证主体快照
  taxNoEnc              String    @map("tax_no_enc")
  /// 税号脱敏串，如 91510107MA6C****7K
  taxNoMask             String    @map("tax_no_mask")
  /// 地址与电话密文；专票必填
  addrTelEnc            String?   @map("addr_tel_enc")
  /// 地址与电话脱敏串
  addrTelMask           String?   @map("addr_tel_mask")
  /// 开户行及账号密文；专票必填
  bankAccountEnc        String?   @map("bank_account_enc")
  /// 开户行及账号脱敏串，如“中国银行成都武侯支行 ****5208”
  bankAccountMask       String?   @map("bank_account_mask")
  /// 接收邮箱密文；电子发票必填
  recvEmailEnc          String?   @map("recv_email_enc")
  /// 接收邮箱脱敏串，如 yunjian****@163.com
  recvEmailMask         String?   @map("recv_email_mask")
  /// 纸质发票收件信息密文（明文为 JSON：收件人、电话、地址）；纸质必填，可编辑，默认带出联系人与门店地址
  mailToEnc             String?   @map("mail_to_enc")
  /// 收件信息脱敏串，如“李女士 · 139****2046 · 成都市武侯区****”
  mailToMask            String?   @map("mail_to_mask")
  /// 开票项目快照，取参数 invoice.item_name.{type}
  itemName              String    @map("item_name")
  /// 开票申请状态：pending 待开票；issued 已开具（纸质展示为“已寄出”）；rejected 已驳回；red_pending 待红冲；red_issued 已红冲
  status                String
  /// 该付款单的入账收款有在途退款申请时置上 → refund_request.id（规则为 unapplied_receipt 的不算）；只作队列展示（“退款处理中，暂停开具”），开具守卫另行现算
  heldByRefundRequestId String?   @map("held_by_refund_request_id") @db.Uuid
  /// 驳回方式；只在 rejected 时有值。系统自动驳回不用字典编码（M55）：manual 财务驳回（带字典原因）；order_refunded 付款单已退款，系统自动驳回
  rejectKind            String?   @map("reject_kind")
  /// 财务驳回原因（字典 reject_reason 的编码，场景 invoice，4 项）；仅 reject_kind = manual 时有值
  rejectReasonCode      String?   @map("reject_reason_code")
  /// 驳回说明，不超过 200 字
  rejectNote            String?   @map("reject_note")
  /// 驳回人 → staff.id；仅 reject_kind = manual 时有值
  rejectedByStaffId     String?   @map("rejected_by_staff_id") @db.Uuid
  /// 驳回时间
  rejectedAt            DateTime? @map("rejected_at") @db.Timestamptz(3)
  /// 申请人（老板）→ merchant_user.id
  appliedByUserId       String    @map("applied_by_user_id") @db.Uuid
  /// 申请时间
  appliedAt             DateTime  @map("applied_at") @db.Timestamptz(3)
  /// 开票方式；V1.0 固定人工开具后回填：manual 人工在税务平台开具后回填
  provider              String    @default("manual")
  /// 财务应处理的截止时间；sla.breach 定时器以本行为主体。未配置时限时为空
  dueAt                 DateTime? @map("due_at") @db.Timestamptz(3)
  /// 计算 due_at 时的时限参数快照 SlaSnapshot（policy = review.invoice_request）
  slaSnapshot           Json?     @map("sla_snapshot")
  /// 乐观锁
  lockVersion           Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 付款单
  billingOrder        BillingOrder   @relation(fields: [billingOrderId], references: [id], onDelete: Restrict, map: "fk_invoice_request_billing_order_id")
  /// 所属主体
  entity              Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_invoice_request_entity_id")
  /// 使开具暂停的在途退款申请
  heldByRefundRequest RefundRequest? @relation(fields: [heldByRefundRequestId], references: [id], onDelete: Restrict, map: "fk_invoice_request_held_by_refund_request_id")
  /// 驳回人
  rejectedByStaff     Staff?         @relation(fields: [rejectedByStaffId], references: [id], onDelete: Restrict, map: "fk_invoice_request_rejected_by_staff_id")
  /// 申请人
  appliedByUser       MerchantUser   @relation(fields: [appliedByUserId], references: [id], onDelete: Restrict, map: "fk_invoice_request_applied_by_user_id")
  invoiceDocs         InvoiceDoc[]

  @@index([status, appliedAt], map: "ix_invoice_request_status_applied")
  @@index([entityId, appliedAt(sort: Desc)], map: "ix_invoice_request_entity_applied")
  @@index([billingOrderId], map: "ix_invoice_request_billing_order_id")
  @@index([heldByRefundRequestId], map: "ix_invoice_request_held_by_refund_request_id")
  @@map("invoice_request")
}

/// 票据：开票申请下的蓝字或红字发票（号码、文件、快递、邮件状态）
model InvoiceDoc {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_invoice_doc") @db.Uuid
  /// 所属主体 → entity.id；创建时从开票申请复制，不可变
  entityId             String    @map("entity_id") @db.Uuid
  /// 开票申请 → invoice_request.id
  invoiceRequestId     String    @map("invoice_request_id") @db.Uuid
  /// 票据种类：blue 蓝字发票；red 红字发票
  docKind              String    @map("doc_kind")
  /// 发票号码：电子为 20 位数字；纸质接受 20 位数字或 8 位号码（配发票代码）。校验规则取参数 invoice.no_rules
  invoiceNo            String    @map("invoice_no")
  /// 发票代码（10 或 12 位）；数电发票没有
  invoiceCode          String?   @map("invoice_code")
  /// 票面金额（分）；红字为负
  amountFen            Int       @map("amount_fen")
  /// 发票文件 → file_object.id（分类 invoice）；纸质发票可为空
  fileId               String?   @map("file_id") @db.Uuid
  /// 文件格式：pdf PDF；ofd OFD；xml XML
  fileFormat           String?   @map("file_format")
  /// 开具（回填）时间
  issuedAt             DateTime  @map("issued_at") @db.Timestamptz(3)
  /// 开具人 → staff.id
  issuedByStaffId      String    @map("issued_by_staff_id") @db.Uuid
  /// 快递公司（字典 express_company 的编码）；纸质才有
  expressCompany       String?   @map("express_company")
  /// 运单号；纸质才有
  trackingNo           String?   @map("tracking_no")
  /// 寄出时间
  shippedAt            DateTime? @map("shipped_at") @db.Timestamptz(3)
  /// 邮件发送状态，由通知结果事件回写：none 不发邮件（纸质或未填邮箱）；queued 已交通知中心；sent 已送达；failed 发送失败，可在后台重发；skipped 未配置邮件驱动，跳过
  emailState           String    @default("none") @map("email_state")
  /// 邮件送达时间
  emailSentAt          DateTime? @map("email_sent_at") @db.Timestamptz(3)
  /// 红字发票指向被冲的蓝字发票 → invoice_doc.id
  originalInvoiceDocId String?   @unique(map: "uq_invoice_doc_original_invoice_doc_id") @map("original_invoice_doc_id") @db.Uuid
  /// 红冲原因
  redReason            String?   @map("red_reason")
  /// 开票服务商侧的引用；V1.0 为空（为自动开票预留）
  providerRef          String?   @map("provider_ref")
  /// 创建时间
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity             Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_invoice_doc_entity_id")
  /// 开票申请
  invoiceRequest     InvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict, map: "fk_invoice_doc_invoice_request_id")
  /// 发票文件
  file               FileObject?    @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_invoice_doc_file_id")
  /// 开具人
  issuedByStaff      Staff          @relation(fields: [issuedByStaffId], references: [id], onDelete: Restrict, map: "fk_invoice_doc_issued_by_staff_id")
  /// 被冲的蓝字发票
  originalInvoiceDoc InvoiceDoc?    @relation("InvoiceDocOriginal", fields: [originalInvoiceDocId], references: [id], onDelete: Restrict, map: "fk_invoice_doc_original_invoice_doc_id")
  /// 反向：冲销本张蓝字发票的红字发票
  redInvoiceDoc      InvoiceDoc?    @relation("InvoiceDocOriginal")

  @@unique([invoiceRequestId, docKind], map: "uq_invoice_doc_request_kind")
  @@index([entityId, issuedAt], map: "ix_invoice_doc_entity_issued")
  @@index([issuedAt], map: "ix_invoice_doc_issued_at")
  @@map("invoice_doc")
}

/// 受控财务配置版本：收款账户、购买入口策略、内控开关；按生效时间取当前值
model FinanceConfigRevision {
  /// 主键，UUID v7，应用生成
  id                String    @id(map: "pk_finance_config_revision") @db.Uuid
  /// 配置键：bank_account 对公收款户名、开户行、账号（展示给所有商家）；purchase_policy 购买入口策略规则表；controls 内控开关组（代建付款单、微信限额、二人复核阈值、发货信息上报）
  configKey         String    @map("config_key")
  /// 配置内容，按键用 Zod 校验；bank_account 的账号在这里只放脱敏值
  payload           Json
  /// 仅 bank_account：对公收款账号密文（AES-256-GCM）
  accountNoEnc      String?   @map("account_no_enc")
  /// 仅 bank_account：对公收款账号脱敏串
  accountNoMask     String?   @map("account_no_mask")
  /// 变更说明，必填
  changeNote        String    @map("change_note")
  /// 审批单 → approval_request.id，一对一；提议人、批准人、结论都在审批单上
  approvalRequestId String    @unique(map: "uq_finance_config_revision_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 生效时间，批准时写入一次：bank_account = 批准时刻 + 24 小时（代码常量），其余 = 批准时刻。为空表示未批准（待审、驳回、撤回）
  effectiveAt       DateTime? @map("effective_at") @db.Timestamptz(3)
  /// 创建时间，即提议时刻
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)

  /// 审批单（一对一）
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_finance_config_revision_approval_request_id")
  billingOrders   BillingOrder[]

  @@map("finance_config_revision")
}

// ===== 09-order-ad =====
// 分组 09-order-ad：选剧单、订购单、订单项、取消申请（order，L3）与广告（ad，L3）。10 张表。
// 依据：docs/appendix/design/d3-flow.md 第 4、5、9、16 节；catalogue.json；rulings M12、M19、M20、M33、M34、M44；
// 第二轮：M46–M48（关系名、归属复合外键、主键命名）、M54、M59、M60、M62、M69。
// 引用的其他分组模型：Entity、Store、MerchantUser（02）、Staff、ApprovalRequest（03）、Drama（05）、FileObject（06）、
// SubscriptionTerm、PointHold（07）、ChannelAccount（11）、AgreementConsent（13）。

/// 选剧单：按门店保存待订购的剧目与加入时的积分价；状态读取时算，不落库
model CartItem {
  /// 主键，UUID v7，应用生成
  id              String    @id(map: "pk_cart_item") @db.Uuid
  /// 所属主体，创建时从门店复制，不可变
  entityId        String    @map("entity_id") @db.Uuid
  /// 所属门店；选剧单按门店保存
  storeId         String    @map("store_id") @db.Uuid
  /// 剧目
  dramaId         String    @map("drama_id") @db.Uuid
  /// 加入人（商家用户）
  addedByUserId   String    @map("added_by_user_id") @db.Uuid
  /// 加入（或最近一次“确认新价格”）时的剧目积分价 P
  listPricePoints Int       @map("list_price_points")
  /// 最近一次“确认新价格”的时间；从未确认过为空
  priceAckedAt    DateTime? @map("price_acked_at") @db.Timestamptz(3)
  /// 创建时间（加入时间）
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity      Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_cart_item_entity_id")
  /// 所属门店
  store       Store        @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_cart_item_store_entity")
  /// 剧目
  drama       Drama        @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_cart_item_drama_id")
  /// 加入人
  addedByUser MerchantUser @relation(fields: [addedByUserId], references: [id], onDelete: Restrict, map: "fk_cart_item_added_by_user_id")

  @@unique([storeId, dramaId], map: "uq_cart_item_store_id_drama_id")
  @@index([storeId, createdAt(sort: Desc)], map: "ix_cart_item_store_id_created_at")
  @@map("cart_item")
}

/// 订购单：一单多部剧的头；下单时的套餐、折扣、加扣快照，整单定制录入，由订单项聚合物化的状态；状态机 machine = drama_order
model DramaOrder {
  /// 主键，UUID v7，应用生成
  id                  String    @id(map: "pk_drama_order") @db.Uuid
  /// 订购单号：LYX + 8 位日期 + 5 位流水
  orderNo             String    @unique(map: "uq_drama_order_order_no") @map("order_no")
  /// 所属主体，不可变
  entityId            String    @map("entity_id") @db.Uuid
  /// 下单门店，不可变
  storeId             String    @map("store_id") @db.Uuid
  /// 下单人（商家用户，V1.0 只有老板），不可变
  placedByUserId      String    @map("placed_by_user_id") @db.Uuid
  /// 状态：pending_start / producing / to_launch / live / ended / cancelled / after_sale / refunded；由订单项阶段与在途取消推导后物化
  status              String
  /// 展示用子状态，取值随 status，见文档 2.2；可空
  subStatus           String?   @map("sub_status")
  /// 最近一次状态变化的时间
  statusChangedAt     DateTime  @map("status_changed_at") @db.Timestamptz(3)
  /// 订单项数，1 到 50
  itemCount           Int       @map("item_count") @db.SmallInt
  /// 应扣积分合计 ΣS
  totalChargePoints   Int       @map("total_charge_points")
  /// 下单时的订阅周期
  subscriptionTermId  String    @map("subscription_term_id") @db.Uuid
  /// 下单时的套餐版本编码（plan.code 的快照）
  planCode            String    @map("plan_code")
  /// 下单时的折扣（万分比）
  discountBp          Int       @map("discount_bp")
  /// 是否勾选顶级模型（整单一份）
  isTopModel          Boolean   @default(false) @map("is_top_model")
  /// 加扣比例快照（万分比）；旗舰版或未勾选为 0
  surchargeBp         Int       @map("surcharge_bp")
  /// 定制重点，字典 custom_focus 的编码，至少 1 项
  /// 不建外键：字典编码，由不变量校验引用存在
  focusCodes          String[]  @default([]) @map("focus_codes")
  /// 补充说明，不超过 200 字（应用层校验）
  note                String?
  /// 期望上线日；空表示成片交付后尽快上线
  expectedLaunchDate  DateTime? @map("expected_launch_date") @db.Date
  /// 《定制内容授权使用协议》的同意记录
  agreementConsentId  String    @map("agreement_consent_id") @db.Uuid
  /// 冗余：门店的交付经理；转移时同步
  deliveryManagerId   String?   @map("delivery_manager_id") @db.Uuid
  /// 在途的取消申请；无则为空
  openCancelRequestId String?   @map("open_cancel_request_id") @db.Uuid
  /// 提交时间（积分冻结）
  submittedAt         DateTime  @map("submitted_at") @db.Timestamptz(3)
  /// 开工时间（积分扣减）
  startedAt           DateTime? @map("started_at") @db.Timestamptz(3)
  /// 进入 ended / cancelled / refunded 的时间
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion         Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity            Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_drama_order_entity_id")
  /// 下单门店
  store             Store            @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_drama_order_store_entity")
  /// 下单人
  placedByUser      MerchantUser     @relation(fields: [placedByUserId], references: [id], onDelete: Restrict, map: "fk_drama_order_placed_by_user_id")
  /// 下单时的订阅周期
  subscriptionTerm  SubscriptionTerm @relation(fields: [subscriptionTermId], references: [id], onDelete: Restrict, map: "fk_drama_order_subscription_term_id")
  /// 协议同意记录
  agreementConsent  AgreementConsent @relation(fields: [agreementConsentId], references: [id], onDelete: Restrict, map: "fk_drama_order_agreement_consent_id")
  /// 交付经理
  deliveryManager   Staff?           @relation(fields: [deliveryManagerId], references: [id], onDelete: Restrict, map: "fk_drama_order_delivery_manager_id")
  /// 在途的取消申请
  openCancelRequest CancelRequest?   @relation("DramaOrderOpenCancelRequest", fields: [openCancelRequestId], references: [id], onDelete: Restrict, map: "fk_drama_order_open_cancel_request_id")
  /// 反向：以本订购单为对象的取消申请（kind = order_cancel）
  cancelRequests    CancelRequest[]  @relation("CancelRequestDramaOrder")
  orderItems        OrderItem[]
  deliveryTickets   DeliveryTicket[]
  deliveryPlan      DeliveryPlan?

  @@index([storeId, submittedAt(sort: Desc)], map: "ix_drama_order_store_id_submitted_at")
  @@index([entityId, submittedAt(sort: Desc)], map: "ix_drama_order_entity_id_submitted_at")
  @@index([status, submittedAt(sort: Desc)], map: "ix_drama_order_status_submitted_at")
  @@index([deliveryManagerId, status], map: "ix_drama_order_delivery_manager_id_status")
  @@map("drama_order")
}

/// 订单项：订购单里的一部剧；计价快照、冻结单、四个退回数量、阶段（由工单步骤推导）、使用期起止；状态机 machine = order_item
model OrderItem {
  /// 主键，UUID v7，应用生成；账本冻结的业务引用 hold:order_item:{id}
  id                    String    @id(map: "pk_order_item") @db.Uuid
  /// 所属订购单
  dramaOrderId          String    @map("drama_order_id") @db.Uuid
  /// 订购单内序号 1..n，对应工单号后缀
  itemNo                Int       @map("item_no") @db.SmallInt
  /// 所属主体，创建时从订购单复制，不可变
  entityId              String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从订购单复制，不可变
  storeId               String    @map("store_id") @db.Uuid
  /// 剧目
  dramaId               String    @map("drama_id") @db.Uuid
  /// 下单时的剧目快照（DramaSnapshot），结构见文档第 4 节；不可变
  dramaSnapshot         Json      @map("drama_snapshot")
  /// 订购集数（整部剧的总集数）
  episodeCount          Int       @map("episode_count")
  /// 剧目积分价 P
  listPricePoints       Int       @map("list_price_points")
  /// 套餐折扣 R（万分比）
  discountBp            Int       @map("discount_bp")
  /// 顶级模型加扣 T（万分比）
  surchargeBp           Int       @map("surcharge_bp")
  /// 应扣积分 S
  chargePoints          Int       @map("charge_points")
  /// 完整计价快照（账本 hold 返回），结构见文档第 4 节；不可变
  pricingSnapshot       Json      @map("pricing_snapshot")
  /// 制作模型：standard / advanced / top（V1.0 仅计价与标签）
  productionModel       String    @map("production_model")
  /// 账本冻结单
  pointHoldId           String    @unique(map: "uq_order_item_point_hold_id") @map("point_hold_id") @db.Uuid
  /// 冻结转扣减的时间（开工）
  capturedAt            DateTime? @map("captured_at") @db.Timestamptz(3)
  /// 已向账本请求退回或释放的数量累计，等于下面三列之和
  refundRequestedPoints Int       @default(0) @map("refund_requested_points")
  /// 账本实际回到原批次可用的数量累计
  returnedPoints        Int       @default(0) @map("returned_points")
  /// 账本转为加购积分的数量累计
  convertedPoints       Int       @default(0) @map("converted_points")
  /// 账本判定不予退回的数量累计
  forfeitedPoints       Int       @default(0) @map("forfeited_points")
  /// 阶段：pending_start / producing / to_launch / live / ended / cancelled / refunded / terminated
  phase                 String
  /// 最近一次阶段变化的时间
  phaseChangedAt        DateTime  @map("phase_changed_at") @db.Timestamptz(3)
  /// 约定上线日；方案确认时写入，可改期
  agreedLaunchDate      DateTime? @map("agreed_launch_date") @db.Date
  /// 上线首日（核验通过时写入）；空表示从未上线
  usageStartDate        DateTime? @map("usage_start_date") @db.Date
  /// 使用期止日；下单时取剧目授权期结束日，版权续期时顺延
  usageEndDate          DateTime  @map("usage_end_date") @db.Date
  /// 止日来源：license / early_end / expired（后两者不再随版权续期顺延）
  usageEndSource        String    @default("license") @map("usage_end_source")
  /// 已核验上线集数（各账号取最大值）
  liveEpisodeCount      Int       @default(0) @map("live_episode_count")
  /// 取消或终止原因：merchant_request / store_closed / platform_fault / qualification_final
  cancelReasonCode      String?   @map("cancel_reason_code")
  /// 取消或终止的时间（取消申请执行时写入）
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion           Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属订购单
  dramaOrder           DramaOrder            @relation(fields: [dramaOrderId], references: [id], onDelete: Restrict, map: "fk_order_item_drama_order_id")
  /// 所属主体
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_order_item_entity_id")
  /// 所属门店
  store                Store                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_order_item_store_entity")
  /// 剧目
  drama                Drama                 @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_order_item_drama_id")
  /// 账本冻结单
  pointHold            PointHold             @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_order_item_point_hold_id")
  orderItemAccounts    OrderItemAccount[]
  orderItemPlacements  OrderItemPlacement[]
  deliveryTicket       DeliveryTicket?
  deliveryReleases     DeliveryRelease[]
  downloadGrants       DownloadGrant[]
  deliveryDownloadLogs DeliveryDownloadLog[]
  launchTasks          LaunchTask[]
  patrolTasks          PatrolTask[]
  takedownTasks        TakedownTask[]

  @@unique([dramaOrderId, itemNo], map: "uq_order_item_drama_order_id_item_no")
  @@index([storeId, phase], map: "ix_order_item_store_id_phase")
  @@index([dramaId, phase], map: "ix_order_item_drama_id_phase")
  @@map("order_item")
}

/// 订单项的发布账号（每平台至多 1 个）；授权书、上线任务按“订单项 × 账号”展开
model OrderItemAccount {
  /// 订单项
  orderItemId      String   @map("order_item_id") @db.Uuid
  /// 渠道账号（publish 的表）
  channelAccountId String   @map("channel_account_id") @db.Uuid
  /// 平台：douyin / wechat_channels；从账号复制
  platform         String
  /// 创建时间
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  /// 订单项
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_order_item_account_order_item_id")
  /// 渠道账号
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, map: "fk_order_item_account_channel_account_id")

  @@id([orderItemId, channelAccountId], map: "pk_order_item_account")
  @@unique([orderItemId, platform], map: "uq_order_item_account_order_item_id_platform")
  @@index([channelAccountId], map: "ix_order_item_account_channel_account_id")
  @@map("order_item_account")
}

/// 广告位绑定：订单项的片头、片尾位绑定哪条广告；bound_version_no 为空表示浮动，样片确认时钉住版本
model OrderItemPlacement {
  /// 主键，UUID v7，应用生成
  id             String    @id(map: "pk_order_item_placement") @db.Uuid
  /// 订单项
  orderItemId    String    @map("order_item_id") @db.Uuid
  /// 广告位：opening / ending / corner / mid_roll；V1.0 只写前两个
  slot           String
  /// 绑定的广告
  adId           String    @map("ad_id") @db.Uuid
  /// 钉住的广告版本号；空表示浮动，跟随该广告最新的已确认版本
  boundVersionNo Int?      @map("bound_version_no") @db.SmallInt
  /// 广告时长（秒），绑定时从广告复制
  durationSec    Int       @map("duration_sec") @db.SmallInt
  /// 钉住时间（样片确认时写入）；返工解除钉住时清空
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 订单项
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_order_item_placement_order_item_id")
  /// 绑定的广告
  ad           Ad         @relation(fields: [adId], references: [id], onDelete: Restrict, map: "fk_order_item_placement_ad_id")
  /// 钉住的广告版本（ad_id + bound_version_no → ad_version 的 ad_id + version_no）
  boundVersion AdVersion? @relation(fields: [adId, boundVersionNo], references: [adId, versionNo], onDelete: Restrict, map: "fk_order_item_placement_bound_version")

  @@unique([orderItemId, slot], map: "uq_order_item_placement_order_item_id_slot")
  @@index([adId], map: "ix_order_item_placement_ad_id")
  @@map("order_item_placement")
}

/// 取消申请：订购取消、广告取消、资质终局驳回后的整店取消；申请级的原因、说明、合计与执行状态；与审批单一对一；状态机 machine = cancel_request
model CancelRequest {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_cancel_request") @db.Uuid
  /// 对应的审批单，一对一；单号 TK… 与审批结论在审批单上
  approvalRequestId  String    @unique(map: "uq_cancel_request_approval_request_id") @map("approval_request_id") @db.Uuid
  /// 类型：order_cancel / ad_cancel / qualification_cancel，与审批单的 kind 相同
  kind               String
  /// 所属主体
  entityId           String    @map("entity_id") @db.Uuid
  /// 所属门店；qualification_cancel 的对象就是它
  storeId            String    @map("store_id") @db.Uuid
  /// 被取消的订购单；仅 order_cancel 填写
  dramaOrderId       String?   @map("drama_order_id") @db.Uuid
  /// 被取消的广告；仅 ad_cancel 填写
  adId               String?   @map("ad_id") @db.Uuid
  /// 取消原因：merchant_request / store_closed / platform_fault / qualification_final
  reasonCode         String    @map("reason_code")
  /// 申请说明，5 到 200 字（应用层校验）
  note               String
  /// 明细行数
  lineCount          Int       @map("line_count") @db.SmallInt
  /// 基数合计：Σ（应扣 − 提交时已请求退回）
  totalBasePoints    Int       @map("total_base_points")
  /// 扣除合计
  totalDeductPoints  Int       @map("total_deduct_points")
  /// 请求退回或释放合计
  totalRefundPoints  Int       @map("total_refund_points")
  /// 执行状态：pending_approval / pending_execution / done / not_executed（M54；积分退回没有 executing）
  status             String
  /// 执行时限；审批通过时写入
  execDueAt          DateTime? @map("exec_due_at") @db.Timestamptz(3)
  /// 执行时限的参数快照（SlaSnapshot），结构见文档第 4 节；与 exec_due_at 同有同无
  slaSnapshot        Json?     @map("sla_snapshot")
  /// 执行人（员工）；系统自动执行时为空
  executedByStaffId  String?   @map("executed_by_staff_id") @db.Uuid
  /// 是否由系统自动执行（免审批开关命中时）
  isExecutedBySystem Boolean   @default(false) @map("is_executed_by_system")
  /// 执行时间
  executedAt         DateTime? @map("executed_at") @db.Timestamptz(3)
  /// 执行时勾选的核对项
  execConfirmChecks  String[]  @default([]) @map("exec_confirm_checks")
  /// 审批时与执行时的重新校验结果，各存最近一份，结构见文档第 4 节
  recheckLog         Json?     @map("recheck_log")
  /// 关闭时间：执行完成，或审批被驳回、撤回、通过后作废时写入；在途唯一索引以它为条件
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)
  /// 未执行即关闭的原因：rejected / withdrawn / voided
  closeReason        String?   @map("close_reason")
  /// 通过后作废的说明
  closeNote          String?   @map("close_note")
  /// 乐观锁版本号
  lockVersion        Int       @default(0) @map("lock_version")
  /// 创建时间（即提交时间）
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 对应的审批单
  approvalRequest    ApprovalRequest     @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "fk_cancel_request_approval_request_id")
  /// 所属主体
  entity             Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_cancel_request_entity_id")
  /// 所属门店
  store              Store               @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_cancel_request_store_entity")
  /// 被取消的订购单
  dramaOrder         DramaOrder?         @relation("CancelRequestDramaOrder", fields: [dramaOrderId], references: [id], onDelete: Restrict, map: "fk_cancel_request_drama_order_id")
  /// 被取消的广告
  ad                 Ad?                 @relation("CancelRequestAd", fields: [adId], references: [id], onDelete: Restrict, map: "fk_cancel_request_ad_id")
  /// 执行人
  executedByStaff    Staff?              @relation(fields: [executedByStaffId], references: [id], onDelete: Restrict, map: "fk_cancel_request_executed_by_staff_id")
  /// 反向：open_cancel_request_id 指向本申请的订购单
  openOnDramaOrders  DramaOrder[]        @relation("DramaOrderOpenCancelRequest")
  /// 反向：open_cancel_request_id 指向本申请的广告
  openOnAds          Ad[]                @relation("AdOpenCancelRequest")
  cancelRequestLines CancelRequestLine[]

  @@index([storeId, createdAt(sort: Desc)], map: "ix_cancel_request_store_id_created_at")
  @@index([entityId, createdAt(sort: Desc)], map: "ix_cancel_request_entity_id_created_at")
  @@index([status, execDueAt], map: "ix_cancel_request_status_exec_due_at")
  @@index([dramaOrderId], map: "ix_cancel_request_drama_order_id")
  @@index([adId], map: "ix_cancel_request_ad_id")
  @@map("cancel_request")
}

/// 取消申请的逐项核算与实际结果：一行 = 一个订单项或一条广告；id 即账本退回幂等键 refund:{id} 的来源
model CancelRequestLine {
  /// 主键，UUID v7，应用生成；账本退回的幂等键 refund:{id} 取自这里
  id                   String    @id(map: "pk_cancel_request_line") @db.Uuid
  /// 所属取消申请
  cancelRequestId      String    @map("cancel_request_id") @db.Uuid
  /// 所属主体，创建时从申请复制
  entityId             String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从申请复制
  storeId              String    @map("store_id") @db.Uuid
  /// 对象类型：order_item / ad
  targetType           String    @map("target_type")
  /// 对象 id
  /// 不建外键：按 target_type 多态（order_item | ad）
  targetId             String    @map("target_id") @db.Uuid
  /// 对象的账本冻结单
  pointHoldId          String    @map("point_hold_id") @db.Uuid
  /// 账本动作：release / refund / terminate_only
  mode                 String
  /// 核算阶段：pending_start / plan_confirm / ad_and_sample / sample_pending / post_sample / live / ad_unassigned / ad_in_production
  stage                String
  /// 提交时的工单步骤或广告状态；待开工订单项为空
  stepAtSubmit         String?   @map("step_at_submit")
  /// 账本原因类别：merchant / platform / qualification
  reasonClass          String    @map("reason_class")
  /// 应扣积分 S
  chargePoints         Int       @map("charge_points")
  /// 提交时已请求退回的累计
  priorRequestedPoints Int       @map("prior_requested_points")
  /// 适用的扣除比例（计价快照里的值，万分比）；释放、已上线折算、人工录入扣除时为空
  ratioBp              Int?      @map("ratio_bp")
  /// 扣除数量
  deductPoints         Int       @map("deduct_points")
  /// 人工录入扣除数时的依据说明
  deductNote           String?   @map("deduct_note")
  /// 本次请求退回或释放的数量
  refundPoints         Int       @map("refund_points")
  /// 仅已上线：固定的终止日
  terminationDate      DateTime? @map("termination_date") @db.Date
  /// 仅已上线：提交时的上线首日快照
  usageStartDate       DateTime? @map("usage_start_date") @db.Date
  /// 仅已上线：提交时的使用期止日快照
  usageEndDate         DateTime? @map("usage_end_date") @db.Date
  /// 仅已上线：提交时的止日来源快照 license / early_end / expired
  usageEndSource       String?   @map("usage_end_source")
  /// 提交时 previewReturn 的结果（ReturnBreakdown），结构见文档第 4 节
  previewSnapshot      Json      @map("preview_snapshot")
  /// 执行时账本返回的 ReturnResult，结构同上；未执行为空
  resultSnapshot       Json?     @map("result_snapshot")
  /// 执行后：账本实际回到原批次的数量
  returnedPoints       Int?      @map("returned_points")
  /// 执行后：账本转为加购积分的数量
  convertedPoints      Int?      @map("converted_points")
  /// 执行后：账本判定不予退回的数量
  forfeitedPoints      Int?      @map("forfeited_points")
  /// 执行时间
  executedAt           DateTime? @map("executed_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)

  /// 所属取消申请
  cancelRequest CancelRequest @relation(fields: [cancelRequestId], references: [id], onDelete: Restrict, map: "fk_cancel_request_line_cancel_request_id")
  /// 所属主体
  entity        Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_cancel_request_line_entity_id")
  /// 所属门店
  store         Store         @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_cancel_request_line_store_entity")
  /// 对象的账本冻结单
  pointHold     PointHold     @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_cancel_request_line_point_hold_id")

  @@unique([cancelRequestId, targetType, targetId], map: "uq_cancel_request_line_cancel_request_id_target")
  @@index([targetType, targetId], map: "ix_cancel_request_line_target_type_target_id")
  @@index([pointHoldId], map: "ix_cancel_request_line_point_hold_id")
  @@map("cancel_request_line")
}

/// 广告：一条广告 = 一次制作需求 + 它的所有版本，独立 GG 编号；计价快照、冻结单、退回四列、免费修改额度与状态；状态机 machine = ad
model Ad {
  /// 主键，UUID v7，应用生成；账本冻结的业务引用 hold:ad:{id}
  id                    String    @id(map: "pk_ad") @db.Uuid
  /// 广告编号：GG + 8 位日期 + 3 位流水（当日超过 999 扩到 4 位）
  adNo                  String    @unique(map: "uq_ad_ad_no") @map("ad_no")
  /// 所属主体，不可变
  entityId              String    @map("entity_id") @db.Uuid
  /// 所属门店，不可变
  storeId               String    @map("store_id") @db.Uuid
  /// 提交人（商家用户，老板），不可变
  requestedByUserId     String    @map("requested_by_user_id") @db.Uuid
  /// 广告类型（即植入形式）：opening / ending / corner / mid_roll；V1.0 只接受前两个
  type                  String
  /// 时长（秒）：片头 3 或 5，片尾 5 或 10
  durationSec           Int       @map("duration_sec") @db.SmallInt
  /// 宣传重点，字典 ad_promo_point 的编码，至少 1 项
  /// 不建外键：字典编码，由不变量校验引用存在
  promoPointCodes       String[]  @default([]) @map("promo_point_codes")
  /// 广告文案，不超过 50 字（应用层校验）；不填由剪辑师依据档案撰写
  copy                  String?
  /// 备注，不超过 200 字（应用层校验）
  remark                String?
  /// 状态：pending_assign / producing / returned / pending_confirm / revising / confirmed / cancelled
  status                String
  /// 被退回前的状态：pending_assign / producing；补充后回到这里
  returnedFrom          String?   @map("returned_from")
  /// 最近一次被退回补充的时间
  returnedAt            DateTime? @map("returned_at") @db.Timestamptz(3)
  /// 最近一次退回补充的原因
  returnReason          String?   @map("return_reason")
  /// 补充后重新提交的次数；首版时限定时器去重键 sla.breach:ad:{id}:first:{resubmit_count} 的序号
  resubmitCount         Int       @default(0) @map("resubmit_count") @db.SmallInt
  /// 剪辑师；指派时写入
  editorId              String?   @map("editor_id") @db.Uuid
  /// 提交时的每条积分（快照）
  unitPricePoints       Int       @map("unit_price_points")
  /// 提交时的折扣（万分比，快照）
  discountBp            Int       @map("discount_bp")
  /// 应扣积分
  chargePoints          Int       @map("charge_points")
  /// 计价快照（账本 hold 返回），结构见文档第 4 节；不可变
  pricingSnapshot       Json      @map("pricing_snapshot")
  /// 账本冻结单
  pointHoldId           String    @unique(map: "uq_ad_point_hold_id") @map("point_hold_id") @db.Uuid
  /// 冻结转扣减的时间（指派剪辑师）
  capturedAt            DateTime? @map("captured_at") @db.Timestamptz(3)
  /// 已向账本请求退回或释放的数量累计，等于下面三列之和
  refundRequestedPoints Int       @default(0) @map("refund_requested_points")
  /// 账本实际回到原批次可用的数量累计
  returnedPoints        Int       @default(0) @map("returned_points")
  /// 账本转为加购积分的数量累计
  convertedPoints       Int       @default(0) @map("converted_points")
  /// 账本判定不予退回的数量累计
  forfeitedPoints       Int       @default(0) @map("forfeited_points")
  /// 提交时的免费修改次数（快照）
  freeRevisionQuota     Int       @map("free_revision_quota") @db.SmallInt
  /// 商家提出修改的累计次数
  revisionCount         Int       @default(0) @map("revision_count") @db.SmallInt
  /// 最新版本号；尚无版本为 0
  latestVersionNo       Int       @default(0) @map("latest_version_no") @db.SmallInt
  /// 最近一次被确认的版本号；非空即可在订购中选用
  confirmedVersionNo    Int?      @map("confirmed_version_no") @db.SmallInt
  /// 《广告制作与交付服务协议》的同意记录
  agreementConsentId    String    @map("agreement_consent_id") @db.Uuid
  /// 在途的取消申请（ad_cancel 或整店取消）；无则为空。非空时广告的其他迁移一律拒绝（M69）
  openCancelRequestId   String?   @map("open_cancel_request_id") @db.Uuid
  /// 提交时间（积分冻结）
  submittedAt           DateTime  @map("submitted_at") @db.Timestamptz(3)
  /// 首版应交付时间：提交时算出，补充后重新提交时重算；之后不再变（首版按时率用）
  firstDueAt            DateTime  @map("first_due_at") @db.Timestamptz(3)
  /// 首版超时标记的时间：首版时限到期仍在待指派或制作中时写入；资质在审而等待指派的不写
  firstBreachedAt       DateTime? @map("first_breached_at") @db.Timestamptz(3)
  /// 当前应交付时间（首版或修改版）；待补充期间为空
  dueAt                 DateTime? @map("due_at") @db.Timestamptz(3)
  /// 当前时限的参数快照，结构见文档第 4 节；与 due_at 同有同无
  slaSnapshot           Json?     @map("sla_snapshot")
  /// 最近一次确认的时间
  confirmedAt           DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// 取消原因：merchant_request / store_closed / platform_fault / qualification_final
  cancelReasonCode      String?   @map("cancel_reason_code")
  /// 取消时间
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// 乐观锁版本号
  lockVersion           Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity              Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_ad_entity_id")
  /// 所属门店
  store               Store                @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_ad_store_entity")
  /// 提交人
  requestedByUser     MerchantUser         @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict, map: "fk_ad_requested_by_user_id")
  /// 剪辑师
  editor              Staff?               @relation(fields: [editorId], references: [id], onDelete: Restrict, map: "fk_ad_editor_id")
  /// 账本冻结单
  pointHold           PointHold            @relation(fields: [pointHoldId], references: [id], onDelete: Restrict, map: "fk_ad_point_hold_id")
  /// 协议同意记录
  agreementConsent    AgreementConsent     @relation(fields: [agreementConsentId], references: [id], onDelete: Restrict, map: "fk_ad_agreement_consent_id")
  /// 在途的取消申请
  openCancelRequest   CancelRequest?       @relation("AdOpenCancelRequest", fields: [openCancelRequestId], references: [id], onDelete: Restrict, map: "fk_ad_open_cancel_request_id")
  /// 反向：以本广告为对象的取消申请（kind = ad_cancel）
  cancelRequests      CancelRequest[]      @relation("CancelRequestAd")
  orderItemPlacements OrderItemPlacement[]
  adVersions          AdVersion[]
  adRevisions         AdRevision[]

  @@index([storeId, status], map: "ix_ad_store_id_status")
  @@index([editorId, status], map: "ix_ad_editor_id_status")
  @@index([status, dueAt], map: "ix_ad_status_due_at")
  @@index([entityId], map: "ix_ad_entity_id")
  @@map("ad")
}

/// 广告视频版本：上传、推送、不可播放时的线下提供时间、商家决定
model AdVersion {
  /// 主键，UUID v7，应用生成
  id                   String    @id(map: "pk_ad_version") @db.Uuid
  /// 所属广告
  adId                 String    @map("ad_id") @db.Uuid
  /// 所属主体，创建时从广告复制，不可变
  entityId             String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从广告复制，不可变
  storeId              String    @map("store_id") @db.Uuid
  /// 版本号，从 1 起
  versionNo            Int       @map("version_no") @db.SmallInt
  /// 视频文件，经 file_ref 登记（ref_type = ad_version）
  fileId               String    @map("file_id") @db.Uuid
  /// 时长（毫秒）
  durationMs           Int       @map("duration_ms")
  /// 宽（像素），规格 1080
  width                Int
  /// 高（像素），规格 1920
  height               Int
  /// 分段元数据 [{ index, fromMs, toMs, label }]，供修改意见选时间段；上传时填写，之后不可改；可空
  segments             Json?
  /// 上传人（剪辑师）
  uploadedByStaffId    String    @map("uploaded_by_staff_id") @db.Uuid
  /// 上传时间
  uploadedAt           DateTime  @map("uploaded_at") @db.Timestamptz(3)
  /// 推送给商家确认的时间
  pushedAt             DateTime? @map("pushed_at") @db.Timestamptz(3)
  /// 推送时确定的查看方式：weapp / album / portal / wecom 的子集；推送后至少 1 项
  previewChannels      String[]  @default([]) @map("preview_channels")
  /// 小程序内不可播放时，经企业微信提供查看的时间
  offlineSentAt        DateTime? @map("offline_sent_at") @db.Timestamptz(3)
  /// 经企业微信提供查看的员工；与 offline_sent_at 同有同无
  offlineSentByStaffId String?   @map("offline_sent_by_staff_id") @db.Uuid
  /// 商家决定：confirmed / revision_requested / superseded；未决为空；只写一次
  decision             String?
  /// 决定时间；只写一次
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz(3)
  /// 商家确认时声明的查看方式：weapp / album / portal / wecom，须在 preview_channels 内；确认时必填，只写一次
  confirmViewedVia     String?   @map("confirm_viewed_via")
  /// 商家勾选“我已查看第 N 版”的时间；确认且不是小程序内播放时必填，只写一次
  viewedAckAt          DateTime? @map("viewed_ack_at") @db.Timestamptz(3)
  /// 创建时间
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属广告
  ad                  Ad                   @relation(fields: [adId], references: [id], onDelete: Restrict, map: "fk_ad_version_ad_id")
  /// 所属主体
  entity              Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_ad_version_entity_id")
  /// 所属门店
  store               Store                @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_ad_version_store_entity")
  /// 视频文件
  file                FileObject           @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_ad_version_file_id")
  /// 上传人
  uploadedByStaff     Staff                @relation("AdVersionUploadedByStaff", fields: [uploadedByStaffId], references: [id], onDelete: Restrict, map: "fk_ad_version_uploaded_by_staff_id")
  /// 经企业微信提供查看的员工
  offlineSentByStaff  Staff?               @relation("AdVersionOfflineSentByStaff", fields: [offlineSentByStaffId], references: [id], onDelete: Restrict, map: "fk_ad_version_offline_sent_by_staff_id")
  /// 反向：针对本版本提出的修改轮次
  revisionsRaised     AdRevision[]         @relation("AdRevisionOnVersion")
  /// 反向：由本版本满足的修改轮次
  revisionsFulfilled  AdRevision[]         @relation("AdRevisionFulfilledByVersion")
  orderItemPlacements OrderItemPlacement[]

  @@unique([adId, versionNo], map: "uq_ad_version_ad_id_version_no")
  @@map("ad_version")
}

/// 广告修改轮次：一次修改意见一行；是否计费、超次扣减的冻结单、时间段与截图、由哪个版本满足
model AdRevision {
  /// 主键，UUID v7，应用生成；超次扣减的业务引用 hold:ad_revision:{id}
  id                   String    @id(map: "pk_ad_revision") @db.Uuid
  /// 所属广告
  adId                 String    @map("ad_id") @db.Uuid
  /// 所属主体，创建时从广告复制，不可变
  entityId             String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从广告复制，不可变
  storeId              String    @map("store_id") @db.Uuid
  /// 第几次修改，从 1 起
  revisionNo           Int       @map("revision_no") @db.SmallInt
  /// 针对的版本号
  onVersionNo          Int       @map("on_version_no") @db.SmallInt
  /// 来源：ad_page / sample_feedback / staff_on_behalf
  source               String
  /// 是否计费（超出免费次数）
  isChargeable         Boolean   @default(false) @map("is_chargeable")
  /// 超次扣减的积分；不计费为 0
  chargePoints         Int       @default(0) @map("charge_points")
  /// 超次扣减的账本冻结单；不计费为空
  chargePointHoldId    String?   @unique(map: "uq_ad_revision_charge_point_hold_id") @map("charge_point_hold_id") @db.Uuid
  /// 修改意见针对的时间段起点（毫秒）；整条广告为空
  timeStartMs          Int?      @map("time_start_ms")
  /// 修改意见针对的时间段终点（毫秒）；整条广告为空
  timeEndMs            Int?      @map("time_end_ms")
  /// 选用的预置分段：on_version_no 那个版本 segments 里的 index；自由输入时间段或整条广告为空
  segmentIndex         Int?      @map("segment_index") @db.SmallInt
  /// 修改意见，不超过 200 字（应用层校验）
  note                 String
  /// 截图文件，有序小集合，经 file_ref 登记（ref_type = ad_revision）
  /// 不建外键：数组列
  screenshotFileIds    String[]  @default([]) @map("screenshot_file_ids") @db.Uuid
  /// 提出人类型：merchant / staff / system / partner
  actorType            String    @map("actor_type")
  /// 提出人 id
  /// 不建外键：操作人多态
  actorId              String?   @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin
  client               String?
  /// 修改版应交付时间
  dueAt                DateTime  @map("due_at") @db.Timestamptz(3)
  /// 修改版超时标记的时间：时限到期仍未被满足时写入
  breachedAt           DateTime? @map("breached_at") @db.Timestamptz(3)
  /// 由哪个版本满足；未满足为空
  fulfilledByVersionNo Int?      @map("fulfilled_by_version_no") @db.SmallInt
  /// 创建时间（提出时间）
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  /// 更新时间
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属广告
  ad                 Ad         @relation(fields: [adId], references: [id], onDelete: Restrict, map: "fk_ad_revision_ad_id")
  /// 所属主体
  entity             Entity     @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_ad_revision_entity_id")
  /// 所属门店
  store              Store      @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_ad_revision_store_entity")
  /// 超次扣减的账本冻结单
  chargePointHold    PointHold? @relation(fields: [chargePointHoldId], references: [id], onDelete: Restrict, map: "fk_ad_revision_charge_point_hold_id")
  /// 针对的版本（ad_id + on_version_no → ad_version）
  onVersion          AdVersion  @relation("AdRevisionOnVersion", fields: [adId, onVersionNo], references: [adId, versionNo], onDelete: Restrict, map: "fk_ad_revision_on_version")
  /// 满足本轮的版本（ad_id + fulfilled_by_version_no → ad_version）
  fulfilledByVersion AdVersion? @relation("AdRevisionFulfilledByVersion", fields: [adId, fulfilledByVersionNo], references: [adId, versionNo], onDelete: Restrict, map: "fk_ad_revision_fulfilled_by_version")

  @@unique([adId, revisionNo], map: "uq_ad_revision_ad_id_revision_no")
  @@map("ad_revision")
}

// ===== 10-delivery =====
// 分组 10-delivery：交付工单、方案、样片、成片、质检、成片包（delivery，L3）。15 张表。
// 依据：docs/appendix/design/d3-flow.md 第 7、8、10、11 节；d5-media.md 第 4.7、8 节；rulings M8、M17、M19、M27、M33、M34、M38、M44、M46、M47、M48、M56、M61、M70、M101、M110；catalogue.json。
// 引用的其他分组模型：Entity、Store、MerchantUser（02）、Staff（03）、Drama（05）、FileObject（06）、DramaOrder、OrderItem（09）。
// 门店外键一律是归属复合外键 (store_id, entity_id) → store (id, entity_id)，另保留主体的单列外键（M47）。
// 同一个模型有多条关系指向同一个外部模型（DeliveryTicket → Staff、Sample → Staff / MerchantUser）时每条都写关系名，反向字段由校验工具补（M46）。

/// 交付工单：开工后一部剧一张；11 步 + 已归档 + 已终止；状态机 machine = delivery_ticket，state_field = step
model DeliveryTicket {
  /// 主键，UUID v7，应用生成
  id                     String    @id(map: "pk_delivery_ticket") @db.Uuid
  /// 工单号：JF + 订购单号数字部分 + “-” + 订单项序号，如 JF2026092600018-1
  ticketNo               String    @unique(map: "uq_delivery_ticket_ticket_no") @map("ticket_no")
  /// 所属主体，创建时从订单项复制，不可变
  entityId               String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从订单项复制，不可变
  storeId                String    @map("store_id") @db.Uuid
  /// 所属订购单
  dramaOrderId           String    @map("drama_order_id") @db.Uuid
  /// 所属订单项；一个订单项至多一张工单
  orderItemId            String    @unique(map: "uq_delivery_ticket_order_item_id") @map("order_item_id") @db.Uuid
  /// 剧目
  dramaId                String    @map("drama_id") @db.Uuid
  /// 步骤：assigning / plan_confirm / ad_prep / sample_making / sample_confirm / batch_compose / delivering / awaiting_launch / launch_verify / in_service / takedown / archived / terminated；只经 flow.transition() 迁移
  step                   String
  /// 进入当前步骤的时间
  stepEnteredAt          DateTime  @map("step_entered_at") @db.Timestamptz(3)
  /// 当前环节的员工侧截止时间；等待商家的环节可为空
  stepDueAt              DateTime? @map("step_due_at") @db.Timestamptz(3)
  /// 当前等待方：staff / merchant / none
  waitingOn              String    @map("waiting_on")
  /// 未解除的暂停原因数，等于 delivery_ticket_pause 中 released_at 为空的行数
  pauseCount             Int       @default(0) @map("pause_count") @db.SmallInt
  /// 第一个暂停原因加入的时间；未暂停时为空
  pausedAt               DateTime? @map("paused_at") @db.Timestamptz(3)
  /// 进入暂停时当前环节剩余的工作分钟数；环节没有员工时限时为空
  pauseRemainingMin      Int?      @map("pause_remaining_min")
  /// 交付经理；待分配时为空
  deliveryManagerId      String?   @map("delivery_manager_id") @db.Uuid
  /// 剪辑师；未指派时为空
  editorId               String?   @map("editor_id") @db.Uuid
  /// 发布专员；未指派时为空
  publisherId            String?   @map("publisher_id") @db.Uuid
  /// 制作排期：standard 标准 / priority 优先 / rush 加急（取值同 plan_revision.schedule_priority）；开工时从订阅周期的权益快照复制，只影响工单池排序
  schedulePriority       String    @default("standard") @map("schedule_priority")
  /// 样片返修轮次，从 0 起；商家提出合成问题的修改意见时加 1
  sampleRoundNo          Int       @default(0) @map("sample_round_no") @db.SmallInt
  /// 最近一次推送给商家的样片版本号；未推送过为空
  currentSampleVersionNo Int?      @map("current_sample_version_no") @db.SmallInt
  /// 成片交付目标时间，开工时按参数 sla.delivery.target 计算并固化
  deliveryTargetAt       DateTime  @map("delivery_target_at") @db.Timestamptz(3)
  /// 里程碑：分配交付经理的时间
  assignedAt             DateTime? @map("assigned_at") @db.Timestamptz(3)
  /// 里程碑：方案确认时间
  planConfirmedAt        DateTime? @map("plan_confirmed_at") @db.Timestamptz(3)
  /// 里程碑：广告全部就绪时间
  adsReadyAt             DateTime? @map("ads_ready_at") @db.Timestamptz(3)
  /// 里程碑：样片首次推送时间
  sampleFirstPushedAt    DateTime? @map("sample_first_pushed_at") @db.Timestamptz(3)
  /// 里程碑：样片确认时间
  sampleConfirmedAt      DateTime? @map("sample_confirmed_at") @db.Timestamptz(3)
  /// 里程碑：全部剧集质检通过、进入成片交付的时间
  composedAt             DateTime? @map("composed_at") @db.Timestamptz(3)
  /// 里程碑：成片包首次推送时间
  deliveredAt            DateTime? @map("delivered_at") @db.Timestamptz(3)
  /// 里程碑：商家首次回填上线链接的时间
  linksSubmittedAt       DateTime? @map("links_submitted_at") @db.Timestamptz(3)
  /// 里程碑：首个账号核验通过的时间；撤销核验通过时清空
  liveAt                 DateTime? @map("live_at") @db.Timestamptz(3)
  /// 里程碑：使用期结束、进入到期下架的时间
  usageEndedAt           DateTime? @map("usage_ended_at") @db.Timestamptz(3)
  /// 里程碑：归档时间；非空当且仅当 step = archived
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz(3)
  /// 里程碑：终止时间；非空当且仅当 step = terminated
  terminatedAt           DateTime? @map("terminated_at") @db.Timestamptz(3)
  /// 乐观锁版本号；每次迁移加 1
  lockVersion            Int       @default(0) @map("lock_version")
  /// 创建时间（开工时间）
  createdAt              DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity               Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_entity_id")
  /// 所属门店（归属复合外键，保证门店属于该主体）
  store                Store                 @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_ticket_store_entity")
  /// 所属订购单
  dramaOrder           DramaOrder            @relation(fields: [dramaOrderId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_drama_order_id")
  /// 所属订单项（一对一）
  orderItem            OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_order_item_id")
  /// 剧目
  drama                Drama                 @relation(fields: [dramaId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_drama_id")
  /// 交付经理
  deliveryManager      Staff?                @relation("DeliveryTicketDeliveryManager", fields: [deliveryManagerId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_delivery_manager_id")
  /// 剪辑师
  editor               Staff?                @relation("DeliveryTicketEditor", fields: [editorId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_editor_id")
  /// 发布专员
  publisher            Staff?                @relation("DeliveryTicketPublisher", fields: [publisherId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_publisher_id")
  deliveryTicketStages DeliveryTicketStage[]
  deliveryTicketPauses DeliveryTicketPause[]
  samples              Sample[]
  episodeOutputs       EpisodeOutput[]
  qcRecords            QcRecord[]
  deliveryReleases     DeliveryRelease[]
  deliveryReissues     DeliveryReissue[]
  publishList          PublishList?
  publishListEpisodes  PublishListEpisode[]
  launchTasks          LaunchTask[]
  patrolTasks          PatrolTask[]
  takedownTasks        TakedownTask[]

  @@index([deliveryManagerId, step], map: "ix_delivery_ticket_delivery_manager_id_step")
  @@index([editorId, step], map: "ix_delivery_ticket_editor_id_step")
  @@index([publisherId, step], map: "ix_delivery_ticket_publisher_id_step")
  @@index([storeId], map: "ix_delivery_ticket_store_id")
  @@index([entityId], map: "ix_delivery_ticket_entity_id")
  @@index([dramaOrderId], map: "ix_delivery_ticket_drama_order_id")
  @@index([dramaId], map: "ix_delivery_ticket_drama_id")
  @@map("delivery_ticket")
}

/// 环节记录：工单每进入一次环节一行，记录截止、完成、暂停分钟、是否超时与时限参数快照
model DeliveryTicketStage {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_delivery_ticket_stage") @db.Uuid
  /// 所属工单
  deliveryTicketId String    @map("delivery_ticket_id") @db.Uuid
  /// 环节：工单的 11 个步骤之一（不含 archived、terminated）
  step             String
  /// 同一环节第几次进入，从 1 起
  visitNo          Int       @map("visit_no") @db.SmallInt
  /// 进入时间
  enteredAt        DateTime  @map("entered_at") @db.Timestamptz(3)
  /// 员工侧截止时间；等待商家或没有时限的环节为空
  dueAt            DateTime? @map("due_at") @db.Timestamptz(3)
  /// 离开环节的时间；仍在环节内为空
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  /// 离开环节的状态机事件名
  exitEvent        String?   @map("exit_event")
  /// 暂停累计的工作分钟
  pausedMinutes    Int       @default(0) @map("paused_minutes")
  /// 是否超时；到期时或离开时判定
  isBreached       Boolean   @default(false) @map("is_breached")
  /// 时限参数快照（SlaSnapshot）：{ policy, amount, unit, calendarVersion, computedAt }；日历修正后重算只写 audit_log
  slaSnapshot      Json?     @map("sla_snapshot")
  /// 创建时间
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属工单
  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_stage_delivery_ticket_id")

  @@unique([deliveryTicketId, step, visitNo], map: "uq_delivery_ticket_stage_delivery_ticket_id_step_visit_no")
  @@index([step, enteredAt], map: "ix_delivery_ticket_stage_step_entered_at")
  @@map("delivery_ticket_stage")
}

/// 工单暂停原因：一个原因一行，可叠加；解除时写 released_at
model DeliveryTicketPause {
  /// 主键，UUID v7，应用生成
  id               String    @id(map: "pk_delivery_ticket_pause") @db.Uuid
  /// 所属工单
  deliveryTicketId String    @map("delivery_ticket_id") @db.Uuid
  /// 暂停原因：cancel_review 取消审批中 / plan_amendment 方案修订待确认
  reason           String
  /// 引用对象类型：approval_request / delivery_plan_version
  refType          String    @map("ref_type")
  /// 引用对象 id
  /// 不建外键：按 ref_type 多态；approval_request 在 L1
  refId            String    @map("ref_id") @db.Uuid
  /// 加入暂停原因的操作人类型：merchant / staff / system / partner
  actorType        String    @map("actor_type")
  /// 操作人 id；system 时为空
  /// 不建外键：按 actor_type 多态
  actorId          String?   @map("actor_id") @db.Uuid
  /// 客户端来源：weapp / portal / admin；系统动作为空
  client           String?
  /// 解除时间；未解除为空
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(3)
  /// 解除事件：rejected / withdrawn / plan_confirmed / superseded / terminated / self_heal
  releaseEvent     String?   @map("release_event")
  /// 创建时间（加入暂停原因的时间）
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属工单
  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict, map: "fk_delivery_ticket_pause_delivery_ticket_id")

  @@unique([deliveryTicketId, reason, refId], map: "uq_delivery_ticket_pause_delivery_ticket_id_reason_ref_id")
  @@index([refType, refId], map: "ix_delivery_ticket_pause_ref_type_ref_id")
  @@map("delivery_ticket_pause")
}

/// 交付方案：一张订购单一份，保存草稿、当前与已确认版本号、方案状态；状态机 machine = delivery_plan，state_field = status
model DeliveryPlan {
  /// 主键，UUID v7，应用生成
  id                 String    @id(map: "pk_delivery_plan") @db.Uuid
  /// 所属主体，创建时从订购单复制，不可变
  entityId           String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从订购单复制，不可变
  storeId            String    @map("store_id") @db.Uuid
  /// 所属订购单；一张订购单一份方案
  dramaOrderId       String    @unique(map: "uq_delivery_plan_drama_order_id") @map("drama_order_id") @db.Uuid
  /// 方案状态：drafting / pending_confirm / revising / confirmed；只经 flow.transition() 迁移
  status             String
  /// 交付经理正在编辑的内容（PlanContent）
  draft              Json
  /// 草稿的乐观锁版本号
  draftLockVersion   Int       @default(0) @map("draft_lock_version")
  /// 最近一次推送的版本号；0 表示尚未推送
  currentVersionNo   Int       @default(0) @map("current_version_no")
  /// 商家确认过的最新版本号；未确认过为空
  confirmedVersionNo Int?      @map("confirmed_version_no")
  /// 最近一次推送时间
  pushedAt           DateTime? @map("pushed_at") @db.Timestamptz(3)
  /// 最近一次商家确认时间
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// 交付经理应推送或应答复修改的时间
  staffDueAt         DateTime? @map("staff_due_at") @db.Timestamptz(3)
  /// 乐观锁版本号；每次迁移加 1
  lockVersion        Int       @default(0) @map("lock_version")
  /// 创建时间
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  /// 最近更新时间
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  /// 所属主体
  entity                     Entity                      @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_entity_id")
  /// 所属门店（归属复合外键）
  store                      Store                       @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_plan_store_entity")
  /// 所属订购单（一对一）
  dramaOrder                 DramaOrder                  @relation(fields: [dramaOrderId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_drama_order_id")
  deliveryPlanVersions       DeliveryPlanVersion[]
  deliveryPlanChangeRequests DeliveryPlanChangeRequest[]

  @@index([storeId], map: "ix_delivery_plan_store_id")
  @@index([entityId], map: "ix_delivery_plan_entity_id")
  @@index([status, staffDueAt], map: "ix_delivery_plan_status_staff_due_at")
  @@map("delivery_plan")
}

/// 方案版本：推送即生成，内容快照不可变；记录商家对该版本的决定（只可写一次）
model DeliveryPlanVersion {
  /// 主键，UUID v7，应用生成
  id              String    @id(map: "pk_delivery_plan_version") @db.Uuid
  /// 所属主体，创建时从方案复制，不可变
  entityId        String    @map("entity_id") @db.Uuid
  /// 所属门店，创建时从方案复制，不可变
  storeId         String    @map("store_id") @db.Uuid
  /// 所属方案
  deliveryPlanId  String    @map("delivery_plan_id") @db.Uuid
  /// 版本号，同一方案内从 1 递增
  versionNo       Int       @map("version_no")
  /// 推送时的方案内容快照（PlanContent），不可变
  contentSnapshot Json      @map("content_snapshot")
  /// 相对上一版的变更摘要
  changeSummary   String?   @map("change_summary")
  /// 推送人（员工）
  pushedByStaffId String    @map("pushed_by_staff_id") @db.Uuid
  /// 推送时间
  pushedAt        DateTime  @map("pushed_at") @db.Timestamptz(3)
  /// 对该版本的决定：confirmed / change_requested / superseded；未决为空
  decision        String?
  /// 决定时间
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  /// 决定人类型：merchant / staff / system / partner；未决为空
  decideActorType String?   @map("decide_actor_type")
  /// 决定人 id；system 时为空
  /// 不建外键：按 decide_actor_type 多态
  decideActorId   String?   @map("decide_actor_id") @db.Uuid
  /// 决定时的客户端来源：weapp / portal / admin；系统动作为空
  decideClient    String?   @map("decide_client")
  /// 创建时间
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)

  /// 所属主体
  entity             Entity                      @relation(fields: [entityId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_version_entity_id")
  /// 所属门店（归属复合外键）
  store              Store                       @relation(fields: [storeId, entityId], references: [id, entityId], onDelete: Restrict, map: "fk_delivery_plan_version_store_entity")
  /// 所属方案
  deliveryPlan       DeliveryPlan                @relation(fields: [deliveryPlanId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_version_delivery_plan_id")
  /// 推送人
  pushedByStaff      Staff                       @relation(fields: [pushedByStaffId], references: [id], onDelete: Restrict, map: "fk_delivery_plan_version_pushed_by_staff_id")
  /// 反向：针对本版本提出的修改请求
  changeRequestsOn   DeliveryPlanChangeRequest[] @relation("DeliveryPlanChangeRequestOnVersion")
  /// 反向：由本版本解决的修改请求
  changeRequestsDone DeliveryPlanChangeRequest[] @relation("DeliveryPlanChangeRequestResolvedByVersion")

  @@unique([deliveryPlanId, versionNo], map: "uq_delivery_plan_version_delivery_plan_id_version_no")
  @@index([storeId], map: "ix_delivery_plan_version_store_id")
  @@map("delivery_plan_version")
}

/// 方案修改请求：商家“联系服务经理修改”的结构化请求；被后续版本解决时回写版本号
model DeliveryPlanChangeRequest {
  /// 主键，UUID v7，应用生成
