/// 冻结分摊：冻结单落在哪些批次、各多少
model PointHoldAlloc {
  /// 冻结单
  pointHoldId  String   @map("point_hold_id") @db.Uuid
  /// 分摊顺序号，从 1 起，= 扣减顺序
  allocNo      Int      @map("alloc_no") @db.SmallInt
  /// 批次；同一冻结单内不重复
