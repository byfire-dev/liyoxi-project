{
  "name": "@liyoxi/shared",
  "version": "0.1.0",
  "private": true,
  "description": "纯函数：计价与取整、周期日期、状态机表、工作日、格式化",
  "type": "module",
  "exports": {
    "./uploads": {
      "types": "./src/uploads/index.ts",
      "default": "./src/uploads/index.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./alloc": {
      "types": "./src/alloc/index.ts",
      "default": "./src/alloc/index.ts"
    },
    "./assert": {
      "types": "./src/assert.ts",
      "default": "./src/assert.ts"
    },
    "./format/money": {
      "types": "./src/format/money.ts",
      "default": "./src/format/money.ts"
    },
    "./period": {
      "types": "./src/period/index.ts",
      "default": "./src/period/index.ts"
    },
    "./pricing": {
      "types": "./src/pricing/index.ts",
      "default": "./src/pricing/index.ts"
    },
    "./time": {
      "types": "./src/time/index.ts",
      "default": "./src/time/index.ts"
    },
    "./workcal": {
      "types": "./src/workcal/index.ts",
      "default": "./src/workcal/index.ts"
    },
    "./design/tokens": {
      "types": "./src/design/generated/tokens.ts",
      "default": "./src/design/generated/tokens.ts"
    },
    "./design/antd-theme": {
      "types": "./src/design/generated/antd-theme.ts",
      "default": "./src/design/generated/antd-theme.ts"
    },
    "./design/icons": {
      "types": "./src/design/generated/icons.ts",
      "default": "./src/design/generated/icons.ts"
    },
    "./design/status-tone": {
      "types": "./src/design/status-tone/index.ts",
      "default": "./src/design/status-tone/index.ts"
    },
    "./design/merchant.scss": "./src/design/generated/merchant.scss",
    "./design/admin.scss": "./src/design/generated/admin.scss",
    "./design/icons-mask.scss": "./src/design/generated/icons-mask.scss",
    "./format/datetime": {
      "types": "./src/format/datetime.ts",
      "default": "./src/format/datetime.ts"
    },
    "./format/duration": {
      "types": "./src/format/duration.ts",
      "default": "./src/format/duration.ts"
    },
    "./mask": {
      "types": "./src/mask/index.ts",
      "default": "./src/mask/index.ts"
    },
    "./machines": {
      "types": "./src/machines/index.ts",
      "default": "./src/machines/index.ts"
    },
    "./params": {
      "types": "./src/params/index.ts",
      "default": "./src/params/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "default": "./src/catalog/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo '源码包：exports 直接指向 src，没有构建'",
    "design:generate": "tsx scripts/generate.ts",
    "machines:check": "tsx scripts/machines-check.ts",
    "machines:coverage": "tsx scripts/machines-coverage.ts",
    "status-tone:check": "tsx scripts/status-tone-check.ts"
  },
  "dependencies": {
    "@liyoxi/contract": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
