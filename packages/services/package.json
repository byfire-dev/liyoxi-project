{
  "name": "@liyoxi/services",
  "version": "0.1.0",
  "private": true,
  "description": "业务逻辑唯一落点：31 个模块分五层，对外只暴露各自的 index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/global-setup": {
      "types": "./src/testing/global-setup.ts",
      "default": "./src/testing/global-setup.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "echo '源码包：exports 直接指向 src，没有构建'",
    "seed": "tsx scripts/seed.ts",
    "seeded-db": "tsx scripts/seeded-db.ts",
    "demo:m0": "tsx scripts/demo-m0.ts",
    "seed:demo": "tsx scripts/demo-seed.ts",
    "admin:live:data": "tsx scripts/admin-live-data.ts",
    "model-budget:inspect": "tsx scripts/model-budget-inspect.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-presigned-post": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@liyoxi/contract": "workspace:*",
    "@liyoxi/db": "workspace:*",
    "@liyoxi/shared": "workspace:*",
    "@napi-rs/canvas": "1.0.9",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "pino": "10.3.1",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/sanitize-html": "2.16.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
