 "errorCodes": [
  {
   "symbol": "ALREADY_IN_ENTITY",
   "code": 41101,
   "http": 409,
   "meaning": "已是其他主体的店员，不能再建主体",
   "retryable": false,
   "details": "{ storeName: string | null }"
  },
  {
   "symbol": "ALREADY_OWNER",
   "code": 41102,
   "http": 409,
   "meaning": "已是该主体的老板，不能接受店员邀请",
   "retryable": false
  },
  {
   "symbol": "PHONE_IN_OTHER_ENTITY",
   "code": 41103,
   "http": 409,
   "meaning": "手机号已属其他主体",
   "retryable": false,
   "details": "{ currentRole: 'owner' | 'clerk' }"
  },
  {
   "symbol": "SEAT_LIMIT_REACHED",
   "code": 41104,
   "http": 409,
   "meaning": "成员名额已满（含待接受的邀请）",
   "retryable": false,
   "details": "{ seatsUsed, memberLimit, limitReason }"
  },
  {
   "symbol": "STORE_LIMIT_REACHED",
   "code": 41105,
   "http": 409,
   "meaning": "门店额度已满",
   "retryable": false,
   "details": "{ storesUsed, storeLimit, limitReason }"
  },
  {
   "symbol": "QUOTA_EXCEEDED",
   "code": 41106,
   "http": 409,
   "meaning": "门店数超过上限，须先停用门店才能新订购、提交广告需求（共用领域码，A77 归 m02；由 m04 m.order.create、m06 m.ad.create 返回，两者的 quote 列为 blockers）",
   "retryable": false,
   "details": "{ storesUsed, storeLimit, storesOver }"
  },
  {
   "symbol": "STORE_ARCHIVED",
   "code": 41107,
   "http": 403,
   "meaning": "门店已停用，只能做收尾操作（门店上下文中间件返回）",
   "retryable": false
  },
  {
   "symbol": "STORE_HAS_OPEN_WORK",
   "code": 41108,
   "http": 409,
   "meaning": "门店有在办事项，不能停用或删除",
   "retryable": false,
   "details": "{ blockers: StoreBlocker[] }"
  },
  {
   "symbol": "LAST_ACTIVE_STORE",
   "code": 41109,
   "http": 409,
   "meaning": "是主体最后一家启用中的门店",
   "retryable": false
  },
  {
   "symbol": "STORE_NOT_DRAFT",
   "code": 41110,
   "http": 409,
   "meaning": "不是草稿门店，只能停用",
   "retryable": false,
   "details": "{ reasons: StoreNotDraftReason[] }"
  },
  {
   "symbol": "INVITATION_INVALID",
   "code": 41111,
   "http": 404,
   "meaning": "邀请令牌不存在或与邀请不符",
   "retryable": false
  },
  {
   "symbol": "INVITATION_USED",
   "code": 41112,
   "http": 410,
   "meaning": "邀请已被使用",
   "retryable": false
  },
  {
   "symbol": "INVITATION_REVOKED",
