 "errorCodes": [
  {
   "symbol": "WECHAT_UNAVAILABLE",
   "code": 41001,
   "http": 503,
   "retryable": true,
   "meaning": "code2Session 或 getPhoneNumber 失败、超时；默认文案“手机号验证服务暂不可用，请稍后重试”（不出现“微信”）"
  },
  {
   "symbol": "WECHAT_CODE_INVALID",
   "code": 41002,
   "http": 400,
   "retryable": false,
   "meaning": "loginCode 或 phoneCode 无效、过期或已使用"
  },
  {
   "symbol": "PHONE_REGION_UNSUPPORTED",
   "code": 41003,
   "http": 400,
   "retryable": false,
   "meaning": "非中国大陆手机号"
  },
  {
   "symbol": "ACCOUNT_DISABLED",
   "code": 41004,
   "http": 403,
   "retryable": false,
   "meaning": "手机号登录时账号已被后台禁用"
  },
  {
   "symbol": "REVERIFY_REQUIRED",
   "code": 41005,
   "http": 403,
   "retryable": false,
   "meaning": "休眠保护：长期未登录的老板账号换微信，需人工复核"
  },
  {
   "symbol": "CONTENT_REJECTED",
   "code": 41006,
   "http": 400,
   "retryable": false,
   "meaning": "提交的文字未通过内容安全检测（共用码，A77；details { fields: string[] }）",
   "details": "{ fields: string[] }"
  },
  {
   "symbol": "SMS_UNAVAILABLE",
   "code": 41007,
   "http": 503,
   "retryable": false,
   "meaning": "短信通道未配置、模板不可用或发送失败（共用码，A77；m03 资质联系人验证码共用）"
  },
  {
   "symbol": "SMS_CODE_INVALID",
   "code": 41008,
   "http": 400,
   "retryable": false,
   "meaning": "短信验证码错误、过期、已用或已作废（共用码，A77；m03 共用）",
   "details": "{ attemptsLeft: integer | null }"
  },
  {
   "symbol": "PHONE_UNCHANGED",
   "code": 41009,
   "http": 400,
   "retryable": false,
   "meaning": "新手机号与当前手机号相同"
  },
  {
   "symbol": "PHONE_TAKEN",
   "code": 41010,
   "http": 409,
   "retryable": false,
   "meaning": "新手机号已被有成员关系或已禁用的账号使用"
  },
  {
   "symbol": "IDENTITY_TOO_NEW",
   "code": 41011,
   "http": 403,
   "retryable": false,
   "meaning": "当前微信绑定不足 7 天，不能移除其他微信",
   "details": "{ removableAt: string(date-time) }"
  },
  {
   "symbol": "ACCOUNT_DELETION_BLOCKED",
   "code": 41012,
   "http": 409,
   "retryable": false,
   "meaning": "老板注销时主体有未办结事项（details.blockers）",
