    "payment_txn.status: created/prepaid → closed（渠道事实）",
    "payment_txn.status: created/prepaid/closed → succeeded（查单为已支付，recordChannelSuccess）",
    "billing_order.status: pending_payment → paid（查单为已支付时，applyPayment + fulfill，同 3.10）",
    "subscription_term.status: （新建）→ active 或 scheduled（fulfill，同 3.10）",
    "billing_account.sub_status: none/expired → active（fulfill，同 3.10）",
    "grant_schedule.status: pending → granted（fulfill，第 0 个月）",
    "billing_order.fulfillment_status: none → done 或 blocked（子状态，只写审计）",
    "payment_exception.status: （新建）→ open 或 auto_healed（同 3.10）"
   ],
   "xAuth": "member",
   "clerkView": "none",
   "xIdempotent": "required",
   "idempotentNote": "三段式用例（C51，先调外部；x-three-phase）：微信先查单再关单，幂等记录随最后的事务写",
   "lockVersion": false,
   "xThreePhase": "call-first"
