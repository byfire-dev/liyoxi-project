  {
   "operationId": "m.paymentOrder.wechatPrepay",
   "method": "POST",
   "path": "/m/payment-orders/{paymentOrderId}/wechat-prepay",
   "section": "3.9",
   "requestSchemas": [],
   "responseSchema": "PrepayResult",
   "errors": [
    "NOT_FOUND",
    "STATE_NOT_ALLOWED",
    "PAYMENT_ORDER_EXPIRED",
    "PAYMENT_ORDER_CLOSED",
    "IDEMPOTENCY_IN_PROGRESS",
    "PROVIDER_UNAVAILABLE",
    "UPSTREAM_TIMEOUT",
    "ACCOUNT_BUSY"
   ],
   "events": [
    "payment_txn.succeeded",
    "billing_order.paid",
    "billing.order_fulfilled",
    "billing.subscription.activated",
    "billing.subscription.renewal_scheduled",
    "billing.subscription.upgraded",
    "billing.points.granted",
    "billing.points.purchased",
    "billing_order.fulfillment_blocked",
    "billing_order.cancelled",
    "payment_exception.opened",
    "payment_exception.auto_healed"
   ],
   "permission": null,
   "capability": "plan.purchase",
   "transitions": [
    "payment_txn.status: （新建）→ created → prepaid（渠道事实，不写状态历史）",
    "payment_txn.status: created/prepaid → closed（老板换了微信号，关闭旧尝试）",
    "payment_txn.status: created/prepaid/closed → succeeded（关旧尝试时查得已支付，recordChannelSuccess）",
    "billing_order.status: pending_payment → paid（关旧尝试时查得已支付，applyPayment + fulfill，同 3.10）",
    "billing_order.status: pending_payment → cancelled（同上，实收或付款人不符）",
    "subscription_term.status: （新建）→ active 或 scheduled（fulfill，同 3.10）",
    "billing_account.sub_status: none/expired → active（fulfill，同 3.10）",
    "grant_schedule.status: pending → granted（fulfill，第 0 个月）",
    "billing_order.fulfillment_status: none → done 或 blocked（子状态，只写审计）",
    "payment_exception.status: （新建）→ open 或 auto_healed（不符、受阻开单；查单补记留痕）"
   ],
   "xAuth": "member",
   "clerkView": "none",
   "xIdempotent": "required",
   "idempotentNote": "三段式用例（C51，多事务；x-three-phase）：幂等记录随事务 B 写；结果脱敏（C50、A80）：payParams 重放为 null，响应带 replayed",
   "lockVersion": false,
   "xRedactOnReplay": [
    "payParams"
   ],
   "xThreePhase": "multi-tx"
  },
