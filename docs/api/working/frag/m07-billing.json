   ],
   "events": [
    "payment_txn.succeeded",
    "billing_order.paid",
    "billing.order_fulfilled",
    "billing.subscription.activated",
    "billing.subscription.renewal_scheduled",
    "billing.subscription.upgraded",
    "billing.points.granted",
    "billing.points.purchased",
    "billing_order.fulfillment_blocked",
    "billing_order.cancelled",
    "payment_exception.opened",
    "payment_exception.auto_healed"
   ],
   "permission": null,
   "capability": "plan.purchase",
   "transitions": [
    "payment_txn.status: created/prepaid → closed（查得渠道 CLOSED，只记渠道事实，不调关单）",
    "payment_txn.status: created/prepaid/closed → succeeded（渠道事实，不写状态历史）",
    "billing_order.status: pending_payment → paid（applyPayment）",
    "billing_order.status: pending_payment → cancelled（实收或付款人不符，cancel_reason = amount_mismatch / payer_mismatch）",
    "subscription_term.status: （新建）→ active 或 scheduled（fulfill）",
    "billing_account.sub_status: none/expired → active（fulfill，付清套餐且无生效订阅）",
    "grant_schedule.status: pending → granted（fulfill，第 0 个月）",
    "billing_order.fulfillment_status: none → done 或 blocked（子状态，只写审计）",
    "payment_exception.status: （新建）→ auto_healed（查单补记并入账成功的留痕，08:761）",
    "payment_exception.status: （新建）→ open（实收或付款人不符、履约受阻）"
   ],
   "xAuth": "member",
   "clerkView": "none",
   "xIdempotent": "none",
   "idempotentNote": "A50：只查询渠道状态，入账由账本操作键去重；三段式用例",
   "lockVersion": false,
   "xThreePhase": "call-first"
  },
