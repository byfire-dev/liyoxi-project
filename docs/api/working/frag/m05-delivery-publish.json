  "errorCodes": [
    {
      "symbol": "ORDER_IN_AFTER_SALE",
      "code": 45101,
      "http": 409,
      "meaning": "订购单有在途取消申请，方案的推送、确认、提出修改都暂停（10-delivery.md:413；d3-flow.md:880）。后台 `admin.deliveryPlan.push` 同样返回它",
      "retryable": false,
      "details": "{ orderId }"
    },
    {
      "symbol": "PLAN_VERSION_STALE",
      "code": 45102,
      "http": 409,
      "meaning": "确认的方案版本不是当前版本（d3-flow.md:1139、1161）",
      "retryable": false,
      "details": "{ currentVersionNo }"
    },
    {
      "symbol": "TICKET_ON_HOLD",
      "code": 45103,
      "http": 409,
      "meaning": "交付工单暂停中（取消审批中、方案修订待确认），属于这张工单的对象一律拒绝操作（d3-flow.md:879）。后台的样片、成片接口同样返回它；a06 的链接核验只有通过与撤销返回它，退回不检查暂停（11-publish.md:302）",
      "retryable": false,
      "details": "{ reasons: ('cancel_review'|'plan_amendment')[] }"
    },
    {
      "symbol": "SAMPLE_VERSION_STALE",
      "code": 45104,
      "http": 409,
      "meaning": "操作的样片不是当前已推送的版本",
      "retryable": false,
      "details": "{ currentSampleId: string | null, currentVersionNo: integer | null }"
    },
    {
      "symbol": "AD_CHANGED",
      "code": 45105,
      "http": 409,
      "meaning": "样片所用的广告版本已不是当前确认版本，不能确认（d3-flow.md:838，沿用草案名）",
      "retryable": false,
      "details": "{ adIds: string[] }"
    },
    {
      "symbol": "SAMPLE_NOT_VIEWABLE",
      "code": 45106,
      "http": 409,
      "meaning": "声明的查看方式没有对应的提供或访问记录（d3-flow.md:1541 的 `422 SAMPLE_NOT_VIEWABLE` 按 C24 改为 409）",
      "retryable": false,
      "details": "{ viewedVia, requiredEvidence: 'album_saved'|'portal_viewed'|'wecom_sent'|'album_or_portal' }（album_or_portal 用于开关被关闭后的 weapp 兜底）"
    },
    {
      "symbol": "SAMPLE_VIEW_CHANNEL_NOT_OFFERED",
      "code": 45107,
      "http": 409,
      "meaning": "该样片版本推送时没有提供这种查看方式；details = { previewChannels: PreviewChannel[] }",
      "retryable": false,
      "details": "{ previewChannels: PreviewChannel[] }（该版本提供的查看方式；与 m06 AD_PREVIEW_CHANNEL_UNAVAILABLE 同一枚举）"
    },
    {
      "symbol": "SAMPLE_PREVIEW_NOT_READY",
      "code": 45108,
      "http": 409,
      "meaning": "样片水印版尚未生成，请稍后再试",
      "retryable": false
    },
    {
      "symbol": "DOWNLOAD_GRANT_INVALID",
      "code": 45109,
      "http": 409,
