      "section": "3.6",
      "requestSchemas": [
        "PlanConfirmBody"
      ],
      "responseSchema": "DeliveryPlanWriteResult",
      "errors": [
        "ORDER_IN_AFTER_SALE",
        "PLAN_VERSION_STALE",
        "STATE_NOT_ALLOWED"
      ],
      "events": [
        "plan.confirmed",
        "ticket.resumed",
        "ticket.step_changed"
      ],
      "permission": null,
      "capability": "delivery.confirm_plan",
      "transitions": [
        "delivery_plan.status: pending_confirm → confirmed（plan.confirm）",
        "delivery_plan_version.decision: 空 → confirmed",
        "delivery_ticket.step: plan_confirm → ad_prep（plan.confirmed，系统求值）",
        "delivery_ticket.step: ad_prep → sample_making（ads.ready，广告已全部就绪时，系统求值）",
        "delivery_ticket.step: 不变（ticket.resume，解除 plan_amendment 暂停原因）"
      ],
      "redactOnReplay": [
        "content.items[].posterUrl"
      ]
    },
