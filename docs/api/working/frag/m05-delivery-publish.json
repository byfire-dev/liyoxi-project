    {
      "operationId": "m.takedownTask.confirm",
      "method": "POST",
      "path": "/m/takedown-tasks/{takedownTaskId}/confirm",
      "section": "3.23",
      "requestSchemas": [
        "TakedownConfirmBody"
      ],
      "responseSchema": "TakedownTaskWriteResult",
      "errors": [
        "STATE_NOT_ALLOWED",
        "TAKEDOWN_METHOD_NOT_ALLOWED"
      ],
      "events": [
        "takedown.merchant_confirmed",
        "takedown.checked",
        "ticket.step_changed",
        "launch.voided",
        "launch.settled",
        "approval.withdrawn",
        "takedown.created",
        "ticket.archived"
      ],
      "permission": null,
      "capability": "publish.takedown_confirm",
      "transitions": [
        "takedown_task.status: pending_merchant → merchant_confirmed（takedown.merchant_confirm）",
        "takedown_task.status: merchant_confirmed → checked（takedown.sample_release，按比例抽查且未抽中时）",
        "delivery_ticket.step: in_service → takedown（usage.ended，全部下架任务已由商家确认时，系统求值，工单迁移表第 15 行）",
        "launch_task.review_status: pending/need_fix/verifying/passed → void（launch.void，未上线的任务，第 15 行收尾）",
        "launch_task.review_status: verifying/need_fix → passed（launch.settle，已上线的任务，第 15 行收尾）",
        "approval_request.status: pending → withdrawn（第 15 行收尾撤回在途核验单）",
        "takedown_task.status: (新建) → pending_merchant（ensureTakedownTasks，通常不新建）",
        "delivery_ticket.step: takedown → archived（takedown.all_checked，全部已核查时，系统求值，第 16 行）",
        "delivery_release.state: pushed → closed（usage_ended，归档时，技术状态）"
      ],
      "redactOnReplay": [
        "posterUrl"
      ]
    },
