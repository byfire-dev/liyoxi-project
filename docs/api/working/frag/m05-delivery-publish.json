      "retryable": false,
      "details": "{ reason: DownloadGrantInvalidReason, expiresAt: string | null, canRegenerate: boolean }"
    },
    {
      "symbol": "DOWNLOAD_NOT_AVAILABLE",
      "code": 45110,
      "http": 409,
      "meaning": "成片当前不可下载或不可重新生成授权（未交付、成片包已关闭、订单项已关闭、已过使用期、文件不可用）。下载页同样返回它",
      "retryable": false,
      "details": "{ reason: DownloadUnavailableReason }"
    },
    {
