   ],
   "events": [],
   "permission": null,
   "capability": "delivery.download",
   "transitions": [
    "zip_bundle.zip_state: — → building（kind = zip，首次 ensureZip；06-media.md:962）",
    "zip_bundle.zip_state: none → building（kind = zip；06-media.md:964）",
    "zip_bundle.zip_state: failed → building（kind = zip 且 retry = true；06-media.md:964，A99）",
    "zip_bundle.zip_state: failed → failed（kind = zip 且 retry = false：不建任务、不升代次，A99；06 待回写）",
    "zip_bundle.zip_state: building → building（返回打包中；06-media.md:968）",
    "zip_bundle.zip_state: ready → ready（ZIP 仍 stored，顺延保留期；06-media.md:969；kind = zip 与 publish_list）",
    "zip_bundle.zip_state: ready → building（kind = zip，ZIP 文件已不在；06-media.md:970）",
    "kind = publish_list 用 ensureZip 的 peek（只查不建）：除 ready → ready 外不迁移、不建行、不建任务（06 待回写）"
   ],
   "xAuth": "portal",
   "clerkView": null,
   "xIdempotent": "none",
   "idempotentBy": null,
   "idempotentNote": "签发短时地址（A18、A51；C47、C60）：每次签发都留痕，结果不进幂等记录；ZIP 打包由 zip_gen 与 media_job.dedupe_key 去重",
   "rateLimit": "portal.global",
   "version": "V1.0",
   "writes": [
    "delivery_download_log（entity_id、store_id 取自成片包；client = portal；仅 state = ready 时）",
    "zip_bundle、media_job、file_ref（经 media.ensureZip；kind = zip；publish_list 只顺延保留期）",
    "analytics_event（package_download，source = direct，actor_id = merchant_user_id = 授权老板，role = owner；episode / zip 且 ready 时）"
   ]
