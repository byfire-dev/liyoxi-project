  "errorCodes": [
    {
      "symbol": "AD_CANCEL_IN_PROGRESS",
      "code": 45201,
      "http": 409,
      "retryable": false,
      "meaning": "广告有在途的取消申请，审批结束前不能确认、提出修改或重新提交",
      "details": null
    },
    {
      "symbol": "AD_VERSION_STALE",
      "code": 45202,
      "http": 409,
      "retryable": false,
      "meaning": "请求里的版本号不是当前版本",
      "details": "{ currentVersionNo: integer | null }"
    },
    {
      "symbol": "AD_PREVIEW_CHANNEL_UNAVAILABLE",
      "code": 45203,
      "http": 409,
      "retryable": false,
      "meaning": "这一版推送时没有提供这种查看方式",
      "details": "{ previewChannels: PreviewChannel[] }"
    },
    {
      "symbol": "AD_NOT_VIEWED",
      "code": 45204,
      "http": 409,
      "retryable": false,
      "meaning": "还没有通过所选方式查看过这一版（含开关被关闭后以 weapp 确认的兜底）",
      "details": "{ viewedVia: PreviewChannel, requiredEvidence: album_saved | portal_viewed | album_or_portal }"
    },
    {
      "symbol": "CHARGE_CHANGED",
      "code": 45205,
      "http": 409,
      "retryable": false,
      "meaning": "超次修改的扣减积分与页面提示不一致，或需要扣积分但尚未确认（沿用 d3-flow.md:1312 的符号名）",
      "details": "{ isChargeable: boolean, chargePoints: integer, freeRevisionsRemaining: integer }"
    },
    {
      "symbol": "PLAYABLE_UNAVAILABLE",
      "code": 45206,
      "http": 409,
      "retryable": false,
      "meaning": "可播放资产不是 ready（处理中、失败或已停用）",
      "details": "{ state: PlayableState }"
    }
  ],
