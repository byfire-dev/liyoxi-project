{
  "name": "@liyoxi/spike-weapp-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "pnpm --dir app build",
    "typecheck": "tsc --noEmit -p server && pnpm --dir app typecheck",
    "test": "node --import ./app/scripts/no-env.mjs ./node_modules/vitest/vitest.mjs run --maxWorkers=1 --no-file-parallelism",
    "server": "node server/src/main.ts",
    "fixtures": "node server/src/fixtures.ts",
    "report": "node server/src/report.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "8.3.1"
  }
}
