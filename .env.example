# 狸有戏 · 环境变量样例。只放占位（尖括号里是说明），不放任何真实值。
# 全部变量只经 loadEnv() 校验：packages/services/src/kernel/env.ts。
# 键集合须与 loadEnv 读的键相等、值须都是占位，由 node infra/ci/check-env-example.mjs 核对。
# 会话与测试不建、不读 .env：本地的取值写法见 CLAUDE.md 第 9 节，出处是 infra/compose/local.yml。

# 运行环境，必填：local、test、stg、prod 四选一
APP_ENV=<local|test|stg|prod>

# 日志级别：trace、debug、info、warn、error、fatal。不填按 info
LOG_LEVEL=<trace|debug|info|warn|error|fatal>

# 数据库连接串（敏感项，必填）。明文与 *_FILE 二选一：
# local、test 可以直接给明文；stg、prod 只认 DATABASE_URL_FILE（值是文件路径，文件里放连接串）
DATABASE_URL=postgresql://<用户>:<口令>@<主机>:<端口>/<库名>
DATABASE_URL_FILE=<文件路径>

# Redis 连接串（敏感项，必填）。规则同上
REDIS_URL=redis://<主机>:<端口>/<库号>
REDIS_URL_FILE=<文件路径>
