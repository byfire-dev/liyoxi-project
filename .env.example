# 狸有戏 · 环境变量样例。只放占位（尖括号里是说明），不放任何真实值。
# 全部变量只经 loadEnv() 校验：packages/services/src/kernel/env.ts。
# 键集合须与 loadEnv 读的键相等、值须都是占位，由 node infra/ci/check-env-example.mjs 核对。
# 会话与测试不建、不读 .env：本地的取值写法见 CLAUDE.md 第 9 节，出处是 infra/compose/local.yml。

# 运行环境，必填：local、test、stg、prod 四选一
APP_ENV=<local|test|stg|prod>

# 日志级别：trace、debug、info、warn、error、fatal。不填按 info
LOG_LEVEL=<trace|debug|info|warn|error|fatal>

# 数据库连接串（敏感项，必填）。明文与 *_FILE 二选一：
# local、test 可以直接给明文；stg、prod 只认 DATABASE_URL_FILE（值是文件路径，文件里放连接串）
DATABASE_URL=postgresql://<用户>:<口令>@<主机>:<端口>/<库名>
DATABASE_URL_FILE=<文件路径>

# Redis 连接串（敏感项，必填）。规则同上
REDIS_URL=redis://<主机>:<端口>/<库号>
REDIS_URL_FILE=<文件路径>

# 本地 MinIO 地址（独立可选，空值使用缺省）。仅 local、test；只接受不含账号密码、查询、片段的 http(s) 根 URL。
# ENDPOINT 用于 API/worker 内部读写；PUBLIC_ENDPOINT 用于手机或浏览器直传与图片读取的签名地址。
# 两个进程须使用相同配置；手机地址须能从手机访问，详见本地开发说明。
MINIO_ENDPOINT=<服务端可访问的MinIO根URL>
MINIO_PUBLIC_ENDPOINT=<手机或浏览器可访问的MinIO根URL>
# COS 公共位置完整成组；敏感角色仅普通 JSON FILE。API 配 signer+issuer，worker 仅 worker。
COS_REGION=<COS地域标识>
COS_BUCKET_SECURE=<secure物理桶名-账号后缀>
COS_BUCKET_ASSET=<asset物理桶名-账号后缀>
COS_BUCKET_MEDIA=<media物理桶名-账号后缀>
COS_BUCKET_PUB=<pub物理桶名-账号后缀>
COS_SIGNER_KEYS_FILE=<signer角色JSON文件路径>
COS_STS_ISSUER_KEYS_FILE=<STS-issuer角色JSON文件路径>
COS_WORKER_KEYS_FILE=<worker角色JSON文件路径>

# 字段加密与盲索引的密钥（敏感项）。任何环境都只认 *_FILE：值是文件路径，文件放在不入库的位置；两项成组，要配一起配。
# 本地要起 api、worker 时自己生成两份；不配时进程的启动自检不过。每把密钥是 32 字节：openssl rand -base64 32
# DATA_KEYS_FILE 的文件内容：{ "current": "<当前 kid>", "keys": { "<kid>": "<base64 的 32 字节>" } }；轮换时加新 kid 并改 current，旧的留着
# BIDX_KEYS_FILE 的文件内容：{ "phone": "<base64 的 32 字节>", "uscc": "<base64 的 32 字节>" }；每个用途一把，互不相同
DATA_KEYS_FILE=<文件路径>
BIDX_KEYS_FILE=<文件路径>

# 后台登录的三把密钥（敏感项）。任何环境都只认 *_FILE：值是文件路径，文件放在不入库的位置。
# 不配时后台登录用不了，进程的启动自检不过。每把密钥是 32 字节：openssl rand -base64 32，三把互不相同，也不与上面两份共用
# 文件内容：{ "ticket": "<base64 的 32 字节>", "device": "<base64 的 32 字节>", "mfa": { "current": "<当前 kid>", "keys": { "<kid>": "<base64 的 32 字节>" } } }
# ticket 签登录票据，device 签设备 Cookie，换掉即全部作废（在途的登录要重来、设备要重新认）；mfa 加密动态口令密钥，轮换时加新 kid 并改 current，旧的留着
AUTH_KEYS_FILE=<文件路径>

# 腾讯云短信：整组全配才启用；两份 FILE 文件为纯文本密钥，任何环境不接受明文变量。
SMS_SECRET_ID_FILE=
SMS_SECRET_KEY_FILE=
SMS_SDK_APP_ID=
SMS_REGION=
# 微信小程序与唯一消息推送配置（W2-21）：四项整组，全不配保留未配置能力，半配启动失败。
# 三个敏感项任何环境只认FILE，文件为不超过4KiB的普通文本文件，不在本文件写明文值。
# AppID/token的128字符与secret的256字符是本项目防御边界；AES是43字符规范base64编码的32字节密钥。
WECHAT_APPID=<小程序AppID>
WECHAT_SECRET_FILE=<AppSecret文件路径>
WECHAT_MESSAGE_TOKEN_FILE=<消息推送token文件路径>
WECHAT_MESSAGE_AES_KEY_FILE=<EncodingAESKey文件路径>
# W2-18 错误上报：FILE JSON {"projects":[{"dsn":"公开项目DSN","upstreamDsn":"固定上游DSN（可选）"}]}。
# 1–3个唯一HTTPS项目，禁止密码/query/hash；不配仅脱敏日志，API仍202；明文 CLIENT_ERROR_PROJECTS 禁止。
CLIENT_ERROR_PROJECTS_FILE=

# W3-03 CI：API仅回调成组；worker另需地域/四桶与独立角色FILE，不借COS角色。
CI_CALLBACK_KEY_FILE=
CI_CALLBACK_ORIGIN=
CI_REGION=
CI_BUCKET_SECURE=
CI_BUCKET_ASSET=
CI_BUCKET_MEDIA=
CI_BUCKET_PUB=
CI_WORKER_KEYS_FILE=

# W3-04：完整FILE JSON {workDir,socketPath,aigc:{Label,ContentProducer,ReservedCode1,ContentPropagator,ReservedCode2},templates:{normalize,sd,hd,sample,brand,ai}}。
# 套接字必须在workDir/.sock/；主体编码/Label须经法务确认，模板ID须外部授权配置；不配受控失败、不自动创建云配置。
# ProduceID/PropagateID由系统文件事实生成，禁止把存储凭据/URL放入本文件。
MEDIA_PRODUCTION_FILE=

# Optional model FILE configuration; parsing alone does not enable model calls.
# Each file must contain one complete configuration; plaintext keys are forbidden.
ASR_TENCENT_FILE=
LLM_DOMESTIC_FILE=
